#!/bin/sh
# Wird beim Start der Creative-OS-Sitzung ausgeführt (als Benutzer).
#  1. Graphit-Aussehen für GTK-Programme in die eigenen Einstellungen legen
#  2. Alte Plasma-Einstellungen entfernen, die das Creative-Aussehen überdecken
#     (Farben, Fensterrahmen). Vorher wird einmalig eine Sicherung angelegt.
conf="${XDG_CONFIG_HOME:-$HOME/.config}"

src=/usr/share/creative-os/gtk/gtk.css
if [ -f "$src" ]; then
    marker="/* Creative OS – Graphit"
    for v in gtk-3.0 gtk-4.0; do
        dst="$conf/$v/gtk.css"
        # Eigene Datei des Benutzers bleibt – nur unsere oder die von KDE
        # automatisch erzeugte (nur „@import 'colors.css'“) wird ersetzt.
        if [ ! -e "$dst" ] || head -n1 "$dst" | grep -qF "$marker" \
           || ! grep -v -e '^\s*$' -e "@import 'colors.css'" -e '@import "colors.css"' "$dst" | grep -q .; then
            mkdir -p "$conf/$v"
            cmp -s "$src" "$dst" 2>/dev/null || cp "$src" "$dst"
        fi
    done
fi

# GTK-Einstellungen: von KDE erzeugte (Breeze, hell) durch die Creative-Fassung ersetzen
for v in gtk-3.0 gtk-4.0; do
    ini="$conf/$v/settings.ini"
    sys_ini="/usr/share/creative-os/xdg/$v/settings.ini"
    [ -f "$sys_ini" ] || continue
    if [ ! -e "$ini" ] || grep -qiE "gtk-theme-name=Breeze|gtk-application-prefer-dark-theme=(false|0)" "$ini"; then
        mkdir -p "$conf/$v"
        cp "$sys_ini" "$ini"
    fi
done
# Unter Wayland lesen GTK-Programme ihre Einstellungen aus GSettings
if command -v gsettings >/dev/null 2>&1; then
    gs() { gsettings set org.gnome.desktop.interface "$1" "$2" 2>/dev/null; }
    gs gtk-theme "Adwaita-dark"
    gs color-scheme "prefer-dark"
    gs icon-theme "Creative"
    gs cursor-theme "breeze_cursors"
    gs font-name "Arial 10"
    gs accent-color "blue"
fi

python3 - "$conf" <<'PY'
import re, shutil, sys
from pathlib import Path

conf = Path(sys.argv[1])
# Datei -> (ganze Abschnitte entfernen, einzelne Schlüssel je Abschnitt entfernen)
RULES = {
    "kdeglobals": (
        re.compile(r"^(Colors:.*|WM|ColorEffects:.*)$"),
        {"General": {"ColorScheme", "font", "menuFont", "toolBarFont", "smallestReadableFont", "AccentColor"},
         "KDE": {"widgetStyle", "LookAndFeelPackage"}, "Icons": {"Theme"}},
    ),
    "kwinrc": (re.compile(r"^org\.kde\.kdecoration2$"), {}),
    "breezerc": (re.compile(r".*"), {}),
    # Druck-Taste gehört „Creative Shots“, nicht mehr Spectacle
    "kglobalshortcutsrc": (re.compile(r"^(services\]\[org\.kde\.spectacle\.desktop|org\.kde\.spectacle\.desktop)$"), {}),
}

for name, (drop_groups, drop_keys) in RULES.items():
    path = conf / name
    if not path.is_file():
        continue
    text = path.read_text(encoding="utf-8", errors="replace")
    out, group, skip, changed = [], None, False, False
    for line in text.splitlines():
        m = re.match(r"^\[(.+?)\]", line)
        if m:
            group = m.group(1).split("][")[0]
            skip = bool(drop_groups.match(group) or drop_groups.match(m.group(1)))
            changed |= skip
            if skip:
                continue
        elif skip:
            continue
        elif group in drop_keys and line.split("=", 1)[0].split("[", 1)[0].strip() in drop_keys[group]:
            changed = True
            continue
        out.append(line)
    if changed:
        backup = path.with_name(name + ".vor-creative-os")
        if not backup.exists():
            shutil.copy2(path, backup)
        path.write_text("\n".join(out) + "\n", encoding="utf-8")
PY
# Steam Play (Proton) für alle Spiele ab Werk – nur vor dem ersten Steam-Start,
# danach bleibt die Einstellung in Steam selbst änderbar
steam_cfg="$HOME/.local/share/Steam/config/config.vdf"
if [ ! -e "$steam_cfg" ]; then
    mkdir -p "$(dirname "$steam_cfg")"
    cat > "$steam_cfg" <<'VDF'
"InstallConfigStore"
{
	"Software"
	{
		"Valve"
		{
			"Steam"
			{
				"CompatToolMapping"
				{
					"0"
					{
						"name"		"proton_experimental"
						"config"		""
						"priority"		"75"
					}
				}
			}
		}
	}
}
VDF
fi

exit 0
