#!/bin/sh
# Wird beim Start der Creative-OS-Sitzung ausgeführt (als Benutzer).
#  1. Graphit-Aussehen für GTK-Programme in die eigenen Einstellungen legen
#  2. Alte Plasma-Einstellungen entfernen, die das Creative-Aussehen überdecken
#     (Farben, Fensterrahmen). Vorher wird einmalig eine Sicherung angelegt.
conf="${XDG_CONFIG_HOME:-$HOME/.config}"

# Design (graphit = dunkel, porzellan = hell) – gewählt unter Einstellungen → Darstellung
design=$(sed -n 's/^design=//p' "$conf/creative-os/look.conf" 2>/dev/null | head -1)
[ "$design" = porzellan ] || design=graphit
src=/usr/share/creative-os/gtk/gtk.css
[ "$design" = porzellan ] && [ -f /usr/share/creative-os/gtk/gtk-light.css ] && src=/usr/share/creative-os/gtk/gtk-light.css
if [ -f "$src" ]; then
    marker="/* Creative OS – "
    for v in gtk-3.0 gtk-4.0; do
        dst="$conf/$v/gtk.css"
        # Eigene Datei des Benutzers bleibt – nur unsere oder die von KDE
        # automatisch erzeugte (nur „@import 'colors.css'“) wird ersetzt.
        if [ ! -e "$dst" ] || head -n1 "$dst" | grep -qF "$marker" \
           || ! grep -v -e '^\s*$' -e "@import 'colors.css'" -e '@import "colors.css"' "$dst" | grep -q .; then
            mkdir -p "$conf/$v"
            cmp -s "$src" "$dst" 2>/dev/null || cp "$src" "$dst"
        fi
    done
fi

# GTK-Einstellungen: von KDE erzeugte (Breeze, hell) durch die Creative-Fassung ersetzen
for v in gtk-3.0 gtk-4.0; do
    ini="$conf/$v/settings.ini"
    sys_ini="/usr/share/creative-os/xdg/$v/settings.ini"
    [ -f "$sys_ini" ] || continue
    if [ ! -e "$ini" ] || grep -qiE "gtk-theme-name=Breeze" "$ini" \
       || { [ "$design" = graphit ] && grep -qiE "gtk-application-prefer-dark-theme=(false|0)" "$ini"; }; then
        mkdir -p "$conf/$v"
        cp "$sys_ini" "$ini"
    fi
done
# Unter Wayland lesen GTK-Programme ihre Einstellungen aus GSettings
if command -v gsettings >/dev/null 2>&1; then
    gs() { gsettings set org.gnome.desktop.interface "$1" "$2" 2>/dev/null; }
    if [ "$design" = porzellan ]; then
        gs gtk-theme "Adwaita"
        gs color-scheme "prefer-light"
    else
        gs gtk-theme "Adwaita-dark"
        gs color-scheme "prefer-dark"
    fi
    gs icon-theme "Creative"
    gs cursor-theme "breeze_cursors"
    gs font-name "Arial 10"
    gs accent-color "blue"
fi

python3 - "$conf" "$design" <<'PY'
import re, shutil, sys
from pathlib import Path

conf = Path(sys.argv[1])
light = sys.argv[2] == "porzellan"
# Datei -> (ganze Abschnitte entfernen, einzelne Schlüssel je Abschnitt entfernen)
RULES = {
    "kdeglobals": (
        re.compile(r"^(Colors:.*|WM|ColorEffects:.*)$"),
        {"General": {"ColorScheme", "font", "menuFont", "toolBarFont", "smallestReadableFont", "AccentColor"},
         "KDE": {"widgetStyle", "LookAndFeelPackage"}, "Icons": {"Theme"}},
    ),
    "kwinrc": (re.compile(r"^org\.kde\.kdecoration2$"), {}),
    "breezerc": (re.compile(r".*"), {}),
    # Druck-Taste gehört „Creative Shots“, nicht mehr Spectacle
    "kglobalshortcutsrc": (re.compile(r"^(services\]\[org\.kde\.spectacle\.desktop|org\.kde\.spectacle\.desktop)$"),
                           {"ksmserver": {"Log Out", "Log Out Without Confirmation"}}),
}

if light:  # die helle Palette steht bewusst in der eigenen kdeglobals – nicht entfernen
    RULES["kdeglobals"] = (re.compile(r"^(WM)$"), {"KDE": {"widgetStyle", "LookAndFeelPackage"}, "Icons": {"Theme"}})
for name, (drop_groups, drop_keys) in RULES.items():
    path = conf / name
    if not path.is_file():
        continue
    text = path.read_text(encoding="utf-8", errors="replace")
    out, group, skip, changed = [], None, False, False
    for line in text.splitlines():
        m = re.match(r"^\[(.+?)\]", line)
        if m:
            group = m.group(1).split("][")[0]
            skip = bool(drop_groups.match(group) or drop_groups.match(m.group(1)))
            changed |= skip
            if skip:
                continue
        elif skip:
            continue
        elif group in drop_keys and line.split("=", 1)[0].split("[", 1)[0].strip() in drop_keys[group]:
            changed = True
            continue
        out.append(line)
    if changed:
        backup = path.with_name(name + ".vor-creative-os")
        if not backup.exists():
            shutil.copy2(path, backup)
        path.write_text("\n".join(out) + "\n", encoding="utf-8")
PY
# Steam Play (Proton) für alle Spiele ab Werk – nur vor dem ersten Steam-Start,
# danach bleibt die Einstellung in Steam selbst änderbar
steam_cfg="$HOME/.local/share/Steam/config/config.vdf"
if [ ! -e "$steam_cfg" ]; then
    mkdir -p "$(dirname "$steam_cfg")"
    cat > "$steam_cfg" <<'VDF'
"InstallConfigStore"
{
	"Software"
	{
		"Valve"
		{
			"Steam"
			{
				"CompatToolMapping"
				{
					"0"
					{
						"name"		"proton_experimental"
						"config"		""
						"priority"		"75"
					}
				}
			}
		}
	}
}
VDF
fi

# Brave im Graphit-Look: Brave übernimmt Farben und Menüs (auch das Rechtsklick-Menü)
# vom GTK-Design von Creative OS. Einmalig je Profil umstellen – nur wenn Brave nicht läuft;
# wer danach in Brave ein anderes Design wählt, behält es.
if ! pgrep -u "$(id -u)" -x brave >/dev/null 2>&1; then
python3 - "$conf" <<'PY'
import json, sys
from pathlib import Path
base = Path(sys.argv[1]) / "BraveSoftware" / "Brave-Browser"
marker = Path(sys.argv[1]) / "creative" / "brave-graphit-v1"
if base.is_dir() and not marker.exists():
    for prefs in list(base.glob("Default/Preferences")) + list(base.glob("Profile */Preferences")):
        try:
            data = json.loads(prefs.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        theme = data.setdefault("extensions", {}).setdefault("theme", {})
        theme["system_theme"] = 1          # 1 = GTK (Creative-Graphit), 0 = Standard
        theme.pop("id", None)              # eigenes Farbschema (alte Richtlinie) entfernen
        theme.pop("pack", None)
        data.setdefault("browser", {}).setdefault("theme", {}).pop("user_color", None)
        data["browser"]["theme"].pop("color_variant", None)
        tmp = prefs.with_name("Preferences.creative-tmp")
        tmp.write_text(json.dumps(data, separators=(",", ":")), encoding="utf-8")
        tmp.replace(prefs)
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.write_text("1\n")
PY
fi

# Farben für KDE-Programme und Terminal ans gewählte Design anpassen
[ -x /usr/libexec/creative-look-apply ] && /usr/libexec/creative-look-apply --no-gtk

# Einmalige Design-Migration; Sperrverhalten und Passwortprüfung bleiben unverändert.
if command -v kwriteconfig6 >/dev/null 2>&1 && command -v kreadconfig6 >/dev/null 2>&1; then
    konsole_style="$(kreadconfig6 --file konsolerc --group CreativeOS --key GraphitStyleVersion --default 0)"
    if [ "$konsole_style" -lt 1 ] 2>/dev/null; then
        kwriteconfig6 --file konsolerc --group 'Desktop Entry' --key DefaultProfile CreativeGraphit.profile
    fi
    if [ "$konsole_style" -lt 2 ] 2>/dev/null; then
        # Terminal-Fenster im Graphit-Look: ohne Menüleiste, schmale Leisten, Graphit-Reiter
        kwriteconfig6 --file konsolerc --group MainWindow --key MenuBar Disabled
        for bar in mainToolBar sessionToolbar; do
            kwriteconfig6 --file konsolerc --group MainWindow --group "Toolbar $bar" --key ToolButtonStyle IconOnly
            kwriteconfig6 --file konsolerc --group MainWindow --group "Toolbar $bar" --key IconSize 16
        done
        kwriteconfig6 --file konsolerc --group TabBar --key TabBarUseUserStyleSheet true
        kwriteconfig6 --file konsolerc --group TabBar --key TabBarUserStyleSheetFile file:///usr/share/konsole/creative-tabs.css
        kwriteconfig6 --file konsolerc --group CreativeOS --key GraphitStyleVersion 2
    fi
    if [ "$(kreadconfig6 --file kscreenlockerrc --group CreativeOS --key GraphitStyleVersion --default 0)" != 1 ]; then
        kwriteconfig6 --file kscreenlockerrc --group Greeter --key WallpaperPlugin org.kde.image
        kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image file:///usr/share/creative-os/lockscreen/background.svg
        kwriteconfig6 --file kscreenlockerrc --group CreativeOS --key GraphitStyleVersion 1
    fi
fi

# Katalog „Eigene Apps“ (z. B. Creative Engine) einmal einrichten – erscheint in Creative Software.
# Entfernt der Benutzer ihn später selbst, bleibt er entfernt (Merker-Datei).
mark="${XDG_DATA_HOME:-$HOME/.local/share}/creative-os/eigene-apps-katalog"
if [ ! -e "$mark" ] && command -v flatpak >/dev/null 2>&1; then
    (
        if flatpak remote-add --user --if-not-exists creative-eigene-apps \
            https://raw.githubusercontent.com/markuspinkall-ux/creative-os/flatpak-repo/creative-eigene-apps.flatpakrepo \
            >/dev/null 2>&1; then
            mkdir -p "$(dirname "$mark")" && touch "$mark"
        fi
    ) &
fi

exit 0
