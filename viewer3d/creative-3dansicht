                                 Path(__file__).resolve().parent / "model-viewer.min.js") if p.is_file()), None)
MIME = {".html": b"text/html", ".js": b"text/javascript", ".glb": b"model/gltf-binary",
        ".gltf": b"model/gltf+json", ".bin": b"application/octet-stream", ".png": b"image/png",
        ".jpg": b"image/jpeg", ".jpeg": b"image/jpeg", ".webp": b"image/webp", ".ktx2": b"image/ktx2"}

