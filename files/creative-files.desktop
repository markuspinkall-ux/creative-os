[Desktop Entry]
Type=Application
Name=Dateien
GenericName=Dateimanager
Comment=Ordner, Laufwerke und USB-Sticks öffnen
Keywords=Dateien;Ordner;Explorer;Dateimanager;Laufwerk;USB;Papierkorb;
