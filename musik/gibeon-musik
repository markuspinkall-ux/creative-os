    def start_setup(self, part):
        if self.busy():
            return
        args = [str(SETUP)]
        key = self.token.text().strip()
        if part == "atmo" or key:
            if not key.startswith("hf_"):
                self.setup_status.setText("Bitte zuerst deinen Hugging-Face-Schlüssel einfügen (beginnt mit hf_).")
                return
            DATA.mkdir(parents=True, exist_ok=True)
            path = DATA / "hf-token"
            path.touch(mode=0o600, exist_ok=True)
            os.chmod(path, 0o600)
            path.write_text(key + "\n")
        if part == "atmo":
            args += ["--teil", "atmo"]
        self.mode, self.error, self.buffer = "setup", "", b""
        self.log.clear()
        self.log.show()
        self.setup_progress.setValue(0)
        self.setup_progress.show()
        self.setup_status.setText("Starte …")
        self.proc.start("sh", args)
        self.refresh()

    def handle_setup_line(self, line):
        self.log.appendPlainText(line)
        if line.startswith("STEP "):
            parts = line.split(" ", 3)
            try:
                self.setup_progress.setValue(int((int(parts[1]) - 1) * 100 / int(parts[2])))
            except (ValueError, IndexError):
                pass
            self.setup_status.setText(parts[3] if len(parts) > 3 else "")
        elif line.startswith("P "):
            self.setup_status.setText(line[2:].partition(" ")[2])
        elif line.startswith("FEHLER:"):
            self.setup_status.setText(line[7:].replace("ZUGANG_GESPERRT", "").strip())

