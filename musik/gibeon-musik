def stem_from(text):
    s = "".join(c if c.isalnum() else "-" for c in (text or "").strip().lower())
    s = "-".join(p for p in s.split("-") if p)[:40]
    for a, b in (("ä", "ae"), ("ö", "oe"), ("ü", "ue"), ("ß", "ss")):
        s = s.replace(a, b)
    return "".join(c for c in s if c.isascii()) or "klang"


def duration_text(seconds):
    m, s = divmod(int(round(seconds)), 60)
    return f"{m}:{s:02d}"


