    # ---- Zustand ----------------------------------------------------------------
    def busy(self):
        return self.proc.state() != QProcess.ProcessState.NotRunning

    def show_page(self):
        self.pages.setCurrentIndex(1 if ready(mv.MUSIK) or ready(mv.ATMO) else 0)

    def set_kind(self, kind):
        self.kind = kind
        self.picked = None
        for k, b in self.kind_buttons.items():
            b.setProperty("picked", "true" if k == kind else "false")
            b.style().unpolish(b)
            b.style().polish(b)
        self.prompt.setPlaceholderText("z. B. ruhige Musik für ein Fantasy-Dorf" if kind == mv.MUSIK
                                       else "z. B. Vogelgezwitscher im Wald")
        self.update_suggestions()
        self.refresh()

    def update_suggestions(self):
        text = self.prompt.toPlainText()
        if self.picked and text.strip() != self.picked["title"]:
            self.picked = None
        found = mv.suggest(text, self.kind, 8) if text.strip() else []
        if not found:
            found = [s for s in mv.SUGGESTIONS if s["kind"] == self.kind][:8]
        while self.tags_grid.count():
            w = self.tags_grid.takeAt(0).widget()
            if w:
                w.deleteLater()
        for i, s in enumerate(found):
            b = QPushButton(s["title"], objectName="tag")
            b.setToolTip("Vorschlag übernehmen")
            b.clicked.connect(lambda _=False, sug=s: self.pick(sug))
            self.tags_grid.addWidget(b, i // 2, i % 2)
        self.refresh()

    def pick(self, sug):
        self.picked = sug
        self.prompt.blockSignals(True)
        self.prompt.setPlainText(sug["title"])
        self.prompt.blockSignals(False)
        if sug["kind"] == mv.ATMO:
            continuous = bool(sug.get("continuous"))
            self.with_pauses.setChecked(not continuous)
            self.with_bed.setChecked(bool(sug.get("bed")))
            self.pause.setCurrentIndex(max(0, self.pause.findData(sug.get("pause", "mittel"))))
        else:
            sec = sug.get("seconds", 120)
            self.music_len.setCurrentIndex(max(0, self.music_len.findData(sec)))
        self.refresh()

    def refresh(self):
        gpu = gpu_name()
        self.chip.setText(("Grafikkarte: " + gpu.split(",")[0]) if gpu else "Keine NVIDIA-Grafikkarte gefunden")
        busy = self.busy()
        music = self.kind == mv.MUSIK
        self.music_box.setVisible(music)
        self.atmo_box.setVisible(not music)
        part_ready = ready(self.kind)
        self.atmo_missing.setVisible(not music and not part_ready)
        self.atmo_setup_btn.setVisible(not music and not part_ready)
        self.atmo_missing.setText("Für Geräusche fehlt noch die Geräusch-KI (Stable Audio Open). Sie braucht einmalig "
                                  "einen kostenlosen Hugging-Face-Schlüssel.")
        self.pause.setEnabled(self.with_pauses.isChecked())
        self.with_bed.setEnabled(self.with_pauses.isChecked())
        if self.picked:
            if self.picked["kind"] == mv.ATMO:
                info = "Vorlage gewählt: Die KI erzeugt mehrere Varianten, die App setzt sie zu einer langen Spur zusammen."
            else:
                info = "Vorlage gewählt – du kannst die Beschreibung noch ergänzen."
        else:
            info = "Eigene Beschreibung – für Geräusche klappen englische Wörter am besten." if not music else ""
        self.picked_label.setText(info)
        self.picked_label.setVisible(bool(info))
        self.go.setEnabled(not busy and part_ready)
        self.setup_music.setEnabled(not busy)
        self.setup_atmo.setEnabled(not busy)
        has = self.results.currentItem() is not None
        playing = self.player is not None and self.player.playbackState() == QMediaPlayer.PlaybackState.PlayingState
        self.play_btn.setText("■  Stopp" if playing else "▶  Anhören")
        self.play_btn.setEnabled(has or playing)
        self.save_btn.setEnabled(has)

    # ---- Erzeugen ---------------------------------------------------------------
    def start_generate(self):
        text = self.prompt.toPlainText().strip()
        if not text:
            self.status.setText("Bitte beschreibe zuerst, was du hören möchtest – oder wähle einen Vorschlag.")
            return
        if self.busy() or not ready(self.kind):
            return
        seed = self.seed.text().strip()
        seed = int(seed) if seed.isdigit() else -1
        self.work = WORK / time.strftime("%Y%m%d-%H%M%S")
        self.work.mkdir(parents=True, exist_ok=True)
        self.collected = {"event": [], "bed": [], "musik": []}
        self.title = text.split("\n")[0][:60]
        if self.kind == mv.MUSIK:
            prompt = mv.music_prompt(text if not self.picked else "", self.picked)
            self.plan = {"kind": mv.MUSIK, "loop": self.loop.isChecked()}
            self.jobs = [{"role": "musik", "args": ["--musik", "--prompt", prompt, "--seconds",
                                                    str(self.music_len.currentData()),
                                                    "--count", str(self.music_count.currentData()),
                                                    "--seed", str(seed), "--prefix", "musik"]}]
        else:
            plan = mv.atmo_plan(text, self.picked)
            continuous = not self.with_pauses.isChecked()
            self.plan = {"kind": mv.ATMO, "continuous": continuous, "pause": self.pause.currentData(),
                         "total": self.atmo_len.currentData(), "loop": self.loop.isChecked(), "seed": seed}
            seconds = 30 if continuous else plan["event_seconds"]
            count = 2 if continuous else plan["variants"]
            self.jobs = [{"role": "event", "args": ["--atmo", "--prompt", plan["event"], "--seconds", str(seconds),
                                                    "--count", str(count), "--seed", str(seed), "--prefix", "klang"]}]
            bed = plan["bed"] or (f"{mv.to_english(text)} ambience, quiet background, field recording"
                                  if not self.picked else "")
            if not continuous and self.with_bed.isChecked() and bed:
                self.jobs.append({"role": "bed", "args": ["--atmo", "--prompt", bed, "--seconds", "30", "--count", "1",
                                                          "--seed", str(seed), "--prefix", "teppich"]})
        self.progress.setValue(0)
        self.progress.show()
        self.status.setText("Starte die KI … (beim ersten Mal dauert das Laden am längsten)")
        self.next_job()

    def next_job(self):
        if not self.jobs:
            self.assemble()
            return
        self.job = self.jobs.pop(0)
        env = QProcessEnvironment.systemEnvironment()
        env.insert("PYTHONUNBUFFERED", "1")
        self.proc.setProcessEnvironment(env)
        args = ["run", "--rm", "--security-opt", "label=disable", "--device", "nvidia.com/gpu=all",
                "-e", "HF_HUB_OFFLINE=1", "-e", "TRANSFORMERS_OFFLINE=1",
                "-v", f"{DATA / 'modelle'}:/cache", "-v", f"{self.work}:/out", *run_override(), IMAGE,
                *self.job["args"], "--out", "/out"]
        self.mode, self.error, self.buffer = "job", "", b""
        self.proc.start("podman", args)
        self.refresh()

    def read_output(self):
        self.buffer += bytes(self.proc.readAllStandardOutput())
        *lines, self.buffer = self.buffer.split(b"\n")
        for raw in lines:
            line = raw.decode(errors="replace").rstrip()
            if not line:
                continue
            if self.mode == "setup":
                self.handle_setup_line(line)
                continue
            kind, _, rest = line.partition(" ")
            if kind == "P":
                pct, _, text = rest.partition(" ")
                if pct.isdigit():
                    share = 70 if self.job and self.job["role"] != "bed" else 20
                    base = 0 if self.job and self.job["role"] != "bed" else 70
                    self.progress.setValue(base + int(pct) * share // 100)
                self.status.setText(text)
            elif kind == "AUDIO":
                name = rest.split(" ")[0]
                self.collected[self.job["role"]].append(self.work / name)
            elif kind == "ERR":
                self.error = rest

    def finished(self, code, _status):
        mode, self.mode = self.mode, None
        self.buffer = b""
        if mode == "setup":
            ok = code == 0 and ready(mv.MUSIK)
            if ok or ready(mv.ATMO):
                self.setup_progress.setValue(100)
                self.setup_status.setText("Fertig – die KI ist bereit." + ("" if ready(mv.ATMO) else
                                          " (Geräusche kannst du später mit einem Schlüssel freischalten.)"))
                QTimer.singleShot(1200, self.show_page)
            elif not self.setup_status.text() or self.setup_status.text().startswith("Starte"):
                self.setup_status.setText("Einrichtung fehlgeschlagen – Details siehe unten.")
            self.refresh()
            return
        if code != 0 or self.error:
            self.jobs = []
            self.progress.hide()
            self.status.setText(self.error or "Die KI wurde unerwartet beendet. Bitte erneut versuchen.")
            self.refresh()
            return
        self.next_job()

    def assemble(self):
        """Ergebnisse fertig machen: Musik kürzen/schließen, Geräusche zu einer langen Spur zusammensetzen."""
        self.status.setText("Setze die Spur zusammen …")
        QApplication.processEvents()
        stamp = time.strftime("%Y-%m-%d %H.%M")
        stem = stem_from(self.title)
        made = []
        try:
            if self.plan["kind"] == mv.MUSIK:
                for i, path in enumerate(self.collected["musik"], 1):
                    audio, rate = km.read_wav(path)
                    audio = km.finish_music(audio, self.plan["loop"], rate)
                    target = music_dir() / f"{stamp} {stem}-{i}.wav"
                    km.write_wav(target, audio, rate)
                    made.append((target, len(audio) / rate))
            else:
                events = [km.resample(*km.read_wav(p)) for p in self.collected["event"]]
                beds = [km.resample(*km.read_wav(p)) for p in self.collected["bed"]]
                seed = None if self.plan["seed"] < 0 else self.plan["seed"]
                if self.plan["continuous"]:
                    audio, _n = km.chain(events, self.plan["total"], 2.0, seed, loop=self.plan["loop"])
                else:
                    audio, _n = km.build_ambience(events, self.plan["total"], self.plan["pause"],
                                                  beds[0] if beds else None, seed=seed, loop=self.plan["loop"])
                target = music_dir() / f"{stamp} {stem}.wav"
                km.write_wav(target, audio)
                made.append((target, len(audio) / km.RATE))
                # Einzelklänge mit ablegen – praktisch, wenn ein Spiel sie selbst zufällig abspielen soll
                parts = music_dir() / f"{stamp} {stem} – Einzelklänge"
                parts.mkdir(exist_ok=True)
                for i, ev in enumerate(events, 1):
                    km.write_wav(parts / f"{stem}-{i}.wav", km.fade(km.trim_silence(ev), 0.05, 0.3))
                for bed in beds:
                    km.write_wav(parts / f"{stem}-teppich.wav", km.make_loop(bed))
        except (OSError, ValueError, EOFError) as error:
            self.status.setText(f"Zusammensetzen fehlgeschlagen: {error}")
            self.progress.hide()
            return
        finally:
            if self.work:
                shutil.rmtree(self.work, ignore_errors=True)
        self.progress.setValue(100)
        self.progress.hide()
        self.load_results()
        self.results.setCurrentRow(0)
        names = ", ".join(t.name for t, _ in made)
        self.status.setText(f"Fertig – gespeichert unter Musik › KI-Musik: {names}")
        self.refresh()

    # ---- Ergebnisse -------------------------------------------------------------
    def load_results(self):
        self.results.clear()
        files = sorted(music_dir().glob("*.wav"), key=lambda p: p.stat().st_mtime, reverse=True)
        for f in files[:200]:
            try:
                import wave
                with wave.open(str(f), "rb") as w:
                    secs = w.getnframes() / w.getframerate()
            except (OSError, EOFError, Exception):  # noqa: BLE001
                secs = 0
            it = QListWidgetItem(f"{f.stem}    ·    {duration_text(secs)}")
            it.setData(Qt.ItemDataRole.UserRole, str(f))
            self.results.addItem(it)

    def current_file(self):
        it = self.results.currentItem()
        return Path(it.data(Qt.ItemDataRole.UserRole)) if it else None

    def play(self):
        if self.player is not None and self.player.playbackState() == QMediaPlayer.PlaybackState.PlayingState:
            self.player.stop()
            return
        f = self.current_file()
        if not f:
            return
        if self.player is None:
            QDesktopServices.openUrl(QUrl.fromLocalFile(str(f)))
            return
        self.player.setSource(QUrl.fromLocalFile(str(f)))
        self.player.play()

    def save_as(self):
        f = self.current_file()
        if not f:
            return
        path, chosen = QFileDialog.getSaveFileName(self, "Speichern unter", str(Path.home() / f.name),
                                                   "WAV (*.wav);;OGG Vorbis – für Spiele (*.ogg);;MP3 (*.mp3)")
        if not path:
            return
        suffix = Path(path).suffix.lower()
        if suffix not in (".wav", ".ogg", ".mp3"):
            suffix = ".ogg" if "ogg" in (chosen or "").lower() else ".mp3" if "mp3" in (chosen or "").lower() else ".wav"
            path += suffix
        try:
            if suffix == ".wav":
                shutil.copyfile(f, path)
            else:
                codec = ["-c:a", "libvorbis", "-q:a", "6"] if suffix == ".ogg" else ["-c:a", "libmp3lame", "-b:a", "256k"]
                subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(f), *codec, path],
                               check=True, timeout=600)
            self.status.setText(f"Gespeichert: {Path(path).name}")
        except (OSError, subprocess.SubprocessError) as error:
            self.status.setText(f"Speichern fehlgeschlagen: {error}")

    def closeEvent(self, event):
        if self.busy():
            if QMessageBox.question(self, APP, "Es läuft noch etwas. Trotzdem beenden?") \
                    != QMessageBox.StandardButton.Yes:
                event.ignore()
                return
            self.proc.kill()
            self.proc.waitForFinished(2000)
        super().closeEvent(event)


def selftest(window):
    """Ohne Grafikkarte: Vorschläge, Pläne und das Zusammensetzen mit künstlichen Klängen prüfen."""
    import numpy as np
    assert mv.suggest("Vogelgezwitscher")[0]["key"] == "voegel-wald"
    window.set_kind(mv.ATMO)
    window.pick(mv.by_key("voegel-wald"))
    assert window.with_pauses.isChecked() and window.with_bed.isChecked()
    work = Path(tempfile.mkdtemp(prefix="musik-test-"))
    rate = km.RATE
    for i, f in enumerate((2000, 3000, 4000), 1):
        t = np.arange(int(1.2 * rate)) / rate
        s = (np.sin(2 * np.pi * f * t) * np.exp(-3 * t) * 0.5).astype(np.float32)
        km.write_wav(work / f"klang-{i}.wav", np.stack([s, s], 1))
    km.write_wav(work / "teppich-1.wav", np.random.default_rng(0).normal(0, .05, (5 * rate, 2)).astype(np.float32))
    window.work = work
    window.title = "Vogelgezwitscher im Wald"
    window.collected = {"event": sorted(work.glob("klang-*.wav")), "bed": [work / "teppich-1.wav"], "musik": []}
    window.plan = {"kind": mv.ATMO, "continuous": False, "pause": "kurz", "total": 60, "loop": True, "seed": 1}
    window.assemble()
    made = sorted(music_dir().glob("*vogelgezwitscher*.wav"))
    assert made, "keine Spur entstanden"
    audio, r = km.read_wav(made[-1])
    assert r == rate and 55 * rate < len(audio) <= 60 * rate
    assert window.results.count() >= 1


def main():
    test = "--selftest" in sys.argv
    shot = next((a.split("=", 1)[1] for a in sys.argv if a.startswith("--screenshot=")), None)
    if test or shot:
        os.environ["MUSIK_AUSGABE"] = tempfile.mkdtemp(prefix="musik-")
    app = QApplication(sys.argv)
    app.setApplicationName(APP)
    app.setDesktopFileName("gibeon-musik")
    app.setWindowIcon(QIcon.fromTheme("gibeon-musik"))
    window = Generator()
    if test:
        selftest(window)
        window.close()
        print("Musikgenerator: Selbsttest ok")
        return 0
    if shot:
        page = next((a.split("=", 1)[1] for a in sys.argv if a.startswith("--seite=")), "haupt")
        art = next((a.split("=", 1)[1] for a in sys.argv if a.startswith("--art=")), "musik")
        window.show()
        window.pages.setCurrentIndex(0 if page == "einrichten" else 1)
        window.set_kind(mv.ATMO if art == "atmo" else mv.MUSIK)
        if art == "atmo":
            window.prompt.setPlainText("Vogel")
        QTimer.singleShot(600, lambda: (window.grab().save(shot), app.quit()))
        return app.exec()
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
