#!/bin/sh
# KI-Musikgenerator – KI einmalig einrichten, ohne sudo.
#   Container:  ghcr.io/markuspinkall-ux/gibeon-musik:latest  (≈ 10 GB)
#   Musik:      ACE-Step (Apache 2.0, ≈ 8 GB)            → ~/.local/share/gibeon-musik/modelle/ace-step
#   Geräusche:  Stable Audio Open (≈ 5 GB, HF-Schlüssel)  → ~/.local/share/gibeon-musik/modelle/stable-audio-open
# Ausgabe: Zeilen „STEP <n> <gesamt> <text>“ für die Fortschrittsanzeige.
#   gibeon-musik-setup                 Musik einrichten (und Geräusche, falls ein Schlüssel hinterlegt ist)
#   gibeon-musik-setup --teil atmo     nur Geräusche einrichten (Schlüssel in …/hf-token)
#   gibeon-musik-setup --entfernen     alles wieder löschen
set -eu
DATA="${MUSIK_HOME:-$HOME/.local/share/gibeon-musik}"
IMAGE="${MUSIK_IMAGE:-ghcr.io/markuspinkall-ux/gibeon-musik:latest}"
TEIL=alle
if [ "${1:-}" = "--teil" ]; then TEIL="${2:-alle}"; shift 2; fi
NEED_GB=30
TOTAL=6
step() { echo "STEP $1 $TOTAL $2"; }
fail() { echo "FEHLER: $*"; exit 1; }

if [ "${1:-}" = "--entfernen" ]; then
    podman rmi -f "$IMAGE" >/dev/null 2>&1 || true
    rm -rf "$DATA"
    echo "KI des Musikgenerators entfernt."
    exit 0
fi
if [ -z "${GIBEON_WACH:-}" ] && command -v systemd-inhibit >/dev/null 2>&1 && systemd-inhibit --list >/dev/null 2>&1; then
    export GIBEON_WACH=1
    exec systemd-inhibit --what=idle --mode=block --who="KI-Musikgenerator" --why="KI wird eingerichtet" "$0" --teil "$TEIL" "$@"
fi
mkdir -p "$DATA/modelle"
step 1 "Prüfe die Grafikkarte …"
command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1 \
    || fail "Der KI-Musikgenerator braucht eine NVIDIA-Grafikkarte mit dem NVIDIA-Abbild von Gibeon OS."
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -1 | sed 's/^/Grafikkarte: /'
mem=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits | head -1 | tr -d ' ')
[ "${mem:-0}" -lt 11000 ] 2>/dev/null && echo "Hinweis: Unter 12 GB Grafikspeicher kann der Speicher knapp werden."

step 2 "Prüfe den Container-Zugriff und den Speicherplatz …"
command -v podman >/dev/null 2>&1 || fail "podman fehlt – bitte Gibeon OS aktualisieren."
podman --version >/dev/null 2>&1 || fail "Das Container-Programm (podman) startet nicht. Bitte den PC neu starten und erneut versuchen."
store="$HOME/.local/share/containers"
mkdir -p "$store"
free_gb=$(df -Pk "$DATA" | awk 'NR==2 {print int($4/1024/1024)}')
if [ -f "$DATA/modelle/ace-step/bereit" ]; then need=8; else need=${MUSIK_MIN_GB:-$NEED_GB}; fi
[ "${free_gb:-0}" -lt "$need" ] && fail "Zu wenig Speicherplatz: frei sind ${free_gb} GB, gebraucht werden während der Einrichtung etwa ${need} GB (danach bleiben ≈ 18–23 GB belegt). Bitte Platz schaffen und erneut versuchen."
echo "Freier Speicher: ${free_gb} GB"
if ! { [ -e /run/cdi/nvidia.yaml ] || [ -e /etc/cdi/nvidia.yaml ]; }; then
    fail "Die Grafikkarte ist für Container noch nicht freigegeben. Bitte Gibeon OS aktualisieren und neu starten."
fi

step 3 "Lade den Musik-Container (≈ 10 GB) …"
log="$DATA/laden.log"
ok=0
for try in 1 2 3; do
    if [ "$try" -gt 1 ]; then
        echo "Neuer Versuch ($try von 3) …"
        podman system check --repair >/dev/null 2>&1 || true
        sleep 5
    fi
    { podman pull "$IMAGE" 2>&1; echo "PULL-ENDE $?"; } | tee "$log" | grep -v '^Writing manifest\|^PULL-ENDE\|^ *[0-9a-f]\{16\}:\|^goroutine\|^\s' || true
    if grep -q '^PULL-ENDE 0$' "$log"; then ok=1; break; fi
    grep -qi 'no space left' "$log" && fail "Der Speicherplatz ist beim Entpacken ausgegangen. Bitte Platz schaffen und erneut versuchen."
    grep -qi 'unauthorized\|denied' "$log" && fail "Der Container ist (noch) nicht öffentlich abrufbar. Bitte später erneut versuchen."
done
[ "$ok" = 1 ] || fail "Der Container ließ sich nicht laden (Details: $log)."

step 4 "Teste die Grafikkarte im Container …"
podman run --rm --security-opt label=disable --device nvidia.com/gpu=all --entrypoint python3 "$IMAGE" -c \
    "import torch; assert torch.cuda.is_available(), 'keine Grafikkarte'; print('Grafikkarte im Container:', torch.cuda.get_device_name(0))" \
    || fail "Der Container sieht die Grafikkarte nicht. Bitte neu starten und erneut versuchen."

HERE="$(dirname "$(readlink -f "$0")")"
override=""
[ -f "$HERE/musik-run.py" ] && override="-v $HERE/musik-run.py:/opt/gibeon/run.py:ro"

if [ "$TEIL" != atmo ]; then
    step 5 "Lade die Musik-KI ACE-Step (≈ 8 GB, einmalig) …"
    out="$DATA/einrichten-musik.log"
    set +e
    # shellcheck disable=SC2086
    podman run --rm --security-opt label=disable --device nvidia.com/gpu=all $override \
        -v "$DATA/modelle:/cache" "$IMAGE" --prepare musik 2>&1 | tee "$out"
    set -e
    grep -q '^OK ' "$out" || fail "Die Musik-KI ließ sich nicht einrichten (Details: $out)."
fi

token_file="$DATA/hf-token"
if [ "$TEIL" = atmo ] || [ -s "$token_file" ]; then
    step 6 "Lade die Geräusch-KI Stable Audio Open (≈ 5 GB, einmalig) …"
    [ -s "$token_file" ] || fail "Bitte zuerst deinen Hugging-Face-Schlüssel im Musikgenerator eintragen."
    HF_TOKEN="$(cat "$token_file")"
    export HF_TOKEN
    out="$DATA/einrichten-atmo.log"
    set +e
    # shellcheck disable=SC2086
    podman run --rm --security-opt label=disable --device nvidia.com/gpu=all $override -e HF_TOKEN \
        -v "$DATA/modelle:/cache" "$IMAGE" --prepare atmo 2>&1 | tee "$out"
    set -e
    unset HF_TOKEN
    if grep -q 'ZUGANG_GESPERRT' "$out"; then
        fail "ZUGANG_GESPERRT Stable Audio Open ist für dein Hugging-Face-Konto noch nicht freigegeben. Bitte auf der Modellseite „Agree“ klicken und erneut einrichten."
    fi
    grep -q '^OK ' "$out" || fail "Die Geräusch-KI ließ sich nicht einrichten (Details: $out)."
fi

date +%s > "$DATA/bereit"
echo "FERTIG"
