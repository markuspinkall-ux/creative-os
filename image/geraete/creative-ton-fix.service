[Unit]
Description=Gibeon OS – Lautsprecher-Korrekturen für bekannte Laptops
# Läuft im normalen Start (nach dem Einhängen der Laufwerke) und schreibt nur auf passenden Geräten
# /etc/modprobe.d/creative-ton-fix.conf – die Korrektur wirkt ab dem nächsten Start.
# NICHT vor systemd-udev-trigger ordnen: die Laufwerke warten auf udev, das ergab eine
# Verklemmung → Notfallmodus hinter dem Bootlogo (Update vom 15.11.).
ConditionPathExists=/sys/class/dmi/id/sys_vendor

[Service]
Type=oneshot
ExecStart=/usr/bin/creative-ton-fix --boot
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
