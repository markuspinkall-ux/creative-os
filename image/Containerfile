# Automatisch zurückrollen: Startet eine neue Version nicht richtig (Anmeldebildschirm
# kommt nicht, Taskleiste beschädigt), geht der PC von selbst auf die letzte gesunde zurück.
RUN dnf install -y --skip-unavailable greenboot greenboot-default-health-checks && dnf clean all \
 && rm -f /usr/lib/greenboot/check/required.d/01_repository_dns_check.sh
COPY image/greenboot/50-creative-desktop.sh /usr/lib/greenboot/check/required.d/50-creative-desktop.sh
COPY image/greenboot/creative-session-health /usr/libexec/creative-session-health
COPY image/greenboot/creative-session-health.service /usr/lib/systemd/system/creative-session-health.service
COPY image/greenboot/50-creative-rollback.sh /usr/lib/greenboot/red.d/50-creative-rollback.sh
RUN chmod 755 /usr/lib/greenboot/check/required.d/50-creative-desktop.sh /usr/libexec/creative-session-health \
      /usr/lib/greenboot/red.d/50-creative-rollback.sh \
 && systemctl enable creative-session-health.service \
 && (systemctl enable greenboot-healthcheck.service && echo "Zurückrollen: greenboot aktiv" || echo "ZURÜCKROLLEN: GREENBOOT FEHLT") \
 && (systemctl enable greenboot-set-rollback-trigger.service 2>/dev/null || true)
COPY image/update/creative-update /usr/bin/creative-update
COPY image/update/creative-fix-origin /usr/libexec/creative-fix-origin
COPY image/update/creative-fix-origin.service /usr/lib/systemd/system/creative-fix-origin.service
RUN chmod 755 /usr/libexec/creative-fix-origin && systemctl enable creative-fix-origin.service
COPY image/update/org.creativeos.update.policy /usr/share/polkit-1/actions/org.creativeos.update.policy
COPY image/update/rpm-ostreed-automatic.conf /usr/lib/systemd/system/rpm-ostreed-automatic.service.d/10-creative.conf
RUN chmod 755 /usr/bin/creative-update
RUN sed -i 's/^#\?AutomaticUpdatePolicy=.*/AutomaticUpdatePolicy=stage/' /etc/rpm-ostreed.conf \
 && systemctl enable rpm-ostreed-automatic.timer

