# Creative OS – System-Abbild auf Basis von Fedora Atomic (KDE/KWin)
#
# Das fertige System ist schreibgeschützt und wird nur als Ganzes
# aktualisiert. Läuft nach einem Update etwas nicht, startet man im
# Bootmenü einfach den vorherigen Stand.
#
# Bauen:   image/build.sh            (siehe image/README.md)
# Varianten: NVIDIA=1 (mit NVIDIA-Treiber) oder NVIDIA=0 (AMD/Intel)

ARG FEDORA_VERSION=44
FROM quay.io/fedora-ostree-desktops/kinoite:${FEDORA_VERSION}

ARG FEDORA_VERSION=44
ARG NVIDIA=1

# ---------------------------------------------------------------------------
# 1) RPM Fusion: Steam, vollständige Codecs, NVIDIA-Treiber
# ---------------------------------------------------------------------------
RUN dnf install -y \
        "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-${FEDORA_VERSION}.noarch.rpm" \
        "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${FEDORA_VERSION}.noarch.rpm" \
 && dnf clean all

# ---------------------------------------------------------------------------
# 2) Alle Audio-/Videoformate (MP3, H.264, H.265 …) mit Hardware-Beschleunigung
# ---------------------------------------------------------------------------
RUN dnf swap -y ffmpeg-free ffmpeg --allowerasing \
 && dnf install -y --skip-unavailable gstreamer1-plugins-bad-freeworld gstreamer1-plugin-libav \
 && dnf clean all
# Hardware-Videobeschleunigung (AMD/Intel) für H.264/H.265 – in neueren Fedora-Versionen
# steckt der Treiber in mesa-dri-drivers; der Tausch klappt dann nicht und wird übersprungen.
RUN (dnf swap -y mesa-va-drivers mesa-va-drivers-freeworld \
     || dnf install -y mesa-va-drivers-freeworld \
     || echo "mesa-va-drivers-freeworld übersprungen") \
 && dnf clean all

# ---------------------------------------------------------------------------
# 3) Spiele: Steam fest im System-Abbild (lässt sich nicht entfernen),
#    Controller-Unterstützung, GameMode, Vulkan
# ---------------------------------------------------------------------------
RUN dnf install -y steam steam-devices gamemode mangohud vulkan-tools \
 && dnf clean all

# Discord fest im System (RPM Fusion). Discord will sich sonst selbst
# aktualisieren und startet dann nicht – Updates kommen mit dem System.
# (/opt ist auf Atomic-Systemen beschreibbar und beim Bauen leer – Discord wird
#  darum nach /usr/lib verschoben und über einen Link wieder unter /opt eingehängt)
RUN mkdir -p /var/opt \
 && dnf install -y discord \
 && if [ -d /var/opt/discord ]; then \
        mv /var/opt/discord /usr/lib/discord \
     && printf 'L+ /var/opt/discord - - - - /usr/lib/discord\n' > /usr/lib/tmpfiles.d/creative-discord.conf; \
    fi \
 && dnf clean all
COPY shell/webapps/discord-settings.json /etc/skel/.config/discord/settings.json
RUN mkdir -p /etc/skel/Bilder

# Secure Boot: öffentlicher Schlüssel der Creative-OS-Treiber und Signier-Werkzeug
COPY image/secureboot/creative-os-mok.der /usr/share/creative-os/secureboot/creative-os-mok.der
COPY image/secureboot/sign-modules.sh /usr/libexec/creative-sign-modules
COPY image/secureboot/kernel-devel.sh /usr/libexec/creative-kernel-devel
COPY image/secureboot/creative-secureboot /usr/libexec/creative-secureboot
COPY image/secureboot/postinstall.sh /usr/share/creative-os/secureboot/postinstall.sh
COPY image/secureboot/org.creativeos.secureboot.policy /usr/share/polkit-1/actions/org.creativeos.secureboot.policy
RUN chmod 755 /usr/libexec/creative-sign-modules /usr/libexec/creative-secureboot /usr/libexec/creative-kernel-devel \
 && (command -v mokutil >/dev/null || dnf install -y --skip-unavailable mokutil) && dnf clean all

# ---------------------------------------------------------------------------
# 4) NVIDIA-Treiber (nur Variante NVIDIA=1)
#    Das Kernelmodul wird hier beim Bauen erzeugt – auf dem fertigen,
#    schreibgeschützten System muss nichts mehr kompiliert werden.
# ---------------------------------------------------------------------------
RUN --mount=type=secret,id=mokkey if [ "$NVIDIA" = "1" ]; then \
        KVER="$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' kernel-core | tail -n1)" \
     && /usr/libexec/creative-kernel-devel \
     && dnf install -y --setopt=tsflags=noscripts akmod-nvidia \
     && dnf install -y xorg-x11-drv-nvidia xorg-x11-drv-nvidia-libs.i686 xorg-x11-drv-nvidia-cuda \
     && akmods --force --kernels "${KVER}" --kmod nvidia \
     && find "/usr/lib/modules/${KVER}" -name 'nvidia*.ko*' | grep -q . \
     && /usr/libexec/creative-sign-modules "${KVER}" 'nvidia*' \
     && mkdir -p /usr/lib/bootc/kargs.d \
     && printf 'kargs = ["rd.driver.blacklist=nouveau", "modprobe.blacklist=nouveau", "nvidia-drm.modeset=1"]\n' \
            > /usr/lib/bootc/kargs.d/00-nvidia.toml \
     && dnf clean all ; \
    fi

# ---------------------------------------------------------------------------
# 5) Brave-Browser (offizielles Paket). Brave installiert nach /opt, das auf
#    Atomic-Systemen beschreibbar ist – darum wird es nach /usr/lib verschoben
#    und schreibgeschützt eingebunden.
# ---------------------------------------------------------------------------
RUN rpm --import https://brave-browser-rpm-release.s3.brave.com/brave-core.asc \
 && curl -fsSLo /etc/yum.repos.d/brave-browser.repo \
        https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo \
 && mkdir -p /var/opt \
 && dnf install -y brave-browser \
 && mv /var/opt/brave.com /usr/lib/brave.com \
 && printf 'L+ /var/opt/brave.com - - - - /usr/lib/brave.com\n' > /usr/lib/tmpfiles.d/creative-brave.conf \
 && dnf clean all
# Startseite und Graphit-Farbe, ohne Werbe-Extras (Rewards, Wallet, VPN …)
COPY browser/startpage /usr/share/creative-os/startpage
COPY browser/youtube-desktop-video /usr/share/creative-os/brave-extensions/youtube-desktop-video
COPY browser/brave-policies.json /etc/brave/policies/managed/creative-os.json

# ---------------------------------------------------------------------------
# 6) Creative Software: Flatpak und Flathub ab Werk
# ---------------------------------------------------------------------------
RUN dnf install -y flatpak \
 && shops="$(rpm -qa --qf '%{NAME}\n' | awk '/^(plasma-discover|gnome-software)(-|$)/')" \
 && if [ -n "$shops" ]; then dnf remove -y --setopt=clean_requirements_on_remove=False $shops; fi \
 && mkdir -p /etc/flatpak/remotes.d \
 && curl -fsSLo /etc/flatpak/remotes.d/flathub.flatpakrepo https://dl.flathub.org/repo/flathub.flatpakrepo \
 && dnf clean all

# ---------------------------------------------------------------------------
# 7) Creative Shell (Taskleiste, Startmenü, Schnellzugriff)
# ---------------------------------------------------------------------------
RUN dnf install -y python3-pyside6 python3-numpy python3-paramiko qt6-qtsvg qt6-qtwayland layer-shell-qt \
                   brightnessctl ddcutil liberation-sans-fonts \
 && dnf clean all

COPY shell/creative_shell /usr/lib/creative-shell/creative_shell
COPY shell/bin/creative-shell /usr/bin/creative-shell
COPY --chmod=755 shell/bin/creative-widgets /usr/bin/creative-widgets
COPY widgets/creative-widgets.desktop /usr/share/applications/creative-widgets.desktop
COPY widgets/creative-widgets.svg /usr/share/icons/hicolor/scalable/apps/creative-widgets.svg
COPY shell/session/creative-session /usr/bin/creative-session
COPY shell/session/creative-shell-supervisor /usr/libexec/creative-shell-supervisor
COPY shell/session/creative.desktop /usr/share/wayland-sessions/creative.desktop
COPY shell/session/creative-graphical-session.service /usr/lib/systemd/user/creative-graphical-session.service
COPY shell/session/kde-portal.conf /usr/lib/systemd/user/plasma-xdg-desktop-portal-kde.service.d/50-creative-session.conf
COPY shell/kwin/kwinrc /usr/share/creative-os/xdg/kwinrc
COPY shell/kwin/kscreenlockerrc /usr/share/creative-os/xdg/kscreenlockerrc
COPY shell/kwin/kxkbrc /usr/share/creative-os/xdg/kxkbrc
# KDE-Sperrbildschirm nur optisch anpassen; Authentifizierung bleibt original.
COPY shell/lockscreen/style-lockscreen.py shell/lockscreen/install-lockscreen.sh /tmp/creative-lockscreen/
COPY login/creative/background.svg /usr/share/creative-os/lockscreen/background.svg
RUN sh /tmp/creative-lockscreen/install-lockscreen.sh && rm -rf /tmp/creative-lockscreen
COPY shell/kwin/creative-tasks /usr/share/kwin/scripts/creative-tasks

# KI-Assistenten, YouTube und Twitch als eigene Fenster, fest in der Taskleiste
COPY shell/webapps/creative-webapp /usr/bin/creative-webapp
# Claude bündelt Web-Chat und die lokale Diagnose mit Claude Code (npm).
RUN dnf install -y npm && dnf clean all
COPY --chmod=755 claude/creative-claude /usr/bin/creative-claude
# ChatGPT: offizielle App von OpenAI (RPM, enthält auch Codex). Jeder Systembau
# holt die neueste Version – Updates kommen also mit dem System.
# Liegt etwas unter /opt, wird es wie bei Discord nach /usr/lib verschoben
# (/opt ist auf Atomic-Systemen beschreibbar und beim Bauen leer).
RUN mkdir -p /var/opt \
 && dnf install -y "https://persistent.oaistatic.com/codex-app-prod/linux/rpm/latest/chatgpt.$(uname -m).rpm" \
 && rpm -q chatgpt && ls -l /usr/bin/chatgpt \
 && rpm -ql chatgpt | sed -n 's#^/opt/\([^/]*\).*#\1#p' | sort -u | while IFS= read -r name; do \
        mv "/var/opt/$name" "/usr/lib/$name" \
     && printf 'L+ "/var/opt/%s" - - - - "/usr/lib/%s"\n' "$name" "$name" >> /usr/lib/tmpfiles.d/creative-chatgpt.conf; \
    done \
 && test -z "$(ls -A /var/opt)" \
 && dnf clean all
# Graphit-Dialoge für alle Widget-Apps (Dateiauswahl, Rückfragen, Eingaben, Farbe)
COPY dialogs/creative_dialogs.py /tmp/creative_dialogs.py
# Fedora: „purelib“ zeigt auf /usr/local (unter rpm-ostree ein Verweis nach /var) – daher fest /usr/lib
RUN site="$(python3 -c 'import sys; print(f"/usr/lib/python{sys.version_info[0]}.{sys.version_info[1]}/site-packages")')" \
 && test -d "$site" && python3 -c "import sys; sys.exit(0 if '$site' in sys.path else 1)" \
 && install -Dm644 /tmp/creative_dialogs.py "$site/creative_dialogs.py" && rm -f /tmp/creative_dialogs.py \
 && python3 -m compileall -q "$site/creative_dialogs.py" \
 && cd / && QT_QPA_PLATFORM=offscreen XDG_RUNTIME_DIR=/tmp HOME=/tmp/dlg-home python3 -m creative_dialogs --selftest \
 && rm -rf /tmp/dlg-home
COPY --chmod=755 software/creative-software /usr/bin/creative-software
COPY software/creative-software.desktop /usr/share/applications/creative-software.desktop
COPY --chmod=755 ftp/creative-ftp /usr/lib/creative-ftp/creative-ftp
COPY ftp/ftp_session.py /usr/lib/creative-ftp/ftp_session.py
COPY ftp/creative-ftp.desktop /usr/share/applications/creative-ftp.desktop
COPY ftp/creative-ftp.svg /usr/share/icons/hicolor/scalable/apps/creative-ftp.svg
RUN ln -s /usr/lib/creative-ftp/creative-ftp /usr/bin/creative-ftp \
 && QT_QPA_PLATFORM=offscreen /usr/bin/creative-ftp --selftest
COPY --chmod=755 cut/creative-cut /usr/lib/creative-cut/creative-cut
COPY cut/cut_project.py cut/cut_timeline.py /usr/lib/creative-cut/
COPY cut/creative-cut.desktop /usr/share/applications/creative-cut.desktop
COPY cut/creative-cut.svg /usr/share/icons/hicolor/scalable/apps/creative-cut.svg
RUN ln -s /usr/lib/creative-cut/creative-cut /usr/bin/creative-cut
# Creative 3D: Foto → 3D-Figur (TripoSR). Die KI (PyTorch, Modell ~5 GB) richtet die App
# beim ersten Start im Benutzerordner ein – hier nur Oberfläche, Rechenteil und Vorschau.
COPY --chmod=755 creative3d/creative-3d /usr/lib/creative-3d/creative-3d
COPY --chmod=755 creative3d/creative3d-setup /usr/lib/creative-3d/creative3d-setup
COPY creative3d/creative3d_worker.py creative3d/torchmcubes_shim.py creative3d/viewer.html \
     creative3d/creative3d_rig.py creative3d/creative3d_rigeditor.py creative3d/creative3d_softview.py \
     /usr/lib/creative-3d/
COPY creative3d/creative-3d.desktop /usr/share/applications/creative-3d.desktop
COPY creative3d/creative-3d.svg /usr/share/icons/hicolor/scalable/apps/creative-3d.svg
RUN curl -fsSL -o /usr/lib/creative-3d/model-viewer.min.js \
      https://cdn.jsdelivr.net/npm/@google/model-viewer@4.1.0/dist/model-viewer.min.js \
 && test -s /usr/lib/creative-3d/model-viewer.min.js \
 && ln -s /usr/lib/creative-3d/creative-3d /usr/bin/creative-3d \
 && QT_QPA_PLATFORM=offscreen /usr/bin/creative-3d --selftest
COPY shell/webapps/creative-claude.desktop shell/webapps/creative-chatgpt.desktop shell/webapps/creative-youtube.desktop shell/webapps/creative-twitch.desktop shell/webapps/creative-whatsapp.desktop /usr/share/applications/
COPY shell/creative_shell/qml/Creative/icons/claude.svg /usr/share/icons/hicolor/scalable/apps/creative-claude.svg
COPY shell/creative_shell/qml/Creative/icons/chatgpt.svg /usr/share/icons/hicolor/scalable/apps/creative-chatgpt.svg
COPY shell/creative_shell/qml/Creative/icons/youtube.svg /usr/share/icons/hicolor/scalable/apps/creative-youtube.svg
COPY shell/creative_shell/qml/Creative/icons/twitch.svg /usr/share/icons/hicolor/scalable/apps/creative-twitch.svg
COPY shell/creative_shell/qml/Creative/icons/whatsapp.svg /usr/share/icons/hicolor/scalable/apps/creative-whatsapp.svg

# Creative OS ist die einzige Sitzung im Anmeldebildschirm
RUN chmod 755 /usr/bin/creative-shell /usr/bin/creative-session /usr/libexec/creative-shell-supervisor /usr/bin/creative-webapp \
 && rm -f /usr/share/wayland-sessions/plasma*.desktop /usr/share/xsessions/plasma*.desktop

# ---------------------------------------------------------------------------
# 8) Creative Player (Musik, Videos, IPTV) – Standardprogramm für Medien
# ---------------------------------------------------------------------------
# YouTube Music läuft über die offizielle Webseite → eingebauter Browser-Baustein (Qt WebEngine)
RUN dnf install -y qt6-qtmultimedia python3-mutagen \
 && dnf install -y --skip-unavailable qt6-qtwebengine python3-pyside6-webengine \
 && dnf clean all
COPY media/creative_media /usr/lib/creative-media/creative_media
COPY media/bin/creative-player /usr/bin/creative-player
COPY media/creative-player.desktop /usr/share/applications/creative-player.desktop
COPY media/creative-player.svg /usr/share/icons/hicolor/scalable/apps/creative-player.svg
COPY media/mimeapps.list /etc/xdg/mimeapps.list
RUN chmod 755 /usr/bin/creative-player

# Creative Art – eigenständige Rasterbildbearbeitung mit Qt Widgets.
COPY art/creative_art /usr/lib/creative-art/creative_art
COPY art/creative-art /usr/bin/creative-art
COPY art/creative-art.desktop /usr/share/applications/creative-art.desktop
COPY art/creative-art.svg /usr/share/icons/hicolor/scalable/apps/creative-art.svg
RUN chmod 755 /usr/bin/creative-art

# Creative Writer – formatierte Dokumente, Druckvorschau und PDF.
COPY writer/creative-writer /usr/bin/creative-writer
COPY writer/creative-writer.desktop /usr/share/applications/creative-writer.desktop
COPY writer/creative-writer.svg /usr/share/icons/hicolor/scalable/apps/creative-writer.svg
RUN chmod 755 /usr/bin/creative-writer

# Creative Podcast nutzt dieselbe Qt-Multimedia-Laufzeit wie Creative Player.
COPY podcast/creative_podcast /usr/lib/creative-podcast/creative_podcast
COPY podcast/bin/creative-podcast /usr/bin/creative-podcast
COPY podcast/creative-podcast.desktop /usr/share/applications/creative-podcast.desktop
COPY podcast/creative-podcast.svg /usr/share/icons/hicolor/scalable/apps/creative-podcast.svg
RUN chmod 755 /usr/bin/creative-podcast

# Creative Mail: Qt-Client und Secret Service für Gmail.
RUN dnf install -y libsecret && dnf clean all
COPY mail/gmail.py mail/creative-mail /usr/lib/creative-mail/
COPY mail/creative-mail.desktop /usr/share/applications/creative-mail.desktop
COPY mail/creative-mail.svg /usr/share/icons/hicolor/scalable/apps/creative-mail.svg
RUN chmod 755 /usr/lib/creative-mail/creative-mail \
 && QT_QPA_PLATFORM=offscreen HOME=/tmp/mail-home timeout 30 /usr/lib/creative-mail/creative-mail --selftest \
 && rm -rf /tmp/mail-home

# Creative Magazin – Lieblingsseiten per RSS als tägliche Zeitschrift lesen.
COPY magazin/creative_magazin /usr/lib/creative-magazin/creative_magazin
COPY magazin/bin/creative-magazin /usr/bin/creative-magazin
COPY magazin/creative-magazin.desktop /usr/share/applications/creative-magazin.desktop
COPY magazin/creative-magazin.svg /usr/share/icons/hicolor/scalable/apps/creative-magazin.svg
RUN chmod 755 /usr/bin/creative-magazin

# ---------------------------------------------------------------------------
# 8a1) Creative Notes – eigener Texteditor (ersetzt KWrite), Standard für Textdateien
# ---------------------------------------------------------------------------
COPY notes/creative_notes /usr/lib/creative-notes/creative_notes
COPY notes/bin/creative-notes /usr/bin/creative-notes
COPY notes/creative-notes.desktop /usr/share/applications/creative-notes.desktop
RUN chmod 755 /usr/bin/creative-notes \
 && sed -n 's/^MimeType=//p' /usr/share/applications/creative-notes.desktop | tr ';' '\n' \
    | sed '/^$/d; s/$/=creative-notes.desktop/' >> /etc/xdg/mimeapps.list

# ---------------------------------------------------------------------------
# 8a3) Taskmanager – wie bei Windows (ersetzt den KDE-Systemmonitor)
# ---------------------------------------------------------------------------
RUN dnf install -y --skip-unavailable python3-psutil pciutils && dnf clean all
COPY taskmanager/creative_taskmanager /usr/lib/creative-taskmanager/creative_taskmanager
COPY taskmanager/bin/creative-taskmanager /usr/bin/creative-taskmanager
COPY taskmanager/creative-taskmanager.desktop /usr/share/applications/creative-taskmanager.desktop
RUN chmod 755 /usr/bin/creative-taskmanager

# ---------------------------------------------------------------------------
# 8a4) Creative Pictures (Bildbetrachter) und Creative Shots (Bildschirmfotos)
# ---------------------------------------------------------------------------
RUN dnf install -y --skip-unavailable python3-pillow qt6-qtimageformats kf6-kimageformats spectacle xdg-user-dirs \
 && dnf clean all
COPY pictures/creative_pictures /usr/lib/creative-pictures/creative_pictures
COPY pictures/bin/creative-pictures /usr/bin/creative-pictures
COPY pictures/creative-pictures.desktop /usr/share/applications/creative-pictures.desktop
COPY shots/creative_shots /usr/lib/creative-shots/creative_shots
COPY shots/bin/creative-shots /usr/bin/creative-shots
COPY shots/creative-shots.desktop /usr/share/applications/creative-shots.desktop
RUN chmod 755 /usr/bin/creative-pictures /usr/bin/creative-shots \
 && sed -n 's/^MimeType=//p' /usr/share/applications/creative-pictures.desktop | tr ';' '\n' \
    | sed '/^$/d; s/$/=creative-pictures.desktop/' >> /etc/xdg/mimeapps.list

# ---------------------------------------------------------------------------
# 8a6) Creative Broadcast – rauschfreies Mikrofon (DeepFilterNet) und virtueller
#      Greenscreen (Robust Video Matting → virtuelle Kamera „Creative Kamera“)
# ---------------------------------------------------------------------------
# Virtuelle Kamera: Kernelmodul v4l2loopback (RPM Fusion), beim Bauen erzeugt
RUN --mount=type=secret,id=mokkey KVER="$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' kernel-core | tail -n1)" \
 && /usr/libexec/creative-kernel-devel \
 && dnf install -y --setopt=tsflags=noscripts akmod-v4l2loopback v4l2loopback \
 && akmods --force --kernels "${KVER}" --kmod v4l2loopback \
 && /usr/libexec/creative-sign-modules "${KVER}" 'v4l2loopback' \
 && (find "/usr/lib/modules/${KVER}" -name 'v4l2loopback.ko*' | grep -q . && echo "Creative Broadcast: virtuelle Kamera ok" \
     || echo "BROADCAST: V4L2LOOPBACK FEHLT") ; dnf clean all
COPY broadcast/modprobe-creative-kamera.conf /usr/lib/modprobe.d/creative-kamera.conf
COPY broadcast/modules-load-creative-kamera.conf /usr/lib/modules-load.d/creative-kamera.conf
# KI-Bausteine: OpenCV, ONNX Runtime (aus Fedora oder als Python-Paket), Freistellungs-Modell
RUN dnf install -y --skip-unavailable python3-opencv python3-numpy python3-onnxruntime python3-pip ffmpeg git && dnf clean all \
 && (python3 -c "import onnxruntime" 2>/dev/null || python3 -m pip install --no-cache-dir --target /usr/lib/creative-broadcast/vendor \
        onnxruntime flatbuffers protobuf sympy mpmath coloredlogs humanfriendly --no-deps) \
 && mkdir -p /usr/share/creative-broadcast \
 && curl -fsSL -o /usr/share/creative-broadcast/rvm_mobilenetv3_fp32.onnx \
        https://github.com/PeterL1n/RobustVideoMatting/releases/download/v1.0.0/rvm_mobilenetv3_fp32.onnx \
 || echo "BROADCAST: MODELL ODER ONNX FEHLT"
# Rauschentfernung: DeepFilterNet als LADSPA-Filter für PipeWire (wird hier übersetzt)
RUN dnf install -y --skip-unavailable cargo rust gcc git && dnf clean all \
 && cd /tmp && git clone -q --depth 1 https://github.com/Rikorose/DeepFilterNet \
 && cd DeepFilterNet && CARGO_HOME=/tmp/cargo cargo build -q --release -p deep-filter-ladspa \
 && install -Dm755 target/release/libdeep_filter_ladspa.so /usr/lib64/ladspa/libdeep_filter_ladspa.so \
 && echo "Creative Broadcast: DeepFilterNet ok" || echo "BROADCAST: DEEPFILTERNET FEHLT"; \
    cd / && rm -rf /tmp/DeepFilterNet /tmp/cargo; dnf remove -y cargo rust >/dev/null 2>&1; dnf clean all
# CUDA-Runtime nur im NVIDIA-Abbild, isoliert von anderen Systemprogrammen.
# CUDA 12 bleibt für diese erste Integration explizit ausgewählt.
RUN if [ "$NVIDIA" = "1" ]; then \
      python3 -m pip install --no-cache-dir --only-binary=:all: \
        --target /usr/lib/creative-broadcast/gpu \
        'onnxruntime-gpu[cuda,cudnn]>=1.21,<1.27' \
      && PYTHONPATH=/usr/lib/creative-broadcast/gpu python3 -c \
        "import onnxruntime as o; assert 'CUDAExecutionProvider' in o.get_available_providers()"; \
    fi
COPY broadcast/creative_broadcast /usr/lib/creative-broadcast/creative_broadcast
COPY broadcast/bin/creative-broadcast /usr/bin/creative-broadcast
COPY broadcast/bin/creative-broadcastd /usr/bin/creative-broadcastd
COPY broadcast/creative-broadcast.desktop /usr/share/applications/creative-broadcast.desktop
RUN chmod 755 /usr/bin/creative-broadcast /usr/bin/creative-broadcastd
# Bluetooth: BlueZ-Steuerung im Tray, KDE-Agent für sichere PIN-Kopplung.
RUN dnf install -y bluez bluedevil && systemctl enable bluetooth.service && dnf clean all
# Benachrichtigungen (org.freedesktop.Notifications) im Creative-Look
RUN dnf install -y --skip-unavailable python3-dbus && dnf clean all
COPY notify/creative_notify /usr/lib/creative-notify/creative_notify
COPY notify/bin/creative-notifyd /usr/bin/creative-notifyd
RUN chmod 755 /usr/bin/creative-notifyd

# Creative Capture – Capture-Karte anzeigen (Bild + Ton, Vollbild, Foto, Aufnahme)
COPY capture/creative_capture /usr/lib/creative-capture/creative_capture
COPY capture/bin/creative-capture /usr/bin/creative-capture
COPY capture/creative-capture.desktop /usr/share/applications/creative-capture.desktop
RUN chmod 755 /usr/bin/creative-capture

# Creative Iso – Installations-ISOs erstellen (aus diesem System oder als Netzinstallation)
COPY iso/creative_iso /usr/lib/creative-iso/creative_iso
COPY iso/bin/creative-iso /usr/bin/creative-iso
COPY iso/creative-iso-helper /usr/libexec/creative-iso-helper
COPY iso/org.creativeos.iso.policy /usr/share/polkit-1/actions/org.creativeos.iso.policy
COPY iso/creative-iso.desktop /usr/share/applications/creative-iso.desktop
COPY image/netinstall /usr/share/creative-iso/netinstall
RUN chmod 755 /usr/bin/creative-iso /usr/libexec/creative-iso-helper /usr/share/creative-iso/netinstall/brand-iso.sh \
 && (command -v podman >/dev/null && echo "Creative Iso: podman da" || echo "CREATIVE-ISO: PODMAN FEHLT") \
 && mkdir -p /usr/share/creative-os && if [ "$NVIDIA" = "1" ]; then echo nvidia; else echo amd; fi > /usr/share/creative-os/variant

# OBS Studio (Original, Qt) – läuft unter X11 (XWayland): unter Wayland fehlen OBS noch Funktionen.
# Look: Graphit-Variante des OBS-Designs „Yami“; eigene virtuelle Kamera „OBS Virtuelle Kamera“ (/dev/video43)
RUN dnf install -y --skip-unavailable obs-studio && dnf clean all \
 && (rpm -q obs-studio >/dev/null && echo "OBS: $(rpm -q --qf '%{VERSION}' obs-studio)" || echo "OBS FEHLT")
COPY obs/Yami_CreativeGraphit.ovt /usr/share/obs/obs-studio/themes/Yami_CreativeGraphit.ovt
COPY obs/creative-obs /usr/bin/creative-obs
RUN chmod 755 /usr/bin/creative-obs \
 && f=/usr/share/applications/com.obsproject.Studio.desktop; if [ -f "$f" ]; then \
      sed -i -E 's#^Exec=obs( |$)#Exec=creative-obs\1#; s#^TryExec=obs$#TryExec=creative-obs#' "$f"; grep -n "^Exec" "$f"; fi

