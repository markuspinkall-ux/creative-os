# Android-Apps – Android-Apps und Google Play Store über Waydroid (Android im Container).
# Die Android-Abbilder lädt erst der Nutzer beim Einrichten; Google-Apps werden nicht mitgeliefert.
RUN dnf install -y waydroid && dnf clean all \
 && (command -v waydroid >/dev/null && echo "Android-Apps: Waydroid da" || echo "ANDROID-APPS: WAYDROID FEHLT")
COPY android/gibeon_android /usr/lib/gibeon-android/gibeon_android
COPY --chmod=755 android/bin/gibeon-android /usr/bin/gibeon-android
COPY --chmod=755 android/gibeon-android-helper /usr/libexec/gibeon-android-helper
COPY android/org.creativeos.android.policy /usr/share/polkit-1/actions/org.creativeos.android.policy
COPY android/gibeon-android.desktop /usr/share/applications/gibeon-android.desktop
COPY android/gibeon-android.svg /usr/share/icons/hicolor/scalable/apps/gibeon-android.svg
# Android-Fenster mit Gibeon-Rahmen und im Tablet-Format: Fenster-Vermittler zwischen Waydroid und KWin.
# Er liest die Wayland-Nachrichtenformate aus den XML-Beschreibungen (wayland-devel, wayland-protocols-devel).
# /usr/bin/waydroid wird ein kleiner Wrapper, der den Vermittler beim Start von Android dazwischenschaltet.
COPY --chmod=755 android/bin/gibeon-android-fenster /usr/libexec/gibeon-android-fenster
COPY --chmod=755 android/gibeon-android-fenster-helper /usr/libexec/gibeon-android-fenster-helper
COPY --chmod=755 android/waydroid-wrapper /usr/libexec/gibeon-waydroid-wrapper
RUN dnf install -y wayland-devel wayland-protocols-devel && dnf clean all \
 && test -f /usr/share/wayland/wayland.xml \
 && find /usr/share/wayland-protocols -name 'xdg-decoration-unstable-v1.xml' | grep -q . \
 && real=$(readlink -f /usr/bin/waydroid) \
 && if [ -L /usr/bin/waydroid ] && [ "$real" != /usr/bin/waydroid ] && [ -f "$real" ]; then \
      sed "s#@WAYDROID@#$real#" /usr/libexec/gibeon-waydroid-wrapper > /usr/bin/waydroid.neu \
      && chmod 755 /usr/bin/waydroid.neu && mv -f /usr/bin/waydroid.neu /usr/bin/waydroid \
      && echo "Android-Fenster: Wrapper vor $real"; \
    else echo "ANDROID-FENSTER: /usr/bin/waydroid ist kein Verweis – Rahmen und Tablet-Format fehlen"; fi \
 && PYTHONPATH=/usr/lib/gibeon-android python3 -c "from gibeon_android import wayland as w; i=w.load_protocols(); assert {'wl_display','xdg_toplevel','zxdg_decoration_manager_v1','wp_viewport'} <= set(i), sorted(i); print('Android-Fenster:', len(i), 'Wayland-Schnittstellen')"

# OBS Studio ist entfernt – aufgenommen und gestreamt wird mit Studio (eigene App, siehe unten).

# Studio – eigenes Aufnehmen und Streamen (statt OBS): GStreamer-Mischpult, Bildschirm über das
# Wayland-Portal, Kodieren auf der Grafikkarte (NVENC/VA-API) oder mit x264, Twitch/YouTube-Anmeldung.
# Die Kennungen für Twitch/YouTube stehen in /usr/lib/gibeon-studio/dienste.json.
RUN dnf install -y --skip-unavailable python3-dbus python3-gobject pipewire-gstreamer gstreamer1-plugins-good \
        gstreamer1-plugins-bad-free gstreamer1-plugins-ugly gstreamer1-plugin-openh264 && dnf clean all
COPY studio/gibeon_studio /usr/lib/gibeon-studio/gibeon_studio
COPY capture/creative_capture/audio_routing.py /usr/lib/gibeon-studio/gibeon_studio/audio_routing.py
COPY studio/dienste.json /usr/lib/gibeon-studio/dienste.json
COPY studio/bin/gibeon-studio /usr/bin/gibeon-studio
COPY studio/gibeon-studio.desktop /usr/share/applications/gibeon-studio.desktop
COPY studio/gibeon-studio.svg /usr/share/icons/hicolor/scalable/apps/gibeon-studio.svg
RUN chmod 755 /usr/bin/gibeon-studio \
 && PYTHONPATH=/usr/lib/gibeon-studio python3 -c "from gibeon_studio import engine as e, gst; \
print('Studio: Bild', e.video_encoder(), '· Ton', e.pick(e.AUDIO_ENCODERS), '· Bildschirm', gst.has('pipewiresrc'), \
'· RTMP', gst.has('rtmp2sink') or gst.has('rtmpsink')); assert e.pick(e.AUDIO_ENCODERS) and e.video_encoder()"

