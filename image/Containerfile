# 8b2) Systemsteuerung
# ---------------------------------------------------------------------------
RUN dnf install -y --skip-unavailable libkscreen pipewire-utils pulseaudio-utils cups-client \
        pciutils polkit-kde system-config-printer \
 && dnf clean all
# Laufwerke: nur die eigene, sichere Verwaltung in der Systemsteuerung (einrichten, formatieren,
# umbenennen, verbinden, auswerfen, Zustand). Das System-Laufwerk bleibt immer geschützt –
# deshalb kein Partitionsmanager mehr, der tief ins System eingreifen könnte.
RUN dnf install -y --skip-unavailable exfatprogs ntfsprogs dosfstools udisks2 smartmontools && dnf clean all \
 && for p in kde-partitionmanager gnome-disk-utility; do \
      rpm -q $p >/dev/null 2>&1 && dnf remove -y $p >/dev/null 2>&1 || true; done
COPY drives/creative-drives-helper /usr/libexec/creative-drives-helper
COPY drives/org.creativeos.drives.policy /usr/share/polkit-1/actions/org.creativeos.drives.policy
