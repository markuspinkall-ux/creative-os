 && printf 'd /var/lib/creative-ki 0755 root root -\nd /var/lib/creative-ki/modelle 0755 root root -\nd /var/lib/creative-ki/stimmen 0755 root root -\n' > /usr/lib/tmpfiles.d/creative-ki.conf

