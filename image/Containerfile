# ---------------------------------------------------------------------------
# 8d) Start- und Ausschaltbildschirm mit Gibeon-Logo statt Fedora
#     (Plymouth-Thema; die Startdatei initramfs wird dafür neu erzeugt)
# ---------------------------------------------------------------------------
COPY image/plymouth /tmp/creative-plymouth
RUN dnf install -y --skip-unavailable plymouth-plugin-two-step plymouth-theme-spinner && dnf clean all \
 && mkdir -p /usr/share/plymouth/themes/creative \
 && cp /usr/share/plymouth/themes/spinner/*.png /usr/share/plymouth/themes/creative/ \
 && cp /tmp/creative-plymouth/creative.plymouth /tmp/creative-plymouth/watermark.png /usr/share/plymouth/themes/creative/ \
 && cp /tmp/creative-plymouth/background-tile.png /usr/share/plymouth/themes/creative/background-tile.png \
 && rm -rf /tmp/creative-plymouth \
 && plymouth-set-default-theme creative \
 && printf 'ShowDelay=0\nDeviceTimeout=8\nUseSimpledrm=1\n' >> /etc/plymouth/plymouthd.conf \
 && grep -q '^Theme=creative' /etc/plymouth/plymouthd.conf && grep -q '^UseSimpledrm=1' /etc/plymouth/plymouthd.conf \
 && KVER="$(ls /usr/lib/modules | sort -V | tail -n1)" \
 && dracut --no-hostonly --kver "$KVER" --reproducible --zstd --add ostree -f "/usr/lib/modules/$KVER/initramfs.img" \
 && chmod 0600 "/usr/lib/modules/$KVER/initramfs.img" \
 && (lsinitrd "/usr/lib/modules/$KVER/initramfs.img" 2>/dev/null | grep -q "plymouth/themes/creative/background-tile.png" \
     && echo "Startbildschirm: Graphit-Thema in der Startdatei" || echo "STARTBILDSCHIRM: THEMA FEHLT IN DER STARTDATEI") \
 && (lsinitrd -f etc/plymouth/plymouthd.conf "/usr/lib/modules/$KVER/initramfs.img" 2>/dev/null | grep -q "^UseSimpledrm=1" \
     && echo "Startbildschirm: sofort sichtbar (simpledrm)" || echo "STARTBILDSCHIRM: UseSimpledrm FEHLT IN DER STARTDATEI") \
 && mkdir -p /usr/lib/bootc/kargs.d \
 && printf 'kargs = ["rhgb", "quiet", "splash", "loglevel=3", "rd.udev.log_level=3", "rd.systemd.show_status=false", "systemd.show_status=false", "plymouth.use-simpledrm"]\n' > /usr/lib/bootc/kargs.d/10-creative-splash.toml

# ---------------------------------------------------------------------------
# 9) Systemeinstellungen
# ---------------------------------------------------------------------------
# Name des Systems (ID bleibt "fedora", damit Updates und Paketquellen passen)
# Überall „Gibeon OS“ statt Fedora (ID bleibt "fedora", damit Updates und
# Paketquellen weiter passen – Fedora ist nur noch der Unterbau)
COPY image/plymouth/watermark.png /usr/share/pixmaps/creative-os-logo.png
COPY LICENSE /usr/share/licenses/creative-os/LICENSE
# Versionsnummer und Codename (Planeten von innen nach außen, wie die Rakete fliegt)
COPY image/version.json /usr/share/creative-os/version.json
RUN v="$(date +%Y.%m.%d)" \
 && nr="$(python3 -c 'import json;print(json.load(open("/usr/share/creative-os/version.json"))["nummer"])')" \
 && cn="$(python3 -c 'import json;print(json.load(open("/usr/share/creative-os/version.json"))["codename"])')" \
 && kurz="$(python3 -c 'import json;print(json.load(open("/usr/share/creative-os/version.json"))["kurz"])')" \
 && sed -i -e 's/^NAME=.*/NAME="Gibeon OS"/' \
           -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"Gibeon OS ${nr} · ${cn}\"/" \
           -e "s/^VERSION=.*/VERSION=\"${nr} · ${cn} (${v})\"/" \
           -e "s/^VERSION_CODENAME=.*/VERSION_CODENAME=${kurz}/" \
           -e 's/^VARIANT=.*/VARIANT="Gibeon OS"/' \
           -e 's/^LOGO=.*/LOGO=creative-os-logo/' \
           -e 's|^HOME_URL=.*|HOME_URL="https://github.com/markuspinkall-ux/creative-os"|' \
           -e 's|^SUPPORT_URL=.*|SUPPORT_URL="https://github.com/markuspinkall-ux/creative-os"|' \
           -e 's|^BUG_REPORT_URL=.*|BUG_REPORT_URL="https://github.com/markuspinkall-ux/creative-os/issues"|' \
           -e '/^DOCUMENTATION_URL=/d' -e '/^REDHAT_/d' -e '/^SUPPORT_END=/d' \
           /usr/lib/os-release \
 && (grep -q '^VERSION_CODENAME=' /usr/lib/os-release || echo "VERSION_CODENAME=${kurz}" >> /usr/lib/os-release) \
 && (grep -q '^DEFAULT_HOSTNAME=' /usr/lib/os-release \
       && sed -i 's/^DEFAULT_HOSTNAME=.*/DEFAULT_HOSTNAME="creative-os"/' /usr/lib/os-release \
       || echo 'DEFAULT_HOSTNAME="creative-os"' >> /usr/lib/os-release)
# Fedora-Logos überall durch das Gibeon-Logo ersetzen (Fedora bleibt nur der Unterbau)
COPY image/debrand.py /tmp/debrand.py
