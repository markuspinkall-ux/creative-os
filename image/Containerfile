# ---------------------------------------------------------------------------
# 8a3b) Game Launcher – Steam-Spiele im Vollbild mit dem Controller (wie Big Picture)
# ---------------------------------------------------------------------------
RUN dnf install -y --skip-unavailable python3-evdev && dnf clean all
COPY gamelauncher/creative_gamelauncher /usr/lib/creative-gamelauncher/creative_gamelauncher
COPY gamelauncher/bin/creative-gamelauncher /usr/bin/creative-gamelauncher
COPY gamelauncher/creative-gamelauncher.desktop /usr/share/applications/creative-gamelauncher.desktop
COPY gamelauncher/creative-gamelauncher.svg /usr/share/icons/hicolor/scalable/apps/creative-gamelauncher.svg
RUN chmod 755 /usr/bin/creative-gamelauncher

# Browser: eigener Webbrowser auf Electron (Chromium mit H.264/AAC für Twitch und YouTube).
# Electron-Version hier anheben, um Chromium-Sicherheitsupdates zu übernehmen.
ARG ELECTRON_VERSION=45.3.1
RUN dnf install -y --skip-unavailable unzip librsvg2-tools nss gtk3 alsa-lib libxkbcommon mesa-libgbm libdrm cups-libs at-spi2-atk \
 && dnf clean all \
 && cd /tmp \
 && curl -fsSLO "https://github.com/electron/electron/releases/download/v${ELECTRON_VERSION}/electron-v${ELECTRON_VERSION}-linux-x64.zip" \
 && curl -fsSL "https://github.com/electron/electron/releases/download/v${ELECTRON_VERSION}/SHASUMS256.txt" -o electron-sums.txt \
 && grep " \*electron-v${ELECTRON_VERSION}-linux-x64.zip$" electron-sums.txt | sed 's/ \*/  /' | sha256sum -c - \
 && mkdir -p /usr/lib/creative-browser/electron \
 && unzip -q "electron-v${ELECTRON_VERSION}-linux-x64.zip" -d /usr/lib/creative-browser/electron \
 && rm -f "electron-v${ELECTRON_VERSION}-linux-x64.zip" electron-sums.txt \
 && rm -f /usr/lib/creative-browser/electron/resources/default_app.asar \
 && chmod 4755 /usr/lib/creative-browser/electron/chrome-sandbox
# Die App liegt als resources/app in Electron – so startet Electron sie von selbst
# (ohne default_app.asar kann Electron keinen Ordner als Argument laden).
COPY webbrowser/app /usr/lib/creative-browser/electron/resources/app
# Werbeblocker (Ghostery, MPL-2.0) genau in den Versionen aus package-lock.json
# (/root ist im bootc-Abbild nur ein Verweis nach /var – npm bekommt deshalb HOME und Cache in /tmp)
RUN cd /usr/lib/creative-browser/electron/resources/app \
 && HOME=/tmp/npm-home npm ci --omit=dev --no-audit --no-fund --ignore-scripts --cache /tmp/npm-cache \
 && test -f node_modules/@ghostery/adblocker-electron-preload/dist/index.cjs \
 && rm -rf /tmp/npm-cache /tmp/npm-home
COPY webbrowser/bin/creative-browser /usr/bin/creative-browser
COPY webbrowser/bin/creative-whatsapp /usr/bin/creative-whatsapp
COPY webbrowser/creative-browser.desktop /usr/share/applications/creative-browser.desktop
COPY webbrowser/creative-whatsapp.desktop /usr/share/applications/creative-whatsapp.desktop
COPY --chmod=755 webbrowser/bin/discord /usr/bin/discord
COPY webbrowser/discord.desktop /usr/share/applications/discord.desktop
COPY shell/creative_shell/qml/Creative/icons/discord.svg /usr/share/icons/hicolor/scalable/apps/discord.svg
COPY webbrowser/creative-webbrowser.svg /usr/share/icons/hicolor/scalable/apps/creative-webbrowser.svg
COPY theme/icons/tile-icons.py /tmp/tile-icons.py
RUN chmod 755 /usr/bin/creative-browser /usr/bin/creative-whatsapp \
 && rsvg-convert -w 256 -h 256 /usr/share/icons/hicolor/scalable/apps/creative-webbrowser.svg -o /usr/lib/creative-browser/electron/resources/app/icon.png \
 && python3 /tmp/tile-icons.py --file /usr/share/icons/hicolor/scalable/apps/creative-whatsapp.svg /tmp/whatsapp-kachel.svg \
 && rsvg-convert -w 256 -h 256 /tmp/whatsapp-kachel.svg -o /usr/lib/creative-browser/electron/resources/app/whatsapp/icon.png \
 && python3 /tmp/tile-icons.py --file /usr/share/icons/hicolor/scalable/apps/discord.svg /tmp/discord-kachel.svg \
 && rsvg-convert -w 256 -h 256 /tmp/discord-kachel.svg -o /usr/lib/creative-browser/electron/resources/app/discord/icon.png \
 && rm -f /tmp/tile-icons.py /tmp/whatsapp-kachel.svg /tmp/discord-kachel.svg \
 && ELECTRON_RUN_AS_NODE=1 /usr/lib/creative-browser/electron/electron -e "const p=require('path'),fs=require('fs');const a=p.join(p.dirname(process.execPath),'resources','app','package.json');console.log('Browser: Electron '+process.versions.electron+', App '+JSON.parse(fs.readFileSync(a)).version)" \
    || echo "CREATIVE BROWSER: ELECTRON STARTET NICHT"

