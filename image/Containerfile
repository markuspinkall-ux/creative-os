RUN dnf install -y rclone fuse3 accountsservice mariadb mariadb-server python3-PyMySQL && dnf clean all
COPY settings/creative-drive.service /usr/lib/systemd/user/creative-drive.service
COPY image/audio/51-live-gamer-mini.conf /usr/share/wireplumber/wireplumber.conf.d/51-live-gamer-mini.conf
COPY settings/creative_settings /usr/lib/creative-settings/creative_settings
COPY --chmod=755 settings/bin/creative-mariadb-setup /usr/libexec/creative-mariadb-setup
COPY settings/bin/creative-settings /usr/bin/creative-settings
