# Creative OS – System-Abbild auf Basis von Fedora Atomic (KDE/KWin)
#
# Das fertige System ist schreibgeschützt und wird nur als Ganzes
# aktualisiert. Läuft nach einem Update etwas nicht, startet man im
# Bootmenü einfach den vorherigen Stand.
#
# Bauen:   image/build.sh            (siehe image/README.md)
# Varianten: NVIDIA=1 (mit NVIDIA-Treiber) oder NVIDIA=0 (AMD/Intel)

ARG FEDORA_VERSION=44
FROM quay.io/fedora-ostree-desktops/kinoite:${FEDORA_VERSION}

ARG FEDORA_VERSION=44
ARG NVIDIA=1

# ---------------------------------------------------------------------------
# 1) RPM Fusion: Steam, vollständige Codecs, NVIDIA-Treiber
# ---------------------------------------------------------------------------
RUN dnf install -y \
        "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-${FEDORA_VERSION}.noarch.rpm" \
        "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${FEDORA_VERSION}.noarch.rpm" \
 && dnf clean all

# ---------------------------------------------------------------------------
# 2) Alle Audio-/Videoformate (MP3, H.264, H.265 …) mit Hardware-Beschleunigung
# ---------------------------------------------------------------------------
RUN dnf swap -y ffmpeg-free ffmpeg --allowerasing \
 && dnf install -y --skip-unavailable gstreamer1-plugins-bad-freeworld gstreamer1-plugin-libav \
 && dnf clean all
# Hardware-Videobeschleunigung (AMD/Intel) für H.264/H.265 – in neueren Fedora-Versionen
# steckt der Treiber in mesa-dri-drivers; der Tausch klappt dann nicht und wird übersprungen.
RUN (dnf swap -y mesa-va-drivers mesa-va-drivers-freeworld \
     || dnf install -y mesa-va-drivers-freeworld \
     || echo "mesa-va-drivers-freeworld übersprungen") \
 && dnf clean all

# ---------------------------------------------------------------------------
# 3) Spiele: Steam fest im System-Abbild (lässt sich nicht entfernen),
#    Controller-Unterstützung, GameMode, Vulkan
# ---------------------------------------------------------------------------
RUN dnf install -y steam steam-devices gamemode mangohud vulkan-tools \
 && dnf clean all

# Discord fest im System (RPM Fusion). Discord will sich sonst selbst
# aktualisieren und startet dann nicht – Updates kommen mit dem System.
# (/opt ist auf Atomic-Systemen beschreibbar und beim Bauen leer – Discord wird
#  darum nach /usr/lib verschoben und über einen Link wieder unter /opt eingehängt)
RUN mkdir -p /var/opt \
 && dnf install -y discord \
 && if [ -d /var/opt/discord ]; then \
        mv /var/opt/discord /usr/lib/discord \
     && printf 'L+ /var/opt/discord - - - - /usr/lib/discord\n' > /usr/lib/tmpfiles.d/creative-discord.conf; \
    fi \
 && dnf clean all
COPY shell/webapps/discord-settings.json /etc/skel/.config/discord/settings.json

# ---------------------------------------------------------------------------
# 4) NVIDIA-Treiber (nur Variante NVIDIA=1)
#    Das Kernelmodul wird hier beim Bauen erzeugt – auf dem fertigen,
#    schreibgeschützten System muss nichts mehr kompiliert werden.
# ---------------------------------------------------------------------------
RUN if [ "$NVIDIA" = "1" ]; then \
        KVER="$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' kernel-core | tail -n1)" \
     && dnf install -y akmods "kernel-devel-${KVER}" \
     && dnf install -y --setopt=tsflags=noscripts akmod-nvidia \
     && dnf install -y xorg-x11-drv-nvidia xorg-x11-drv-nvidia-libs.i686 xorg-x11-drv-nvidia-cuda \
     && akmods --force --kernels "${KVER}" --kmod nvidia \
     && find "/usr/lib/modules/${KVER}" -name 'nvidia*.ko*' | grep -q . \
     && mkdir -p /usr/lib/bootc/kargs.d \
     && printf 'kargs = ["rd.driver.blacklist=nouveau", "modprobe.blacklist=nouveau", "nvidia-drm.modeset=1"]\n' \
            > /usr/lib/bootc/kargs.d/00-nvidia.toml \
     && dnf clean all ; \
    fi

# ---------------------------------------------------------------------------
# 5) Brave-Browser (offizielles Paket). Brave installiert nach /opt, das auf
#    Atomic-Systemen beschreibbar ist – darum wird es nach /usr/lib verschoben
#    und schreibgeschützt eingebunden.
# ---------------------------------------------------------------------------
RUN rpm --import https://brave-browser-rpm-release.s3.brave.com/brave-core.asc \
 && curl -fsSLo /etc/yum.repos.d/brave-browser.repo \
        https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo \
 && mkdir -p /var/opt \
 && dnf install -y brave-browser \
 && mv /var/opt/brave.com /usr/lib/brave.com \
 && printf 'L+ /var/opt/brave.com - - - - /usr/lib/brave.com\n' > /usr/lib/tmpfiles.d/creative-brave.conf \
 && dnf clean all
# Startseite und Graphit-Farbe, ohne Werbe-Extras (Rewards, Wallet, VPN …)
COPY browser/startpage /usr/share/creative-os/startpage
COPY browser/brave-policies.json /etc/brave/policies/managed/creative-os.json

# ---------------------------------------------------------------------------
# 6) App-Shop: GNOME Software statt Discover, Flathub ab Werk
# ---------------------------------------------------------------------------
RUN dnf install -y gnome-software gnome-software-rpm-ostree \
 && rpm -qa --qf '%{NAME}\n' 'plasma-discover*' | xargs -r dnf remove -y \
 && mkdir -p /etc/flatpak/remotes.d \
 && curl -fsSLo /etc/flatpak/remotes.d/flathub.flatpakrepo https://dl.flathub.org/repo/flathub.flatpakrepo \
 && dnf clean all

# ---------------------------------------------------------------------------
# 7) Creative Shell (Taskleiste, Startmenü, Schnellzugriff)
# ---------------------------------------------------------------------------
RUN dnf install -y python3-pyside6 qt6-qtsvg qt6-qtwayland layer-shell-qt \
                   brightnessctl ddcutil liberation-sans-fonts \
 && dnf clean all

COPY shell/creative_shell /usr/lib/creative-shell/creative_shell
COPY shell/bin/creative-shell /usr/bin/creative-shell
COPY shell/session/creative-session /usr/bin/creative-session
COPY shell/session/creative-shell-supervisor /usr/libexec/creative-shell-supervisor
COPY shell/session/creative.desktop /usr/share/wayland-sessions/creative.desktop
COPY shell/kwin/kwinrc /usr/share/creative-os/xdg/kwinrc
COPY shell/kwin/kscreenlockerrc /usr/share/creative-os/xdg/kscreenlockerrc
COPY shell/kwin/kxkbrc /usr/share/creative-os/xdg/kxkbrc
COPY shell/lockscreen /tmp/creative-lockscreen
RUN sh /tmp/creative-lockscreen/install-lockscreen.sh && rm -rf /tmp/creative-lockscreen
COPY shell/kwin/creative-tasks /usr/share/kwin/scripts/creative-tasks

# KI-Assistenten, YouTube und Twitch als eigene Fenster, fest in der Taskleiste
COPY shell/webapps/creative-webapp /usr/bin/creative-webapp
COPY shell/webapps/creative-claude.desktop shell/webapps/creative-gemini.desktop shell/webapps/creative-chatgpt.desktop shell/webapps/creative-youtube.desktop shell/webapps/creative-twitch.desktop /usr/share/applications/
COPY shell/creative_shell/qml/Creative/icons/claude.svg /usr/share/icons/hicolor/scalable/apps/creative-claude.svg
COPY shell/creative_shell/qml/Creative/icons/gemini.svg /usr/share/icons/hicolor/scalable/apps/creative-gemini.svg
COPY shell/creative_shell/qml/Creative/icons/chatgpt.svg /usr/share/icons/hicolor/scalable/apps/creative-chatgpt.svg
COPY shell/creative_shell/qml/Creative/icons/youtube.svg /usr/share/icons/hicolor/scalable/apps/creative-youtube.svg
COPY shell/creative_shell/qml/Creative/icons/twitch.svg /usr/share/icons/hicolor/scalable/apps/creative-twitch.svg

# Creative OS ist die einzige Sitzung im Anmeldebildschirm
RUN chmod 755 /usr/bin/creative-shell /usr/bin/creative-session /usr/libexec/creative-shell-supervisor /usr/bin/creative-webapp \
 && rm -f /usr/share/wayland-sessions/plasma*.desktop /usr/share/xsessions/plasma*.desktop

# ---------------------------------------------------------------------------
# 8) Creative Player (Musik, Videos, IPTV) – Standardprogramm für Medien
# ---------------------------------------------------------------------------
RUN dnf install -y qt6-qtmultimedia python3-mutagen python3-requests python3-pip yt-dlp \
 && dnf install -y --skip-unavailable deno yt-dlp-ejs \
 && dnf clean all
COPY media/creative_media /usr/lib/creative-media/creative_media
# YouTube Music (Top 10, Suche) – ytmusicapi in einem eigenen Ordner
RUN pip install --no-cache-dir --no-deps --target /usr/lib/creative-media/vendor ytmusicapi \
 && rm -rf /usr/lib/creative-media/vendor/bin
COPY media/bin/creative-player /usr/bin/creative-player
COPY media/creative-player.desktop /usr/share/applications/creative-player.desktop
COPY media/creative-player.svg /usr/share/icons/hicolor/scalable/apps/creative-player.svg
COPY media/mimeapps.list /etc/xdg/mimeapps.list
RUN chmod 755 /usr/bin/creative-player

# ---------------------------------------------------------------------------
# 8a1) Creative Notes – eigener Texteditor (ersetzt KWrite), Standard für Textdateien
# ---------------------------------------------------------------------------
COPY notes/creative_notes /usr/lib/creative-notes/creative_notes
COPY notes/bin/creative-notes /usr/bin/creative-notes
COPY notes/creative-notes.desktop /usr/share/applications/creative-notes.desktop
RUN chmod 755 /usr/bin/creative-notes \
 && sed -n 's/^MimeType=//p' /usr/share/applications/creative-notes.desktop | tr ';' '\n' \
    | sed '/^$/d; s/$/=creative-notes.desktop/' >> /etc/xdg/mimeapps.list

# ---------------------------------------------------------------------------
# 8a3) Taskmanager – wie bei Windows (ersetzt den KDE-Systemmonitor)
# ---------------------------------------------------------------------------
RUN dnf install -y --skip-unavailable python3-psutil pciutils && dnf clean all
COPY taskmanager/creative_taskmanager /usr/lib/creative-taskmanager/creative_taskmanager
COPY taskmanager/bin/creative-taskmanager /usr/bin/creative-taskmanager
COPY taskmanager/creative-taskmanager.desktop /usr/share/applications/creative-taskmanager.desktop
RUN chmod 755 /usr/bin/creative-taskmanager

# ---------------------------------------------------------------------------
# 8a4) Creative Pictures (Bildbetrachter) und Creative Shots (Bildschirmfotos)
# ---------------------------------------------------------------------------
RUN dnf install -y --skip-unavailable python3-pillow qt6-qtimageformats kf6-kimageformats spectacle xdg-user-dirs \
 && dnf clean all
COPY pictures/creative_pictures /usr/lib/creative-pictures/creative_pictures
COPY pictures/bin/creative-pictures /usr/bin/creative-pictures
COPY pictures/creative-pictures.desktop /usr/share/applications/creative-pictures.desktop
COPY shots/creative_shots /usr/lib/creative-shots/creative_shots
COPY shots/bin/creative-shots /usr/bin/creative-shots
COPY shots/creative-shots.desktop /usr/share/applications/creative-shots.desktop
RUN chmod 755 /usr/bin/creative-pictures /usr/bin/creative-shots \
 && sed -n 's/^MimeType=//p' /usr/share/applications/creative-pictures.desktop | tr ';' '\n' \
    | sed '/^$/d; s/$/=creative-pictures.desktop/' >> /etc/xdg/mimeapps.list

# ---------------------------------------------------------------------------
# 8a2) Creative Calculator – eigener Rechner (ersetzt KCalc)
# ---------------------------------------------------------------------------
COPY calculator/creative_calculator /usr/lib/creative-calculator/creative_calculator
COPY calculator/bin/creative-calculator /usr/bin/creative-calculator
COPY calculator/creative-calculator.desktop /usr/share/applications/creative-calculator.desktop
RUN chmod 755 /usr/bin/creative-calculator

# ---------------------------------------------------------------------------
# 8b) Dateien – eigener Dateimanager, Standard für Ordner
# ---------------------------------------------------------------------------
RUN dnf install -y --skip-unavailable udisks2 xdg-user-dirs && dnf clean all
COPY files/creative_files /usr/lib/creative-files/creative_files
COPY files/bin/creative-files /usr/bin/creative-files
COPY files/creative-files.desktop /usr/share/applications/creative-files.desktop
COPY files/creative-files.svg /usr/share/icons/hicolor/scalable/apps/creative-files.svg
RUN chmod 755 /usr/bin/creative-files \
 && cat /etc/xdg/mimeapps.list > /usr/share/creative-os/xdg/creative-mimeapps.list \
 && echo "inode/directory=creative-files.desktop" >> /usr/share/creative-os/xdg/creative-mimeapps.list \
 && echo "inode/directory=creative-files.desktop" >> /etc/xdg/mimeapps.list

# ---------------------------------------------------------------------------
# 8b2) Systemsteuerung
# ---------------------------------------------------------------------------
RUN dnf install -y --skip-unavailable libkscreen pipewire-utils pulseaudio-utils cups-client \
        pciutils polkit-kde system-config-printer \
 && dnf clean all
# Laufwerke: eigener Helfer (Einrichten, beim Start verbinden) + GNOME Laufwerke für Profis
RUN dnf install -y --skip-unavailable gnome-disk-utility exfatprogs udisks2 && dnf clean all
COPY drives/creative-drives-helper /usr/libexec/creative-drives-helper
COPY drives/org.creativeos.drives.policy /usr/share/polkit-1/actions/org.creativeos.drives.policy
COPY drives/creative-automount /usr/bin/creative-automount
RUN chmod 755 /usr/libexec/creative-drives-helper /usr/bin/creative-automount
COPY settings/creative_settings /usr/lib/creative-settings/creative_settings
COPY settings/bin/creative-settings /usr/bin/creative-settings
COPY settings/creative-settings.desktop /usr/share/applications/creative-settings.desktop
RUN chmod 755 /usr/bin/creative-settings

# ---------------------------------------------------------------------------
# 8b3) Mein Server – Webseite im Heimnetz (Caddy + PHP), Schalter in der Systemsteuerung
# ---------------------------------------------------------------------------
RUN dnf install -y --skip-unavailable caddy php-fpm php-cli nss-mdns avahi && dnf clean all \
 && systemctl enable avahi-daemon.service
COPY server/creative-server-helper /usr/libexec/creative-server-helper
COPY server/creative-server.service /usr/lib/systemd/system/creative-server.service
COPY server/org.creativeos.server.policy /usr/share/polkit-1/actions/org.creativeos.server.policy
COPY server/README.md /usr/share/doc/creative-server/README.md
RUN chmod 755 /usr/libexec/creative-server-helper

# ---------------------------------------------------------------------------
# 8b4) Sprachassistent im Tray (Wetter, Timer, Musik) – Modelle laufen lokal
# ---------------------------------------------------------------------------
RUN dnf install -y --skip-unavailable mpv yt-dlp espeak-ng sound-theme-freedesktop python3-pip python3-numpy \
 && dnf clean all
COPY assistant /tmp/creative-assistant
RUN SKIP_DNF=1 sh /tmp/creative-assistant/install.sh && rm -rf /tmp/creative-assistant /root/.cache

# Willkommens-Assistent beim ersten Start
COPY welcome/creative_welcome /usr/lib/creative-welcome/creative_welcome
COPY welcome/bin/creative-welcome /usr/bin/creative-welcome
RUN chmod 755 /usr/bin/creative-welcome

# ---------------------------------------------------------------------------
# 8c) Nur das Nötigste – und alles im gleichen Look
# ---------------------------------------------------------------------------
# Was das System braucht, lässt sich nicht entfernen (auch nicht versehentlich)
COPY theme/protected.conf /etc/dnf/protected.d/creative-os.conf
# Standard-Apps: Terminal, Spectacle (nimmt für Creative Shots im Hintergrund auf),
# Entpacken (unsichtbar, für ZIP-Dateien)
RUN dnf install -y --skip-unavailable konsole spectacle ark liberation-mono-fonts qt6-qttranslations \
        plasma-integration breeze-gtk breeze-icon-theme \
 && dnf clean all
# Überflüssige KDE-Programme entfernen. Wird etwas davon noch gebraucht,
# bleibt es installiert und wird nur im Startmenü ausgeblendet.
RUN for p in firefox firefox-langpacks okular kate kde-connect kdeconnectd kwalletmanager5 \
             kfind khelpcenter plasma-welcome skanpage kamoso krdc krfb kmousetool kmag \
             kmouth kcharselect kcalc kwrite plasma-systemmonitor gwenview kdebugsettings filelight kgpg akregator dragon elisa-player \
             juk kolourpaint kontact kmail korganizer neochat qrca kde-partitionmanager \
             kjournald mediawriter kwrite-doc; do \
        rpm -q "$p" >/dev/null 2>&1 || continue; \
        dnf remove -y "$p" >/dev/null 2>&1 && echo "entfernt: $p" || echo "bleibt (wird gebraucht): $p"; \
    done \
 && dnf clean all
# PDFs öffnet der Browser (Okular ist entfernt)
RUN for f in /etc/xdg/mimeapps.list /usr/share/creative-os/xdg/creative-mimeapps.list; do \
        echo "application/pdf=brave-browser.desktop" >> "$f"; \
    done

# Aussehen: Fensterrahmen, Graphit-Farben (Qt/KDE + GTK), Creative-Symbole, Startmenü
COPY theme /tmp/creative-theme
RUN SKIP_DNF=1 CREATIVE_ICONS=/usr/lib/creative-shell/creative_shell/qml/Creative/icons \
        sh /tmp/creative-theme/install.sh \
 && rm -rf /tmp/creative-theme

# ---------------------------------------------------------------------------
# 8c2) Anmeldebildschirm im Graphit-Look (SDDM statt Plasma Login Manager)
# ---------------------------------------------------------------------------
RUN dnf install -y --skip-unavailable sddm sddm-wayland-plasma && dnf clean all
COPY login/creative /usr/share/sddm/themes/creative
COPY login/sddm-creative.conf /usr/lib/sddm/sddm.conf.d/10-creative.conf
RUN (systemctl disable plasmalogin.service 2>/dev/null || true) \
 && systemctl enable --force sddm.service

# ---------------------------------------------------------------------------
# 8d) Start- und Ausschaltbildschirm mit Creative-Logo statt Fedora
#     (Plymouth-Thema; die Startdatei initramfs wird dafür neu erzeugt)
# ---------------------------------------------------------------------------
COPY image/plymouth /tmp/creative-plymouth
RUN dnf install -y --skip-unavailable plymouth-plugin-two-step plymouth-theme-spinner && dnf clean all \
 && mkdir -p /usr/share/plymouth/themes/creative \
 && cp /usr/share/plymouth/themes/spinner/*.png /usr/share/plymouth/themes/creative/ \
 && cp /tmp/creative-plymouth/creative.plymouth /tmp/creative-plymouth/watermark.png /usr/share/plymouth/themes/creative/ \
 && rm -f /usr/share/plymouth/themes/creative/background-tile.png \
 && rm -rf /tmp/creative-plymouth \
 && plymouth-set-default-theme creative \
 && KVER="$(ls /usr/lib/modules | sort -V | tail -n1)" \
 && dracut --no-hostonly --kver "$KVER" --reproducible --zstd --add ostree -f "/usr/lib/modules/$KVER/initramfs.img" \
 && chmod 0600 "/usr/lib/modules/$KVER/initramfs.img" \
 && mkdir -p /usr/lib/bootc/kargs.d \
 && printf 'kargs = ["rhgb", "quiet", "splash", "loglevel=3", "rd.udev.log_level=3", "rd.systemd.show_status=false", "systemd.show_status=false", "vt.global_cursor_default=0", "vt.default_red=0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12", "vt.default_grn=0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15", "vt.default_blu=0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b"]\n' > /usr/lib/bootc/kargs.d/10-creative-splash.toml

# ---------------------------------------------------------------------------
# 9) Systemeinstellungen
# ---------------------------------------------------------------------------
# Name des Systems (ID bleibt "fedora", damit Updates und Paketquellen passen)
# Überall „Creative OS“ statt Fedora (ID bleibt "fedora", damit Updates und
# Paketquellen weiter passen – Fedora ist nur noch der Unterbau)
COPY image/plymouth/watermark.png /usr/share/pixmaps/creative-os-logo.png
RUN v="$(date +%Y.%m.%d)" \
 && sed -i -e 's/^NAME=.*/NAME="Creative OS"/' \
           -e 's/^PRETTY_NAME=.*/PRETTY_NAME="Creative OS"/' \
           -e "s/^VERSION=.*/VERSION=\"${v}\"/" \
           -e 's/^VARIANT=.*/VARIANT="Creative OS"/' \
           -e 's/^LOGO=.*/LOGO=creative-os-logo/' \
           -e 's|^HOME_URL=.*|HOME_URL="https://github.com/markuspinkall-ux/creative-os"|' \
           -e 's|^SUPPORT_URL=.*|SUPPORT_URL="https://github.com/markuspinkall-ux/creative-os"|' \
           -e 's|^BUG_REPORT_URL=.*|BUG_REPORT_URL="https://github.com/markuspinkall-ux/creative-os/issues"|' \
           -e '/^DOCUMENTATION_URL=/d' -e '/^REDHAT_/d' -e '/^SUPPORT_END=/d' \
           /usr/lib/os-release \
 && (grep -q '^DEFAULT_HOSTNAME=' /usr/lib/os-release \
       && sed -i 's/^DEFAULT_HOSTNAME=.*/DEFAULT_HOSTNAME="creative-os"/' /usr/lib/os-release \
       || echo 'DEFAULT_HOSTNAME="creative-os"' >> /usr/lib/os-release)

# Updates wie bei Windows: im Hintergrund laden, beim nächsten Neustart aktiv
# Ruhiger Start auch auf bereits installierten PCs (Startparameter nachtragen)
COPY image/quiet-boot/creative-quiet-boot /usr/libexec/creative-quiet-boot
COPY image/quiet-boot/creative-quiet-boot.service /usr/lib/systemd/system/creative-quiet-boot.service
RUN chmod 755 /usr/libexec/creative-quiet-boot && systemctl enable creative-quiet-boot.service
COPY image/polkit/50-creative-updates.rules /usr/share/polkit-1/rules.d/50-creative-updates.rules
COPY image/polkit/50-creative-drives.rules /usr/share/polkit-1/rules.d/50-creative-drives.rules
RUN sed -i 's/^#\?AutomaticUpdatePolicy=.*/AutomaticUpdatePolicy=stage/' /etc/rpm-ostreed.conf \
 && systemctl enable rpm-ostreed-automatic.timer

# Abschlussprüfung des Abbilds
# Oberflächen prüfen – bei einem Fehler wird das Abbild nicht veröffentlicht
COPY image/qml-check.py /tmp/qml-check.py
RUN python3 /tmp/qml-check.py \
        /usr/lib/creative-calculator/creative_calculator/qml/Main.qml \
        /usr/lib/creative-media/creative_media/qml/Main.qml \
        /usr/lib/creative-media/creative_media/qml/YtMusicView.qml \
        /usr/lib/creative-media/creative_media/qml/PlayerBar.qml \
        /usr/lib/creative-taskmanager/creative_taskmanager/qml/Main.qml \
        /usr/lib/creative-taskmanager/creative_taskmanager/qml/ProcessesPage.qml \
        /usr/lib/creative-taskmanager/creative_taskmanager/qml/PerformancePage.qml \
        /usr/lib/creative-taskmanager/creative_taskmanager/qml/StartupPage.qml \
        /usr/lib/creative-taskmanager/creative_taskmanager/qml/DetailsPage.qml \
        /usr/lib/creative-shell/creative_shell/qml/Creative/PerfTile.qml \
        /usr/lib/creative-shell/creative_shell/qml/surfaces/Wallpaper.qml \
        /usr/lib/creative-pictures/creative_pictures/qml/Main.qml \
        /usr/lib/creative-pictures/creative_pictures/qml/Viewer.qml \
        /usr/lib/creative-shots/creative_shots/qml/Main.qml \
        /usr/lib/creative-shots/creative_shots/qml/SnipOverlay.qml \
 && rm -f /tmp/qml-check.py
# Taskmanager kurz ohne Bildschirm durchtesten (Warnungen landen im Bau-Protokoll)
RUN QT_QPA_PLATFORM=offscreen XDG_RUNTIME_DIR=/tmp timeout 60 /usr/bin/creative-taskmanager --selftest \
    || echo "TASKMANAGER-SELBSTTEST FEHLGESCHLAGEN"
# Creative Shots und Creative Pictures kurz ohne Bildschirm durchtesten
RUN QT_QPA_PLATFORM=offscreen XDG_RUNTIME_DIR=/tmp HOME=/tmp/shots-home timeout 60 /usr/bin/creative-shots --selftest \
    || echo "SHOTS-SELBSTTEST FEHLGESCHLAGEN"; \
    QT_QPA_PLATFORM=offscreen XDG_RUNTIME_DIR=/tmp HOME=/tmp/shots-home timeout 60 /usr/bin/creative-pictures --selftest \
    || echo "PICTURES-SELBSTTEST FEHLGESCHLAGEN"; rm -rf /tmp/shots-home
# Creative Notes kurz ohne Bildschirm durchtesten
RUN QT_QPA_PLATFORM=offscreen HOME=/tmp/notes-home python3 -c "import sys; sys.path.insert(0, '/usr/lib/creative-notes'); sys.argv=['creative-notes','--selftest']; from creative_notes.__main__ import main; sys.exit(main())" \
    || echo "NOTES-SELBSTTEST FEHLGESCHLAGEN"; rm -rf /tmp/notes-home

RUN bootc container lint
