# 9) Systemeinstellungen
# ---------------------------------------------------------------------------
# Name des Systems (ID bleibt "fedora", damit Updates und Paketquellen passen)
# Überall „Creative OS“ statt Fedora (ID bleibt "fedora", damit Updates und
# Paketquellen weiter passen – Fedora ist nur noch der Unterbau)
COPY image/plymouth/watermark.png /usr/share/pixmaps/creative-os-logo.png
COPY LICENSE /usr/share/licenses/creative-os/LICENSE
RUN v="$(date +%Y.%m.%d)" \
 && sed -i -e 's/^NAME=.*/NAME="Creative OS"/' \
           -e 's/^PRETTY_NAME=.*/PRETTY_NAME="Creative OS"/' \
           -e "s/^VERSION=.*/VERSION=\"${v}\"/" \
           -e 's/^VARIANT=.*/VARIANT="Creative OS"/' \
           -e 's/^LOGO=.*/LOGO=creative-os-logo/' \
           -e 's|^HOME_URL=.*|HOME_URL="https://github.com/markuspinkall-ux/creative-os"|' \
           -e 's|^SUPPORT_URL=.*|SUPPORT_URL="https://github.com/markuspinkall-ux/creative-os"|' \
           -e 's|^BUG_REPORT_URL=.*|BUG_REPORT_URL="https://github.com/markuspinkall-ux/creative-os/issues"|' \
           -e '/^DOCUMENTATION_URL=/d' -e '/^REDHAT_/d' -e '/^SUPPORT_END=/d' \
           /usr/lib/os-release \
 && (grep -q '^DEFAULT_HOSTNAME=' /usr/lib/os-release \
       && sed -i 's/^DEFAULT_HOSTNAME=.*/DEFAULT_HOSTNAME="creative-os"/' /usr/lib/os-release \
       || echo 'DEFAULT_HOSTNAME="creative-os"' >> /usr/lib/os-release)
# Fedora-Logos überall durch das Creative-Logo ersetzen (Fedora bleibt nur der Unterbau)
