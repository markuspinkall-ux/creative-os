#!/bin/sh
# Live-Umgebung vorbereiten: Markierung für die Sitzung, automatische Anmeldung in Creative
touch /run/creative-live
# Test in der virtuellen Maschine: ein Datenträger mit dem Namen CRTEST startet den automatischen Durchlauf
if [ -e /dev/disk/by-label/CRTEST ]; then
    touch /run/creative-live-autotest
    # Protokoll auf die serielle Konsole (der Test liest sie mit)
    mkdir -p /run/systemd/journald.conf.d
    printf '[Journal]\nForwardToConsole=yes\nTTYPath=/dev/ttyS0\nMaxLevelConsole=info\n' > /run/systemd/journald.conf.d/creative-test.conf
    systemctl restart systemd-journald || true
fi
cat > /etc/sddm.conf <<CONF
[Autologin]
User=liveuser
Session=creative.desktop
Relogin=false
CONF
exit 0
