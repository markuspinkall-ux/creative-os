#!/bin/bash
# Creative OS: Update laden – mit Ausweg, wenn IPv6 nicht funktioniert.
#
#   sudo creative-update          Update herunterladen (danach neu starten)
#   sudo creative-update --check  nur nachsehen, ob es ein Update gibt (Ausgang 77 = keins)
#   creative-update --auto        für die automatischen Updates (Dienst)
#   creative-update --channel     zeigt den Update-Kanal (stabil | test)
#   sudo creative-update --channel test|stabil   Kanal wechseln (lädt die Version des Kanals)
#   creative-update --verfolgen   laufendes Update im Terminal mitlesen (auch ohne Passwort)
#
# Während ein Update lädt, steht seine Ausgabe in /run/creative-update/log und
# /run/creative-update/state („PID Art Startzeit“). So zeigt die Systemsteuerung den
# Fortschritt auch dann, wenn sie zwischendurch geschlossen und wieder geöffnet wurde.
#
# Klappt der Download nicht, weil die Verbindung über IPv6 abgelehnt wird
# (kommt in manchen Heimnetzen und VMs vor), wird IPv6 für diesen einen
# Versuch kurz ausgeschaltet und danach wieder eingeschaltet.
set -u
RUN_DIR=/run/creative-update

# Mitlesen: braucht keine Rechte, die Dateien sind für alle lesbar
if [ "${1:-}" = "--verfolgen" ] || [ "${1:-}" = "--follow" ]; then
    if [ -r "$RUN_DIR/state" ]; then
        read -r pid art start < "$RUN_DIR/state"
        if kill -0 "$pid" 2>/dev/null || [ -d "/proc/$pid" ]; then
            echo "Update läuft ($art, seit $(date -d "@$start" +%H:%M) Uhr) – Strg+C beendet nur das Mitlesen."
            echo
            exec tail -n +1 -f --pid="$pid" "$RUN_DIR/log"
        fi
    fi
    if [ -r "$RUN_DIR/log" ]; then
        echo "Gerade läuft kein Update. Das letzte endete so:"
        echo
        tail -n 15 "$RUN_DIR/log"
        [ -r "$RUN_DIR/result" ] && echo && echo "Ergebnis: $(cat "$RUN_DIR/result")"
    else
        echo "Seit dem letzten Neustart lief kein Update. Den Stand zeigt:  rpm-ostree status"
    fi
    exit 0
fi

# Solange ein Update lädt, geht der PC nicht von selbst in den Standby
# (selbst in den Standby schicken geht weiterhin).
if [ -z "${CREATIVE_WACH:-}" ] && [ "${1:-}" != "--check" ] && ! { [ "${1:-}" = "--channel" ] && [ -z "${2:-}" ]; } \
   && command -v systemd-inhibit >/dev/null 2>&1 && systemd-inhibit --list >/dev/null 2>&1; then
    export CREATIVE_WACH=1
    exec systemd-inhibit --what=idle --mode=block --who="Creative OS" --why="Update wird geladen" "$0" "$@"
fi

# Aktuelle Quelle, z. B. ostree-unverified-registry:ghcr.io/…/creative-os:amd-testing
current_ref() {
    rpm-ostree status --json 2>/dev/null | python3 -c "
import json, sys
d = json.load(sys.stdin)
b = next((x for x in d.get('deployments', []) if x.get('booted')), {})
print(b.get('container-image-reference', ''))"
}

if [ "${1:-}" = "--channel" ] && [ -z "${2:-}" ]; then
    case "$(current_ref)" in
        *-testing) echo test ;;
        "") echo unbekannt ;;
        *) echo stabil ;;
    esac
    exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
    exec pkexec "$0" "$@"
fi

if [ "${1:-}" = "--channel" ]; then
    ref="$(current_ref)"
    [ -n "$ref" ] || { echo "Update-Quelle unbekannt" >&2; exit 1; }
    base="${ref%:*}"; tag="${ref##*:}"; variant="${tag%%-*}"
    case "$2" in
        test)   new="$base:$variant-testing" ;;
        stabil) new="$base:$variant" ;;
        *) echo "Kanal: test oder stabil" >&2; exit 2 ;;
    esac
    if [ "$new" = "$ref" ]; then
        # Zurück zum laufenden Kanal: vorbereiteten Wechsel einfach verwerfen
        rpm-ostree cleanup -p >/dev/null 2>&1
        echo "Bleibt auf diesem Kanal."
        exit 0
    fi
    echo "Wechsle zu $new …"
    rpm-ostree rebase "$new"
    rc=$?
    [ "$rc" -eq 0 ] && echo && echo "Fertig. Mit einem Neustart wird der Kanal aktiv:  systemctl reboot"
    exit "$rc"
fi

# Nachsehen, ob es ein Update gibt: bootc vergleicht zuverlässig mit der Registry
# (rpm-ostree --check ist bei Container-Abbildern unzuverlässig).
if [ "${1:-}" = "--check" ] && command -v bootc >/dev/null 2>&1; then
    out=$(bootc upgrade --check 2>&1); rc=$?
    echo "$out"
    if [ "$rc" -eq 0 ]; then
        if echo "$out" | grep -qiE "no changes|no update"; then exit 77; fi
        if echo "$out" | grep -qiE "update available|available for"; then exit 0; fi
    fi
    echo "(bootc ohne eindeutiges Ergebnis – frage rpm-ostree)" >&2
fi

case "${1:-}" in
    --check) args=(upgrade --check) ;;
    --auto)  args=(upgrade --quiet --trigger-automatic-update-policy) ;;
    *)       args=(upgrade) ;;
esac

log=$(mktemp)
# Nur ein Update gleichzeitig – und Fortschritt für alle lesbar ablegen
mkdir -p "$RUN_DIR" && chmod 755 "$RUN_DIR"
if [ "${1:-}" != "--check" ]; then
    if [ -r "$RUN_DIR/state" ]; then
        read -r opid _ _ < "$RUN_DIR/state"
        if [ "$opid" != "$$" ] && [ -d "/proc/$opid" ]; then
            echo "Es lädt bereits ein Update – mitlesen mit:  creative-update --verfolgen"
            exit 75
        fi
    fi
    live="$RUN_DIR/log"
    : > "$live"; chmod 644 "$live"; rm -f "$RUN_DIR/result"
    echo "$$ ${1:-update} $(date +%s)" > "$RUN_DIR/state"; chmod 644 "$RUN_DIR/state"
    trap 'rm -f "$log" "$RUN_DIR/state"' EXIT
else
    live="$log"
    trap 'rm -f "$log"' EXIT
fi
# Wird das Fenster geschlossen, das zuschaut, läuft das Update trotzdem weiter
trap '' PIPE HUP

attempt() {
    local start
    start=$(stat -c %s "$live" 2>/dev/null || echo 0)
    rpm-ostree "${args[@]}" >>"$live" 2>&1 &
    local job=$!
    # Ausgabe live weiterreichen (an die Systemsteuerung oder das Terminal)
    tail -c +"$((start + 1))" -f --pid="$job" "$live" 2>/dev/null &
    local viewer=$!
    wait "$job"
    local rc=$?
    wait "$viewer" 2>/dev/null
    [ "$live" = "$log" ] || tail -c +"$((start + 1))" "$live" > "$log"
    return "$rc"
}

attempt
rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 77 ] && \
   grep -qiE 'dial tcp \[|connection refused|network is unreachable|no route to host|i/o timeout|connection reset' "$log"; then
    v6=$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || echo 1)
    if [ "$v6" = "0" ]; then
        echo "Verbindung über IPv6 klappt nicht – neuer Versuch über IPv4 …" >&2
        sysctl -qw net.ipv6.conf.all.disable_ipv6=1
        attempt
        rc=$?
        sysctl -qw net.ipv6.conf.all.disable_ipv6=0
    fi
fi
if [ "$rc" -eq 0 ] && [ "${1:-}" != "--check" ] && [ "${1:-}" != "--auto" ]; then
    { echo; echo "Fertig. Mit einem Neustart wird das Update aktiv:  systemctl reboot"; } | tee -a "$live"
fi
[ "${1:-}" != "--check" ] && echo "$rc" > "$RUN_DIR/result" && chmod 644 "$RUN_DIR/result"
exit "$rc"
