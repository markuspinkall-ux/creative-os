#!/bin/sh
# Sorgt dafür, dass beim Starten und Herunterfahren nur das Creative-Logo zu
# sehen ist – keine Textmeldungen. Wirkt ab dem nächsten Neustart.
# Zusätzlich malt die Textkonsole alle Farben im Graphit-Hintergrund (#12151b):
# Meldungen, die trotzdem durchrutschen, sind damit unsichtbar.
set -eu
args="rhgb quiet splash loglevel=3 rd.udev.log_level=3 rd.systemd.show_status=false systemd.show_status=false vt.global_cursor_default=0 vt.default_red=0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12,0x12 vt.default_grn=0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15,0x15 vt.default_blu=0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b,0x1b"
missing=""
for a in $args; do
    grep -qw -- "$a" /proc/cmdline || missing="$missing --append-if-missing=$a"
done
staged="$(rpm-ostree status --json 2>/dev/null | python3 -c 'import json,sys; print(any(d.get("staged") for d in json.load(sys.stdin).get("deployments",[])))' 2>/dev/null || echo False)"
# Liegt schon ein Update bereit, warten wir bis nach dessen Neustart
if [ -n "$missing" ] && [ "$staged" = "False" ] && command -v rpm-ostree >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    rpm-ostree kargs $missing
fi
# Gerätename „fedora“/„localhost“ aus älteren Installationen → „creative-os“
case "$(hostnamectl hostname 2>/dev/null || hostname)" in
    fedora|localhost|localhost.localdomain|localhost-live) hostnamectl set-hostname creative-os || true ;;
esac
# Startmenü von GRUB nur bei Problemen zeigen (wie bei Windows)
command -v grub2-editenv >/dev/null 2>&1 && grub2-editenv - set menu_auto_hide=1 || true
# GRUB-Meldung „Booting `Creative OS …`“ unsichtbar: Schrift schwarz auf schwarz.
# Fedora/bootupd lädt user.cfg (bzw. console.cfg) aus dem GRUB-Ordner automatisch.
marker="# creative-os: GRUB-Textmeldungen unsichtbar"
for dir in /boot/grub2 /boot/efi/EFI/fedora; do
    [ -f "$dir/grub.cfg" ] || continue
    if grep -q "user.cfg" "$dir/grub.cfg"; then
        target="$dir/user.cfg"
    elif grep -q "console.cfg" "$dir/grub.cfg"; then
        target="$dir/console.cfg"
    else
        continue
    fi
    if ! grep -qF "$marker" "$target" 2>/dev/null; then
        # /boot ist bei Creative OS meist schreibgeschützt eingehängt – kurz freigeben
        ro=""
        if ! touch "$dir/.creative-test" 2>/dev/null; then
            mount -o remount,rw /boot 2>/dev/null && ro=1
        fi
        rm -f "$dir/.creative-test"
        {
            echo "$marker"
            echo "set color_normal=black/black"
            echo "set menu_color_normal=light-gray/black"
            echo "set menu_color_highlight=white/dark-gray"
        } >> "$target" || true
        [ -n "$ro" ] && mount -o remount,ro /boot 2>/dev/null || true
    fi
done
