@dataclass
class Job:
    url: str
    title: str
    uploader: str
    duration: int
    thumb: str
    widget: "JobRow" = None
    state: str = "wartet"          # wartet | läuft | fertig | fehler


class JobRow(QFrame):
    def __init__(self, job, remove):
        super().__init__(objectName="row")
        self.job = job
        layout = QHBoxLayout(self)
        layout.setContentsMargins(10, 10, 12, 10)
        layout.setSpacing(12)
        self.cover = QLabel()
        self.cover.setFixedSize(128, 72)
        self.cover.setStyleSheet("background:#12151b; border-radius:8px;")
        self.cover.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(self.cover)
        text = QVBoxLayout()
        text.setSpacing(4)
        title = QLabel(job.title)
        title.setStyleSheet("font-weight:700; font-size:14px;")
        title.setWordWrap(True)
        meta = QLabel(" · ".join(x for x in (job.uploader, duration_text(job.duration)) if x), objectName="muted")
        self.status = QLabel("Wartet", objectName="muted")
        self.bar = QProgressBar()
        self.bar.setRange(0, 100)
        self.bar.setTextVisible(False)
        self.bar.hide()
        for w in (title, meta, self.status, self.bar):
            text.addWidget(w)
        layout.addLayout(text, 1)
        self.remove = QPushButton("✕")
        self.remove.setFixedWidth(40)
        self.remove.setToolTip("Aus der Liste nehmen")
        self.remove.clicked.connect(lambda: remove(job))
        layout.addWidget(self.remove, 0, Qt.AlignmentFlag.AlignTop)

    def set_cover(self, data):
        pix = QPixmap()
        if data and pix.loadFromData(data):
            self.cover.setPixmap(pix.scaled(QSize(128, 72), Qt.AspectRatioMode.KeepAspectRatioByExpanding,
                                            Qt.TransformationMode.SmoothTransformation).copy(0, 0, 128, 72))

    def set_state(self, state, text, percent=None):
        self.job.state = state
        color = {"fertig": "#6fdcc0", "fehler": "#ffb07a", "läuft": "#8fb3ff"}.get(state, "rgba(220,230,255,0.6)")
        self.status.setStyleSheet(f"color:{color};")
        self.status.setText(text)
        self.bar.setVisible(state == "läuft")
        if percent is not None:
            self.bar.setValue(int(percent))
        self.remove.setEnabled(state != "läuft")


class Converter(QMainWindow):
