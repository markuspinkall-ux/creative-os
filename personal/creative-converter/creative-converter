# ---- reine Hilfsfunktionen (ohne Oberfläche, testbar) -------------------------------------

CHECK_SVG = ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18"><path d="M4.5 9.5l3 3 6-7" '
             'fill="none" stroke="#12151b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>')
ARROW_SVG = ('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" '
             'fill="none" stroke="#dce6ff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>')


def style_sheet():
    """STYLE mit Pfaden zu Häkchen und Pfeil (als kleine SVG-Dateien im Cache)."""
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "creative-converter"
    paths = {}
    for name, svg in (("check", CHECK_SVG), ("arrow", ARROW_SVG)):
        path = cache / f"{name}.svg"
        try:
            cache.mkdir(parents=True, exist_ok=True)
            if not path.is_file() or path.read_text() != svg:
                path.write_text(svg)
        except OSError:
            pass
        paths[name] = path.as_posix()
    return STYLE.replace("@CHECK@", paths["check"]).replace("@ARROW@", paths["arrow"])


def ytdlp():
    if YTDLP_LOCAL.is_file() and os.access(YTDLP_LOCAL, os.X_OK):
        return str(YTDLP_LOCAL)
    return shutil.which("yt-dlp") or ""


def music_dir():
    try:
        out = subprocess.run(["xdg-user-dir", "MUSIC"], capture_output=True, text=True, timeout=3).stdout.strip()
        if out and out != str(Path.home()):
            return Path(out)
    except (OSError, subprocess.SubprocessError):
        pass
    for name in ("Musik", "Music"):
        if (Path.home() / name).is_dir():
            return Path.home() / name
    return Path.home() / "Musik"


def is_youtube(url):
    return bool(URL_RE.match(url.strip()))


def duration_text(seconds):
    if not seconds:
        return ""
    seconds = int(seconds)
    h, rest = divmod(seconds, 3600)
    m, s = divmod(rest, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def info_args(url, playlist):
    return ["-J", "--flat-playlist" if playlist else "--no-playlist", "--no-warnings", url]


def parse_info(data, url):
    """yt-dlp -J → Liste von Einträgen {url, title, uploader, duration, thumb}."""
    def entry(d, fallback_url):
        thumbs = d.get("thumbnails") or []
        thumb = d.get("thumbnail") or (thumbs[-1].get("url") if thumbs else "")
        link = d.get("webpage_url") or d.get("url") or fallback_url
        if link and not link.startswith("http") and d.get("id"):
            link = f"https://www.youtube.com/watch?v={d['id']}"
        return {"url": link, "title": d.get("title") or "Ohne Titel",
                "uploader": d.get("uploader") or d.get("channel") or "",
                "duration": d.get("duration") or 0, "thumb": thumb}
    if data.get("_type") == "playlist":
        return [entry(e, "") for e in data.get("entries") or [] if e]
    return [entry(data, url)]


def convert_args(url, folder, quality, cover):
    args = ["--no-playlist", "-f", "bestaudio/best", "-x", "--audio-format", "mp3",
            "--audio-quality", f"{quality}K", "--embed-metadata",
            "-P", str(folder), "-o", "%(title)s.%(ext)s", "--windows-filenames",
            "--newline", "--no-warnings", "--progress-template", "download:cc-progress %(progress._percent_str)s"]
    if cover:
        args += ["--embed-thumbnail", "--convert-thumbnails", "jpg"]
    return args + [url]


def parse_progress(line):
    """Fortschritt (0–100) aus einer yt-dlp-Zeile, sonst None."""
    m = PROGRESS_RE.match(line.strip())
    return float(m.group(1)) if m else None


