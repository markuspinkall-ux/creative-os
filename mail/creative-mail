class FolderDelegate(QStyledItemDelegate):
    def sizeHint(self, option, index):
        return QSize(200, 26 if index.data(Qt.ItemDataRole.UserRole + 3) else 38)

    def paint(self, painter, option, index):
        painter.save()
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        rect = option.rect
        if index.data(Qt.ItemDataRole.UserRole + 3):          # Abschnittsüberschrift
            font = QFont("Arial")
            font.setPixelSize(11)
            font.setBold(True)
            painter.setFont(font)
            painter.setPen(QColor(C["dim"]))
            painter.drawText(rect.adjusted(14, 6, 0, 0), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                             index.data())
            painter.restore()
            return
        selected = option.state & QStyle.StateFlag.State_Selected
        hover = option.state & QStyle.StateFlag.State_MouseOver
        if selected or hover:
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QColor(C["select"] if selected else C["raised"]))
            painter.drawRoundedRect(rect, 10, 10)
        ico = index.data(Qt.ItemDataRole.DecorationRole)
        if isinstance(ico, QIcon):
            ico.paint(painter, QRect(rect.left() + 12, rect.center().y() - 9, 18, 18))
        unread = index.data(Qt.ItemDataRole.UserRole + 1) or 0
        font = QFont("Arial")
        font.setPixelSize(13)
        font.setBold(bool(selected) or unread > 0)
        painter.setFont(font)
        painter.setPen(QColor(C["text"]))
        text_rect = rect.adjusted(40, 0, -48, 0)
        painter.drawText(text_rect, Qt.AlignmentFlag.AlignVCenter,
                         painter.fontMetrics().elidedText(index.data(), Qt.TextElideMode.ElideRight, text_rect.width()))
        if unread:
            label = str(unread) if unread < 1000 else "999+"
            font.setPixelSize(11)
            painter.setFont(font)
            w = painter.fontMetrics().horizontalAdvance(label) + 14
            pill = QRect(rect.right() - w - 10, rect.center().y() - 10, w, 20)
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QColor(C["accent"] if index.data(Qt.ItemDataRole.UserRole) == "INBOX" else C["track"]))
            painter.drawRoundedRect(pill, 10, 10)
            painter.setPen(QColor(C["accentText"] if index.data(Qt.ItemDataRole.UserRole) == "INBOX" else C["text"]))
            painter.drawText(pill, Qt.AlignmentFlag.AlignCenter, label)
        painter.restore()


class MessageDelegate(QStyledItemDelegate):
    HEIGHT = 84

    def sizeHint(self, option, index):
        return QSize(300, self.HEIGHT)

    def paint(self, painter, option, index):
        row = index.data(Qt.ItemDataRole.UserRole)
        if not isinstance(row, dict):
            return super().paint(painter, option, index)
        painter.save()
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        rect = option.rect.adjusted(8, 3, -8, -3)
        selected = option.state & QStyle.StateFlag.State_Selected
        hover = option.state & QStyle.StateFlag.State_MouseOver
        if selected or hover:
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QColor(C["select"] if selected else C["surface"]))
            painter.drawRoundedRect(rect, 12, 12)
        unread = row.get("unread")
        if unread:
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QColor(C["accent"]))
            painter.drawEllipse(rect.left() + 6, rect.top() + 18, 7, 7)
        painter.drawPixmap(rect.left() + 18, rect.top() + 10, avatar_pixmap(row.get("from", ""), 34))
        left = rect.left() + 64
        right = rect.right() - 12
        f = QFont("Arial")
        # Absender und Datum
        f.setPixelSize(13)
        f.setBold(True)
        painter.setFont(f)
        date = short_date(row.get("date"))
        date_w = painter.fontMetrics().horizontalAdvance(date) + 8
        painter.setPen(QColor(C["text"] if unread else C["muted"]))
        name = display_name(row.get("from", ""))
        painter.drawText(QRect(left, rect.top() + 8, right - left - date_w, 18), Qt.AlignmentFlag.AlignVCenter,
                         painter.fontMetrics().elidedText(name, Qt.TextElideMode.ElideRight, right - left - date_w))
        f.setBold(False)
        f.setPixelSize(12)
        painter.setFont(f)
        painter.setPen(QColor(C["accent"] if unread else C["dim"]))
        painter.drawText(QRect(right - date_w, rect.top() + 8, date_w, 18),
                         Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter, date)
        # Betreff
        f.setPixelSize(13)
        f.setBold(bool(unread))
        painter.setFont(f)
        painter.setPen(QColor(C["text"]))
        star_w = 20 if row.get("starred") else 0
        subject_rect = QRect(left, rect.top() + 28, right - left - star_w, 18)
        painter.drawText(subject_rect, Qt.AlignmentFlag.AlignVCenter,
                         painter.fontMetrics().elidedText(row.get("subject", ""), Qt.TextElideMode.ElideRight,
                                                          subject_rect.width()))
        if star_w:
            icon("star", C["star"], 16, C["star"]).paint(painter, QRect(right - 16, rect.top() + 29, 16, 16))
        # Vorschau
        f.setBold(False)
        f.setPixelSize(12)
        painter.setFont(f)
        painter.setPen(QColor(C["muted"]))
        snippet_rect = QRect(left, rect.top() + 48, right - left, 18)
        painter.drawText(snippet_rect, Qt.AlignmentFlag.AlignVCenter,
                         painter.fontMetrics().elidedText(row.get("snippet", ""), Qt.TextElideMode.ElideRight,
                                                          snippet_rect.width()))
        painter.restore()


