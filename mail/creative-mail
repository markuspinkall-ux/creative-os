    # Ordner
    def fill_folders(self, labels):
        current = self.folder
        self.folders.blockSignals(True)
        self.folders.clear()
        user_started = False
        for lid, name, unread, system in labels:
            if not system and not user_started:
                header = QListWidgetItem("LABELS")
                header.setData(Qt.ItemDataRole.UserRole + 3, True)
                header.setFlags(Qt.ItemFlag.NoItemFlags)
                self.folders.addItem(header)
                user_started = True
            item = QListWidgetItem(icon(FOLDER_ICONS.get(lid, "label") if system else "label", C["muted"], 18), name)
            item.setData(Qt.ItemDataRole.UserRole, lid)
            item.setData(Qt.ItemDataRole.UserRole + 1, unread)
            self.folders.addItem(item)
            if lid == current:
                self.folders.setCurrentItem(item)
        self.folders.blockSignals(False)

    def refresh_labels(self):
        if self.gmail:
            self.jobs.run(self.gmail.labels, self.fill_folders, lambda exc: None)

    def pick_folder(self, item, _old=None):
        if item is None or item.data(Qt.ItemDataRole.UserRole + 3):
            return
        self.folder = item.data(Qt.ItemDataRole.UserRole)
        self.pane_title.setText(item.text())
        self.query.clear()
        self.refresh()

    # Liste
    def refresh(self, append=False):
        if not self.gmail or (self.loading and append):
            return
        folder, query = self.folder, self.query.text().strip()
        page = self.page if append else None
        if not append:
            self.page = None
            self.messages.clear()
            self.show_empty("Keine E-Mail ausgewählt", "Wähle links eine Nachricht aus.")
        self.set_loading(True)
        token = object()
        self._listing = token

        def listed(result):
            if self._listing is not token:
                return
            rows, self.page = result
            self.set_loading(False)
            for row in rows:
                self.add_row(row)
            empty = not self.messages.count()
            self.list_state.setVisible(empty)
            self.list_state.setText("Keine E-Mails gefunden." if query else "Hier ist nichts – alles erledigt.")

        self.jobs.run(lambda: self.gmail.listing(folder, query, page), listed)

    def add_row(self, row, top=False):
        item = QListWidgetItem()
        item.setData(Qt.ItemDataRole.UserRole, row)
        item.setToolTip(f"{row.get('from', '')}\n{row.get('subject', '')}")
        if top:
            self.messages.insertItem(0, item)
        else:
            self.messages.addItem(item)
        return item

    def maybe_more(self, value):
        bar = self.messages.verticalScrollBar()
        if self.page and not self.loading and value >= bar.maximum() - MessageDelegate.HEIGHT * 2:
            self.refresh(append=True)

    def check_new(self):
        if not self.gmail or self.loading or self.query.text().strip() or self.jobs.busy:
            return
        folder = self.folder
        known = {self.messages.item(i).data(Qt.ItemDataRole.UserRole)["id"] for i in range(self.messages.count())}

        def listed(result):
            if folder != self.folder:
                return
            for row in reversed([r for r in result[0] if r["id"] not in known]):
                self.add_row(row, top=True)

        self.jobs.run(lambda: self.gmail.listing(folder, "", None, 20), listed, lambda exc: None)
        self.refresh_labels()

    def row_item(self, message_id):
        for i in range(self.messages.count()):
            item = self.messages.item(i)
            if item.data(Qt.ItemDataRole.UserRole)["id"] == message_id:
                return item
        return None

    def update_row(self, message_id, **changes):
        item = self.row_item(message_id)
        if item:
            row = dict(item.data(Qt.ItemDataRole.UserRole))
            row.update(changes)
            item.setData(Qt.ItemDataRole.UserRole, row)

    def list_menu(self, pos):
        item = self.messages.itemAt(pos)
        if not item:
            return
        self.messages.setCurrentItem(item)
        row = item.data(Qt.ItemDataRole.UserRole)
        menu = QMenu(self)
        menu.addAction(icon("reply", C["text"], 16), "Antworten", lambda: self.reply_to(False))
        menu.addAction(icon("forward", C["text"], 16), "Weiterleiten", self.forward)
        menu.addSeparator()
        menu.addAction(icon("unread", C["text"], 16), "Als gelesen markieren" if row.get("unread") else
                       "Als ungelesen markieren", self.mark_unread)
        menu.addAction(icon("star", C["text"], 16), "Markierung entfernen" if row.get("starred") else "Markieren",
                       self.toggle_star)
        menu.addAction(icon("archive", C["text"], 16), "Archivieren", self.archive)
        menu.addAction(icon("trash", C["text"], 16), "Löschen", self.delete)
        menu.exec(self.messages.viewport().mapToGlobal(pos))

    # Lesen
    def open_message(self, item, _old=None):
        if item is None:
            return
        row = item.data(Qt.ItemDataRole.UserRole)
        self.allow_remote = False
        token = object()
        self._reading = token
        self.statusBar().showMessage("E-Mail wird geladen …")

        def received(mail):
            if self._reading is not token:
                return
            self.statusBar().clearMessage()
            self.current = mail
            if row.get("unread"):
                self.update_row(row["id"], unread=False)
                self.refresh_labels()
            self.show_mail(mail)

        self.jobs.run(lambda: self.gmail.message(row["id"], row.get("unread")), received)

    def body_view(self):
        if self.web is None and not os.environ.get("CREATIVE_MAIL_NO_WEBENGINE"):
            self.web = make_web_view() or False
            if self.web:
                self.body_holder.replaceWidget(self.browser, self.web)
                self.browser.hide()
        return self.web or self.browser

    def show_mail(self, mail):
        self.reader_stack.setCurrentIndex(1)
        self.subject_label.setText(mail["subject"])
        self.sender_avatar.setPixmap(avatar_pixmap(mail["from"], 42))
        name, address = parseaddr(mail["from"])
        self.sender_label.setText(f"{html.escape(display_name(mail['from']))}  <span style='color:{C['muted']};font-weight:normal'>"
                                  f"{html.escape(address) if name else ''}</span>")
        to = ", ".join(display_name(a) for a in mail["to"].split(",") if a.strip())
        cc = ", ".join(display_name(a) for a in mail["cc"].split(",") if a.strip())
        self.recipients_label.setText(f"An: {to}" + (f"   ·   Cc: {cc}" if cc else ""))
        self.date_label.setText(self.long_date(mail))
        starred = "STARRED" in mail.get("labels", [])
        self.tool_buttons["star"].setIcon(icon("star", C["star"] if starred else C["text"], 19,
                                               C["star"] if starred else "none"))
        remote = bool(mail.get("html")) and bool(REMOTE_IMG.search(mail["html"]))
        self.banner.setVisible(remote and not self.allow_remote)
        self.fill_attachments(mail.get("attachments", []))
        self.body_view().show_mail(mail, self.allow_remote)

    def long_date(self, mail):
        row = self.messages.currentItem().data(Qt.ItemDataRole.UserRole) if self.messages.currentItem() else {}
        stamp = row.get("date") if row else 0
        if not stamp:
            return mail.get("date", "")
        t = time.localtime(stamp)
        return f"{t.tm_mday}. {MONTHS[t.tm_mon - 1]} {t.tm_year}, {time.strftime('%H:%M', t)}"

    def load_images(self):
        if self.current:
            self.allow_remote = True
            self.banner.setVisible(False)
            if self.web:
                self.web.show_mail(self.current, True)
            else:
                self.statusBar().showMessage("Bilder aus dem Netz zeigt nur die volle Ansicht (Qt WebEngine).", 6000)

    def fill_attachments(self, attachments):
        while self.attach_row.count():
            widget = self.attach_row.takeAt(0).widget()
            if widget:
                widget.deleteLater()
        for item in attachments:
            chip = QPushButton(icon("attach", C["muted"], 14), f" {item['name']}  ·  {human_size(item['size'])}",
                               objectName="chip")
            chip.setToolTip("Klicken zum Speichern")
            chip.clicked.connect(lambda _=False, it=item: self.save_attachment(it))
            self.attach_row.addWidget(chip)
        self.attach_row.addStretch(1)
        self.attach_box.setVisible(bool(attachments))

    def save_attachment(self, item):
        downloads = Path.home() / "Downloads"
        start = str((downloads if downloads.is_dir() else Path.home()) / item["name"])
        path, _ = QFileDialog.getSaveFileName(self, "Anhang speichern", start, "Alle Dateien (*)")
        if path:
            try:
                Path(path).write_bytes(item["data"])
            except OSError as exc:
                QMessageBox.warning(self, "Anhang speichern", str(exc))
            else:
                self.statusBar().showMessage(f"„{Path(path).name}“ gespeichert.", 5000)

    # Aktionen
    def selected_row(self):
        item = self.messages.currentItem()
        return item.data(Qt.ItemDataRole.UserRole) if item else None

    def change(self, task, done):
        row = self.selected_row()
        if not row or not self.gmail:
            return
        self.jobs.run(lambda: task(row["id"]), lambda _r: done(row))

    def drop_row(self, row, message):
        item = self.row_item(row["id"])
        if item:
            index = self.messages.row(item)
            self.messages.takeItem(index)
            if self.messages.count():
                self.messages.setCurrentRow(min(index, self.messages.count() - 1))
            else:
                self.show_empty("Keine E-Mail ausgewählt", "Wähle links eine Nachricht aus.")
        self.statusBar().showMessage(message, 4000)
        self.refresh_labels()

    def archive(self):
        self.change(lambda mid: self.gmail.modify(mid, remove=["INBOX"]),
                    lambda row: self.drop_row(row, "Archiviert.") if self.folder == "INBOX"
                    else self.statusBar().showMessage("Archiviert.", 4000))

    def delete(self):
        if self.folder == "TRASH":
            return
        self.change(self.gmail.trash if self.gmail else None, lambda row: self.drop_row(row, "In den Papierkorb verschoben."))

    def mark_unread(self):
        row = self.selected_row()
        if not row:
            return
        unread = not row.get("unread")
        self.change(lambda mid: self.gmail.modify(mid, add=["UNREAD"]) if unread else
                    self.gmail.modify(mid, remove=["UNREAD"]),
                    lambda r: (self.update_row(r["id"], unread=unread), self.refresh_labels()))

    def toggle_star(self):
        row = self.selected_row()
        if not row:
            return
        starred = not row.get("starred")

        def done(r):
            self.update_row(r["id"], starred=starred)
            if self.current and self.current.get("id") == r["id"]:
                labels = set(self.current.get("labels", []))
                (labels.add if starred else labels.discard)("STARRED")
                self.current["labels"] = list(labels)
                self.tool_buttons["star"].setIcon(icon("star", C["star"] if starred else C["text"], 19,
                                                       C["star"] if starred else "none"))

        self.change(lambda mid: self.gmail.modify(mid, add=["STARRED"]) if starred else
                    self.gmail.modify(mid, remove=["STARRED"]), done)

    def quote(self, mail, heading):
        body = mail.get("html") or plain_to_html(mail.get("text", ""))
        body = re.sub(r"(?is)<(script|style|head)[^>]*>.*?</\1>", "", body)
        return (f'<br><div style="color:#6f7a92">{html.escape(heading)}</div>'
                f'<blockquote style="margin:0 0 0 8px;border-left:3px solid #8fb3ff;padding-left:10px">{body}'
                '</blockquote>')

    def reply_to(self, everyone):
        mail = self.current
        if not mail or not self.gmail:
            return
        own = (self.gmail.address or "").lower()
        to = mail.get("reply_to") or mail["from"]
        cc = ""
        if everyone:
            others = [f"{n} <{a}>" if n else a for n, a in getaddresses([mail["to"], mail["cc"]])
                      if a and a.lower() != own and a.lower() not in to.lower()]
            cc = ", ".join(others)
        subject = mail["subject"]
        if not subject.lower().startswith(("re:", "aw:")):
            subject = "Re: " + subject
        heading = f"Am {self.date_label.text()} schrieb {display_name(mail['from'])}:"
        self.open_composer(to=to, cc=cc, subject=subject, quoted=self.quote(mail, heading),
                           reply={"message_id": mail.get("message_id"), "references": mail.get("references"),
                                  "threadId": mail.get("threadId")},
                           title="Allen antworten" if everyone else "Antworten")

    def forward(self):
        mail = self.current
        if not mail:
            return
        subject = mail["subject"]
        if not subject.lower().startswith(("fwd:", "wg:")):
            subject = "Fwd: " + subject
        heading = (f"---------- Weitergeleitete Nachricht ----------\nVon: {mail['from']}\n"
                   f"Datum: {self.date_label.text()}\nBetreff: {mail['subject']}\nAn: {mail['to']}")
        quoted = '<br><div style="color:#6f7a92;white-space:pre-wrap">' + html.escape(heading) + "</div><br>" + \
                 re.sub(r"(?is)<(script|style|head)[^>]*>.*?</\1>", "",
                        mail.get("html") or plain_to_html(mail.get("text", "")))
        attachments = [{"name": a["name"], "data": a["data"]} for a in mail.get("attachments", [])]
        self.open_composer(subject=subject, quoted=quoted, attachments=attachments, title="Weiterleiten")

    def open_composer(self, **kwargs):
        if not self.gmail:
            return
        window = ComposeWindow(self, **kwargs)
        self.composers.append(window)
        window.finished.connect(lambda _r, w=window: self.composers.remove(w) if w in self.composers else None)
        window.show()

    # Konto
    def connect_google(self):
        client = self.settings.value("client", SYSTEM_CLIENT, type=str)
        if not Path(client).is_file():
            QMessageBox.information(self, "Google-Anmeldung einrichten",
                                    "Wähle die OAuth-JSON-Datei deiner Google-Desktop-App. "
                                    "Die Gmail API muss im zugehörigen Google-Projekt aktiviert sein.")
            client, _ = QFileDialog.getOpenFileName(self, "Google-OAuth-Datei auswählen", "", "JSON (*.json)")
            if not client:
                return
        try:
            gmail = Gmail(client)
        except ValueError as exc:
            self.settings.remove("client")
            QMessageBox.warning(self, "Creative Mail", str(exc))
            return

        def connected(address):
            self.set_loading(False)
            self.gmail = gmail
            self.settings.setValue("client", client)
            self.settings.setValue("address", address)
            self.folder = "INBOX"
            self.update_account()
            self.refresh_labels()
            self.refresh()
            self.poll_timer.start()

        self.set_loading(True, "Google-Anmeldung im Browser abschließen …")
        self.jobs.run(gmail.connect, connected)

    def sign_out(self):
        if not self.gmail or QMessageBox.question(
                self, "Abmelden", f"{self.gmail.address} in Creative Mail abmelden?") != QMessageBox.StandardButton.Yes:
            return
        self.settings.remove("address")
        self.gmail = None
        self.current = None
        self.poll_timer.stop()
        self.messages.clear()
        self.fill_folders([(lid, name, 0, True) for lid, name in Gmail.SYSTEM])
        self.update_account()

    def edit_signature(self):
        dialog = QDialog(self)
        dialog.setWindowTitle("Signatur")
        dialog.setStyleSheet(STYLE + f"QDialog {{ background: {C['surface']}; }}"
                             f"QPlainTextEdit {{ background: {C['ground']}; border-radius: 10px; padding: 8px; }}")
        layout = QVBoxLayout(dialog)
        layout.setContentsMargins(22, 18, 22, 18)
        layout.addWidget(QLabel("Signatur", objectName="paneTitle"))
        layout.addWidget(QLabel("Wird unter jede neue E-Mail gesetzt.", objectName="muted"))
        text = QPlainTextEdit(self.settings.value("signature", "", type=str))
        text.setMinimumSize(420, 140)
        layout.addWidget(text)
        row = QHBoxLayout()
        row.addStretch(1)
        cancel = QPushButton("Abbrechen")
        cancel.clicked.connect(dialog.reject)
        save = QPushButton("Speichern", objectName="primary")
        save.clicked.connect(dialog.accept)
        row.addWidget(cancel)
        row.addWidget(save)
        layout.addLayout(row)
        if dialog.exec() == QDialog.DialogCode.Accepted:
            self.settings.setValue("signature", text.toPlainText())

    def closeEvent(self, event):
        self.jobs.shutdown()
        super().closeEvent(event)

    def selftest(self):
        """Zeigt Beispiel-Mails, öffnet das Verfassen-Fenster (ohne Netz)."""
        sample = [{"id": str(i), "from": f"Anna Beispiel <anna{i}@example.org>", "subject": f"Test {i}",
                   "snippet": "Hallo, hier ist die Vorschau …", "date": time.time() - i * 90000,
                   "unread": i % 2 == 0, "starred": i == 1} for i in range(6)]
        for row in sample:
            self.add_row(row)
        self.fill_folders([("INBOX", "Posteingang", 3, True), ("SENT", "Gesendet", 0, True),
                           ("Label_1", "Projekte", 2, False)])
        mail = {"subject": "Test", "from": "Anna <anna@example.org>", "to": "ich@example.org", "cc": "",
                "html": '<p>Hallo <img src="https://tracker.example/x.png"></p>', "text": "", "date": "",
                "attachments": [{"name": "bild.png", "size": 1234, "data": b"x"}], "inline": {}, "labels": []}
        self.messages.setCurrentRow(0)
        self.show_mail(mail)
        assert self.banner.isVisibleTo(self.reader_stack.currentWidget())
        self.messages.viewport().grab()
        self.folders.viewport().grab()
        self.gmail = type("Fake", (), {"address": "ich@example.org"})()
        self.current = dict(mail, id="0", message_id="<a@b>", references="", threadId="t", reply_to="")
        self.reply_to(True)
        self.forward()
        for window in list(self.composers):
            window.grab()
            window.reject()
        self.gmail = None
        print("Creative Mail: Selbsttest bestanden")


def main():
    selftest = "--selftest" in sys.argv
    if selftest:
        os.environ["CREATIVE_MAIL_NO_WEBENGINE"] = "1"
    else:
        try:  # WebEngine muss vor der Anwendung geladen werden
            import PySide6.QtWebEngineWidgets  # noqa: F401
        except ImportError:
            pass
    QApplication.setAttribute(Qt.ApplicationAttribute.AA_ShareOpenGLContexts)
    app = QApplication(sys.argv)
    app.setOrganizationName("Creative OS")
    app.setApplicationName("Creative Mail")
    app.setDesktopFileName("creative-mail")
    app.setWindowIcon(QIcon.fromTheme("creative-mail"))
    app.setStyleSheet(STYLE)
    window = MailWindow(selftest)
    window.show()
    if selftest:
        app.processEvents()
        window.selftest()
        QTimer.singleShot(150, app.quit)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
