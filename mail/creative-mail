# ── Hintergrundaufgaben ────────────────────────────────────────────────────

class Jobs(QObject):
    """Führt Gmail-Aufrufe im Hintergrund aus und meldet sich im Hauptthread zurück."""

    def __init__(self, parent, on_error):
        super().__init__(parent)
        self.pool = ThreadPoolExecutor(max_workers=4)
        self.pending = []
        self.on_error = on_error
        self.timer = QTimer(self, interval=60)
        self.timer.timeout.connect(self.poll)

    def run(self, task, done=None, failed=None):
        self.pending.append((self.pool.submit(task), done, failed))
        self.timer.start()

    @property
    def busy(self):
        return bool(self.pending)

    def poll(self):
        finished = [job for job in self.pending if job[0].done()]
        self.pending = [job for job in self.pending if not job[0].done()]
        for future, done, failed in finished:     # Rückmeldungen dürfen neue Aufgaben starten
            try:
                result = future.result()
            except (OSError, RuntimeError, ValueError, KeyError, TypeError) as exc:
                (failed or self.on_error)(exc)
            else:
                if done:
                    done(result)
        if not self.pending:
            self.timer.stop()

    def shutdown(self):
        self.pool.shutdown(wait=False, cancel_futures=True)


