def icon(name, color=C["text"], size=20, fill="none"):
    svg = (f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" viewBox="0 0 24 24">'
           f'<g fill="{fill}" stroke="{color}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">'
           f'{ICONS[name]}</g></svg>')
    pixmap = QPixmap()
    pixmap.loadFromData(svg.encode(), "SVG")
    return QIcon(pixmap)


def display_name(address):
    name, mail = parseaddr(address or "")
    return (name or mail or address or "Unbekannt").strip().strip('"')


def initials(text):
    words = [w for w in re.split(r"[\s._@-]+", display_name(text)) if w and w[0].isalnum()]
    if not words:
        return "?"
    return (words[0][0] + (words[1][0] if len(words) > 1 else "")).upper()


def avatar_color(text):
    _name, mail = parseaddr(text or "")
    digest = hashlib.md5((mail or text or "").lower().encode()).digest()
    return AVATAR_COLORS[digest[0] % len(AVATAR_COLORS)]


def avatar_pixmap(text, size=36):
    pixmap = QPixmap(size, size)
    pixmap.fill(Qt.GlobalColor.transparent)
    with QPainter(pixmap) as p:
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(avatar_color(text)))
        p.drawEllipse(0, 0, size, size)
        font = QFont("Arial")
        font.setPixelSize(int(size * .38))
        font.setBold(True)
        p.setFont(font)
        p.setPen(QColor(C["accentText"]))
        p.drawText(QRect(0, 0, size, size), Qt.AlignmentFlag.AlignCenter, initials(text))
    return pixmap


def short_date(stamp):
    if not stamp:
        return ""
    t, now = time.localtime(stamp), time.localtime()
    if t[:3] == now[:3]:
        return time.strftime("%H:%M", t)
    if time.mktime(now) - stamp < 6 * 86400 and stamp < time.time():
        return ["Mo.", "Di.", "Mi.", "Do.", "Fr.", "Sa.", "So."][t.tm_wday]
    if t.tm_year == now.tm_year:
        return f"{t.tm_mday}. {MONTHS[t.tm_mon - 1]}"
    return time.strftime("%d.%m.%y", t)


def human_size(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}".replace(".", ",")
        n /= 1024


def plain_to_html(text):
    escaped = html.escape(text or "")
    escaped = re.sub(r"(https?://[^\s<]+)", r'<a href="\1">\1</a>', escaped)
    return ('<div style="font-family:Arial,sans-serif;font-size:14px;line-height:1.55;white-space:pre-wrap;'
            f'color:#1c2029">{escaped}</div>')


