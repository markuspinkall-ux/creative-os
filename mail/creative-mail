class MailBrowser(QTextBrowser):
    """Einfache, sichere Darstellung (ohne Web-Engine): lädt nur eingebettete Bilder."""

    def __init__(self):
        super().__init__()
        self.inline = {}
        self.setOpenLinks(False)
        self.anchorClicked.connect(QDesktopServices.openUrl)
        self.setStyleSheet("QTextBrowser { background: #ffffff; color: #1c2029; border: none; border-radius: 14px;"
                           " padding: 18px; }")

    def show_mail(self, mail, allow_remote=False):
        self.inline = mail.get("inline", {})
        self.setHtml(mail.get("html") or plain_to_html(mail.get("text", "")))

    def loadResource(self, kind, url):
        if url.scheme() == "cid":
            content = self.inline.get(url.path() or url.toString()[4:])
            if content:
                image = QPixmap()
                image.loadFromData(content[1])
                return image.toImage()
        return None                          # nichts aus dem Netz laden


def make_web_view():
    """Volle HTML-Darstellung mit Qt WebEngine – ohne JavaScript, Bilder aus dem Netz nur auf Wunsch."""
    if os.environ.get("CREATIVE_MAIL_NO_WEBENGINE"):
        return None
    try:
        from PySide6.QtWebEngineCore import (
            QWebEnginePage, QWebEngineProfile, QWebEngineSettings, QWebEngineUrlRequestInterceptor,
        )
        from PySide6.QtWebEngineWidgets import QWebEngineView
    except ImportError:
        return None

    class Guard(QWebEngineUrlRequestInterceptor):
        allow_remote = False

        def interceptRequest(self, info):
            scheme = info.requestUrl().scheme()
            if scheme in ("http", "https") and not self.allow_remote:
                info.block(True)

    class Page(QWebEnginePage):
        def acceptNavigationRequest(self, url, kind, main_frame):
            if kind == QWebEnginePage.NavigationType.NavigationTypeLinkClicked:
                QDesktopServices.openUrl(url)
                return False
            return url.scheme() in ("file", "data", "about")

        def createWindow(self, _kind):
            return None

    class View(QWebEngineView):
        def __init__(self):
            super().__init__()
            self.profile = QWebEngineProfile(self)      # ohne Namen: nichts wird gespeichert
            self.guard = Guard(self)
            self.profile.setUrlRequestInterceptor(self.guard)
            page = Page(self.profile, self)
            settings = page.settings()
            settings.setAttribute(QWebEngineSettings.WebAttribute.JavascriptEnabled, False)
            settings.setAttribute(QWebEngineSettings.WebAttribute.LocalContentCanAccessRemoteUrls, False)
            settings.setAttribute(QWebEngineSettings.WebAttribute.LocalContentCanAccessFileUrls, False)
            settings.setAttribute(QWebEngineSettings.WebAttribute.PluginsEnabled, False)
            self.setPage(page)
            self.page().setBackgroundColor(QColor("#ffffff"))
            self.tmp = tempfile.TemporaryDirectory(prefix="creative-mail-")

        def show_mail(self, mail, allow_remote=False):
            self.guard.allow_remote = allow_remote
            body = mail.get("html") or plain_to_html(mail.get("text", ""))
            for cid, (kind, data) in mail.get("inline", {}).items():
                import base64
                uri = f"data:{kind};base64,{base64.b64encode(data).decode()}"
                body = re.sub(rf"""cid:{re.escape(cid)}(?=["'\s>])""", uri, body)
            head = ('<meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="script-src \'none\'">'
                    '<style>html{background:#fff}body{margin:20px;font-family:Arial,sans-serif;color:#1c2029;'
                    'word-wrap:break-word}img{max-width:100%;height:auto}</style>')
            path = Path(self.tmp.name) / "mail.html"
            path.write_text(head + body, encoding="utf-8")
            self.load(QUrl.fromLocalFile(str(path)))

    return View()


