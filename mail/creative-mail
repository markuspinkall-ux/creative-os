        self.cc.setVisible(True)
        self.bcc.setVisible(True)
        self.cc_toggle.setVisible(False)
        self.cc.setFocus()

    def merge(self, fmt):
        cursor = self.editor.textCursor()
        cursor.mergeCharFormat(fmt)
        self.editor.mergeCurrentCharFormat(fmt)

    def bold(self):
        fmt = QTextCharFormat()
        fmt.setFontWeight(400 if int(self.editor.fontWeight()) > 500 else 700)
        self.merge(fmt)

    def italic(self):
        fmt = QTextCharFormat()
        fmt.setFontItalic(not self.editor.fontItalic())
        self.merge(fmt)

    def underline(self):
        fmt = QTextCharFormat()
        fmt.setFontUnderline(not self.editor.fontUnderline())
        self.merge(fmt)

    def bullets(self):
        self.editor.textCursor().createList(QTextListFormat.Style.ListDisc)

    def link(self):
        from PySide6.QtWidgets import QInputDialog
        try:
            from creative_dialogs import QInputDialog  # noqa: F811
        except ImportError:
            pass
        url, ok = QInputDialog.getText(self, "Link einfügen", "Adresse (https://…):", text="https://")
        if ok and url.strip() and url.strip() != "https://":
            cursor = self.editor.textCursor()
            text = cursor.selectedText() or url.strip()
            cursor.insertHtml(f'<a href="{html.escape(url.strip(), quote=True)}">{html.escape(text)}</a>')

    def add_files(self):
        paths, _ = QFileDialog.getOpenFileNames(self, "Dateien anhängen", "", "Alle Dateien (*)")
        self.attachments += [p for p in paths if p]
        self.refresh_chips()

    def attachment_info(self, item):
        if isinstance(item, dict):
            return item["name"], len(item["data"])
        path = Path(item)
        try:
            return path.name, path.stat().st_size
        except OSError:
            return path.name, 0

    def refresh_chips(self):
        while self.chips.count():
            widget = self.chips.takeAt(0).widget()
            if widget:
                widget.deleteLater()
        for item in self.attachments:
            name, size = self.attachment_info(item)
            chip = QPushButton(icon("attach", C["muted"], 14), f" {name}  ·  {human_size(size)}   ✕", objectName="chip")
            chip.setToolTip("Klicken zum Entfernen")
            chip.clicked.connect(lambda _=False, it=item: self.remove_attachment(it))
            self.chips.addWidget(chip)
        self.chips.addStretch(1)
        self.chip_scroll.setVisible(bool(self.attachments))

    def remove_attachment(self, item):
        self.attachments.remove(item)
        self.refresh_chips()

    def discard(self):
        if self.editor.toPlainText().strip() and QMessageBox.question(
                self, "Entwurf verwerfen", "Diese E-Mail verwerfen?") != QMessageBox.StandardButton.Yes:
            return
        self.reject()

    def send(self):
        to, cc, bcc = self.to.text().strip(), self.cc.text().strip(), self.bcc.text().strip()
        everyone = [a for _n, a in getaddresses([to, cc, bcc]) if a]
        if not to or any("@" not in a for a in everyone):
            self.status.setText("Bitte gültige Empfängeradressen eingeben.")
            self.to.setFocus()
            return
        total = sum(self.attachment_info(item)[1] for item in self.attachments)
        if total > 24 * 1024 * 1024:
            self.status.setText("Anhänge sind zusammen größer als 25 MB – Gmail nimmt das nicht an.")
            return
        if not self.subject.text().strip() and QMessageBox.question(
                self, "Ohne Betreff senden", "Diese E-Mail hat keinen Betreff. Trotzdem senden?") \
                != QMessageBox.StandardButton.Yes:
            return
        self.send_button.setEnabled(False)
        self.status.setText("Wird gesendet …")
        text, rich = self.editor.toPlainText(), self.editor.toHtml()
        subject, attachments, reply = self.subject.text(), list(self.attachments), self.reply

        def done(_result):
            self.main.statusBar().showMessage("E-Mail gesendet.", 5000)
            self.accept()
            self.main.refresh_labels()

        def failed(exc):
            self.send_button.setEnabled(True)
            self.status.setText(f"Nicht gesendet: {exc}")

        self.main.jobs.run(lambda: self.main.gmail.send(to, subject, text, cc, bcc, rich, attachments, reply),
                           done, failed)


