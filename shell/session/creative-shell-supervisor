#!/bin/sh
# Die Shell selbst ist ein Wayland-Programm (KWin selbst darf das nicht gesetzt bekommen)
export QT_QPA_PLATFORM=wayland
# Hält die Taskleiste am Leben: Stürzt die Shell ab, wird sie sofort neu
# gestartet. Die Sitzung (und alle offenen Programme) bleiben dabei erhalten.
# Nach 5 Abstürzen innerhalb einer Minute wird aufgegeben, damit kein
# Endlos-Kreislauf entsteht.

# Reste einer früheren Sitzung beenden (z. B. nach Abmelden ohne Neustart).
# Sonst hängen alter Sprachassistent, Tray-Dienst oder Laufwerks-Wächter noch
# herum und können die neue Anmeldung blockieren.
uid="$(id -u)"
for p in creative-assistant creative-automount "creative_broadcast.daemon" "python3 -m creative_notify" "python3 -m creative_shell" "python3 -m creative_assistant" \
         kded6 polkit-kde-authentication-agent-1 "parec --device=@DEFAULT_MONITOR@"; do
    pkill -u "$uid" -f "$p" 2>/dev/null
done
# Schleife des Sprachassistenten aus der alten Sitzung (läuft als „sh“)
pkill -u "$uid" -f "while true; do creative-assistant" 2>/dev/null
sleep 0.3

# Beim Abmelden alles wieder mitnehmen, was diese Sitzung gestartet hat
children=""
session_unit_started=false
cleanup() {
    if [ "$session_unit_started" = true ]; then
        session_unit_started=false
        systemctl --user stop creative-graphical-session.service
    fi
    [ -n "$children" ] && kill $children 2>/dev/null
    pkill -u "$uid" -f creative-assistant 2>/dev/null
    pkill -u "$uid" -f creative-automount 2>/dev/null
    pkill -u "$uid" -f creative_broadcast.daemon 2>/dev/null
    pkill -u "$uid" -f "python3 -m creative_notify" 2>/dev/null
    pkill -u "$uid" -f "while true; do creative-notifyd" 2>/dev/null
    pkill -u "$uid" -f "parec --device=@DEFAULT_MONITOR@" 2>/dev/null
    pkill -u "$uid" -x kded6 2>/dev/null
    pkill -u "$uid" -f polkit-kde-authentication-agent-1 2>/dev/null
}
trap cleanup EXIT
trap 'cleanup; exit 0' INT TERM HUP

# KWin hat den Wayland-Socket angelegt. Portal-Dienste brauchen diese Sitzung
# in der D-Bus- und systemd-Aktivierungsumgebung.
if dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE &&
   systemctl --user start creative-graphical-session.service; then
    session_unit_started=true
fi

# Passwort-Abfrage für Systemänderungen (z. B. Gerätename, Drucker, Updates)
for agent in /usr/libexec/kf6/polkit-kde-authentication-agent-1 \
             /usr/libexec/polkit-kde-authentication-agent-1 \
             /usr/lib/polkit-kde-authentication-agent-1; do
    if [ -x "$agent" ]; then
        "$agent" >/dev/null 2>&1 &
        children="$children $!"
        break
    fi
done

# Tray-Symbole anderer Programme (Steam, Discord …): Anmeldestelle bereitstellen
for kded in /usr/bin/kded6 /usr/libexec/kf6/kded6; do
    if [ -x "$kded" ]; then
        "$kded" >/dev/null 2>&1 &
        children="$children $!"
        break
    fi
done

# Weitere Platten automatisch verbinden (erscheinen nur in „Dieser PC“)
if command -v creative-automount >/dev/null 2>&1; then
    creative-automount >/dev/null 2>&1 &
    children="$children $!"
fi

# Creative Broadcast (rauschfreies Mikrofon / virtuelle Kamera) – ruht, solange alles aus ist
if command -v creative-broadcastd >/dev/null 2>&1; then
    # läuft immer (Symbol im Tray) und startet nach einem Absturz neu
    ( while true; do
        pgrep -u "$(id -u)" -f creative_broadcast.daemon >/dev/null 2>&1 || creative-broadcastd >/dev/null 2>&1
        sleep 5
      done ) &
    children="$children $!"
fi

# Benachrichtigungen (Steam, Discord, Downloads …) unten rechts – startet nach einem Absturz neu
if command -v creative-notifyd >/dev/null 2>&1; then
    ( while true; do creative-notifyd 2>&1 | systemd-cat -t creative-notifyd; sleep 3; done ) &
    children="$children $!"
fi

# Datensicherung: stündlich prüfen, ob eine automatische Sicherung fällig ist
if command -v creative-backup >/dev/null 2>&1; then
    ( sleep 300; while true; do creative-backup --auto >/dev/null 2>&1; sleep 3600; done ) &
    children="$children $!"
fi

# Sprachassistent (läuft im Hintergrund, wird bei einem Absturz neu gestartet)
if command -v creative-assistant >/dev/null 2>&1; then
    # Meldungen landen im Systemprotokoll: journalctl --user -t creative-assistant
    ( while true; do creative-assistant 2>&1 | systemd-cat -t creative-assistant; sleep 5; done ) &
    children="$children $!"
fi

# Live-Umgebung (vom USB-Stick): statt Willkommen gleich die Creative-Installation öffnen
if [ -e /run/creative-live ] && command -v creative-installer >/dev/null 2>&1; then
    mkdir -p "$HOME/.cache"
    auto=""; [ -e /run/creative-live-autotest ] && auto="--auto"
    (sleep 4; creative-installer $auto) >"$HOME/.cache/creative-installer.log" 2>&1 &
# Willkommens-Assistent: nach jeder Anmeldung, bis „Nicht mehr anzeigen“ angehakt ist
elif command -v creative-welcome >/dev/null 2>&1; then
    # Meldungen landen in ~/.cache/creative-welcome.log (falls er sich unerwartet schließt)
    mkdir -p "$HOME/.cache"
    (sleep 3; creative-welcome) >"$HOME/.cache/creative-welcome.log" 2>&1 &
fi

crashes=0
window_start=$(date +%s)
# Zustand für die Gesundheitsprüfung des Systems (creative-session-health):
# „ok“ = Oberfläche läuft stabil, „failed“ = stürzt immer wieder ab → neue Version zurückrollen
state="/tmp/creative-shell-state-$uid"
rm -f "$state"

while true; do
    /usr/bin/creative-shell &
    spid=$!
    ( sleep 60; kill -0 "$spid" 2>/dev/null && echo ok > "$state" ) &
    wait "$spid"
    code=$?
    [ "$code" -eq 0 ] && exit 0          # regulär beendet (Abmelden) – cleanup läuft über trap

    now=$(date +%s)
    if [ $((now - window_start)) -gt 60 ]; then
        crashes=0
        window_start=$now
    fi
    crashes=$((crashes + 1))
    if [ "$crashes" -ge 5 ]; then
        logger -t creative-shell "Shell stürzt wiederholt ab (Code $code) – gebe auf"
        echo failed > "$state"
        # Sitzung offen halten, damit Programme und Daten nicht verloren gehen,
        # und ein Terminal öffnen, damit man nicht vor einem leeren Bildschirm sitzt
        (konsole || ptyxis) >/dev/null 2>&1 &
        while true; do sleep 3600; done
    fi
    logger -t creative-shell "Shell beendet mit Code $code – Neustart"
    sleep 1
done
