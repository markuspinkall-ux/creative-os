# Bildschirmsperre in der Creative-OS-Sitzung
# (liegt unter /usr/share/creative-os/xdg und wird von creative-session eingebunden)

[Daemon]
# Nach 10 Minuten ohne Eingabe sperren, beim Aufwachen aus dem Standby sperren
Autolock=true
Timeout=10
LockOnResume=true

[Greeter]
WallpaperPlugin=org.kde.image

[Greeter][Wallpaper][org.kde.image][General]
Image=file:///usr/share/creative-os/lockscreen/background.svg
FillMode=2
