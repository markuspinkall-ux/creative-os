# KWin-Voreinstellungen, die nur in der Gibeon-OS-Sitzung gelten
# (liegt unter /usr/share/creative-os/xdg und wird von creative-session eingebunden)

[ModifierOnlyShortcuts]
# Windows-Taste allein öffnet das Orbit-Startmenü
Meta=org.creativeos.Shell,/Shell,org.creativeos.Shell,toggleStartMenu

[Plugins]
creative-tasksEnabled=true
# Maximierte Fenster füllen den ganzen Platz bis zur Taskleiste – ohne Abstand
# (das Skript „creative-abstand“ liegt noch bei, ist aber abgeschaltet)
creative-abstandEnabled=false
# Fluid-Glas: Hintergrund hinter Leisten und Startmenü weichzeichnen
blurEnabled=true
# Fenster öffnen dynamisch: wachsen aus dem angeklickten Symbol, minimieren ins Taskleisten-Symbol
# (eigener Effekt „gibeon-fenster“ statt der KDE-Effekte für Öffnen/Schließen/Minimieren)
gibeon-fensterEnabled=true
scaleEnabled=false
glideEnabled=false
fadeEnabled=false
squashEnabled=false
magiclampEnabled=false

[Effect-blur]
BlurStrength=10
NoiseStrength=0

[org.kde.kdecoration2]
# Fensterrahmen: KWin-Standard (Breeze, sauber gezeichnet) in Graphit-Farben aus kdeglobals.
# Der SVG-Rahmen „Graphit“ liegt bei, ist aber abgeschaltet (Nahtstellen).
BorderSize=Tiny
BorderSizeAuto=false
# Wie bei Windows: links das App-Symbol, rechts Minimieren, Maximieren, Schließen
ButtonsOnLeft=M
ButtonsOnRight=IAX
