#!/bin/sh
# Öffnet eine Webseite als eigenes Fenster (ohne Adressleiste und Tabs),
# z. B. Claude, Gemini oder ChatGPT. Anmeldungen bleiben im Brave-Profil
# gespeichert, man ist also beim nächsten Öffnen noch angemeldet.
url="$1"
[ -n "$url" ] || exit 1

if command -v brave-browser >/dev/null 2>&1; then
    exec brave-browser --app="$url"
elif flatpak info com.brave.Browser >/dev/null 2>&1; then
    exec flatpak run com.brave.Browser --app="$url"
elif command -v firefox >/dev/null 2>&1; then
    exec firefox --new-window "$url"
else
    exec xdg-open "$url"
fi
