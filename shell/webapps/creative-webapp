#!/bin/sh
# Öffnet eine Webseite als eigenes Fenster (ohne Adressleiste und Tabs),
# z. B. Claude oder WhatsApp – im Creative Browser. Jede Web-App hat ihre
# eigene Anmeldung (bleibt gespeichert) und ihr eigenes Taskleisten-Symbol.
#   creative-webapp URL [name]    name: z. B. whatsapp → Fensterklasse creative-whatsapp
url="$1"
name="$2"
[ -n "$url" ] || exit 1
if [ -z "$name" ]; then
    case "$url" in
        *web.whatsapp.com*) name=whatsapp ;;
        *claude.ai*) name=claude ;;
        *) name=$(printf '%s' "$url" | sed -E 's#^[a-z]+://(www\.)?##; s#[/:?].*##; s#[^a-zA-Z0-9]+#-#g') ;;
    esac
fi

# WhatsApp hat eine eigene App (Benachrichtigungen, Zähler, Nicht stören …)
case "$url" in
    *web.whatsapp.com*) command -v creative-whatsapp >/dev/null 2>&1 && exec creative-whatsapp ;;
esac

if command -v creative-browser >/dev/null 2>&1; then
    exec creative-browser --class="creative-$name" --app="$url" --app-name="$name"
elif command -v firefox >/dev/null 2>&1; then
    exec firefox --new-window "$url"
else
    exec xdg-open "$url"
fi
