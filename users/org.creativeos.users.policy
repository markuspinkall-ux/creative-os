<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Creative OS</vendor>
  <action id="org.creativeos.users.manage">
    <description>Benutzerkonten verwalten</description>
    <message>Zum Anlegen, Ändern oder Löschen von Benutzerkonten wird ein Administrator-Passwort benötigt.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/creative-users-helper</annotate>
  </action>
</policyconfig>
