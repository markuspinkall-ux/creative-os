#!/bin/bash
# Creative Iso – Hilfsprogramm mit Administratorrechten (über pkexec).
#
#   full  <zielordner> <uid>                              ISO von diesem System (vollständig, ohne Internet installierbar)
#   net   <amd|nvidia> <stabil|test> <quelle> <zielordner> <uid>
#                                                         kleine Installations-ISO; quelle = ISO-Datei oder „download“
#   cancel                                                laufenden Vorgang abbrechen
#
# Fortschritt für die Oberfläche: Zeilen „@@ <prozent> <text>“, Ergebnis „@@ok <datei>“,
# Fehler „@@fehler <text>“. Alles andere ist Protokoll.
set -u
PIDFILE=/run/creative-iso.pid
WORK=/var/tmp/creative-iso
REGISTRY_IMAGE=ghcr.io/markuspinkall-ux/creative-os
BIB=quay.io/centos-bootc/bootc-image-builder:latest
NETDIR=/usr/share/creative-iso/netinstall

say()  { echo "@@ $1 $2"; }
fail() { echo "@@fehler $1"; cleanup; exit 1; }
cleanup() {
    rm -f "$PIDFILE"
    podman rmi -f localhost/creative-os-iso:latest >/dev/null 2>&1 || true
    rm -rf "$WORK"
}

if [ "$(id -u)" -ne 0 ]; then
    echo "@@fehler Bitte über Creative Iso starten."
    exit 1
fi

if [ "${1:-}" = "cancel" ]; then
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE")
        pkill -TERM -P "$pid" 2>/dev/null
        kill -TERM "$pid" 2>/dev/null
        podman ps -q --filter label=creative-iso=1 | xargs -r podman kill >/dev/null 2>&1
        echo "abgebrochen"
    fi
    exit 0
fi

if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "@@fehler Es läuft schon eine ISO-Erstellung."
    exit 1
fi
echo $$ > "$PIDFILE"
trap 'echo "@@fehler Abgebrochen."; cleanup; exit 130' TERM INT

free_gb() { df -BG --output=avail "$1" 2>/dev/null | tail -1 | tr -dc '0-9'; }

finish() {   # <iso> <zielordner> <uid> <name>
    local src="$1" outdir="$2" uid="$3" name="$4"
    mkdir -p "$outdir"
    local dst="$outdir/$name"
    mv -f "$src" "$dst" || fail "Die fertige ISO konnte nicht nach $outdir verschoben werden."
    chown "$uid:$(id -g "$uid" 2>/dev/null || echo "$uid")" "$dst" "$outdir" 2>/dev/null
    say 100 "Fertig"
    echo "@@ok $dst"
}

booted_ref() {
    rpm-ostree status --json 2>/dev/null | python3 -c "
import json, sys
d = json.load(sys.stdin)
b = next((x for x in d.get('deployments', []) if x.get('booted')), {})
print(b.get('container-image-reference', ''))"
}

# ---------------------------------------------------------------------------------------
full() {
    local outdir="$1" uid="$2"
    command -v podman >/dev/null || fail "podman fehlt."
    rm -rf "$WORK"; mkdir -p "$WORK/output"
    local f; f=$(free_gb /var/lib/containers)
    [ "${f:-0}" -ge 25 ] || fail "Zu wenig Speicherplatz: Für eine vollständige ISO werden etwa 25 GB frei benötigt (frei: ${f:-?} GB)."

    # Welche Quelle bekommt das installierte System später für Updates?
    local ref regref tag variant
    ref="$(booted_ref)"
    regref="${ref#*registry:}"; regref="${regref#docker://}"
    case "$regref" in
        ghcr.io/*|quay.io/*|docker.io/*) ;;
        *) variant=$(cat /usr/share/creative-os/variant 2>/dev/null || echo amd); regref="$REGISTRY_IMAGE:$variant" ;;
    esac
    tag="${regref##*:}"; variant="${tag%%-*}"

    say 3 "Dieses System wird für die ISO vorbereitet …"
    if ! bootc image copy-to-storage --target localhost/creative-os-iso:latest 2>&1; then
        echo "Kopieren des laufenden Systems klappt nicht – lade die gleiche Version aus der Registry …"
        podman pull "$regref" 2>&1 || fail "Das System-Abbild konnte nicht geladen werden."
        podman tag "$regref" localhost/creative-os-iso:latest
    fi

    say 20 "Werkzeug zum Erstellen von ISOs wird geladen …"
    podman pull "$BIB" 2>&1 || fail "Das ISO-Werkzeug konnte nicht geladen werden (Internet?)."

    cat > "$WORK/config.toml" <<TOML
[customizations.installer.kickstart]
contents = """
lang de_DE.UTF-8
keyboard --vckeymap=de --xlayouts=de
timezone Europe/Berlin --utc
network --bootproto=dhcp --activate --hostname=creative-os

%post --erroronfail
bootc switch --mutate-in-place --transport registry $regref
%end
"""
TOML

    say 30 "ISO wird gebaut – das dauert 15 bis 40 Minuten …"
    podman run --rm --privileged --label creative-iso=1 \
        --security-opt label=type:unconfined_t \
        -v "$WORK/output:/output" \
        -v "$WORK/config.toml:/config.toml:ro" \
        -v /var/lib/containers/storage:/var/lib/containers/storage \
        "$BIB" --type anaconda-iso --rootfs btrfs \
        localhost/creative-os-iso:latest 2>&1 \
      | while IFS= read -r line; do
            echo "$line"
            case "$line" in
                *"Pipeline build"*)   say 40 "Grundsystem wird zusammengestellt …" ;;
                *"Pipeline anaconda"*|*"Pipeline anaconda-tree"*) say 55 "Installer wird eingebaut …" ;;
                *"Pipeline bootiso-tree"*|*"Pipeline efiboot-tree"*) say 75 "Startdateien werden erzeugt …" ;;
                *"Pipeline bootiso"*) say 88 "ISO-Datei wird geschrieben …" ;;
            esac
        done
    [ -f "$WORK/output/bootiso/install.iso" ] || fail "Die ISO wurde nicht erzeugt – Details im Protokoll."
    finish "$WORK/output/bootiso/install.iso" "$outdir" "$uid" "Creative-OS-${variant}-$(date +%Y%m%d).iso"
    cleanup
}

# ---------------------------------------------------------------------------------------
net() {
    local variant="$1" channel="$2" source="$3" outdir="$4" uid="$5"
    case "$variant" in amd|nvidia) ;; *) fail "Unbekannte Variante." ;; esac
    local tag="$variant"; [ "$channel" = "test" ] && tag="$variant-testing"
    command -v podman >/dev/null || fail "podman fehlt."
    [ -d "$NETDIR" ] || fail "Die Installer-Vorlagen fehlen."
    rm -rf "$WORK"; mkdir -p "$WORK/out"
    local f; f=$(free_gb /var/tmp)
    [ "${f:-0}" -ge 6 ] || fail "Zu wenig Speicherplatz: etwa 6 GB frei werden benötigt (frei: ${f:-?} GB)."

    sed "s|@IMAGE@|$REGISTRY_IMAGE:$tag|" "$NETDIR/creative.ks.in" > "$WORK/out/creative.ks"
    local srcmount=()
    if [ "$source" != "download" ]; then
        [ -f "$source" ] || fail "Die gewählte ISO-Datei wurde nicht gefunden."
        cp "$source" "$WORK/source.iso" 2>/dev/null || ln -f "$source" "$WORK/source.iso" || fail "Die ISO-Datei konnte nicht gelesen werden."
        srcmount=(-v "$WORK/source.iso:/in.iso:ro")
    fi

    say 5 "Werkzeuge werden geladen …"
    podman pull registry.fedoraproject.org/fedora:44 2>&1 || fail "Fedora-Werkzeuge konnten nicht geladen werden (Internet?)."
    say 15 "Installations-ISO wird erstellt …"
    podman run --rm --privileged --label creative-iso=1 \
        -v "$WORK/out:/out" -v "$NETDIR:/src:ro" "${srcmount[@]}" \
        registry.fedoraproject.org/fedora:44 bash -euc '
            echo "@@ 20 Werkzeuge werden eingerichtet …"
            dnf install -y -q --setopt=install_weak_deps=False lorax xorriso curl cpio gzip mtools >/dev/null
            if [ -f /in.iso ]; then
                iso=/in.iso
            else
                echo "@@ 35 Fedora-Netzinstallation wird heruntergeladen (etwa 1 GB) …"
                base=https://download.fedoraproject.org/pub/fedora/linux/releases/44/Everything/x86_64/iso
                name=$(curl -fsSL "$base/" | grep -o "Fedora-Everything-netinst-x86_64-[0-9.-]*\.iso" | head -n1)
                curl -fsSL -o /tmp/netinst.iso "$base/$name"
                iso=/tmp/netinst.iso
            fi
            echo "@@ 70 Creative-OS-Installer wird eingebaut …"
            bash /src/brand-iso.sh "$iso" /out/creative.ks /out/creative.iso \
              || mkksiso --ks /out/creative.ks "$iso" /out/creative.iso
        ' 2>&1
    [ -f "$WORK/out/creative.iso" ] || fail "Die ISO wurde nicht erzeugt – Details im Protokoll."
    local suffix=""; [ "$channel" = "test" ] && suffix="-test"
    finish "$WORK/out/creative.iso" "$outdir" "$uid" "Creative-OS-${variant}${suffix}-netinstall-$(date +%Y%m%d).iso"
    cleanup
}

case "${1:-}" in
    full) [ $# -eq 3 ] || fail "Aufruf: full <zielordner> <uid>"; full "$2" "$3" ;;
    net)  [ $# -eq 6 ] || fail "Aufruf: net <variante> <kanal> <quelle> <zielordner> <uid>"; net "$2" "$3" "$4" "$5" "$6" ;;
    *)    fail "Unbekannter Befehl." ;;
esac
