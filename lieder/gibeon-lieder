    def load_songs(self, select=None):
        self.songs.clear()
        files = sorted(songs_dir().glob("*.wav"), key=lambda p: p.stat().st_mtime, reverse=True)
        for f in files:
            m, s = divmod(int(round(wav_seconds(f))), 60)
            it = QListWidgetItem(f"{f.stem}    ·    {m}:{s:02d}")
            it.setData(Qt.ItemDataRole.UserRole, str(f))
            self.songs.addItem(it)
            if select and Path(select) == f:
                self.songs.setCurrentItem(it)
        self.empty.setVisible(not files)
        if self.songs.currentRow() < 0 and files:
            self.songs.setCurrentRow(0)
        self.refresh()

    def current(self):
        it = self.songs.currentItem()
        return Path(it.data(Qt.ItemDataRole.UserRole)) if it else None

    def show_song(self):
        f = self.current()
        info = f.with_suffix(".txt") if f else None
        self.song_text.setPlainText(info.read_text(encoding="utf-8") if info and info.is_file() else "")
        self.refresh()

    def play(self):
        if self.player is not None and self.player.playbackState() == QMediaPlayer.PlaybackState.PlayingState:
            self.player.stop()
            return
        f = self.current()
        if not f:
            return
        if self.player is None:
            QDesktopServices.openUrl(QUrl.fromLocalFile(str(f)))
            return
        self.player.setSource(QUrl.fromLocalFile(str(f)))
        self.player.play()

    def stop_if_playing(self, f):
        if self.player is not None and self.player.source() == QUrl.fromLocalFile(str(f)):
            self.player.stop()
            self.player.setSource(QUrl())

    def save_as(self):
        f = self.current()
        if not f:
            return
        start = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.MusicLocation) or str(Path.home())
        path, chosen = QFileDialog.getSaveFileName(self, "Lied speichern als", str(Path(start) / f"{f.stem}.mp3"),
                                                   "MP3 (*.mp3);;WAV – verlustfrei (*.wav)")
        if not path:
            return
        suffix = Path(path).suffix.lower()
        if suffix not in (".mp3", ".wav"):
            suffix = ".wav" if "wav" in (chosen or "").lower() else ".mp3"
            path += suffix
        try:
            if suffix == ".wav":
                shutil.copyfile(f, path)
            else:
                subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(f), "-c:a", "libmp3lame", "-b:a", "320k",
                                "-metadata", f"title={f.stem}", "-metadata", "comment=Erzeugt mit dem KI-Liedstudio",
                                path], check=True, timeout=600)
            self.status.setText(f"Gespeichert: {Path(path).name}")
        except (OSError, subprocess.SubprocessError) as error:
            self.status.setText(f"Speichern fehlgeschlagen: {error}")

    def rename_song(self):
        f = self.current()
        if not f:
            return
        name, ok = QInputDialog.getText(self, "Lied umbenennen", "Neuer Name:", text=f.stem)
        name = ls.safe_name(name) if ok else ""
        if not name or name == f.stem:
            return
        target = f.with_name(f"{name}.wav")
        if target.exists():
            self.status.setText("Ein Lied mit diesem Namen gibt es schon.")
            return
        self.stop_if_playing(f)
        f.rename(target)
        if f.with_suffix(".txt").is_file():
            f.with_suffix(".txt").rename(target.with_suffix(".txt"))
        self.load_songs(target)

    def delete_song(self):
        f = self.current()
        if not f:
            return
        if QMessageBox.question(self, "Lied löschen", f"„{f.stem}“ wirklich löschen?") != QMessageBox.StandardButton.Yes:
            return
        self.stop_if_playing(f)
        f.unlink(missing_ok=True)
        f.with_suffix(".txt").unlink(missing_ok=True)
        self.load_songs()

    def reuse_song(self):
        f = self.current()
        info = f.with_suffix(".txt") if f else None
        if not info or not info.is_file():
            return
        text = info.read_text(encoding="utf-8")
        head, _, lyrics = text.partition("\n\n")
        self.lyrics.setPlainText(lyrics.split("\n\n—\n")[0].strip())
        for line in head.split("\n"):
            key, _, value = line.partition(": ")
            box = {"Stil": self.style_box, "Stimme": self.voice_box, "Stimmung": self.mood_box,
                   "Sprache": self.lang_box}.get(key)
            if box:
                i = box.findText(value)
                if i >= 0:
                    box.setCurrentIndex(i)
            if key == "Titel":
                self.title.setText(value)

    # ---- Einrichten und Erzeugen ------------------------------------------------
    def busy(self):
        return self.proc.state() != QProcess.ProcessState.NotRunning

    def refresh(self):
        gpu = gpu_name()
        self.chip.setText(("Grafikkarte: " + gpu) if gpu else "Keine NVIDIA-Grafikkarte gefunden")
        busy = self.busy()
        self.setup_box.setVisible(not ready() or self.mode == "setup")
        self.setup_btn.setEnabled(not busy)
        self.go.setEnabled(ready() and not busy)
        self.go.setText("Lied erzeugen" if ls.has_lyrics(self.lyrics.toPlainText()) else "Lied erzeugen (instrumental)")
        has = self.current() is not None
        playing = self.player is not None and self.player.playbackState() == QMediaPlayer.PlaybackState.PlayingState
        self.play_btn.setText("■  Stopp" if playing else "▶  Anhören")
        self.play_btn.setEnabled(has or playing)
        for b in (self.save_btn, self.rename_btn, self.delete_btn, self.reuse_btn):
            b.setEnabled(has and not busy)

    def start_setup(self):
        if self.busy() or not SETUP.is_file():
            self.setup_status.setText("Das Einrichtungsprogramm des Musikgenerators fehlt – bitte Gibeon OS aktualisieren.")
            return
        self.mode, self.buffer = "setup", b""
        self.log.clear()
        self.log.show()
        self.setup_status.setText("Starte … (das dauert je nach Internet eine Weile)")
        self.proc.start("sh", [str(SETUP), "--teil", "musik"])
        self.refresh()

    def start_generate(self):
        if self.busy() or not ready():
            return
        title = ls.safe_name(self.title.text())
        lyrics = ls.to_ace(self.lyrics.toPlainText())
        sung = ls.has_lyrics(self.lyrics.toPlainText())
        prompt = ls.build_prompt(self.style_box.currentData(), self.voice_box.currentData() if sung else "",
                                 self.mood_box.currentData(), self.lang_box.currentData() if sung else "",
                                 self.bpm.value() if self.bpm.value() >= 60 else 0)
        if not sung:
            prompt = "instrumental, " + prompt
        seconds = self.length.currentData() or (ls.suggest_length(self.lyrics.toPlainText()) if sung else 120)
        self.work = WORK / time.strftime("%Y%m%d-%H%M%S")
        self.work.mkdir(parents=True, exist_ok=True)
        args = ["--musik", "--prompt", prompt, "--seconds", str(seconds), "--count", str(self.count.currentData()),
                "--prefix", "lied"]
        if sung:
            (self.work / "songtext.txt").write_text(lyrics, encoding="utf-8")
            args += ["--lyrics-file", "/out/songtext.txt"]
        self.job = {"title": title, "prompt": prompt, "lyrics": self.lyrics.toPlainText().strip(), "sung": sung}
        self.made = []
        env = QProcessEnvironment.systemEnvironment()
        env.insert("PYTHONUNBUFFERED", "1")
        self.proc.setProcessEnvironment(env)
        podman = ["run", "--rm", "--security-opt", "label=disable", "--device", "nvidia.com/gpu=all",
                  "-e", "HF_HUB_OFFLINE=1", "-e", "TRANSFORMERS_OFFLINE=1",
                  "-v", f"{DATA / 'modelle'}:/cache", "-v", f"{self.work}:/out", *run_override(), IMAGE,
                  *args, "--out", "/out"]
        self.mode, self.error, self.buffer = "job", "", b""
        self.progress.setValue(0)
        self.progress.show()
        self.status.setText("Starte die KI … (beim ersten Lied dauert das Laden am längsten)")
        self.proc.start("podman", podman)
        self.refresh()

    def read_output(self):
        self.buffer += bytes(self.proc.readAllStandardOutput())
        *lines, self.buffer = self.buffer.split(b"\n")
        for raw in lines:
            line = raw.decode(errors="replace").rstrip()
            if not line:
                continue
            if self.mode == "setup":
                self.log.appendPlainText(line)
                if line.startswith("STEP "):
                    self.setup_status.setText(line.split(" ", 3)[-1])
                elif line.startswith("FEHLER:"):
                    self.setup_status.setText(line[7:].strip())
                continue
            kind, _, rest = line.partition(" ")
            if kind == "P":
                pct, _, text = rest.partition(" ")
                if pct.isdigit():
                    self.progress.setValue(int(pct))
                self.status.setText(text)
            elif kind == "AUDIO":
                self.store(self.work / rest.split(" ")[0], rest.split(" ")[-1])
            elif kind == "ERR":
                self.error = rest

    def store(self, src, seed):
        """Fertiges Lied in „Meine Lieder“ legen, mit Songtext und Einstellungen daneben."""
        if not src.is_file():
            return
        base = self.job["title"]
        target = songs_dir() / f"{base}.wav"
        n = 2
        while target.exists():
            target = songs_dir() / f"{base} ({n}).wav"
            n += 1
        shutil.move(str(src), target)
        info = [f"Titel: {target.stem}", f"Stil: {self.style_box.currentText()}",
                f"Stimme: {self.voice_box.currentText() if self.job['sung'] else 'Ohne Gesang'}",
                f"Stimmung: {self.mood_box.currentText()}", f"Sprache: {self.lang_box.currentText()}",
                f"Startwert: {seed}", "Modell: ACE-Step (ACE Studio & StepFun, Apache 2.0)"]
        target.with_suffix(".txt").write_text("\n".join(info) + "\n\n" + (self.job["lyrics"] or "(instrumental)")
                                              + f"\n\n—\nKI-Stichwörter: {self.job['prompt']}\n", encoding="utf-8")
        self.made.append(target)

    def finished(self, code, _status):
        mode, self.mode = self.mode, None
        self.buffer = b""
        if mode == "setup":
            self.setup_status.setText("Fertig – die Musik-KI ist bereit." if ready() else
                                      (self.setup_status.text() or "Einrichtung fehlgeschlagen – Details siehe unten."))
            self.refresh()
            return
        self.progress.hide()
        if self.work:
            shutil.rmtree(self.work, ignore_errors=True)
        if self.made:
            self.status.setText(f"Fertig – {len(self.made)} Lied{'er' if len(self.made) > 1 else ''} in „Meine Lieder“.")
            self.load_songs(self.made[0])
        else:
            self.status.setText(self.error or "Die KI wurde unerwartet beendet. Bitte erneut versuchen.")
        self.refresh()

    def closeEvent(self, event):
        if self.busy():
            if QMessageBox.question(self, APP, "Es läuft noch etwas. Trotzdem beenden?") \
                    != QMessageBox.StandardButton.Yes:
                event.ignore()
                return
            self.proc.kill()
            self.proc.waitForFinished(2000)
        super().closeEvent(event)


def example_song(window):
    """Für Selbsttest und Fotos: ein Lied mit Text in „Meine Lieder“ ablegen (Stille statt Gesang)."""
    work = Path(tempfile.mkdtemp(prefix="lied-test-"))
    src = work / "lied-1.wav"
    with wave.open(str(src), "wb") as w:
        w.setnchannels(2)
        w.setsampwidth(2)
        w.setframerate(48000)
        w.writeframes(b"\0\0\0\0" * 48000 * 3)
    window.title.setText("Sommer am See")
    window.lyrics.setPlainText("[Strophe]\nDie Sonne steht hoch über'm Weinberg\nWir fahren los, das Fenster auf\n\n"
                               "[Refrain]\nSommer, Sommer, bleib noch hier\nSommer, tanz noch mal mit mir")
    window.job = {"title": ls.safe_name(window.title.text()), "prompt": "pop, female vocals",
                  "lyrics": window.lyrics.toPlainText(), "sung": True}
    window.work, window.made = work, []
    window.store(src, 42)
    window.finished(0, None)


def main():
    test = "--selftest" in sys.argv
    shot = next((a.split("=", 1)[1] for a in sys.argv if a.startswith("--screenshot=")), None)
    if test or shot:
        os.environ["LIEDER_AUSGABE"] = tempfile.mkdtemp(prefix="lieder-")
    app = QApplication(sys.argv)
    app.setApplicationName(APP)
    app.setDesktopFileName("gibeon-lieder")
    app.setWindowIcon(QIcon.fromTheme("gibeon-lieder"))
    window = Studio()
    if test:
        assert ls.to_ace("[Refrain]\nla la").startswith("[chorus]")
        example_song(window)
        assert window.songs.count() == 1 and "Sommer" in window.song_text.toPlainText()
        window.reuse_song()
        assert window.title.text().startswith("Sommer")
        window.close()
        print("Liedstudio: Selbsttest ok")
        # Qt beim Aufräumen nicht mehr anfassen – das stürzte gelegentlich ab, nachdem alles geprüft war
        sys.stdout.flush()
        os._exit(0)
    if shot:
        window.show()
        example_song(window)
        QTimer.singleShot(600, lambda: (window.grab().save(shot), app.quit()))
        return app.exec()
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
