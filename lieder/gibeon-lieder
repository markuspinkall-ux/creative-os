def ready():
    return (DATA / "modelle" / "ace-step" / "bereit").is_file()


def gpu_name():
    if not shutil.which("nvidia-smi"):
        return ""
    try:
        out = subprocess.run(["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"],
                             capture_output=True, text=True, timeout=5).stdout.strip().splitlines()
        return out[0] if out else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def songs_dir():
    if os.environ.get("LIEDER_AUSGABE"):
        path = Path(os.environ["LIEDER_AUSGABE"])
    else:
        base = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.MusicLocation) \
            or str(Path.home() / "Musik")
        path = Path(base) / "KI-Lieder"
    path.mkdir(parents=True, exist_ok=True)
    return path


def run_override():
    newer = MUSIK_LIB / "musik-run.py"
    return ["-v", f"{newer}:/opt/gibeon/run.py:ro"] if newer.is_file() else []


def wav_seconds(path):
    try:
        with wave.open(str(path), "rb") as w:
            return w.getnframes() / w.getframerate()
    except (OSError, EOFError, wave.Error):
        return 0


