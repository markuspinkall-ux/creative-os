#!/usr/bin/python3
"""Per-user folder permissions for installed Flatpak apps."""

import configparser
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import Qt
from PySide6.QtWidgets import (
    QApplication, QComboBox, QFileDialog, QFormLayout, QHBoxLayout, QLabel,
    QLineEdit, QListWidget, QListWidgetItem, QMessageBox, QPushButton, QVBoxLayout,
    QWidget,
)
try:  # Graphit-Dialoge von Creative OS statt der Qt-Standarddialoge
    from creative_dialogs import QFileDialog, QMessageBox
except ImportError:
    pass


def flatpak(*args):
    return subprocess.run(
        ["flatpak", *args], capture_output=True, text=True, check=True, timeout=5,
    ).stdout


def folder_rules(app_id):
    metadata = flatpak("override", "--user", "--show", app_id)
    config = configparser.ConfigParser(interpolation=None)
    config.read_string(metadata)
    for entry in config.get("Context", "filesystems", fallback="").split(";"):
        path, _, access = entry.removeprefix("!").partition(":")
        if path.startswith(("/", "~/")) and access in ("", "ro", "rw", "create"):
            yield path, "blocked" if entry.startswith("!") else access or "rw"


class FlatRules(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Creative FlatRules")
        self.resize(670, 460)
        self.setStyleSheet("""
            QWidget { background: #161925; color: #edf0fb; font-size: 14px; }
            QLabel#title { font-size: 27px; font-weight: 700; }
            QLineEdit, QComboBox, QListWidget, QPushButton {
                background: #252b3e; border: 1px solid #414969;
                border-radius: 8px; padding: 8px;
            }
            QPushButton:hover { background: #373d59; }
            QPushButton#save { background: #a8a1ff; color: #1b1931; font-weight: 700; }
            QPushButton:disabled, QPushButton#save:disabled { background: #252b3e; color: #8b92ad; }
        """)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 20, 24, 20)
        title = QLabel("Creative FlatRules", objectName="title")
        layout.addWidget(title)
        intro = QLabel("Gib einer Flatpak-App Zugriff auf einen bestimmten Ordner.")
        intro.setWordWrap(True)
        layout.addWidget(intro)

        form = QFormLayout()
        self.apps = QComboBox()
        self.apps.setAccessibleName("Flatpak-App")
        form.addRow("1. App", self.apps)
        self.folder = QLineEdit(placeholderText="Wähle deinen Projekt- oder Ausgabeordner")
        self.folder.setReadOnly(True)
        self.folder.setAccessibleName("Ordnerpfad")
        choose = QPushButton("Ordner auswählen …")
        choose.clicked.connect(self.choose_folder)
        folder_row = QHBoxLayout()
        folder_row.addWidget(self.folder, 1)
        folder_row.addWidget(choose)
        form.addRow("2. Ordner", folder_row)
        self.access = QComboBox()
        self.access.setAccessibleName("Ordnerzugriff")
        self.access.addItem("Nur lesen", "ro")
        self.access.addItem("Lesen und schreiben", "rw")
        form.addRow("3. Zugriff", self.access)
        layout.addLayout(form)

        self.save = QPushButton("Freigabe speichern", objectName="save")
        self.save.clicked.connect(self.save_rule)
        layout.addWidget(self.save)
        layout.addWidget(QLabel("Ordnerregeln für diese App"))
        self.rules = QListWidget()
        self.rules.setAccessibleName("Ordnerregeln für diese App")
        self.rules.currentItemChanged.connect(self.select_rule)
        layout.addWidget(self.rules, 1)
        self.block = QPushButton("Zugriff entziehen")
        self.block.clicked.connect(self.block_rule)
        layout.addWidget(self.block)
        self.status = QLabel()
        self.status.setTextFormat(Qt.TextFormat.PlainText)
        self.status.setWordWrap(True)
        layout.addWidget(self.status)

        self.apps.currentIndexChanged.connect(self.change_app)
        self.folder.textChanged.connect(self.update_buttons)
        self.load_apps()

    def load_apps(self):
        try:
            output = flatpak("list", "--app", "--columns=application,name")
        except (OSError, subprocess.SubprocessError) as error:
            self.show_error("Flatpak-Apps konnten nicht geladen werden.", error)
            self.update_buttons()
            return
        apps = {}
        for line in output.splitlines():
            app_id, separator, name = line.partition("\t")
            if separator and app_id:
                apps[app_id] = name or app_id
        self.apps.blockSignals(True)
        for app_id, name in sorted(apps.items(), key=lambda app: app[1].casefold()):
            self.apps.addItem(name, app_id)
        self.apps.blockSignals(False)
        self.change_app()
        if not apps:
            self.status.setText("Es sind keine Flatpak-Apps installiert.")

    def change_app(self):
        self.folder.clear()
        self.access.setCurrentIndex(0)
        self.status.clear()
        self.load_rules()

    def load_rules(self):
        self.rules.clear()
        app_id = self.apps.currentData()
        if app_id:
            try:
                for path, access in sorted(folder_rules(app_id)):
                    label = {"ro": "Nur lesen", "rw": "Lesen und schreiben",
                             "create": "Lesen und schreiben", "blocked": "Zugriff entzogen"}[access]
                    item = QListWidgetItem(f"{label}  ·  {path}")
                    item.setData(Qt.ItemDataRole.UserRole, (path, access))
                    self.rules.addItem(item)
            except (OSError, subprocess.SubprocessError, configparser.Error) as error:
                self.show_error("Ordnerregeln konnten nicht geladen werden.", error)
        self.update_buttons()

    def choose_folder(self):
        path = QFileDialog.getExistingDirectory(self, "Ordner auswählen", str(Path.home()))
        if path:
            self.rules.setCurrentRow(-1)
            self.folder.setText(path)
            self.access.setCurrentIndex(0)

    def select_rule(self, item, _previous):
        if item:
            path, access = item.data(Qt.ItemDataRole.UserRole)
            self.folder.setText(path)
            self.access.setCurrentIndex(int(access in ("rw", "create")))
        self.update_buttons()

    def update_buttons(self):
        self.save.setEnabled(bool(self.apps.currentData() and self.folder.text()))
        item = self.rules.currentItem()
        self.block.setEnabled(bool(item and item.data(Qt.ItemDataRole.UserRole)[1] != "blocked"))

    def save_rule(self):
        path = self.folder.text()
        if path == "/" or any(char in path for char in ":;\n\r\\"):
            self.status.setText("Wähle einen einzelnen Ordner mit einem unterstützten Pfad.")
            return
        if not Path(path).expanduser().is_dir():
            self.status.setText("Dieser Ordner existiert nicht. Wähle einen anderen Ordner.")
            return
        self.apply_rule(f"--filesystem={path}:{self.access.currentData()}", "Freigabe gespeichert.")

    def block_rule(self):
        item = self.rules.currentItem()
        if item:
            path, _ = item.data(Qt.ItemDataRole.UserRole)
            self.apply_rule(f"--nofilesystem={path}", "Ordnerzugriff entzogen.")

    def apply_rule(self, option, message):
        try:
            flatpak("override", "--user", option, self.apps.currentData())
        except (OSError, subprocess.SubprocessError) as error:
            self.show_error("Die Freigabe konnte nicht geändert werden.", error)
            return
        self.status.setText(f"{message} Starte die betroffene App neu.")
        self.load_rules()

    def show_error(self, message, error):
        details = (getattr(error, "stderr", None) or str(error)).strip()
        QMessageBox.warning(self, "Creative FlatRules", f"{message}\n\n{details}" if details else message)


def main():
    app = QApplication(sys.argv)
    app.setDesktopFileName("creative-flatrules")
    window = FlatRules()
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
