[Desktop Entry]
Type=Application
Name=Creative Writer
GenericName=Textverarbeitung
Comment=Dokumente wie in Word schreiben – mit Menüband, Word-Dateien, PDF und Rechtschreibprüfung
Exec=creative-writer %f
Icon=creative-writer
Terminal=false
Categories=Office;WordProcessor;
Keywords=Text;Dokument;PDF;Drucken;Schreiben;Word;docx;Brief;Textverarbeitung;
