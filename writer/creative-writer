def save_bytes(path, data):
    target = QSaveFile(str(path))
    if not target.open(QIODevice.OpenModeFlag.WriteOnly):
        raise OSError(target.errorString())
    if target.write(data) != len(data) or not target.commit():
        raise OSError(target.errorString())


def default_page():
    return {"size": "A4", "landscape": False, "width_mm": 210, "height_mm": 297,
            "margins_mm": [25, 25, 20, 25], "header": "", "footer": "", "numbers": "", "color": "#ffffff"}


def page_from(meta):
    page = default_page()
    if isinstance(meta, dict):
        for key in page:
            if key in meta:
                page[key] = meta[key]
    try:
        page["margins_mm"] = [float(v) for v in page["margins_mm"]][:4]
        if len(page["margins_mm"]) != 4:
            raise ValueError
    except (TypeError, ValueError):
        page["margins_mm"] = default_page()["margins_mm"]
    w, h = float(page["width_mm"]), float(page["height_mm"])
    page["width_mm"], page["height_mm"] = w, h
    page["landscape"] = w > h
    return page


META_RE = re.compile(r'<meta name="creative-writer" content="([^"]*)"\s*/?>')


def html_with_meta(html, page):
    meta = '<meta name="creative-writer" content="%s" />' % escape(json.dumps(page, ensure_ascii=False), quote=True)
    if "<head>" in html:
        return html.replace("<head>", "<head>" + meta, 1)
    return meta + html


def meta_from_html(html):
    import html as htmllib
    m = META_RE.search(html)
    if not m:
        return {}
    try:
        return json.loads(htmllib.unescape(m.group(1)))
    except ValueError:
        return {}


def fill_placeholders(text, page_no, pages, title):
    return (text.replace("{seite}", str(page_no)).replace("{seiten}", str(pages))
            .replace("{titel}", title).replace("{datum}", QDate.currentDate().toString("dd.MM.yyyy")))


def paginate(document, page):
    """Kopie des Dokuments, auf Seiten umbrochen (96-dpi-Pixel). Rückgabe: (Kopie, Seitenbreite, -höhe)."""
    pw, ph = page["width_mm"] * MM, page["height_mm"] * MM
    clone = document.clone()
    top, right, bottom, left = (v * MM for v in page["margins_mm"])
    root = clone.rootFrame()
    ff = root.frameFormat()
    ff.setTopMargin(top)
    ff.setBottomMargin(bottom)
    ff.setLeftMargin(left)
    ff.setRightMargin(right)
    ff.setPadding(0)
    root.setFrameFormat(ff)
    clone.setDocumentMargin(0)
    clone.setPageSize(QSizeF(pw, ph))
    return clone, pw, ph


def render_pages(document, page, printer, title=""):
    """Druckt/exportiert mit Seitenrändern, Kopf-/Fußzeile und Seitenzahlen."""
    clone, pw, ph = paginate(document, page)
    printer.setFullPage(True)
    layout = QPageLayout(QPageSize(QSizeF(page["width_mm"], page["height_mm"]), QPageSize.Unit.Millimeter),
                         QPageLayout.Orientation.Portrait, QMarginsF(0, 0, 0, 0))
    printer.setPageLayout(layout)
    painter = QPainter()
    if not painter.begin(printer):
        raise OSError("Drucker oder PDF konnte nicht geöffnet werden.")
    target = printer.pageRect(QPrinter.Unit.DevicePixel)
    scale = target.width() / pw
    pages = max(1, clone.pageCount())
    top, right, bottom, left = (v * MM for v in page["margins_mm"])
    small = QFont(clone.defaultFont())
    small.setPointSizeF(9)
    for index in range(pages):
        if index:
            printer.newPage()
        painter.save()
        painter.scale(scale, scale)
        if page.get("color") and page["color"].lower() != "#ffffff":
            painter.fillRect(QRectF(0, 0, pw, ph), QColor(page["color"]))
        painter.save()
        painter.translate(0, -index * ph)
        ctx = QAbstractTextDocumentLayout.PaintContext()
        ctx.clip = QRectF(0, index * ph, pw, ph)
        painter.setClipRect(ctx.clip)
        clone.documentLayout().draw(painter, ctx)
        painter.restore()
        painter.setFont(small)
        painter.setPen(QColor("#5d6884"))
        if page.get("header"):
            painter.drawText(QRectF(left, top * 0.35, pw - left - right, top * 0.5),
                             Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                             fill_placeholders(page["header"], index + 1, pages, title))
        footer = fill_placeholders(page.get("footer", ""), index + 1, pages, title)
        foot_rect = QRectF(left, ph - bottom * 0.85, pw - left - right, bottom * 0.5)
        if footer:
            painter.drawText(foot_rect, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, footer)
        numbers = page.get("numbers", "")
        if numbers:
            align = {"rechts": Qt.AlignmentFlag.AlignRight, "links": Qt.AlignmentFlag.AlignLeft}.get(
                numbers, Qt.AlignmentFlag.AlignHCenter)
            text = f"Seite {index + 1} von {pages}" if numbers.endswith("von") else str(index + 1)
            if numbers.startswith("mitte"):
                align = Qt.AlignmentFlag.AlignHCenter
            painter.drawText(foot_rect, align | Qt.AlignmentFlag.AlignVCenter, text)
        painter.restore()
    painter.end()
    return pages


def export_pdf(document, page, path, title=""):
    tmp = Path(str(path) + ".teil")
    printer = QPrinter(QPrinter.PrinterMode.HighResolution)
    printer.setOutputFormat(QPrinter.OutputFormat.PdfFormat)
    printer.setOutputFileName(str(tmp))
    printer.setDocName(title or "Dokument")
    render_pages(document, page, printer, title)
    with tmp.open("rb") as handle:
        if handle.read(5) != b"%PDF-":
            raise OSError("Die PDF-Datei konnte nicht erstellt werden.")
    tmp.replace(path)


def page_breaks(document, page):
    """Für jede Seite ab 2 die Blocknummer, mit der sie beginnt (für die Markierungen im Editor)."""
    clone, pw, ph = paginate(document, page)
    layout = clone.documentLayout()
    starts = []
    block = clone.begin()
    next_page = 1
    while block.isValid():
        rect = layout.blockBoundingRect(block)
        while rect.top() >= next_page * ph - 0.5:
            starts.append(block.blockNumber())
            next_page += 1
        block = block.next()
    return starts, max(1, clone.pageCount())


