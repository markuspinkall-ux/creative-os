WORD_RE = re.compile(r"[^\W\d_](?:[^\W\d_]|['’-](?=[^\W\d_]))*", re.UNICODE)


class Speller(QSyntaxHighlighter):
    def __init__(self, document, language="de_DE"):
        super().__init__(document)
        self.dictionary = None
        self.ignored = set()
        self.enabled = False
        self.language = None
        if enchant is not None:
            for lang in (language, "de_DE", "de", "en_US"):
                try:
                    self.dictionary = enchant.Dict(lang)
                    self.language = lang
                    break
                except Exception:
                    continue
        self.fmt = QTextCharFormat()
        self.fmt.setUnderlineStyle(QTextCharFormat.UnderlineStyle.SpellCheckUnderline)
        self.fmt.setUnderlineColor(QColor("#e5484d"))

    @property
    def available(self):
        return self.dictionary is not None

    def set_enabled(self, on):
        self.enabled = bool(on) and self.available
        self.rehighlight()

    def wrong(self, word):
        if not self.dictionary or len(word) < 2 or word in self.ignored or word.isupper():
            return False
        try:
            return not self.dictionary.check(word)
        except Exception:
            return False

    def suggest(self, word):
        try:
            return self.dictionary.suggest(word)[:6]
        except Exception:
            return []

    def add(self, word):
        try:
            self.dictionary.add(word)
        except Exception:
            self.ignored.add(word)
        self.rehighlight()

    def highlightBlock(self, text):
        if not self.enabled:
            return
        for m in WORD_RE.finditer(text):
            if self.wrong(m.group()):
                self.setFormat(m.start(), m.end() - m.start(), self.fmt)


