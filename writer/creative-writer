        cursor.insertHtml("<hr/>")
        cursor.insertBlock()

    def header_footer_dialog(self, which):
        label = "Kopfzeile" if which == "header" else "Fußzeile"
        text, ok = QInputDialog.getText(
            self, label, f"{label} (auf jeder Seite). Platzhalter: {{seite}}, {{seiten}}, {{titel}}, {{datum}}",
            text=self.page.get(which, ""))
        if ok:
            self.page[which] = text
            self.editor.document().setModified(True)
            self.update_pages()

    def set_numbers(self, value):
        self.page["numbers"] = value
        self.editor.document().setModified(True)
        self.flash("Seitenzahlen erscheinen beim Drucken und im PDF." if value else "Seitenzahlen entfernt.")
        self.update_pages()

    def headings(self):
        out = []
        block = self.editor.document().begin()
        while block.isValid():
            level = block.blockFormat().headingLevel()
            if level and block.blockFormat().property(STYLE_KEY) != "toc" and block.text().strip():
                out.append((level, block.text().strip(), block.blockNumber()))
            block = block.next()
        return out

    def heading_pages(self):
        doc = self.editor.document()
        starts, _count = page_breaks(doc, self.page)
        pages = {}
        for level, text, number in self.headings():
            pages[number] = 1 + sum(1 for s in starts if s <= number)
        return pages

    def insert_toc(self, at_cursor=None):
        heads = self.headings()
        if not heads:
            self.flash("Erst Überschriften setzen (Start → Formatvorlagen → Überschrift 1/2/3).")
            return
        pages = self.heading_pages()
        cursor = at_cursor or self.editor.textCursor()
        cursor.beginEditBlock()
        tab_pos = self.content_width()
        title_bf = QTextBlockFormat()
        title_bf.setProperty(STYLE_KEY, "toc")
        title_bf.setBottomMargin(8)
        title_cf = QTextCharFormat()
        title_cf.setFontPointSize(16)
        title_cf.setForeground(QColor("#2b4f9e"))
        if cursor.block().text():
            cursor.insertBlock()
        cursor.setBlockFormat(title_bf)
        cursor.insertText("Inhaltsverzeichnis", title_cf)
        for level, text, number in heads:
            bf = QTextBlockFormat()
            bf.setProperty(STYLE_KEY, "toc")
            bf.setLeftMargin((level - 1) * 6 * MM)
            bf.setBottomMargin(3)
            bf.setTabPositions([QTextOption.Tab(tab_pos - (level - 1) * 6 * MM, QTextOption.TabType.RightTab)])
            cf = QTextCharFormat()
            cf.setFontPointSize(11)
            cf.setForeground(QColor(INK))
            cf.setFontWeight(QFont.Weight.DemiBold if level == 1 else QFont.Weight.Normal)
            cursor.insertBlock(bf, cf)
            cursor.insertText(f"{text}\t{pages.get(number, 1)}", cf)
        end_bf = QTextBlockFormat()
        end_bf.setPageBreakPolicy(QTextFormat.PageBreakFlag.PageBreak_Auto)
        cursor.insertBlock(end_bf, QTextCharFormat())
        cursor.endEditBlock()
        self.flash("Inhaltsverzeichnis eingefügt – nach Änderungen „Verzeichnis aktualisieren“.")

    def update_toc(self):
        doc = self.editor.document()
        block = doc.begin()
        first = last = None
        while block.isValid():
            if block.blockFormat().property(STYLE_KEY) == "toc":
                first = first if first is not None else block.position()
                last = block.position() + block.length() - 1
            block = block.next()
        if first is None:
            self.insert_toc()
            return
        cursor = QTextCursor(doc)
        cursor.beginEditBlock()
        cursor.setPosition(first)
        cursor.setPosition(min(last + 1, doc.characterCount() - 1), QTextCursor.MoveMode.KeepAnchor)
        cursor.removeSelectedText()
        cursor.endEditBlock()
        self.insert_toc(cursor)

