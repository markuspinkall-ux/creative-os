    def open_document(self, path, ask=True):
        if ask and not self.can_discard():
            return False
        path = Path(path)
        suffix = path.suffix.lower()
        doc = self.editor.document()
        page = default_page()
        try:
            if suffix == ".docx":
                page.update(writer_docx.import_docx(path, doc))
                page = page_from(page)
            elif suffix in (".html", ".htm"):
                content = path.read_text(encoding="utf-8-sig")
                doc.setHtml(content)
                page = page_from(meta_from_html(content))
            elif suffix == ".md":
                doc.setMarkdown(path.read_text(encoding="utf-8-sig"))
            elif suffix in (".txt", ""):
                doc.setPlainText(path.read_text(encoding="utf-8-sig", errors="replace"))
            elif suffix == ".odt":
                raise ValueError("OpenDocument-Dateien kann Creative Writer exportieren, aber noch nicht öffnen.")
            else:
                raise ValueError("Dieses Dateiformat kann Creative Writer nicht öffnen.")
        except Exception as error:
            self.error(f"„{path.name}“ konnte nicht geöffnet werden:\n{error}")
            return False
        self.page = page
        self.apply_page()
        self.path = path if suffix in (".docx", ".html", ".htm") else None
        if self.path is None:
            self.import_name = path.stem
        self.add_recent(path)
        doc.clearUndoRedoStacks()
        doc.setModified(False)
        self.editor.moveCursor(QTextCursor.MoveOperation.Start)
        self.update_title()
        self.update_pages()
        self.update_navigation()
        self.hide_backstage()
        return True

    def save(self):
        if self.path is None or self.path.suffix.lower() not in (".docx", ".html", ".htm"):
            return self.save_as()
        return self.save_document(self.path)

    def save_as(self):
        name = (self.path.stem if self.path else getattr(self, "import_name", "Dokument"))
        start = (self.path.parent if self.path else Path.home() / "Dokumente")
        if writer_docx.AVAILABLE:
            filters = "Word-Dokument (*.docx);;Webseite (*.html)"
            default = start / (name + ".docx")
        else:
            filters = "Webseite (*.html)"
            default = start / (name + ".html")
        filename, chosen = QFileDialog.getSaveFileName(self, "Speichern unter", str(default), filters)
        if not filename:
            return False
        path = Path(filename)
        if path.suffix.lower() not in (".docx", ".html", ".htm"):
            path = path.with_name(path.name + (".docx" if "docx" in (chosen or "") else ".html"))
            if path.exists() and not self.confirm_overwrite(path):
                return False
        return self.save_document(path)

    def confirm_overwrite(self, path):
        return QMessageBox.question(self, "Datei ersetzen?", f"„{path.name}“ ist bereits vorhanden. Ersetzen?") \
            == QMessageBox.StandardButton.Yes

    def save_document(self, path):
        try:
            self.write_file(path, path.suffix.lower().lstrip("."))
        except Exception as error:
            self.error(f"Speichern fehlgeschlagen:\n{error}")
            return False
        self.path = path
        self.add_recent(path)
        self.editor.document().setModified(False)
        self.remove_backup()
        self.update_title()
        self.flash(f"Gespeichert: {path.name}")
        return True

    def write_file(self, path, kind):
        doc = self.editor.document()
        title = path.stem
        if kind == "docx":
            tmp = path.with_name(f".{path.name}.teil")
            writer_docx.export_docx(doc, tmp, self.page, title)
            tmp.replace(path)
        elif kind in ("html", "htm"):
            save_bytes(path, html_with_meta(doc.toHtml(), self.page).encode("utf-8"))
        elif kind == "odt":
            tmp = path.with_name(f".{path.name}.teil")
            writer = QTextDocumentWriter(str(tmp), QByteArray(b"odf"))
            if not writer.write(doc):
                raise OSError("OpenDocument-Datei konnte nicht geschrieben werden.")
            tmp.replace(path)
        elif kind == "md":
            save_bytes(path, doc.toMarkdown().encode("utf-8"))
        elif kind == "txt":
            save_bytes(path, doc.toPlainText().encode("utf-8"))
        elif kind == "pdf":
            export_pdf(doc, self.page, path, title)
        else:
            raise ValueError(kind)

    def export_as(self, kind):
        if kind == "docx" and not writer_docx.AVAILABLE:
            self.error("Für Word-Dateien fehlt python3-docx.")
            return
        names = {"docx": "Word-Dokument (*.docx)", "odt": "OpenDocument-Text (*.odt)", "html": "Webseite (*.html)",
                 "md": "Markdown (*.md)", "txt": "Text (*.txt)", "pdf": "PDF (*.pdf)"}
        name = self.path.stem if self.path else "Dokument"
        start = self.path.parent if self.path else Path.home() / "Dokumente"
        filename, _ = QFileDialog.getSaveFileName(self, "Exportieren", str(start / f"{name}.{kind}"), names[kind])
        if not filename:
            return
        path = Path(filename)
        if path.suffix.lower() != "." + kind:
            path = path.with_name(path.name + "." + kind)
            if path.exists() and not self.confirm_overwrite(path):
                return
        try:
            self.write_file(path, kind)
        except Exception as error:
            self.error(f"Export fehlgeschlagen:\n{error}")
            return
        self.flash(f"Exportiert: {path.name}")
        self.hide_backstage()

    def pdf_dialog(self):
        self.export_as("pdf")

