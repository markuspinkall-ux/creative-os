        self.sp_right = self.spin(" cm", 0, 15, 0.1)
        self.sp_before = self.spin(" pt", 0, 96, 1, decimals=0)
        self.sp_after = self.spin(" pt", 0, 96, 1, decimals=0)
        for i, (label, spin) in enumerate((("Einzug links", self.sp_left), ("Einzug rechts", self.sp_right))):
