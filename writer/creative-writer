def demo(window):
    """Beispieldokument (für Bildschirmfotos: --beispiel)."""
    window.new_from_template("bericht")
    ed = window.editor
    cursor = ed.textCursor()
    cursor.movePosition(QTextCursor.MoveOperation.End)
    ed.setTextCursor(cursor)
    window.apply_style_key("h2")
    ed.textCursor().insertText("Zahlen im Überblick")
    c = ed.textCursor()
    c.insertBlock()
    ed.setTextCursor(c)
    window.apply_style_key("standard")
    window.insert_table(3, 3)
    t = ed.textCursor().currentTable()
    for r, row in enumerate((("Quartal", "Umsatz", "Plus"), ("Q1", "12.400 €", "+8 %"), ("Q2", "15.100 €", "+22 %"))):
        for col, text in enumerate(row):
            cell = t.cellAt(r, col).firstCursorPosition()
            fmt = QTextCharFormat()
            if r == 0:
                fmt.setFontWeight(QFont.Weight.Bold)
            cell.insertText(text, fmt)
    ed.moveCursor(QTextCursor.MoveOperation.Start)
    ed.document().setModified(False)
    window.a_nav.setChecked(True)
    window.toggle_nav(True)
    window.update_pages()


def selftest(window):
    import tempfile
    demo(window)
    tmp = Path(tempfile.mkdtemp(prefix="writer-test-"))
    window.apply_style_key("h1")
    window.insert_toc()
    window.update_toc()
    for kind in ("html", "odt", "md", "txt", "pdf") + (("docx",) if writer_docx.AVAILABLE else ()):
        path = tmp / f"test.{kind}"
        window.write_file(path, kind)
        assert path.stat().st_size > 0, kind
    if writer_docx.AVAILABLE:
        assert window.open_document(tmp / "test.docx", ask=False)
        assert "Einleitung" in window.editor.toPlainText(), "docx-Rückweg"
    assert window.open_document(tmp / "test.html", ask=False)
    print(f"Selbsttest ok ({'mit' if writer_docx.AVAILABLE else 'ohne'} Word, "
          f"Rechtschreibung {'ja' if window.speller.available else 'nein'})")


def main():
    arguments = sys.argv[1:]
    app = QApplication(sys.argv[:1])
    app.setApplicationName(APP)
    app.setOrganizationName("CreativeOS")
    app.setDesktopFileName("creative-writer")
    app.setWindowIcon(QIcon.fromTheme("creative-writer"))
    app.setStyle("Fusion")
    palette = app.palette()
    for role, key in ((QPalette.ColorRole.Window, "ground"), (QPalette.ColorRole.WindowText, "text"),
                      (QPalette.ColorRole.Base, "surface"), (QPalette.ColorRole.AlternateBase, "raised"),
                      (QPalette.ColorRole.Text, "text"), (QPalette.ColorRole.Button, "raised"),
                      (QPalette.ColorRole.ButtonText, "text"), (QPalette.ColorRole.Highlight, "accent"),
                      (QPalette.ColorRole.HighlightedText, "accentText"), (QPalette.ColorRole.ToolTipBase, "raised"),
                      (QPalette.ColorRole.ToolTipText, "text"), (QPalette.ColorRole.PlaceholderText, "dim")):
        palette.setColor(role, QColor(C[key]))
    app.setPalette(palette)
    window = Writer()
    if arguments == ["--selftest"]:
        selftest(window)
        return 0
    if arguments == ["--beispiel"]:
        demo(window)
    elif arguments:
        window.open_document(Path(arguments[0]), ask=False)
    window.show()
    if not arguments:
        QTimer.singleShot(300, window.offer_recovery)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
