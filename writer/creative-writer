    # ---- Datei-Bereich (Backstage) -------------------------------------------------------
    def build_backstage(self):
        w = QWidget()
        w.setObjectName("backstage")
        h = QHBoxLayout(w)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(0)
        side = QWidget()
        side.setObjectName("backSide")
        side.setFixedWidth(220)
        sv = QVBoxLayout(side)
        sv.setContentsMargins(10, 14, 10, 14)
        sv.setSpacing(2)
        back = QPushButton("  Zurück")
        back.setIcon(self.ic("back"))
        back.setObjectName("backItem")
        back.clicked.connect(self.hide_backstage)
        sv.addWidget(back)
        sv.addSpacing(10)
        self.back_stack = QStackedWidget()
        self.back_pages = {}
        self.back_buttons = {}
        for key, label, icon_name in (("info", "Start", "info"), ("new", "Neu", "new"), ("open", "Öffnen", "open")):
            self.add_back_item(sv, key, label, icon_name)
        sv.addSpacing(8)
        for label, icon_name, slot in (("Speichern", "save", self.save), ("Speichern unter", "saveas", self.save_as)):
            b = QPushButton("  " + label)
            b.setIcon(self.ic(icon_name))
            b.setObjectName("backItem")
            b.clicked.connect(lambda _=False, s=slot: (s(), self.hide_backstage()))
            sv.addWidget(b)
        for key, label, icon_name in (("export", "Exportieren", "export"), ("print", "Drucken", "print")):
            self.add_back_item(sv, key, label, icon_name)
        sv.addStretch(1)
        close = QPushButton("  Schließen")
        close.setIcon(self.ic("close"))
        close.setObjectName("backItem")
        close.clicked.connect(self.close)
        sv.addWidget(close)
        h.addWidget(side)
        h.addWidget(self.back_stack, 1)
        self.back_pages["info"] = self.back_info()
        self.back_pages["new"] = self.back_new()
        self.back_pages["open"] = self.back_open()
        self.back_pages["export"] = self.back_export()
        self.back_pages["print"] = self.back_print()
        for key, page in self.back_pages.items():
            self.back_stack.addWidget(page)
        return w

    def add_back_item(self, layout, key, label, icon_name):
        b = QPushButton("  " + label)
        b.setIcon(self.ic(icon_name))
        b.setObjectName("backItem")
        b.setCheckable(True)
        b.clicked.connect(lambda: self.show_backstage(key))
        layout.addWidget(b)
        self.back_buttons[key] = b

