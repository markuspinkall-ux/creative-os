class Group(QWidget):
    def __init__(self, title):
        super().__init__()
        outer = QVBoxLayout(self)
        outer.setContentsMargins(6, 4, 6, 2)
        outer.setSpacing(2)
        self.body = QHBoxLayout()
        self.body.setSpacing(2)
        outer.addLayout(self.body, 1)
        label = QLabel(title)
        label.setObjectName("groupLabel")
        label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        outer.addWidget(label)

    def add(self, widget):
        self.body.addWidget(widget)
        return widget

    def column(self, *rows):
        """Mehrere Zeilen kleiner Knöpfe übereinander (wie Word)."""
        box = QVBoxLayout()
        box.setSpacing(2)
        for row in rows:
            line = QHBoxLayout()
            line.setSpacing(1)
            for w in row:
                line.addWidget(w)
            line.addStretch(1)
            box.addLayout(line)
        box.addStretch(1)
        self.body.addLayout(box)


def vline():
    line = QFrame()
    line.setObjectName("groupLine")
    line.setFixedWidth(1)
    return line


class Ribbon(QWidget):
    fileRequested = Signal()

    def __init__(self):
        super().__init__()
        self.setObjectName("ribbon")
        v = QVBoxLayout(self)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(0)
        self.tabs_row = QHBoxLayout()
        self.tabs_row.setContentsMargins(10, 4, 10, 0)
        self.tabs_row.setSpacing(2)
        v.addLayout(self.tabs_row)
        self.stack = QStackedWidget()
        self.stack.setObjectName("ribbonBody")
        self.stack.setFixedHeight(104)
        v.addWidget(self.stack)
        self.buttons = []
        file_tab = QToolButton(text="Datei")
        file_tab.setObjectName("fileTab")
        file_tab.clicked.connect(self.fileRequested)
        self.tabs_row.addWidget(file_tab)
        self.tail = QHBoxLayout()
        self.collapsed = False

    def add_tab(self, name):
        page = QWidget()
        h = QHBoxLayout(page)
        h.setContentsMargins(8, 2, 8, 2)
        h.setSpacing(0)
        index = self.stack.addWidget(page)
        tab = QToolButton(text=name, checkable=True)
        tab.setObjectName("ribbonTab")
        tab.clicked.connect(lambda: self.show_tab(index))
        self.tabs_row.addWidget(tab)
        self.buttons.append(tab)
        if index == 0:
            tab.setChecked(True)
        page.groups = h
        return page

    def finish(self):
        self.tabs_row.addStretch(1)
        self.tabs_row.addLayout(self.tail)
        for i in range(self.stack.count()):
            self.stack.widget(i).groups.addStretch(1)

    def show_tab(self, index):
        if self.collapsed:
            self.stack.setVisible(True)
            self.collapsed = False
        self.stack.setCurrentIndex(index)
        for i, b in enumerate(self.buttons):
            b.setChecked(i == index)

    def toggle_collapsed(self):
        self.collapsed = not self.collapsed
        self.stack.setVisible(not self.collapsed)

    @staticmethod
    def add_group(page, group):
        if page.groups.count():
            page.groups.addWidget(vline())
        page.groups.addWidget(group)
        return group


