    # ---- Seite, Zoom, Ansicht -----------------------------------------------------------
    def content_width(self):
        top, right, bottom, left = self.page["margins_mm"]
        return (self.page["width_mm"] - left - right) * MM

    def apply_page(self):
        top, right, bottom, left = (v * MM for v in self.page["margins_mm"])
        doc = self.editor.document()
        root = doc.rootFrame()
        ff = root.frameFormat()
        ff.setTopMargin(top)
        ff.setBottomMargin(bottom)
        ff.setLeftMargin(left)
        ff.setRightMargin(right)
        root.setFrameFormat(ff)
        paper = self.editor.palette()
        paper.setColor(QPalette.ColorRole.Base, QColor(self.page.get("color", "#ffffff")))
        self.editor.setPalette(paper)
        self.shadow.setBrush(QColor(self.page.get("color", "#ffffff")))
        self.relayout()
        self.schedule_pages()

    def relayout(self):
        if self.print_layout:
            width = self.page["width_mm"] * MM
            min_h = self.page["height_mm"] * MM
        else:
            width = max(400, self.view.viewport().width() / (self.zoom / 100) - 40)
            min_h = self.view.viewport().height() / (self.zoom / 100) - 40
        doc = self.editor.document()
        if abs(self.editor.width() - width) > 0.5:
            self.editor.setFixedWidth(int(width))
        height = max(min_h, doc.size().height() + 2)
        if abs(self.editor.height() - height) > 0.5:
            self.editor.setFixedHeight(int(height))
        self.proxy.setPos(0, 0)
        self.shadow.setRect(QRectF(0, 0, self.editor.width(), self.editor.height()))
        gap = 28
        self.scene.setSceneRect(QRectF(-gap, -gap, self.editor.width() + 2 * gap, self.editor.height() + 2 * gap))

    def set_zoom(self, value):
        value = max(25, min(300, int(value)))
        self.zoom = value
        self.view.setTransform(QTransform.fromScale(value / 100, value / 100))
        if self.zoom_slider.value() != value:
            self.zoom_slider.blockSignals(True)
            self.zoom_slider.setValue(value)
            self.zoom_slider.blockSignals(False)
        self.zoom_label.setText(f"{value} %")
        if not self.print_layout:
            self.relayout()
        self.ensure_cursor_visible()

    def fit_width(self):
        width = self.view.viewport().width() - 60
        self.set_zoom(int(width / (self.page["width_mm"] * MM) * 100))

    def zoom_dialog(self):
        value, ok = QInputDialog.getInt(self, "Zoom", "Zoomfaktor in Prozent", self.zoom, 25, 300, 10)
        if ok:
            self.set_zoom(value)

    def set_layout(self, print_layout):
        self.print_layout = print_layout
        self.a_print_layout.setChecked(print_layout)
        self.a_web_layout.setChecked(not print_layout)
        self.shadow.setVisible(True)
        self.relayout()
        self.update_pages()

    def toggle_focus(self):
        focus = self.ribbon.isVisible() and self.pages.currentIndex() == 0
        self.ribbon.setVisible(not focus)
        self.centralWidget().findChild(QWidget, "titleBar").setVisible(not focus)
        self.centralWidget().findChild(QWidget, "statusBar").setVisible(not focus)
        if focus:
            self.showFullScreen()
        else:
            self.showNormal()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key.Key_Escape:
            if self.isFullScreen():
                self.toggle_focus()
                return
            if self.pages.currentIndex() == 1:
                self.hide_backstage()
                return
            if self.painter_format:
                self.a_painter.setChecked(False)
                self.painter_format = None
                return
        super().keyPressEvent(event)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        if not self.print_layout:
            QTimer.singleShot(0, self.relayout)

    def focus_editor(self):
        self.view.setFocus()
        self.scene.setFocusItem(self.proxy)
        self.editor.setFocus()

    def cursor_moved(self):
        self.update_format_controls()
        self.update_status()
        self.ensure_cursor_visible()

    def ensure_cursor_visible(self):
        rect = QRectF(self.editor.cursorRect())
        scene_rect = self.proxy.mapRectToScene(rect)
        self.view.ensureVisible(scene_rect, 30, 60)

    def schedule_pages(self):
        self.page_timer.start()
        self.nav_timer.start()

    def update_pages(self):
        doc = self.editor.document()
        try:
            starts, count = page_breaks(doc, self.page)
        except Exception:
            starts, count = [], 1
        layout = doc.documentLayout()
        breaks = []
        if self.print_layout:
            for n, number in enumerate(starts, start=2):
                block = doc.findBlockByNumber(number)
                if block.isValid():
                    y = layout.blockBoundingRect(block).top()
                    breaks.append((y - 4, n))
        self.editor.breaks = breaks
        title = self.path.stem if self.path else "Dokument"
        self.editor.header_text = fill_placeholders(self.page.get("header", ""), 1, count, title) if self.print_layout else ""
        footer = fill_placeholders(self.page.get("footer", ""), count, count, title)
        if self.page.get("numbers"):
            number = f"Seite {count} von {count}" if self.page["numbers"].endswith("von") else str(count)
            footer = f"{footer}      {number}" if footer else number
        self.editor.footer_text = footer if self.print_layout else ""
        self.page_count = count
        self.editor.viewport().update()
        self.update_status()

    # ---- Titel, Status ------------------------------------------------------------------
    def update_title(self):
        name = self.path.name if self.path else "Dokument1"
        self.title_label.setText(f"{name}{' •' if self.editor.document().isModified() else ''}  –  {APP}")
        self.setWindowTitle(f"{name}[*] – {APP}")

    def update_status(self):
        cursor = self.editor.textCursor()
        doc = self.editor.document()
        count = getattr(self, "page_count", 1)
        current = 1
        y = doc.documentLayout().blockBoundingRect(cursor.block()).top()
        for by, n in self.editor.breaks:
            if y >= by:
                current = n
        self.st_page.setText(f"Seite {current} von {count}")
        if cursor.hasSelection():
            sel = cursor.selectedText()
            words = len(WORD_RE.findall(sel))
            self.st_words.setText(f"{words} von {self.total_words()} Wörtern")
        else:
            self.st_words.setText(f"{self.total_words()} Wörter")
        self.st_spell.setText(("Rechtschreibung: an" if self.speller.enabled else "")
                              if self.speller.available else "")

    def total_words(self):
        return len(WORD_RE.findall(self.editor.toPlainText()))

    def update_info(self):
        name = self.path.name if self.path else "noch nicht gespeichert"
        text = self.editor.toPlainText()
        self.info_label.setText(
            f"Dokument: {name}   ·   {getattr(self, 'page_count', 1)} Seite(n)   ·   {self.total_words()} Wörter   ·   "
            f"{len(text)} Zeichen   ·   Format {self.page_name()}")

    def page_name(self):
        w, h = self.page["width_mm"], self.page["height_mm"]
        for name, (pw, ph) in PAGE_SIZES.items():
            if {round(w), round(h)} == {round(pw), round(ph)}:
                return name + (" quer" if w > h else "")
        return f"{w:g} × {h:g} mm"

    # ---- Formatieren --------------------------------------------------------------------
    def apply_text(self, **properties):
        fmt = QTextCharFormat()
        for name, value in properties.items():
            getattr(fmt, "set" + name[0].upper() + name[1:])(value)
        self.editor.mergeCurrentCharFormat(fmt)
        self.focus_editor()

    def apply_size(self):
        try:
            size = float(self.size.currentText().replace(",", "."))
        except ValueError:
            size = 0
        if 1 <= size <= 400:
            self.apply_text(fontPointSize=size)
        else:
            self.update_format_controls()

    def step_size(self, direction):
        sizes = [8, 9, 10, 10.5, 11, 12, 14, 16, 18, 20, 22, 24, 26, 28, 36, 48, 72]
        current = self.current_font().pointSizeF()
        if direction > 0:
            nxt = next((s for s in sizes if s > current + 0.01), current + 10)
        else:
            nxt = next((s for s in reversed(sizes) if s < current - 0.01), max(1, current - 1))
        self.apply_text(fontPointSize=nxt)

    def set_valign(self, on, align):
        self.apply_text(verticalAlignment=align if on else QTextCharFormat.VerticalAlignment.AlignNormal)

    def current_font(self):
        return self.editor.currentCharFormat().font().resolve(self.editor.document().defaultFont())

    def update_format_controls(self, fmt=None):
        fmt = fmt if isinstance(fmt, QTextCharFormat) else self.editor.currentCharFormat()
        font = fmt.font().resolve(self.editor.document().defaultFont())
        for widget in (self.family, self.size):
            widget.blockSignals(True)
        self.family.setCurrentFont(font)
        self.size.setCurrentText(f"{font.pointSizeF():g}".replace(".", ","))
        for widget in (self.family, self.size):
            widget.blockSignals(False)
        self.bold.setChecked(font.bold())
        self.italic.setChecked(font.italic())
        self.underline.setChecked(font.underline())
        self.strike.setChecked(font.strikeOut())
        va = fmt.verticalAlignment()
        self.sub.setChecked(va == QTextCharFormat.VerticalAlignment.AlignSubScript)
        self.sup.setChecked(va == QTextCharFormat.VerticalAlignment.AlignSuperScript)
        align = self.editor.alignment()
        for flag, action in self.align_actions.items():
            action.setChecked(bool(align & flag) if flag != Qt.AlignmentFlag.AlignLeft
                              else not (align & (Qt.AlignmentFlag.AlignHCenter | Qt.AlignmentFlag.AlignRight
                                                 | Qt.AlignmentFlag.AlignJustify)))
        bf = self.editor.textCursor().blockFormat()
        for spin, value in ((self.sp_left, bf.leftMargin() / MM / 10), (self.sp_right, bf.rightMargin() / MM / 10),
                            (self.sp_before, bf.topMargin() * 0.75), (self.sp_after, bf.bottomMargin() * 0.75)):
            spin.blockSignals(True)
            spin.setValue(value)
            spin.blockSignals(False)

    def color_menu(self, palette_list, slot, with_none):
        grid = ColorGrid(palette_list, extra=[("Keine Farbe", lambda: slot(None))] if with_none else
                         [("Weitere Farben …", lambda: slot("dialog"))])
        menu = popup_menu(self, grid)
        grid.picked.connect(lambda c: (menu.close(), slot(c)))
        return menu

    def refresh_color_icons(self):
        self.a_highlight.setIcon(icons.color_bar_icon("highlight", C["text"], self.highlight_color.name()))
        self.a_fontcolor.setIcon(icons.color_bar_icon("fontcolor", C["text"], self.font_color.name()))

    def pick_highlight(self, color):
        if color is None:
            self.remove_char_property(QTextFormat.Property.BackgroundBrush)
            return
        self.highlight_color = color
        self.refresh_color_icons()
        self.apply_text(background=color)

    def pick_fontcolor(self, color):
        if color == "dialog":
            color = QColorDialog.getColor(self.font_color, self, "Schriftfarbe")
            if not color.isValid():
                return
        self.font_color = color
        self.refresh_color_icons()
        self.apply_text(foreground=color)

    def remove_char_property(self, prop):
        cursor = self.editor.textCursor()
        if not cursor.hasSelection():
            return
        start, end = cursor.selectionStart(), cursor.selectionEnd()
        cursor.beginEditBlock()
        pos = start
        while pos < end:
            c = QTextCursor(self.editor.document())
            c.setPosition(pos)
            c.setPosition(pos + 1, QTextCursor.MoveMode.KeepAnchor)
            fmt = c.charFormat()
            fmt.clearProperty(prop)
            c.setCharFormat(fmt)
            pos += 1
        cursor.endEditBlock()

    def clear_format(self):
        cursor = self.editor.textCursor()
        if not cursor.hasSelection():
            cursor.select(QTextCursor.SelectionType.BlockUnderCursor)
        cursor.setCharFormat(QTextCharFormat())
        self.focus_editor()

    def change_case(self, mode):
        cursor = self.editor.textCursor()
        if not cursor.hasSelection():
            cursor.select(QTextCursor.SelectionType.WordUnderCursor)
        text = cursor.selectedText()
        if mode == "klein":
            new = text.lower()
        elif mode == "gross":
            new = text.upper()
        elif mode == "wort":
            new = re.sub(r"\b(\w)(\w*)", lambda m: m.group(1).upper() + m.group(2).lower(), text)
        elif mode == "umkehren":
            new = text.swapcase()
        else:
            new = text[:1].upper() + text[1:].lower()
        start = cursor.selectionStart()
        fmt = cursor.charFormat()
        cursor.insertText(new, fmt)
        cursor.setPosition(start)
        cursor.setPosition(start + len(new), QTextCursor.MoveMode.KeepAnchor)
        self.editor.setTextCursor(cursor)

    def format_painter(self, on):
        if on:
            self.painter_format = (self.editor.currentCharFormat(), self.editor.textCursor().blockFormat())
            self.editor.viewport().setCursor(Qt.CursorShape.CrossCursor)
        else:
            self.painter_format = None
            self.editor.viewport().setCursor(Qt.CursorShape.IBeamCursor)

    def eventFilter(self, obj, event):
        if event.type() == QEvent.Type.MouseButtonRelease and self.painter_format and obj is self.editor.viewport():
            cursor = self.editor.textCursor()
            if cursor.hasSelection():
                char, block = self.painter_format
                cursor.beginEditBlock()
                cursor.setCharFormat(char)
                cursor.endEditBlock()
                self.painter_format = None
                self.a_painter.setChecked(False)
                self.editor.viewport().setCursor(Qt.CursorShape.IBeamCursor)
        return super().eventFilter(obj, event)

    def set_alignment(self, flag):
        self.editor.setAlignment(flag)
        self.focus_editor()

    def set_list(self, style):
        cursor = self.editor.textCursor()
        lst = cursor.currentList()
        if lst:
            fmt = lst.format()
            fmt.setStyle(style)
            lst.setFormat(fmt)
        else:
            cursor.createList(style)
        self.focus_editor()

    def toggle_list(self, style):
        cursor = self.editor.textCursor()
        current = cursor.currentList()
        bullets = (QTextListFormat.Style.ListDisc, QTextListFormat.Style.ListCircle, QTextListFormat.Style.ListSquare)
        same_kind = current and ((current.format().style() in bullets) == (style in bullets))
        if same_kind:
            doc = self.editor.document()
            first, last = cursor.selectionStart(), cursor.selectionEnd()
            block = doc.findBlock(first)
            cursor.beginEditBlock()
            while block.isValid():
                lst = block.textList()
                if lst:
                    lst.remove(block)
                    bc = QTextCursor(block)
                    bf = bc.blockFormat()
                    bf.setIndent(0)
                    bc.setBlockFormat(bf)
                if block.position() + block.length() > last:
                    break
                block = block.next()
            cursor.endEditBlock()
        elif current:
            self.set_list(style)
        else:
            cursor.createList(style)
        self.focus_editor()

    def change_indent(self, delta):
        cursor = self.editor.textCursor()
        lst = cursor.currentList()
        if lst:
            fmt = QTextListFormat(lst.format())
            fmt.setIndent(max(1, fmt.indent() + delta))
            cursor.createList(fmt)
        else:
            bf = cursor.blockFormat()
            bf.setLeftMargin(max(0, bf.leftMargin() + delta * 1.25 * 10 * MM))
            cursor.setBlockFormat(bf)
        self.focus_editor()

    def set_line_spacing(self, value):
        cursor = self.editor.textCursor()
        bf = QTextBlockFormat()
        bf.setLineHeight(value * 100, QTextBlockFormat.LineHeightTypes.ProportionalHeight.value)
        cursor.mergeBlockFormat(bf)
        self.focus_editor()

    def set_para_space(self, top=None, bottom=None):
        bf = QTextBlockFormat()
        if top is not None:
            bf.setTopMargin(top / 0.75)
        if bottom is not None:
            bf.setBottomMargin(bottom / 0.75)
        self.editor.textCursor().mergeBlockFormat(bf)

    def set_shading(self, color):
        cursor = self.editor.textCursor()
        bf = cursor.blockFormat()
        if color is None:
            bf.clearBackground()
            cursor.setBlockFormat(bf)
        else:
            bf.setBackground(color)
            cursor.setBlockFormat(bf)

    def apply_paragraph_spins(self):
        bf = QTextBlockFormat()
        bf.setLeftMargin(self.sp_left.value() * 10 * MM)
        bf.setRightMargin(self.sp_right.value() * 10 * MM)
        bf.setTopMargin(self.sp_before.value() / 0.75)
        bf.setBottomMargin(self.sp_after.value() / 0.75)
        self.editor.textCursor().mergeBlockFormat(bf)

    def paragraph_dialog(self):
        dlg = QDialog(self)
        dlg.setWindowTitle("Absatz")
        form = QFormLayout(dlg)
        bf = self.editor.textCursor().blockFormat()
        left = self.spin(" cm", 0, 15, 0.1)
        left.setValue(bf.leftMargin() / MM / 10)
        first = self.spin(" cm", -5, 5, 0.1)
        first.setValue(bf.textIndent() / MM / 10)
        before = self.spin(" pt", 0, 96, 1, 0)
        before.setValue(bf.topMargin() * 0.75)
        after = self.spin(" pt", 0, 96, 1, 0)
        after.setValue(bf.bottomMargin() * 0.75)
        line = self.spin("", 0.8, 4, 0.05, 2)
        line.setValue(bf.lineHeight() / 100 if bf.lineHeight() else 1.15)
        keep = QCheckBox("Absatz nicht trennen (vor Seitenumbruch)")
        for label, w in (("Einzug links", left), ("Erste Zeile", first), ("Abstand vor", before),
                         ("Abstand nach", after), ("Zeilenabstand", line)):
            form.addRow(label, w)
        form.addRow(keep)
        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        buttons.button(QDialogButtonBox.StandardButton.Cancel).setText("Abbrechen")
        buttons.accepted.connect(dlg.accept)
        buttons.rejected.connect(dlg.reject)
        form.addRow(buttons)
        if dlg.exec():
            nf = QTextBlockFormat()
            nf.setLeftMargin(left.value() * 10 * MM)
            nf.setTextIndent(first.value() * 10 * MM)
            nf.setTopMargin(before.value() / 0.75)
            nf.setBottomMargin(after.value() / 0.75)
            nf.setLineHeight(line.value() * 100, QTextBlockFormat.LineHeightTypes.ProportionalHeight.value)
            if keep.isChecked():
                nf.setNonBreakableLines(True)
            self.editor.textCursor().mergeBlockFormat(nf)

    def apply_style_key(self, key):
        _key, name, size, bold, italic, color, before, after, level, align = STYLE_BY_KEY[key]
        cursor = self.editor.textCursor()
        doc = self.editor.document()
        start, end = cursor.selectionStart(), cursor.selectionEnd()
        block = doc.findBlock(start)
        cursor.beginEditBlock()
        while block.isValid():
            bc = QTextCursor(block)
            bf = bc.blockFormat()
            bf.setHeadingLevel(level)
            bf.setProperty(STYLE_KEY, key if key in ("titel", "untertitel", "zitat") else "")
            bf.setTopMargin(before / 0.75)
            bf.setBottomMargin(after / 0.75)
            bf.setAlignment(align if align is not None else Qt.AlignmentFlag.AlignLeft)
            if key == "kein":
                bf.setLineHeight(100, QTextBlockFormat.LineHeightTypes.ProportionalHeight.value)
            else:
                bf.setLineHeight(115, QTextBlockFormat.LineHeightTypes.ProportionalHeight.value)
            if key == "zitat":
                bf.setLeftMargin(10 * MM)
                bf.setRightMargin(10 * MM)
            elif bf.leftMargin() == 10 * MM:
                bf.setLeftMargin(0)
                bf.setRightMargin(0)
            bc.setBlockFormat(bf)
            cf = QTextCharFormat()
            cf.setFontPointSize(size)
            cf.setFontWeight(QFont.Weight.Bold if bold else QFont.Weight.Normal)
            cf.setFontItalic(italic)
            cf.setForeground(QColor(color))
            sel = QTextCursor(block)
            sel.movePosition(QTextCursor.MoveOperation.EndOfBlock, QTextCursor.MoveMode.KeepAnchor)
            sel.mergeCharFormat(cf)
            bc.mergeBlockCharFormat(cf)
            if block.position() + block.length() > end:
                break
            block = block.next()
        cursor.endEditBlock()
        self.nav_timer.start()
        self.focus_editor()

    def toggle_marks(self, on):
        opt = self.editor.document().defaultTextOption()
        flags = opt.flags()
        marks = QTextOption.Flag.ShowTabsAndSpaces | QTextOption.Flag.ShowLineAndParagraphSeparators
        opt.setFlags(flags | marks if on else flags & ~marks)
        self.editor.document().setDefaultTextOption(opt)

    def paste_plain(self):
        text = QApplication.clipboard().text()
        if text:
            self.editor.textCursor().insertText(text)

    # ---- Einfügen -----------------------------------------------------------------------
    def page_break(self):
        cursor = self.editor.textCursor()
        cursor.beginEditBlock()
        cursor.removeSelectedText()
        paragraph = cursor.blockFormat()
        boundary = QTextBlockFormat(paragraph)
        boundary.setPageBreakPolicy(paragraph.pageBreakPolicy() | QTextFormat.PageBreakFlag.PageBreak_AlwaysAfter)
        cursor.setBlockFormat(boundary)
        paragraph.setPageBreakPolicy(QTextFormat.PageBreakFlag.PageBreak_Auto)
        cursor.insertBlock(paragraph)
        cursor.endEditBlock()
        self.editor.setTextCursor(cursor)
        self.schedule_pages()

    def blank_page(self):
        self.page_break()
        cursor = self.editor.textCursor()
        self.page_break()
        cursor.movePosition(QTextCursor.MoveOperation.PreviousBlock)
        self.editor.setTextCursor(cursor)

    def insert_table(self, rows, cols):
        fmt = QTextTableFormat()
        fmt.setBorder(1)
        fmt.setBorderBrush(QColor("#9aa3b5"))
        fmt.setBorderCollapse(True)
        fmt.setCellPadding(5)
        fmt.setCellSpacing(0)
        fmt.setWidth(QTextLength(QTextLength.Type.PercentageLength, 100))
        cursor = self.editor.textCursor()
        cursor.insertTable(rows, cols, fmt)
        self.editor.setTextCursor(cursor)
        self.focus_editor()

    def table_dialog(self):
        rows, ok = QInputDialog.getInt(self, "Tabelle einfügen", "Zeilen", 3, 1, 200)
        if not ok:
            return
        cols, ok = QInputDialog.getInt(self, "Tabelle einfügen", "Spalten", 3, 1, 30)
        if ok:
            self.insert_table(rows, cols)

    def table_edit(self, what):
        cursor = self.editor.textCursor()
        table = cursor.currentTable()
        if not table:
            self.flash("Der Cursor steht in keiner Tabelle.")
            return
        cell = table.cellAt(cursor)
        if what == "row":
            table.insertRows(cell.row() + 1, 1)
        elif what == "col":
            table.insertColumns(cell.column() + 1, 1)
        elif what == "delrow":
            table.removeRows(cell.row(), 1)
        elif what == "delcol":
            table.removeColumns(cell.column(), 1)

    def insert_picture(self):
        filename, _ = QFileDialog.getOpenFileName(self, "Bild einfügen", str(Path.home() / "Bilder"),
                                                  "Bilder (*.png *.jpg *.jpeg *.webp *.bmp *.gif)")
        if filename:
            reader = QImageReader(filename)
            reader.setAutoTransform(True)
            if not self.editor.insert_image(reader.read()):
                self.error("Das Bild konnte nicht geladen werden.")

