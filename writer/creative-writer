class Editor(QTextEdit):
    def __init__(self, writer):
        super().__init__()
        self.writer = writer
        self.breaks = []         # (y, Seitennummer)
        self.header_text = ""
        self.footer_text = ""
        self.setFrameShape(QFrame.Shape.NoFrame)
        self.setVerticalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.setAcceptRichText(True)
        self.setTabChangesFocus(False)

    def canInsertFromMimeData(self, source):
        return source.hasImage() or super().canInsertFromMimeData(source)

    def insertFromMimeData(self, source):
        if source.hasImage():
            image = source.imageData()
            self.insert_image(image.toImage() if isinstance(image, QPixmap) else image)
        else:
            super().insertFromMimeData(source)

    def insert_image(self, image, max_width=None):
        if image.isNull():
            return False
        max_width = max_width or self.writer.content_width()
        width = min(image.width(), int(max_width))
        if width < image.width():
            image = image.scaledToWidth(width, Qt.TransformationMode.SmoothTransformation)
        data = QByteArray()
        buffer = QBuffer(data)
        buffer.open(QIODevice.OpenModeFlag.WriteOnly)
        if not image.save(buffer, "PNG"):
            return False
        fmt = QTextImageFormat()
        fmt.setName("data:image/png;base64," + bytes(data.toBase64()).decode("ascii"))
        fmt.setWidth(image.width())
        fmt.setHeight(image.height())
        self.textCursor().insertImage(fmt)
        return True

    def wheelEvent(self, event):
        event.ignore()   # die Ansicht scrollt bzw. zoomt (Strg)

    def paintEvent(self, event):
        super().paintEvent(event)
        if not self.writer.print_layout:
            return
        p = QPainter(self.viewport())
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        pen = QPen(QColor(0, 0, 0, 40), 1, Qt.PenStyle.DashLine)
        small = QFont(self.font())
        small.setPointSizeF(7.5)
        p.setFont(small)
        w = self.viewport().width()
        for y, number in self.breaks:
            p.fillRect(QRectF(0, y - 7, w, 14), QColor(self.writer.desk_color))
            p.setPen(QPen(QColor(0, 0, 0, 30), 1))
            p.drawLine(QPointF(0, y - 7), QPointF(w, y - 7))
            p.drawLine(QPointF(0, y + 7), QPointF(w, y + 7))
            p.setPen(QColor(C["dim"]))
            p.drawText(QRectF(0, y - 7, w - 10, 14), Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter,
                       f"Seite {number}")
        p.setPen(QColor("#8a93a8"))
        top, right, bottom, left = (v * MM for v in self.writer.page["margins_mm"])
        if self.header_text:
            p.drawText(QRectF(left, top * 0.3, w - left - right, top * 0.5),
                       Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, self.header_text)
        if self.footer_text:
            h = self.viewport().height()
            p.drawText(QRectF(left, h - bottom * 0.85, w - left - right, bottom * 0.5),
                       Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, self.footer_text)
        p.end()

    def contextMenuEvent(self, event):
        menu = self.createStandardContextMenu(event.pos())
        speller = self.writer.speller
        if speller.enabled:
            cursor = self.cursorForPosition(event.pos())
            cursor.select(QTextCursor.SelectionType.WordUnderCursor)
            word = cursor.selectedText()
            if word and speller.wrong(word):
                first = menu.actions()[0] if menu.actions() else None
                suggestions = speller.suggest(word)
                for s in suggestions:
                    act = QAction(s, menu)
                    f = act.font()
                    f.setBold(True)
                    act.setFont(f)
                    act.triggered.connect(lambda _=False, c=QTextCursor(cursor), s=s: c.insertText(s))
                    menu.insertAction(first, act)
                if not suggestions:
                    none = QAction("(keine Vorschläge)", menu)
                    none.setEnabled(False)
                    menu.insertAction(first, none)
                add = QAction("Zum Wörterbuch hinzufügen", menu)
                add.triggered.connect(lambda: speller.add(word))
                menu.insertAction(first, add)
                ignore = QAction("Alle ignorieren", menu)
                ignore.triggered.connect(lambda: (speller.ignored.add(word), speller.rehighlight()))
                menu.insertAction(first, ignore)
                menu.insertSeparator(first)
        menu.exec(event.globalPos())


class PageView(QGraphicsView):
    zoomRequested = Signal(int)

    def wheelEvent(self, event):
        if event.modifiers() & Qt.KeyboardModifier.ControlModifier:
            self.zoomRequested.emit(10 if event.angleDelta().y() > 0 else -10)
            event.accept()
            return
        super().wheelEvent(event)


