    def find_next(self):
        if not self.find_term:
            return self.find_focus()
        if self.editor.find(self.find_term):
            self.ensure_cursor_visible()
            return
        previous = self.editor.textCursor()
        self.editor.moveCursor(QTextCursor.MoveOperation.Start)
        if not self.editor.find(self.find_term):
            self.editor.setTextCursor(previous)
            self.flash("Kein Treffer.")
        self.ensure_cursor_visible()

    def replace_dialog(self):
        dlg = QDialog(self)
        dlg.setWindowTitle("Suchen und Ersetzen")
        form = QFormLayout(dlg)
        find = QLineEdit(self.editor.textCursor().selectedText() or self.find_term)
        repl = QLineEdit()
        case = QCheckBox("Groß-/Kleinschreibung beachten")
        whole = QCheckBox("Nur ganzes Wort")
        form.addRow("Suchen nach", find)
        form.addRow("Ersetzen durch", repl)
        form.addRow(case)
        form.addRow(whole)
        buttons = QDialogButtonBox()
        all_btn = buttons.addButton("Alle ersetzen", QDialogButtonBox.ButtonRole.AcceptRole)
        all_btn.setDefault(True)
        buttons.addButton("Abbrechen", QDialogButtonBox.ButtonRole.RejectRole)
        buttons.accepted.connect(dlg.accept)
        buttons.rejected.connect(dlg.reject)
        form.addRow(buttons)
        if not dlg.exec() or not find.text():
            return
        flags = QTextDocument.FindFlag(0)
        if case.isChecked():
            flags |= QTextDocument.FindFlag.FindCaseSensitively
        if whole.isChecked():
            flags |= QTextDocument.FindFlag.FindWholeWords
        doc = self.editor.document()
        group = self.editor.textCursor()
        group.beginEditBlock()
        count = 0
        cursor = doc.find(find.text(), 0, flags)
        while not cursor.isNull():
            cursor.insertText(repl.text())
            count += 1
            cursor = doc.find(find.text(), cursor, flags)
        group.endEditBlock()
        self.find_term = find.text()
        self.flash(f"{count} Ersetzung(en) vorgenommen.")

