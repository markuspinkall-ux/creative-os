    def ic(self, name, accent=None):
        return icons.icon(name, C["text"], accent or C["accent"], disabled=C["dim"])

    def act(self, text, slot, icon=None, shortcut=None, checkable=False, tip=None):
        action = QAction(text, self, checkable=checkable)
        if icon:
            action.setIcon(self.ic(icon))
        if shortcut:
            action.setShortcut(shortcut)
            action.setShortcutContext(Qt.ShortcutContext.WindowShortcut)
            self.addAction(action)
        if slot:
            action.triggered.connect(slot)
        action.setToolTip((tip or text) + (f"  ({QKeySequence(shortcut).toString(QKeySequence.SequenceFormat.NativeText)})"
                                           if shortcut else ""))
        return action

    def big(self, action, menu=None, popup=False):
        b = QToolButton()
        b.setObjectName("big")
        b.setDefaultAction(action)
        b.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonTextUnderIcon)
        b.setIconSize(QSize(26, 26))
        b.setMinimumWidth(52)
        b.setSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Expanding)
        if menu:
            b.setMenu(menu)
            b.setPopupMode(QToolButton.ToolButtonPopupMode.InstantPopup if popup
                           else QToolButton.ToolButtonPopupMode.MenuButtonPopup)
        return b

    def small(self, action, text=False, menu=None, popup=False):
        b = QToolButton()
        b.setObjectName("small")
        b.setDefaultAction(action)
        b.setIconSize(QSize(17, 17))
        b.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonTextBesideIcon if text else Qt.ToolButtonStyle.ToolButtonIconOnly)
        if menu:
            b.setMenu(menu)
            b.setPopupMode(QToolButton.ToolButtonPopupMode.InstantPopup if popup
                           else QToolButton.ToolButtonPopupMode.MenuButtonPopup)
        return b

    def glyph(self, text, slot, tip, checkable=False, shortcut=None, font=None):
        action = self.act(text, slot, shortcut=shortcut, checkable=checkable, tip=tip)
        b = QToolButton()
        b.setObjectName("glyph")
        b.setDefaultAction(action)
        b.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonTextOnly)
        if font:
            b.setFont(font)
        b.setFixedSize(28, 26)
        return action, b

