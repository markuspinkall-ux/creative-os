class ColorGrid(QWidget):
    picked = Signal(QColor)

    def __init__(self, colors_list, extra=None):
        super().__init__()
        grid = QGridLayout(self)
        grid.setContentsMargins(8, 8, 8, 8)
        grid.setSpacing(4)
        for i, color in enumerate(colors_list):
            b = QToolButton()
            b.setFixedSize(22, 22)
            b.setStyleSheet(f"QToolButton{{background:{color};border:1px solid rgba(128,128,128,0.45);border-radius:5px}}"
                            f"QToolButton:hover{{border:2px solid {C['accent']}}}")
            b.clicked.connect(lambda _=False, c=color: self.picked.emit(QColor(c)))
            grid.addWidget(b, i // 8, i % 8)
        row = (len(colors_list) + 7) // 8
        if extra:
            for j, (label, slot) in enumerate(extra):
                btn = QPushButton(label)
                btn.setObjectName("flat")
                btn.clicked.connect(slot)
                grid.addWidget(btn, row + j, 0, 1, 8)


class TableGrid(QWidget):
    picked = Signal(int, int)

    def __init__(self):
        super().__init__()
        self.rows, self.cols = 0, 0
        self.setMouseTracking(True)
        self.setFixedSize(10 * 20 + 16, 8 * 20 + 40)

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setPen(QColor(C["text"]))
        p.drawText(QRectF(8, 4, self.width() - 16, 22), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                   f"Tabelle {self.cols} × {self.rows}" if self.rows else "Tabelle einfügen")
        for r in range(8):
            for c in range(10):
                rect = QRectF(8 + c * 20, 30 + r * 20, 17, 17)
                on = r < self.rows and c < self.cols
                p.setPen(QPen(QColor(C["accent"] if on else C["track"]), 1))
                p.setBrush(QColor(C["select"]) if on else Qt.BrushStyle.NoBrush)
                p.drawRoundedRect(rect, 3, 3)

    def mouseMoveEvent(self, event):
        x, y = event.position().x() - 8, event.position().y() - 30
        self.cols = max(0, min(10, int(x // 20) + 1)) if x >= 0 else 0
        self.rows = max(0, min(8, int(y // 20) + 1)) if y >= 0 else 0
        self.update()

    def mouseReleaseEvent(self, event):
        if self.rows and self.cols:
            self.picked.emit(self.rows, self.cols)


def popup_menu(parent, widget):
    menu = QMenu(parent)
    act = QWidgetAction(menu)
    act.setDefaultWidget(widget)
    menu.addAction(act)
    return menu


class StyleTile(QToolButton):
    def __init__(self, style, on_click):
        super().__init__()
        key, name, size, bold, italic, color, *_ = style
        self.setObjectName("styleTile")
        self.setFixedSize(84, 62)
        self.setToolTip(name)
        self.clicked.connect(lambda: on_click(key))
        self.style_data = (name, size, bold, italic, color)

    def paintEvent(self, event):
        super().paintEvent(event)
        name, size, bold, italic, color = self.style_data
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor("#ffffff"))
        p.drawRoundedRect(QRectF(5, 5, self.width() - 10, 32), 4, 4)
        f = QFont(default_family())
        f.setPointSizeF(min(15, max(9, size * 0.75)))
        f.setBold(bold)
        f.setItalic(italic)
        p.setFont(f)
        p.setPen(QColor(color if color != "#ffffff" else INK))
        p.drawText(QRectF(8, 5, self.width() - 16, 32), Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, "AaBbCc")
        f2 = QFont(self.font())
        f2.setPointSizeF(8)
        p.setFont(f2)
        p.setPen(QColor(C["muted"]))
        p.drawText(QRectF(4, 39, self.width() - 8, 18), Qt.AlignmentFlag.AlignCenter, name)
        p.end()


