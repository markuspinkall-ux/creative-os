    def add_recent(self, path):
        items = [str(path)] + [p for p in self.recent() if p != str(path)]
        self.settings.setValue("recent", items[:15])

    def recent(self):
        value = self.settings.value("recent", [])
        if isinstance(value, str):
            value = [value]
        return [p for p in (value or []) if p]

    def refresh_recent(self):
        for lst in (self.recent_list, self.recent_list_info):
            lst.clear()
            for p in self.recent():
                path = Path(p)
                item = QListWidgetItem(icons.icon("word" if path.suffix == ".docx" else "page", C["muted"]),
                                       f"{path.name}\n{path.parent}")
                item.setData(Qt.ItemDataRole.UserRole, p)
                if not path.exists():
                    item.setFlags(Qt.ItemFlag.NoItemFlags)
                lst.addItem(item)
            if not lst.count():
                item = QListWidgetItem("Noch keine Dokumente geöffnet.")
                item.setFlags(Qt.ItemFlag.NoItemFlags)
                lst.addItem(item)

    def open_recent_item(self, item):
        p = item.data(Qt.ItemDataRole.UserRole)
        if p and Path(p).exists():
            self.open_document(Path(p))

    def backup_dir(self):
        base = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "creative-writer" / "wiederherstellung"
        return base

    def backup(self):
        doc = self.editor.document()
        if not doc.isModified() or doc.isEmpty():
            return
        folder = self.backup_dir()
        try:
            folder.mkdir(parents=True, exist_ok=True)
            name = (self.path.stem if self.path else "Dokument1") + f"-{os.getpid()}.html"
            meta = dict(self.page, original=str(self.path) if self.path else "")
            save_bytes(folder / name, html_with_meta(doc.toHtml(), meta).encode("utf-8"))
            self.backup_file = folder / name
        except OSError:
            pass

    def remove_backup(self):
        f = getattr(self, "backup_file", None)
        if f:
            try:
                f.unlink()
            except OSError:
                pass
            self.backup_file = None

    def offer_recovery(self):
        folder = self.backup_dir()
        if not folder.is_dir():
            return
        files = sorted(folder.glob("*.html"), key=lambda p: p.stat().st_mtime, reverse=True)
        def running(f):
            pid = f.stem.rsplit("-", 1)[-1]
            return pid.isdigit() and Path(f"/proc/{pid}").exists()
        files = [f for f in files if not running(f)]
        if not files:
            return
        newest = files[0]
        when = time.strftime("%d.%m. %H:%M", time.localtime(newest.stat().st_mtime))
        reply = QMessageBox.question(
            self, "Dokument wiederherstellen?",
            f"Creative Writer wurde nicht richtig beendet. Es gibt eine automatische Sicherung "
            f"von {when} („{newest.name.rsplit('-', 1)[0]}“). Wiederherstellen?")
        if reply == QMessageBox.StandardButton.Yes:
            content = newest.read_text(encoding="utf-8")
            meta = meta_from_html(content)
            self.editor.document().setHtml(content)
            self.page = page_from(meta)
            self.apply_page()
            original = meta.get("original")
            self.path = Path(original) if original else None
            self.editor.document().setModified(True)
            self.update_title()
            self.update_pages()
        for f in files:
            try:
                f.unlink()
            except OSError:
                pass

    def closeEvent(self, event):
        if self.can_discard():
            self.remove_backup()
            event.accept()
        else:
            event.ignore()


