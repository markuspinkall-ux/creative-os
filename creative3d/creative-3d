        self.generate.setToolTip("" if is_ready else "Zuerst rechts die KI einrichten")
        self.setup_button.setEnabled(not busy)
        for b in self.export_buttons + [self.folder_button]:
            b.setEnabled(bool(self.result) and not busy)
        can_rig = bool(self.result and "npz" in self.result.get("files", {})) and not busy
        self.rig_button.setVisible(self.skeleton.currentData() == "human")
        self.rig_button.setEnabled(can_rig)
        self.export_buttons[0].setText("GLB mit Skelett …" if self.rigged else "GLB …")
        self.rotate.setEnabled(bool(self.result))

    def js(self, code):
        if self.view is not None and not self.web_failed:
            self.view.page().runJavaScript(code)

    # ---- Vorschau: Web (WebGL) oder Ausweich-Vorschau -------------------------------
    def web_loaded(self, ok):
        if not ok:
            self.use_soft("Die Vorschau-Seite ließ sich nicht laden.")
            return
        # model-viewer muss sich innerhalb weniger Sekunden melden, sonst Ausweich-Vorschau
        QTimer.singleShot(15000, lambda: None if self.web_ok else self.use_soft("Die 3D-Vorschau hat nicht geantwortet."))

    def web_message(self, text):
        if text.startswith("ready webgl"):
            self.web_ok = True
            renderer = text[len("ready webgl"):].strip()
            if renderer:
                print(f"Creative 3D: 3D-Vorschau läuft ({renderer})", file=sys.stderr)
        elif text.startswith("nowebgl"):
            self.use_soft("Die Grafikkarte steht der eingebauten Browser-Engine nicht zur Verfügung (kein WebGL).")
        elif text.startswith("error") and not self.web_ok:
            self.use_soft("Die 3D-Vorschau konnte nicht starten.")
        elif text.startswith("modelerror"):
            self.use_soft("Die Figur ließ sich in der 3D-Vorschau nicht laden.")

    def set_simple(self, on):
        self.settings.setValue("simplePreview", on)
        if on:
            self.use_soft("eingestellt")
        elif self.view is not None:
            self.web_failed = False
            self.preview_stack.setCurrentWidget(self.view)
            self.soft.set_rotate(False)
            if self.result:
                self.preview(self.rigged or self.result["files"]["glb"])

    def busy(self):
        return self.proc.state() != QProcess.ProcessState.NotRunning

    def use_soft(self, reason):
        if self.web_failed:
            return
        # Echte 3D-Vorschau scheitert an der Grafikkarte? Dann einmal mit Software-WebGL
        # (SwiftShader) neu starten – das ist weit besser als die einfache Vorschau.
        if reason != "eingestellt" and not os.environ.get("CREATIVE3D_SOFTGL") and not self.busy() \
                and self.settings.value("webglSoftware", False, type=bool) is False:
            self.settings.setValue("webglSoftware", True)
            self.settings.sync()
            print(f"Creative 3D: {reason} – starte die 3D-Vorschau mit Software-WebGL neu", file=sys.stderr)
            QProcess.startDetached(sys.executable, [str(Path(sys.argv[0]).resolve()), *sys.argv[1:]])
            QTimer.singleShot(0, QApplication.quit)
            return
        self.web_failed = True
        if hasattr(self, "simple"):
            self.simple.setToolTip("Einfache Vorschau aktiv: " + reason)
        if hasattr(self, "simple") and not self.simple.isChecked():
            self.simple.blockSignals(True)
            self.simple.setChecked(True)
            self.simple.blockSignals(False)
        print(f"Creative 3D: Ausweich-Vorschau – {reason}", file=sys.stderr)
        self.preview_stack.setCurrentWidget(self.soft)
        if self.result:
            self.show_soft()
            self.status.setText("Einfache Vorschau (ohne Grafikkarte). Export und Skelett sind davon nicht betroffen.")

    def show_soft(self):
        if not (self.result and "npz" in self.result.get("files", {})):
            return
        try:
            vertices, faces, normals, colors = self.mesh_data()
            self.soft.set_mesh(vertices, faces, normals, colors)
        except (OSError, ValueError, KeyError) as error:
            self.soft.setText(f"Vorschau nicht möglich: {error}")

    def choose_image(self):
        if self.proc.state() != QProcess.ProcessState.NotRunning:
            return
        path, _ = QFileDialog.getOpenFileName(self, "Bild wählen", str(Path.home() / "Bilder"),
                                              IMAGE_TYPES + ";;Alle Dateien (*)")
        if path:
            self.set_image(path)

    def set_image(self, path):
        pix = QPixmap(path)
        if pix.isNull():
            self.status.setText("Diese Datei ist kein Bild, das sich öffnen lässt.")
            return
        self.image = path
        self.drop.setPixmap(pix.scaled(self.drop.size() * 0.95, Qt.AspectRatioMode.KeepAspectRatio,
                                       Qt.TransformationMode.SmoothTransformation))
        self.status.setText(Path(path).name)
        self.refresh()

    # ---- KI einrichten ------------------------------------------------------------
    def start_setup(self):
        self.mode, self.error, self.buffer = "setup", "", b""
        self.log.clear()
        self.log.show()
        self.setup_progress.setValue(0)
        self.setup_progress.show()
        self.setup_status.setText("Starte …")
        self.proc.start("sh", [str(SETUP)])
        self.refresh()

    # ---- Figur erzeugen -----------------------------------------------------------
    def start_generate(self):
        if not (self.image and ready()):
            return
        self.counter += 1
        self.out = OUTPUT / time.strftime("%Y%m%d-%H%M%S")
        self.out.mkdir(parents=True, exist_ok=True)
        # Bild in den Ausgabeordner kopieren: Sonderzeichen im Pfad (:, ,) stören podman -v nicht
        source = Path(self.image)
        stem = "".join(c if c.isalnum() or c in "-_" else "_" for c in source.stem)[:60] or "bild"
        copy = self.out / f"{stem}{source.suffix.lower() or '.png'}"
        try:
            shutil.copyfile(source, copy)
        except OSError as error:
            self.status.setText(f"Bild nicht lesbar: {error}")
            return
        args = ["run", "--rm", "--security-opt", "label=disable", "--device", "nvidia.com/gpu=all",
                "-e", "HF_HUB_OFFLINE=1", "-e", "TRANSFORMERS_OFFLINE=1",
                "-v", f"{DATA / 'modelle'}:/cache", "-v", f"{self.out}:/out",
                *run_override(),
                IMAGE, "--image", f"/out/{copy.name}", "--out", "/out", "--quality", str(self.detail.currentData())]
        env = QProcessEnvironment.systemEnvironment()
        env.insert("PYTHONUNBUFFERED", "1")
        self.proc.setProcessEnvironment(env)
        self.mode, self.error, self.buffer = "generate", "", b""
        self.progress.setValue(0)
        self.progress.show()
        self.status.setText("Starte …")
        self.proc.start("podman", args)
        self.refresh()

    def read_output(self):
        self.buffer += bytes(self.proc.readAllStandardOutput())
        *lines, self.buffer = self.buffer.split(b"\n")
        for raw in lines:
            line = raw.decode(errors="replace").rstrip()
            if not line:
                continue
            if self.mode == "setup":
                self.handle_setup_line(line)
            else:
                self.handle_worker_line(line)

    def handle_setup_line(self, line):
        self.log.appendPlainText(line)
        if line.startswith("STEP "):
            parts = line.split(" ", 3)
            try:
                n, total = int(parts[1]), int(parts[2])
                self.setup_progress.setValue(int((n - 1) * 100 / total))
            except (ValueError, IndexError):
                pass
            self.setup_status.setText(parts[3] if len(parts) > 3 else "")

    def handle_worker_line(self, line):
        kind, _, rest = line.partition(" ")
        if kind == "P":
            pct, _, text = rest.partition(" ")
            if pct.isdigit():
                self.progress.setValue(int(pct))
            self.status.setText(text)
        elif kind == "OK":
            try:
                result = json.loads(rest)
                # Der Container nennt Dateien relativ zu /out → Pfade auf diesem PC
                result["files"] = {k: str(self.out / v) for k, v in result.get("files", {}).items()}
                if result.get("input"):
                    result["input"] = str(self.out / result["input"])
                self.show_result(result)
            except (ValueError, TypeError, AttributeError):
                self.error = "Antwort der KI nicht lesbar."
        elif kind == "ERR":
            self.error = rest
        else:
            self.last = line

    def show_result(self, result):
        self.result = result
        self.joints = self.rigged = None
        self.preview(result["files"]["glb"])
        faces = f"{result.get('faces', 0):,}".replace(",", ".")
        self.info.setText(f"{faces} Dreiecke · {result.get('seconds', 0)} s")

    def finished(self, code, _status):
        mode, self.mode = self.mode, None
        if mode == "setup":
            ok = code == 0 and ready()
            self.setup_progress.setValue(100 if ok else self.setup_progress.value())
            self.setup_status.setText("Fertig – Creative 3D ist bereit." if ok
                                      else "Einrichtung fehlgeschlagen – Details siehe unten. Erneut versuchen?")
            if ok:
                self.status.setText("KI bereit. Wähle links ein Bild.")
        else:
            self.progress.hide()
            if code != 0 or self.error:
                self.status.setText("Fehler: " + (self.error or getattr(self, "last", "") or f"Code {code}"))
            elif self.result:
                self.status.setText("Fertig. Ziehen dreht die Figur, unten speichern.")
                if self.skeleton.currentData() == "human":
                    self.refresh()
                    self.edit_joints()
        self.refresh()

    # ---- Skelett ------------------------------------------------------------------
    def mesh_data(self):
        import numpy as np
        data = np.load(self.result["files"]["npz"])
        colors = data["colors"] if len(data["colors"]) else None
        return data["vertices"], data["faces"], data["normals"], colors

    def skeleton_changed(self):
        if self.skeleton.currentData() != "human":
            self.joints = self.rigged = None
            self.preview(self.result["files"]["glb"] if self.result else None)
            self.refresh()
        elif self.result and "npz" in self.result.get("files", {}):
            self.refresh()
            self.edit_joints()
        else:
            self.refresh()

    def edit_joints(self):
        if not (self.result and "npz" in self.result.get("files", {})):
            return
        from creative3d_rigeditor import RigDialog
        vertices, faces, normals, colors = self.mesh_data()
        dialog = RigDialog(self, vertices, self.joints, self.probe)
        dialog.setStyleSheet(STYLE)
        if dialog.exec() != RigDialog.DialogCode.Accepted:
            if self.joints is None:
                self.skeleton.blockSignals(True)
                self.skeleton.setCurrentIndex(0)
                self.skeleton.blockSignals(False)
                self.refresh()
            return
        self.joints, self.probe = dialog.joints, dialog.probe.isChecked()
        self.write_rig(vertices, faces, normals, colors)

    def write_rig(self, vertices, faces, normals, colors):
        import creative3d_rig as rig
        base = Path(self.result["files"]["glb"])
        self.rigged = str(base.with_name(base.stem + "-skelett.glb"))
        try:
            rig.write_glb(self.rigged, vertices, faces, colors, normals, self.joints)
            shown = self.rigged
            if self.probe:
                shown = str(base.with_name(base.stem + "-probe.glb"))
                rig.write_glb(shown, vertices, faces, colors, normals, self.joints, rig.probe_animation())
        except (OSError, ValueError) as error:
            self.rigged = None
            self.status.setText(f"Skelett konnte nicht gespeichert werden: {error}")
            self.refresh()
            return
        self.preview(shown)
        self.status.setText("Skelett gesetzt – „GLB mit Skelett“ speichert es mit."
                            + (" Die Vorschau zeigt eine Probe-Bewegung." if self.probe else ""))
        self.refresh()

    def preview(self, path):
        if not path:
            return
        if self.web_failed:
            self.show_soft()
        elif self.scheme:
            self.counter += 1
            self.scheme.model = path
            self.js(f"show('c3d://app/model/{self.counter}.glb')")

    # ---- Export -------------------------------------------------------------------
    def save(self, fmt):
        if not self.result:
            return
        source = Path(self.rigged if fmt == "glb" and self.rigged else self.result["files"][fmt])
        target, _ = QFileDialog.getSaveFileName(self, f"Als {fmt.upper()} speichern",
                                                str(Path.home() / source.name), f"{fmt.upper()} (*.{fmt})")
        if not target:
            return
        if not target.lower().endswith("." + fmt):
            target += "." + fmt
        try:
            shutil.copyfile(source, target)
            if fmt == "obj":   # Material (.mtl) und Textur gehören dazu
                for extra in source.parent.iterdir():
                    if extra != source and extra.suffix.lower() in (".mtl", ".png", ".jpg", ".jpeg"):
                        shutil.copyfile(extra, Path(target).parent / extra.name)
            self.status.setText(f"Gespeichert: {target.replace(str(Path.home()), '~')}")
        except OSError as error:
            QMessageBox.warning(self, "Speichern fehlgeschlagen", str(error))

    def open_folder(self):
        if self.result:
            QDesktopServices.openUrl(QUrl.fromLocalFile(str(Path(self.result["files"]["glb"]).parent)))

    def closeEvent(self, event):
        if self.proc.state() != QProcess.ProcessState.NotRunning:
            if QMessageBox.question(self, "Creative 3D", "Es läuft noch etwas. Trotzdem beenden?") \
                    != QMessageBox.StandardButton.Yes:
                event.ignore()
                return
            self.proc.kill()
            self.proc.waitForFinished(2000)
        super().closeEvent(event)


def main():
    selftest = "--selftest" in sys.argv
    # Falls die Browser-Engine die Grafikkarte sperrt: WebGL notfalls per Software (SwiftShader).
    # Ist das schon einmal nötig gewesen (Einstellung webglSoftware), gleich damit starten.
    flags = os.environ.get("QTWEBENGINE_CHROMIUM_FLAGS", "")
    extra = ["--enable-unsafe-swiftshader", "--ignore-gpu-blocklist"]
    if QSettings("Creative OS", "Creative 3D").value("webglSoftware", False, type=bool):
        os.environ["CREATIVE3D_SOFTGL"] = "1"
        extra += ["--use-gl=angle", "--use-angle=swiftshader"]
    for flag in extra:
        if flag.split("=")[0] not in flags:
            flags = (flags + " " + flag).strip()
    os.environ["QTWEBENGINE_CHROMIUM_FLAGS"] = flags
    if not selftest:
        register_scheme()
    QApplication.setAttribute(Qt.ApplicationAttribute.AA_ShareOpenGLContexts)
    app = QApplication(sys.argv)
    app.setApplicationName("Creative 3D")
    app.setDesktopFileName("creative-3d")
    window = Creative3D(preview_web=not selftest and not os.environ.get("CREATIVE3D_NO_WEB"))
    if selftest:
        assert not window.generate.isEnabled() and not window.result
        assert all(not b.isEnabled() for b in window.export_buttons)
        assert SETUP.is_file() and (LIB / "creative3d_softview.py").is_file()
        import creative3d_softview as sv
        vertices, faces = sv.uv_sphere()
        window.soft.set_mesh(vertices, faces, None, None)
        assert not window.soft.pixmap().isNull()
        window.close()
        return 0
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
