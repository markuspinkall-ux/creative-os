    # ---- Zustand ------------------------------------------------------------------
    def refresh(self):
        busy = self.proc.state() != QProcess.ProcessState.NotRunning
        is_ready = ready()
        gpu = gpu_name()
        self.chip.setText(("Grafikkarte: " + gpu.split(",")[0]) if gpu else "Keine NVIDIA-Grafikkarte – Prozessor")
        self.stack.setCurrentIndex(0 if is_ready else 1)
        self.generate.setEnabled(is_ready and bool(self.image) and not busy)
        self.generate.setToolTip("" if is_ready else "Zuerst rechts die KI einrichten")
        self.setup_button.setEnabled(not busy)
        for b in self.export_buttons + [self.folder_button]:
            b.setEnabled(bool(self.result) and not busy)
        self.rotate.setEnabled(bool(self.result))

    def js(self, code):
        if WEB and isinstance(self.view, QWebEngineView):
            self.view.page().runJavaScript(code)

    def choose_image(self):
        if self.proc.state() != QProcess.ProcessState.NotRunning:
            return
        path, _ = QFileDialog.getOpenFileName(self, "Bild wählen", str(Path.home() / "Bilder"),
                                              IMAGE_TYPES + ";;Alle Dateien (*)")
        if path:
            self.set_image(path)

    def set_image(self, path):
        pix = QPixmap(path)
        if pix.isNull():
            self.status.setText("Diese Datei ist kein Bild, das sich öffnen lässt.")
            return
        self.image = path
        self.drop.setPixmap(pix.scaled(self.drop.size() * 0.95, Qt.AspectRatioMode.KeepAspectRatio,
                                       Qt.TransformationMode.SmoothTransformation))
        self.status.setText(Path(path).name)
        self.refresh()

    # ---- KI einrichten ------------------------------------------------------------
    def start_setup(self):
        self.mode, self.error, self.buffer = "setup", "", b""
        self.log.clear()
        self.log.show()
        self.setup_progress.setValue(0)
        self.setup_progress.show()
        self.setup_status.setText("Starte …")
        self.proc.start("sh", [str(SETUP)])
        self.refresh()

    # ---- Figur erzeugen -----------------------------------------------------------
    def start_generate(self):
        if not (self.image and ready()):
            return
        self.counter += 1
        self.out = OUTPUT / time.strftime("%Y%m%d-%H%M%S")
        args = [str(LIB / "creative3d_worker.py"), "--image", self.image, "--out", str(self.out),
                "--resolution", str(self.detail.currentData()), "--foreground", f"{self.fill.value() / 100:.2f}"]
        if not self.background.isChecked():
            args.append("--keep-background")
        env = QProcessEnvironment.systemEnvironment()
        env.insert("PYTHONUNBUFFERED", "1")
        self.proc.setProcessEnvironment(env)
        self.mode, self.error, self.buffer = "generate", "", b""
        self.progress.setValue(0)
        self.progress.show()
        self.status.setText("Starte …")
        self.proc.start(str(DATA / "venv/bin/python"), args)
        self.refresh()

    def read_output(self):
        self.buffer += bytes(self.proc.readAllStandardOutput())
        *lines, self.buffer = self.buffer.split(b"\n")
        for raw in lines:
            line = raw.decode(errors="replace").rstrip()
            if not line:
                continue
            if self.mode == "setup":
                self.handle_setup_line(line)
            else:
                self.handle_worker_line(line)

    def handle_setup_line(self, line):
        self.log.appendPlainText(line)
        if line.startswith("STEP "):
            parts = line.split(" ", 3)
            try:
                n, total = int(parts[1]), int(parts[2])
                self.setup_progress.setValue(int((n - 1) * 100 / total))
            except (ValueError, IndexError):
                pass
            self.setup_status.setText(parts[3] if len(parts) > 3 else "")

    def handle_worker_line(self, line):
        kind, _, rest = line.partition(" ")
        if kind == "P":
            pct, _, text = rest.partition(" ")
            if pct.isdigit():
                self.progress.setValue(int(pct))
            self.status.setText(text)
        elif kind == "OK":
            try:
                self.show_result(json.loads(rest))
            except ValueError:
                self.error = "Antwort der KI nicht lesbar."
        elif kind == "ERR":
            self.error = rest
        else:
            self.last = line

    def show_result(self, result):
        self.result = result
        if self.scheme:
            self.scheme.model = result["files"]["glb"]
            self.js(f"show('c3d:///model/{self.counter}.glb')")
        faces = f"{result.get('faces', 0):,}".replace(",", ".")
        self.info.setText(f"{faces} Dreiecke · {result.get('seconds', 0)} s")

    def finished(self, code, _status):
        mode, self.mode = self.mode, None
        if mode == "setup":
            ok = code == 0 and ready()
            self.setup_progress.setValue(100 if ok else self.setup_progress.value())
            self.setup_status.setText("Fertig – Creative 3D ist bereit." if ok
                                      else "Einrichtung fehlgeschlagen – Details siehe unten. Erneut versuchen?")
            if ok:
                self.status.setText("KI bereit. Wähle links ein Bild.")
        else:
            self.progress.hide()
            if code != 0 or self.error:
                self.status.setText("Fehler: " + (self.error or getattr(self, "last", "") or f"Code {code}"))
            elif self.result:
                self.status.setText("Fertig. Ziehen dreht die Figur, unten speichern.")
        self.refresh()

    # ---- Export -------------------------------------------------------------------
    def save(self, fmt):
        if not self.result:
            return
        source = Path(self.result["files"][fmt])
        target, _ = QFileDialog.getSaveFileName(self, f"Als {fmt.upper()} speichern",
                                                str(Path.home() / source.name), f"{fmt.upper()} (*.{fmt})")
        if not target:
            return
        if not target.lower().endswith("." + fmt):
            target += "." + fmt
        try:
            shutil.copyfile(source, target)
            self.status.setText(f"Gespeichert: {target.replace(str(Path.home()), '~')}")
        except OSError as error:
            QMessageBox.warning(self, "Speichern fehlgeschlagen", str(error))

    def open_folder(self):
        if self.result:
            QDesktopServices.openUrl(QUrl.fromLocalFile(str(Path(self.result["files"]["glb"]).parent)))

    def closeEvent(self, event):
        if self.proc.state() != QProcess.ProcessState.NotRunning:
            if QMessageBox.question(self, "Creative 3D", "Es läuft noch etwas. Trotzdem beenden?") \
                    != QMessageBox.StandardButton.Yes:
                event.ignore()
                return
            self.proc.kill()
            self.proc.waitForFinished(2000)
        super().closeEvent(event)


def main():
    selftest = "--selftest" in sys.argv
    if not selftest:
        register_scheme()
    app = QApplication(sys.argv)
    app.setApplicationName("Creative 3D")
    app.setDesktopFileName("creative-3d")
    window = Creative3D(preview_web=not selftest)
    if selftest:
        assert not window.generate.isEnabled() and not window.result
        assert all(not b.isEnabled() for b in window.export_buttons)
        assert (LIB / "creative3d_worker.py").is_file() and SETUP.is_file()
        window.close()
        return 0
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
