def ready():
    return (DATA / "ready").is_file() and (DATA / "venv/bin/python").is_file()


def gpu_name():
    if not shutil.which("nvidia-smi"):
        return ""
    import subprocess
    try:
        out = subprocess.run(["nvidia-smi", "--query-gpu=name,memory.total", "--format=csv,noheader"],
                             capture_output=True, text=True, timeout=5).stdout.strip().splitlines()
        return out[0] if out else ""
    except (OSError, subprocess.SubprocessError):
        return ""


# ---- Vorschau: eigenes URL-Schema c3d:// (Module und GLB dürfen nicht über file:// laden) ----
WEB = None
try:
    from PySide6.QtWebEngineCore import (QWebEngineProfile, QWebEngineUrlRequestJob, QWebEngineUrlScheme,
                                         QWebEngineUrlSchemeHandler)
    from PySide6.QtWebEngineWidgets import QWebEngineView
    WEB = True
except ImportError:                                            # ohne WebEngine: Vorschau als Bild
    WEB = False


def register_scheme():
    if not WEB:
        return
    scheme = QWebEngineUrlScheme(b"c3d")
    scheme.setSyntax(QWebEngineUrlScheme.Syntax.Path)
    scheme.setFlags(QWebEngineUrlScheme.Flag.SecureScheme | QWebEngineUrlScheme.Flag.LocalScheme
                    | QWebEngineUrlScheme.Flag.LocalAccessAllowed | QWebEngineUrlScheme.Flag.CorsEnabled)
    QWebEngineUrlScheme.registerScheme(scheme)


if WEB:
    class Scheme(QWebEngineUrlSchemeHandler):
        """Liefert viewer.html, model-viewer und die aktuelle GLB-Datei."""
        TYPES = {".html": b"text/html", ".js": b"text/javascript", ".glb": b"model/gltf-binary"}

        def __init__(self, parent=None):
            super().__init__(parent)
            self.model = None

        def requestStarted(self, job):
            path = job.requestUrl().path()
            if path.startswith("/model/") and self.model:
                file = Path(self.model)
            elif path in ("/viewer.html", "/model-viewer.min.js"):
                file = LIB / path.lstrip("/")
            else:
                job.fail(QWebEngineUrlRequestJob.Error.UrlNotFound)
                return
            try:
                data = file.read_bytes()
            except OSError:
                job.fail(QWebEngineUrlRequestJob.Error.UrlNotFound)
                return
            buffer = QBuffer(job)
            buffer.setData(QByteArray(data))
            buffer.open(QIODevice.OpenModeFlag.ReadOnly)
            job.reply(self.TYPES.get(file.suffix, b"application/octet-stream"), buffer)


class DropLabel(QLabel):
    dropped = Signal(str)
    clicked = Signal()

    def __init__(self):
        super().__init__("Bild hierher ziehen\noder klicken zum Wählen\n\nAm besten: ganze Person, von vorn,\nruhiger Hintergrund",
                         objectName="drop")
        self.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.setAcceptDrops(True)
        self.setMinimumSize(300, 300)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setAccessibleName("Bild für die 3D-Figur")

    def mousePressEvent(self, _event):
        self.clicked.emit()

    def dragEnterEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dropEvent(self, event):
        urls = [u.toLocalFile() for u in event.mimeData().urls() if u.isLocalFile()]
        if urls:
            self.dropped.emit(urls[0])


