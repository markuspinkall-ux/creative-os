def run_override():
    """Neuere Fassung des Rechenteils aus Creative OS in den Container legen – so kommen
    Verbesserungen (z. B. „Sehr hoch“) mit dem System-Update, ohne den 14-GB-Container neu zu laden."""
    newer = LIB / "trellis-run.py"
    if not newer.is_file():
        return []
    args = ["-v", f"{newer}:/opt/creative/run.py:ro"]
    helper = LIB / "trellis-foto_projektion.py"
    if helper.is_file():
        args += ["-v", f"{helper}:/opt/creative/foto_projektion.py:ro"]
    return args


def gpu_name():
    if not shutil.which("nvidia-smi"):
        return ""
    import subprocess
    try:
        out = subprocess.run(["nvidia-smi", "--query-gpu=name,memory.total", "--format=csv,noheader"],
                             capture_output=True, text=True, timeout=5).stdout.strip().splitlines()
        return out[0] if out else ""
    except (OSError, subprocess.SubprocessError):
        return ""


# ---- Vorschau: eigenes URL-Schema c3d:// (Module und GLB dürfen nicht über file:// laden) ----
WEB = None
try:
    from PySide6.QtWebEngineCore import (QWebEnginePage, QWebEngineProfile, QWebEngineUrlRequestJob,
                                         QWebEngineUrlScheme, QWebEngineUrlSchemeHandler)
    from PySide6.QtWebEngineWidgets import QWebEngineView
    WEB = True
except ImportError:                                            # ohne WebEngine: Vorschau als Bild
    WEB = False


def register_scheme():
    if not WEB:
        return
    scheme = QWebEngineUrlScheme(b"c3d")
    # Host-Syntax (c3d://app/…): Seite, model-viewer und GLB haben dieselbe Herkunft –
    # bei Path-Syntax ist die Herkunft „opaque“ und Module/fetch werden per CORS blockiert.
    scheme.setSyntax(QWebEngineUrlScheme.Syntax.Host)
    scheme.setFlags(QWebEngineUrlScheme.Flag.SecureScheme | QWebEngineUrlScheme.Flag.LocalScheme
                    | QWebEngineUrlScheme.Flag.LocalAccessAllowed | QWebEngineUrlScheme.Flag.CorsEnabled)
    QWebEngineUrlScheme.registerScheme(scheme)


if WEB:
    class Scheme(QWebEngineUrlSchemeHandler):
        """Liefert viewer.html, model-viewer und die aktuelle GLB-Datei."""
        TYPES = {".html": b"text/html", ".js": b"text/javascript", ".glb": b"model/gltf-binary"}

        def __init__(self, parent=None):
            super().__init__(parent)
            self.model = None

        def requestStarted(self, job):
            path = job.requestUrl().path()
            if path.startswith("/model/") and self.model:
                file = Path(self.model)
            elif path in ("/viewer.html", "/model-viewer.min.js"):
                file = LIB / path.lstrip("/")
            else:
                job.fail(QWebEngineUrlRequestJob.Error.UrlNotFound)
                return
            try:
                data = file.read_bytes()
            except OSError:
                job.fail(QWebEngineUrlRequestJob.Error.UrlNotFound)
                return
            if path == "/viewer.html":                       # Farben ans Design (Graphit/Porzellan) anpassen
                data = T(data.decode("utf-8")).encode("utf-8")
            buffer = QBuffer(job)
            buffer.setData(QByteArray(data))
            buffer.open(QIODevice.OpenModeFlag.ReadOnly)
            if hasattr(job, "setAdditionalResponseHeaders"):        # Qt ≥ 6.6
                try:
                    job.setAdditionalResponseHeaders({QByteArray(b"Access-Control-Allow-Origin"): QByteArray(b"*")})
                except TypeError:
                    pass
            job.reply(self.TYPES.get(file.suffix, b"application/octet-stream"), buffer)

    class Page(QWebEnginePage):
        """Meldungen der Vorschau (console.log „C3D:…“) an die App weitergeben."""
        message = Signal(str)

        def javaScriptConsoleMessage(self, level, text, line, source):
            if text.startswith("C3D:"):
                self.message.emit(text[4:].strip())
            elif level == QWebEnginePage.JavaScriptConsoleMessageLevel.ErrorMessageLevel:
                print(f"Vorschau: {text} ({source}:{line})", file=sys.stderr)
                self.message.emit("error " + text)


class SoftView(QLabel):
    """Ausweich-Vorschau ohne Grafikkarte: ziehen dreht, Mausrad zoomt."""

    def __init__(self):
        super().__init__("Noch keine Figur\n\nBild links wählen und „3D-Figur erstellen“ drücken.")
        self.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.setObjectName("muted")
        self.setMinimumSize(200, 200)
        self.mesh = None
        self.yaw, self.pitch, self.zoom = 25.0, -10.0, 1.0
        self.drag = None
        self.rotating = True
        self.fine = QTimer(self, singleShot=True, interval=180)
        self.fine.timeout.connect(lambda: self.draw(fast=False))
        self.spin = QTimer(self, interval=80)
        self.spin.timeout.connect(self.turn)

    def set_mesh(self, vertices, faces, normals, colors):
        sys.path.insert(0, str(LIB))
        import creative3d_softview as sv
        self.mesh = sv.Mesh(vertices, faces, normals, colors)
        self.draw(fast=False)
        self.set_rotate(self.rotating)

    def set_rotate(self, on):
        self.rotating = on
        if on and self.mesh is not None:
            self.spin.start()
        else:
            self.spin.stop()

    def turn(self):
        if self.drag is None and self.isVisible():
            self.yaw = (self.yaw + 4) % 360
            self.draw(fast=True)

    def draw(self, fast=True):
        if self.mesh is None:
            return
        side = max(160, min(self.width(), self.height()) - 8)
        ratio = self.devicePixelRatioF()
        rgba = self.mesh.render(int(side * ratio), self.yaw, self.pitch, self.zoom, fast)
        image = QImage(rgba.tobytes(), rgba.shape[1], rgba.shape[0], rgba.shape[1] * 4,
                       QImage.Format.Format_RGBA8888).copy()
        pixmap = QPixmap.fromImage(image)
        pixmap.setDevicePixelRatio(ratio)
        self.setPixmap(pixmap)
        if fast:
            self.fine.start()

    def resizeEvent(self, event):
        super().resizeEvent(event)
        if self.mesh is not None:
            self.draw(fast=True)

    def mousePressEvent(self, event):
        self.drag = event.position()

    def mouseMoveEvent(self, event):
        if self.drag is not None and self.mesh is not None:
            delta = event.position() - self.drag
            self.drag = event.position()
            self.yaw = (self.yaw + delta.x() * .6) % 360
            self.pitch = max(-85.0, min(85.0, self.pitch - delta.y() * .4))
            self.draw(fast=True)

    def mouseReleaseEvent(self, _event):
        self.drag = None
        self.draw(fast=False)

    def wheelEvent(self, event):
        if self.mesh is not None:
            self.zoom = max(.4, min(4.0, self.zoom * (1.12 if event.angleDelta().y() > 0 else 1 / 1.12)))
            self.draw(fast=True)


class DropLabel(QLabel):
    dropped = Signal(str)
    clicked = Signal()

    def __init__(self):
        super().__init__("Bild hierher ziehen\noder klicken zum Wählen\n\nAm besten: ganze Person, von vorn,\nruhiger Hintergrund",
                         objectName="drop")
        self.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.setAcceptDrops(True)
        self.setMinimumSize(300, 300)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setAccessibleName("Bild für die 3D-Figur")

    def mousePressEvent(self, _event):
        self.clicked.emit()

    def dragEnterEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dropEvent(self, event):
        urls = [u.toLocalFile() for u in event.mimeData().urls() if u.isLocalFile()]
        if urls:
            self.dropped.emit(urls[0])


