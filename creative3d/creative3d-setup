#!/bin/sh
# Creative 3D – KI (TRELLIS) einmalig einrichten, ohne sudo.
#   Container:  ghcr.io/markuspinkall-ux/creative-trellis:latest  (≈ 14 GB, fertig kompiliert)
#   Modelle:    ~/.local/share/creative-3d/modelle  (≈ 4 GB: TRELLIS, DINOv2, Hintergrund-Entfernung)
#   Markierung: ~/.local/share/creative-3d/trellis-ready
# Ausgabe: Zeilen „STEP <n> <gesamt> <text>“ für die Fortschrittsanzeige.
#   creative3d-setup                     TRELLIS einrichten / reparieren
#   creative3d-setup --modell trellis2   TRELLIS.2 einrichten (größer, braucht HF-Schlüssel für DINOv3)
#   creative3d-setup --entfernen         alles wieder löschen
set -eu
DATA="${CREATIVE3D_HOME:-$HOME/.local/share/creative-3d}"
MODELL=trellis
if [ "${1:-}" = "--modell" ]; then MODELL="${2:-trellis}"; shift 2; fi
if [ "$MODELL" = trellis2 ]; then
    IMAGE="${CREATIVE3D_IMAGE2:-ghcr.io/markuspinkall-ux/creative-trellis2:latest}"
    NAME="TRELLIS.2"; MARK="$DATA/trellis2-ready"; NEED_GB=50; MODEL_GB=13
else
    IMAGE="${CREATIVE3D_IMAGE:-ghcr.io/markuspinkall-ux/creative-trellis:latest}"
    NAME="TRELLIS"; MARK="$DATA/trellis-ready"; NEED_GB=32; MODEL_GB=4
fi
TOTAL=5
step() { echo "STEP $1 $TOTAL $2"; }
fail() { echo "FEHLER: $*"; exit 1; }

if [ "${1:-}" = "--entfernen" ]; then
    podman rmi -f ghcr.io/markuspinkall-ux/creative-trellis:latest ghcr.io/markuspinkall-ux/creative-trellis2:latest >/dev/null 2>&1 || true
    rm -rf "$DATA"
    echo "Creative-3D-KI entfernt."
    exit 0
fi
# Solange geladen wird, geht der PC nicht von selbst in den Standby
# (selbst in den Standby schicken geht weiterhin).
if [ -z "${CREATIVE_WACH:-}" ] && command -v systemd-inhibit >/dev/null 2>&1 && systemd-inhibit --list >/dev/null 2>&1; then
    export CREATIVE_WACH=1
    exec systemd-inhibit --what=idle --mode=block --who="Creative 3D" --why="KI wird eingerichtet" "$0" "$@"
fi
rm -f "$MARK" "$DATA/ready"

# Reste der früheren TripoSR-Einrichtung (≈ 5 GB) aufräumen
for old in venv TripoSR hf u2net bin python cache; do
    [ -e "$DATA/$old" ] && rm -rf "${DATA:?}/$old" && echo "Alte TripoSR-Daten entfernt: $old"
done
mkdir -p "$DATA/modelle"

step 1 "Prüfe die Grafikkarte …"
command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1 \
    || fail "Creative 3D braucht eine NVIDIA-Grafikkarte mit dem NVIDIA-Abbild von Creative OS."
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -1 | sed 's/^/Grafikkarte: /'
mem=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits | head -1 | tr -d ' ')
[ "${mem:-0}" -lt 11000 ] 2>/dev/null && echo "Hinweis: Unter 12 GB Grafikspeicher kann TRELLIS zu wenig Speicher haben."

# podman selbst prüfen: stürzt es schon beim Start ab, hilft kein erneuter Download
podman_ok() {
    out=$(podman --version 2>&1) && return 0
    case "$out" in
        *"fatal error"*|*SIGSEGV*|*"unexpected fault"*)
            fail "Das Container-Programm (podman) stürzt beim Start ab. Das liegt nicht am Download, sondern meist an einem Speicherfehler im laufenden System. Bitte den PC neu starten und Creative 3D erneut einrichten – bereits geladene Teile bleiben erhalten." ;;
    esac
    fail "podman funktioniert nicht: $(echo "$out" | head -1)"
}

step 2 "Prüfe den Container-Zugriff auf die Grafikkarte …"
command -v podman >/dev/null 2>&1 || fail "podman fehlt – bitte Creative OS aktualisieren."
podman_ok
# Platz: Container ≈ 14 GB gepackt + ≈ 18 GB entpackt, Modelle ≈ 4 GB
store="$HOME/.local/share/containers"
mkdir -p "$store"
free_gb=$(df -Pk "$store" | awk 'NR==2 {print int($4/1024/1024)}')
if podman image exists "$IMAGE" 2>/dev/null; then need=$((MODEL_GB + 2)); else need=${CREATIVE3D_MIN_GB:-$NEED_GB}; fi
[ "${free_gb:-0}" -lt "$need" ] && fail "Zu wenig Speicherplatz: frei sind ${free_gb} GB, gebraucht werden etwa ${need} GB. Bitte Platz schaffen (z. B. Papierkorb leeren) und erneut versuchen."
echo "Freier Speicher: ${free_gb} GB"
if ! { [ -e /run/cdi/nvidia.yaml ] || [ -e /etc/cdi/nvidia.yaml ]; }; then
    fail "Die Grafikkarte ist für Container noch nicht freigegeben. Bitte Creative OS aktualisieren und neu starten."
fi

step 3 "Lade den $NAME-Container (≈ 14–18 GB, das dauert eine Weile) …"
# Bis zu drei Versuche – bereits geladene Teile bleiben erhalten
log="$DATA/laden.log"
ok=0
for try in 1 2 3; do
    if [ "$try" -gt 1 ]; then
        echo "Neuer Versuch ($try von 3) …"
        # halb entpackte Teile aufräumen, damit der nächste Versuch sauber startet
        podman system check --repair >/dev/null 2>&1 || true
        sleep 5
    fi
    { podman pull "$IMAGE" 2>&1; echo "PULL-ENDE $?"; } | tee "$log" | grep -v '^Writing manifest\|^PULL-ENDE\|^ *[0-9a-f]\{16\}:\|^goroutine\|^\s' || true
    if grep -q '^PULL-ENDE 0$' "$log"; then ok=1; break; fi
    if grep -q 'fatal error\|SIGSEGV\|unexpected fault' "$log"; then podman_ok; fi
    grep -qi 'no space left' "$log" && fail "Der Speicherplatz ist beim Entpacken ausgegangen. Bitte Platz schaffen und erneut versuchen."
done
[ "$ok" = 1 ] || fail "Der $NAME-Container ließ sich nicht laden (Details: $log)."
podman image exists "$IMAGE" 2>/dev/null || { podman_ok; fail "Der $NAME-Container fehlt nach dem Laden."; }

step 4 "Teste die Grafikkarte im Container …"
podman run --rm --security-opt label=disable --device nvidia.com/gpu=all --entrypoint python3 "$IMAGE" -c \
    "import torch; assert torch.cuda.is_available(), 'keine Grafikkarte'; print('Grafikkarte im Container:', torch.cuda.get_device_name(0))" \
    || fail "Der Container sieht die Grafikkarte nicht. Bitte neu starten und erneut versuchen."

step 5 "Lade die KI-Modelle (≈ $MODEL_GB GB) …"
if [ "$MODELL" = trellis2 ]; then
    # DINOv3 (Meta) ist freischaltpflichtig: Schlüssel aus Creative 3D, nur für diesen Schritt
    token_file="$DATA/hf-token"
    [ -s "$token_file" ] || fail "Bitte zuerst deinen Hugging-Face-Schlüssel in Creative 3D eintragen."
    HF_TOKEN="$(cat "$token_file")"
    export HF_TOKEN
    out="$DATA/einrichten2.log"
    set +e
    podman run --rm --security-opt label=disable --device nvidia.com/gpu=all -e HF_TOKEN \
        -v "$DATA/modelle:/cache" "$IMAGE" --prepare 2>&1 | tee "$out"
    rc=$?
    set -e
    unset HF_TOKEN
    if grep -q '^ERR DINOV3_GESPERRT' "$out"; then
        fail "DINOV3_GESPERRT Meta hat den Zugang zu DINOv3 noch nicht freigeschaltet. Sobald die Freischaltungs-Mail da ist, einfach erneut einrichten."
    fi
    grep -q '^OK ' "$out" || fail "Die Modelle ließen sich nicht laden (Details: $out)."
    [ "$rc" = 0 ] || true
else
    # DINOv2 (Bildverständnis) von Hugging Face statt von Metas Server holen – der war im
    # November 2026 wegen eines abgelaufenen Zertifikats nicht erreichbar. Klappt das nicht,
    # lädt TRELLIS es wie bisher selbst von Meta.
    HERE="$(dirname "$(readlink -f "$0")")"
    if [ -f "$HERE/dinov2_from_timm.py" ]; then
        podman run --rm --security-opt label=disable -v "$HERE/dinov2_from_timm.py:/opt/dinov2_from_timm.py:ro" \
            -v "$DATA/modelle:/cache" --entrypoint python3 "$IMAGE" /opt/dinov2_from_timm.py /cache/torch/hub/checkpoints \
            || echo "Hinweis: DINOv2 von Hugging Face ging nicht – versuche es bei Meta."
    fi
    # Mit Grafikkarte: TRELLIS baut beim Laden schon Teile auf der Grafikkarte auf. Ohne sie
    # scheiterte das Laden – und wurde als irreführender „401“-Fehler von Hugging Face gemeldet.
    podman run --rm --security-opt label=disable --device nvidia.com/gpu=all -v "$DATA/modelle:/cache" "$IMAGE" --prepare \
        || fail "Die Modelle ließen sich nicht laden."
fi

date +%s > "$MARK"
echo "FERTIG"
