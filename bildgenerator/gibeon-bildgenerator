def ready():
    return (DATA / "bereit").is_file() and (DATA / "modelle" / "bereit.json").is_file()


def gpu_name():
    if not shutil.which("nvidia-smi"):
        return ""
    try:
        out = subprocess.run(["nvidia-smi", "--query-gpu=name,memory.total", "--format=csv,noheader"],
                             capture_output=True, text=True, timeout=5).stdout.strip().splitlines()
        return out[0] if out else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def pictures_dir():
    base = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.PicturesLocation) \
        or str(Path.home() / "Bilder")
    return Path(base) / "KI-Bildgenerator"


def run_override():
    """Neuere Fassung des Rechenteils aus dem System in den Container legen – Verbesserungen
    kommen so mit dem System-Update, ohne den Container neu zu laden."""
    newer = LIB / "bildgenerator-run.py"
    return ["-v", f"{newer}:/opt/gibeon/run.py:ro"] if newer.is_file() else []


class Thumb(QLabel):
    clicked = Signal(object)
    double = Signal(object)

    def __init__(self, path):
        super().__init__(objectName="thumb")
        self.path = path
        self.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.setFixedSize(QSize(260, 260))
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        pix = QPixmap(str(path))
        if not pix.isNull():
            self.setPixmap(pix.scaled(QSize(250, 250), Qt.AspectRatioMode.KeepAspectRatio,
                                      Qt.TransformationMode.SmoothTransformation))
        self.setToolTip(Path(path).name)
        self.setAccessibleName(f"Bild {Path(path).name}")

    def set_picked(self, on):
        self.setProperty("picked", "true" if on else "false")
        self.style().unpolish(self)
        self.style().polish(self)

    def mousePressEvent(self, event):
        self.clicked.emit(self)

    def mouseDoubleClickEvent(self, event):
        self.double.emit(self)


