    # ---- Zustand ----------------------------------------------------------------
    def busy(self):
        return self.proc.state() != QProcess.ProcessState.NotRunning

    def out_dir(self):
        path = pictures_dir()
        path.mkdir(parents=True, exist_ok=True)
        return path

    def refresh(self):
        gpu = gpu_name()
        self.chip.setText(("Grafikkarte: " + gpu.split(",")[0]) if gpu else "Keine NVIDIA-Grafikkarte gefunden")
        self.pages.setCurrentIndex(1 if ready() and self.mode != "setup" else 0)
        mode = self.modus.currentData()
        hints = {k: h for k, _, h in bp.MODES}
        self.modus_hint.setText(hints.get(mode, "") + (" · immer quadratisch, heller Hintergrund"
                                                       if mode != "frei" else ""))
        self.format.setEnabled(mode == "frei")
        busy = self.busy()
        self.setup_button.setEnabled(not busy)
        self.go.setEnabled(not busy and ready())
        for w in (self.prompt, self.modus, self.stil, self.anzahl, self.seed):
            w.setEnabled(not busy)
        self.format.setEnabled(not busy and mode == "frei")
        has = self.picked is not None
        self.to3d.setEnabled(has and shutil.which("creative-3d") is not None)
        self.to3d.setToolTip("" if shutil.which("creative-3d") else "3D Studio ist nicht installiert.")
        self.save.setEnabled(has)

    # ---- KI einrichten ----------------------------------------------------------
    def start_setup(self):
        if self.busy():
            return
        self.mode, self.error, self.buffer = "setup", "", b""
        self.log.clear()
        self.log.show()
        self.setup_progress.setValue(0)
        self.setup_progress.show()
        self.setup_status.setText("Starte …")
        self.proc.start("sh", [str(SETUP)])
        self.refresh()

    def handle_setup_line(self, line):
        self.log.appendPlainText(line)
        if line.startswith("STEP "):
            parts = line.split(" ", 3)
            try:
                n, total = int(parts[1]), int(parts[2])
                self.setup_progress.setValue(int((n - 1) * 100 / total))
            except (ValueError, IndexError):
                pass
            self.setup_status.setText(parts[3] if len(parts) > 3 else "")
        elif line.startswith("P "):
            _, _, rest = line.partition(" ")
            pct, _, text = rest.partition(" ")
            if pct.isdigit():
                self.setup_progress.setValue(80 + int(pct) * 20 // 100)
            self.setup_status.setText(text)
        elif line.startswith("FEHLER:"):
            self.setup_status.setText(line[7:].strip())

    # ---- Bilder erzeugen --------------------------------------------------------
    def start_generate(self):
        text = self.prompt.toPlainText().strip()
        if not text:
            self.status.setText("Bitte beschreibe zuerst, was auf dem Bild sein soll.")
            self.prompt.setFocus()
            return
        if not ready() or self.busy():
            return
        mode, style = self.modus.currentData(), self.stil.currentData()
        prompt = bp.build_prompt(text, mode, style)
        width, height = bp.size_for(mode, self.format.currentData())
        seed = self.seed.text().strip()
        seed = int(seed) if seed.isdigit() else -1
        self.work = WORK / time.strftime("%Y%m%d-%H%M%S")
        self.work.mkdir(parents=True, exist_ok=True)
        self.prefix = time.strftime("%Y-%m-%d %H.%M ") + bp.safe_stem(text)
        args = ["run", "--rm", "--security-opt", "label=disable", "--device", "nvidia.com/gpu=all",
                "-e", "HF_HUB_OFFLINE=1", "-e", "TRANSFORMERS_OFFLINE=1",
                "-v", f"{DATA / 'modelle'}:/cache", "-v", f"{self.work}:/out", *run_override(), IMAGE,
                "--prompt", prompt, "--count", str(self.anzahl.currentData()), "--seed", str(seed),
                "--width", str(width), "--height", str(height), "--out", "/out", "--prefix", "bild"]
        env = QProcessEnvironment.systemEnvironment()
        env.insert("PYTHONUNBUFFERED", "1")
        self.proc.setProcessEnvironment(env)
        self.mode, self.error, self.buffer, self.last_prompt = "generate", "", b"", prompt
        self.clear_results()
        self.progress.setValue(0)
        self.progress.show()
        self.status.setText("Starte die KI … (das erste Bild dauert am längsten)")
        self.proc.start("podman", args)
        self.refresh()

    def clear_results(self):
        for t in self.thumbs:
            t.setParent(None)
            t.deleteLater()
        self.thumbs, self.picked = [], None
        self.info.setText("")

    def add_result(self, name, seed):
        src = self.work / name
        if not src.is_file():
            return
        n = len(self.thumbs) + 1
        target = self.out_dir() / f"{self.prefix}-{n}.png"
        try:
            shutil.move(str(src), target)
        except OSError:
            target = src
        try:
            target.with_suffix(".txt").write_text(f"{self.last_prompt}\n\nStartwert: {seed}\n"
                                                  "Modell: FLUX.1 [schnell] (Black Forest Labs, Apache-2.0)\n",
                                                  encoding="utf-8")
        except OSError:
            pass
        thumb = Thumb(target)
        thumb.clicked.connect(self.pick)
        thumb.double.connect(lambda t: QDesktopServices.openUrl(QUrl.fromLocalFile(str(t.path))))
        self.grid.addWidget(thumb, (n - 1) // 2, (n - 1) % 2)
        self.thumbs.append(thumb)
        self.empty.hide()
        self.scroll.show()
        if self.picked is None:
            self.pick(thumb)

    def pick(self, thumb):
        self.picked = thumb
        for t in self.thumbs:
            t.set_picked(t is thumb)
        self.refresh()

    def read_output(self):
        self.buffer += bytes(self.proc.readAllStandardOutput())
        *lines, self.buffer = self.buffer.split(b"\n")
        for raw in lines:
            line = raw.decode(errors="replace").rstrip()
            if not line:
                continue
            if self.mode == "setup":
                self.handle_setup_line(line)
            else:
                self.handle_worker_line(line)

    def handle_worker_line(self, line):
        kind, _, rest = line.partition(" ")
        if kind == "P":
            pct, _, text = rest.partition(" ")
            if pct.isdigit():
                self.progress.setValue(int(pct))
            self.status.setText(text)
        elif kind == "IMG":
            name, _, seed = rest.partition(" ")
            self.add_result(name, seed)
        elif kind == "OK":
            try:
                info = json.loads(rest)
                self.info.setText(f"{len(self.thumbs)} Bild{'er' if len(self.thumbs) != 1 else ''} · "
                                  f"{info.get('seconds', 0)} s")
            except ValueError:
                pass
        elif kind == "ERR":
            self.error = rest

    def finished(self, code, _status):
        mode, self.mode = self.mode, None
        self.buffer = b""
        if mode == "setup":
            ok = code == 0 and ready()
            self.setup_progress.setValue(100 if ok else self.setup_progress.value())
            if ok:
                self.setup_status.setText("Fertig – der Bildgenerator ist bereit.")
                self.status.setText("KI bereit. Beschreibe links dein Bild.")
            elif not self.setup_status.text() or self.setup_status.text().startswith("Starte"):
                self.setup_status.setText("Einrichtung fehlgeschlagen – Details siehe unten. Erneut versuchen?")
        else:
            self.progress.hide()
            if self.error:
                self.status.setText(self.error)
            elif code != 0:
                self.status.setText("Die KI wurde unerwartet beendet. Bitte erneut versuchen.")
            else:
                self.status.setText(f"Fertig – gespeichert unter Bilder › {pictures_dir().name}.")
            if self.work:
                shutil.rmtree(self.work, ignore_errors=True)
        self.refresh()

    # ---- Ergebnisse -------------------------------------------------------------
    def open_in_3d(self):
        if self.picked and not QProcess.startDetached("creative-3d", [str(self.picked.path)]):
            self.status.setText("3D Studio ließ sich nicht starten.")

    def save_as(self):
        if not self.picked:
            return
        path, _ = QFileDialog.getSaveFileName(self, "Bild speichern unter",
                                              str(Path.home() / Path(self.picked.path).name), "PNG-Bild (*.png)")
        if path:
            if not path.lower().endswith(".png"):
                path += ".png"
            try:
                shutil.copyfile(self.picked.path, path)
                self.status.setText(f"Gespeichert: {Path(path).name}")
            except OSError as error:
                self.status.setText(f"Speichern fehlgeschlagen: {error}")

    def closeEvent(self, event):
        if self.busy():
            if QMessageBox.question(self, APP, "Es läuft noch etwas. Trotzdem beenden?") \
                    != QMessageBox.StandardButton.Yes:
                event.ignore()
                return
            self.proc.kill()
            self.proc.waitForFinished(2000)
        super().closeEvent(event)


def main():
    selftest = "--selftest" in sys.argv
    app = QApplication(sys.argv)
    app.setApplicationName(APP)
    app.setDesktopFileName("gibeon-bildgenerator")
    app.setWindowIcon(QIcon.fromTheme("gibeon-bildgenerator"))
    window = Generator()
    if selftest:
        assert SETUP.is_file(), "Einrichtungsskript fehlt"
        assert bp.build_prompt("ritter", "figur").startswith("single character, ritter")
        assert not window.save.isEnabled() and not window.to3d.isEnabled()
        window.close()
        print("Bildgenerator: Selbsttest ok")
        return 0
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
