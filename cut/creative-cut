def timecode(ms):
    seconds, milliseconds = divmod(max(0, int(ms)), 1000)
    return f"{seconds // 60:02d}:{seconds % 60:02d}.{milliseconds:03d}"


def combo(items):
    box = QComboBox()
    for key, label in items:
        box.addItem(label, key)
    return box


def set_combo(box, key):
    index = box.findData(key)
    box.setCurrentIndex(max(0, index))


