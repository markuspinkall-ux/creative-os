    # ---- Zustand -----------------------------------------------------------------------
    def snapshot(self):
        return tuple(self.media), tuple(self.clips), tuple(self.titles), tuple(self.music)

    def refresh(self, selection=None):
        if selection is not None:
            self.selection = selection
        kind, index = self.selection
        items = {"clip": self.clips, "title": self.titles, "music": self.music}.get(kind)
        if items is None or not 0 <= index < len(items):
            self.selection = ("", -1)
        if getattr(self, "_listed", None) != tuple(self.media):
            self._listed = tuple(self.media)
            row = self.library.currentRow()
            self.library.clear()
            for media in self.media:
                icon = "🎬" if media.video else "♪"
                self.library.addItem(f"{icon}  {media.name}  ·  {timecode(media.duration)}")
            self.library.setCurrentRow(min(row, len(self.media) - 1))
        _, total = layout(self.clips)
        self.length.setText("Länge  " + timecode(total))
        self.undo_button.setEnabled(bool(self.undo_stack))
        self.redo_button.setEnabled(bool(self.redo_stack))
        self.export_button.setEnabled(bool(self.clips) and self.export is None)
        self.effects_preview.setEnabled(self.export_button.isEnabled())
        self.timeline.selection = self.selection
        self.timeline.relayout()
        self.show_inspector()
        name = self.project.stem if self.project else "Neues Projekt"
        self.setWindowTitle(f"{name}{' *' if self.snapshot() != self.saved else ''} – Creative Cut")

    def checkpoint(self):
        self.undo_stack.append(self.snapshot())
        del self.undo_stack[:-80]
        self.redo_stack.clear()

    def restore(self, source, destination):
        if source:
            destination.append(self.snapshot())
            self.media, self.clips, self.titles, self.music = map(list, source.pop())
            self.refresh()

    # ---- Import ------------------------------------------------------------------------
    def import_media(self):
        if self.importing:
            return
        files, _ = QFileDialog.getOpenFileNames(
            self, "Videos und Musik importieren", str(Path.home()),
            f"Videos und Musik ({VIDEO_TYPES} {AUDIO_TYPES});;Videos ({VIDEO_TYPES});;Musik ({AUDIO_TYPES});;Alle Dateien (*)")
        if not files:
            return
        self.importing = True
        self.import_button.setEnabled(False)
        self.statusBar().showMessage("Dateien werden geprüft …")

        def work():
            found, errors = [], []
            for path in files:
                try:
                    found.append(probe(path))
                except (ValueError, OSError, TypeError, KeyError) as error:
                    errors.append(f"{Path(path).name}: {error}")
                except Exception:
                    errors.append(f"{Path(path).name}: Datei konnte nicht gelesen werden.")
            self.imported.emit(found, errors)
        self.pool.submit(work)

    def finish_import(self, found, errors):
        self.importing = False
        self.import_button.setEnabled(True)
        known = {media.path for media in self.media}
        new = list({media.path: media for media in found if media.path not in known}.values())
        if new:
            self.checkpoint()
            self.media.extend(new)
            self.refresh()
            self.library.setCurrentRow(len(self.media) - len(new))
        self.statusBar().showMessage(f"{len(new)} Dateien importiert.", 5000)
        if errors:
            QMessageBox.warning(self, "Import", "\n".join(errors))

    def append_media(self):
        row = self.library.currentRow()
        if row < 0:
            self.statusBar().showMessage("Wähle zuerst links ein Video oder Musikstück.", 5000)
            return
        media = self.media[row]
        self.checkpoint()
        if media.video:
            self.clips.append(Clip(media, 0, media.duration))
            self.refresh(("clip", len(self.clips) - 1))
        else:
            self.music.append(Music(media, at=self.timeline.playhead if self.music else 0,
                                    start=0, end=media.duration))
            self.refresh(("music", len(self.music) - 1))

    def make_thumb(self, media_path, ms, target):
        def work():
            try:
                CACHE.mkdir(parents=True, exist_ok=True)
                media = next((m for m in self.media if m.path == media_path), None)
                if media is not None:
                    subprocess.run(thumbnail_args(media, ms, target), capture_output=True, timeout=20)
            except (OSError, subprocess.SubprocessError):
                pass
            self.thumbDone.emit(target)
        self.thumbs.submit(work)

    # ---- Auswahl & Inspektor -----------------------------------------------------------
    def select(self, kind, index):
        self.selection = (kind, index)
        self.show_inspector()
        if kind == "clip":
            starts, _ = layout(self.clips)
            self.preview(self.clips[index], index, play=False)
            self.timeline.set_playhead(starts[index])

    def show_inspector(self):
        kind, index = self.selection
        self.loading = True
        try:
            if kind == "clip":
                clip = self.clips[index]
                for control, value in ((self.start, clip.start), (self.end, clip.end)):
                    control.setMaximum(clip.media.duration / 1000)
                    control.setValue(value / 1000)
                self.volume.setValue(clip.volume)
                set_combo(self.look, clip.look)
                self.brightness.setValue(clip.brightness)
                self.contrast.setValue(clip.contrast)
                self.saturation.setValue(clip.saturation)
                set_combo(self.speed, clip.speed)
                self.reverse.setChecked(clip.reverse)
                set_combo(self.kenburns, clip.kenburns)
                self.fade_in.setValue(clip.fade_in / 1000)
                self.fade_out.setValue(clip.fade_out / 1000)
                set_combo(self.transition, clip.transition)
                self.transition.setEnabled(index > 0)
                self.transition_s.setValue(clip.transition_ms / 1000)
                self.transition_s.setEnabled(index > 0)
                if self.title_text.text() != clip.title:
                    self.title_text.setText(clip.title)
                self.inspector.setCurrentIndex(1)
            elif kind == "title":
                title = self.titles[index]
                if self.t_text.text() != title.text:
                    self.t_text.setText(title.text)
                set_combo(self.t_style, title.style)
                self.t_at.setValue(title.at / 1000)
                self.t_duration.setValue(title.duration / 1000)
                self.inspector.setCurrentIndex(2)
            elif kind == "music":
                music = self.music[index]
                self.m_name.setText("♪  " + music.media.name)
                for control in (self.m_start, self.m_end):
                    control.setMaximum(music.media.duration / 1000)
                self.m_at.setValue(music.at / 1000)
                self.m_start.setValue(music.start / 1000)
                self.m_end.setValue(music.end / 1000)
                self.m_volume.setValue(music.volume)
                self.m_fade_in.setValue(music.fade_in / 1000)
                self.m_fade_out.setValue(music.fade_out / 1000)
                self.inspector.setCurrentIndex(3)
            else:
                self.inspector.setCurrentIndex(0)
        finally:
            self.loading = False

    def apply_inspector(self):
        kind, index = self.selection
        ms = lambda box: round(box.value() * 1000)  # noqa: E731
        if kind == "clip":
            old = self.clips[index]
            start, end = ms(self.start), ms(self.end)
            if end - start < 50:
                self.statusBar().showMessage("Das Ende muss mindestens 0,05 s nach dem Start liegen.", 6000)
                return
            new = replace(
                old, start=start, end=end, volume=self.volume.value(), look=self.look.currentData(),
                brightness=self.brightness.value(), contrast=self.contrast.value(),
                saturation=self.saturation.value(), speed=self.speed.currentData(),
                reverse=self.reverse.isChecked(), kenburns=self.kenburns.currentData(),
                fade_in=ms(self.fade_in), fade_out=ms(self.fade_out),
                transition=self.transition.currentData() if index > 0 else "",
                transition_ms=max(100, ms(self.transition_s)),
                title=self.title_text.text().replace("\x00", "").replace("\r", " ").replace("\n", " ").strip(),
            )
            if new.fade_in + new.fade_out > new.length:
                self.statusBar().showMessage("Ein- und Ausblenden müssen zusammen in den Clip passen.", 6000)
                return
            if new != old:
                self.checkpoint()
                self.clips[index] = new
                if self.preview_clip == old:
                    self.preview_clip = new
                    self.player.setPlaybackRate(new.speed / 100)
                    self.audio.setVolume(new.volume / 100)
        elif kind == "title":
            text = self.t_text.text().replace("\x00", "").replace("\r", " ").replace("\n", " ").strip()
            if not text:
                return
            new = Title(text, ms(self.t_at), max(300, ms(self.t_duration)), self.t_style.currentData())
            if new != self.titles[index]:
                self.checkpoint()
                self.titles[index] = new
        elif kind == "music":
            old = self.music[index]
            start, end = ms(self.m_start), ms(self.m_end)
            if end - start < 50:
                self.statusBar().showMessage("„Bis Stelle“ muss nach „Ab Stelle“ liegen.", 6000)
                return
            new = replace(old, at=ms(self.m_at), start=start, end=end, volume=self.m_volume.value(),
                          fade_in=min(ms(self.m_fade_in), end - start), fade_out=min(ms(self.m_fade_out), end - start))
            if new != old:
                self.checkpoint()
                self.music[index] = new
        else:
            return
        self.refresh()

    # ---- Bearbeiten --------------------------------------------------------------------
    def add_title(self):
        self.checkpoint()
        self.titles.append(Title("Mein Titel", self.timeline.playhead, 3000, "mitte"))
        self.refresh(("title", len(self.titles) - 1))
        self.t_text.setFocus()
        self.t_text.selectAll()

    def clip_at(self, ms):
        starts, _ = layout(self.clips)
        for i in reversed(range(len(starts))):
            if starts[i] <= ms < starts[i] + self.clips[i].length:
                return i
        return -1

    def source_pos(self, index, ms):
        """Zeitleisten-ms → Stelle im Quellvideo des Clips."""
        clip = self.clips[index]
        starts, _ = layout(self.clips)
        offset = (ms - starts[index]) * clip.speed / 100
        pos = clip.end - offset if clip.reverse else clip.start + offset
        return int(min(clip.end, max(clip.start, pos)))

    def split(self):
        index = self.clip_at(self.timeline.playhead)
        if index < 0:
            self.statusBar().showMessage("Setze den Abspielkopf auf einen Clip.", 5000)
            return
        clip = self.clips[index]
        position = self.source_pos(index, self.timeline.playhead)
        if not clip.start + 50 <= position <= clip.end - 50 or clip.reverse:
            self.statusBar().showMessage("Hier kann nicht geteilt werden.", 5000)
            return
        self.checkpoint()
        first = replace(clip, end=position, fade_out=0)
        second = replace(clip, start=position, fade_in=0, transition="")
        first = replace(first, fade_in=min(first.fade_in, first.length))
        second = replace(second, fade_out=min(second.fade_out, second.length))
        self.clips[index:index + 1] = [first, second]
        self.refresh(("clip", index + 1))

    def move_clip(self, source, target):
        self.checkpoint()
        self.clips.insert(target, self.clips.pop(source))
        if self.clips:
            self.clips[0] = replace(self.clips[0], transition="")
        self.refresh(("clip", target))

    def shift_item(self, kind, index, at):
        self.checkpoint()
        items = self.titles if kind == "title" else self.music
        items[index] = replace(items[index], at=at)
        self.refresh((kind, index))

    def remove_selected(self):
        kind, index = self.selection
        items = {"clip": self.clips, "title": self.titles, "music": self.music}.get(kind)
        if items is None or not 0 <= index < len(items):
            return
        self.checkpoint()
        items.pop(index)
        if kind == "clip" and self.clips:
            self.clips[0] = replace(self.clips[0], transition="")
        self.refresh((kind, min(index, len(items) - 1)) if items else ("", -1))

    # ---- Vorschau ----------------------------------------------------------------------
    def preview_media(self, item):
        media = self.media[self.library.row(item)]
        self.preview(Clip(media, 0, media.duration))

    def preview(self, clip, index=None, play=False, position=None):
        self.player.pause()
        self.preview_clip, self.preview_index = clip, index
        self.audio.setVolume(clip.volume / 100)
        self.player.setPlaybackRate(clip.speed / 100)
        self.seek.setRange(clip.start, clip.end)
        start = clip.start if position is None else position
        self.seek.setValue(start)
        self.clock.setText(timecode(start))
        self.pending_seek = (start, play)
        url = QUrl.fromLocalFile(clip.media.path)
        if self.player.source() != url:
            self.player.setSource(url)
        elif self.player.isSeekable():
            self.apply_seek()

    def seek_timeline(self, ms):
        self.timeline.set_playhead(ms)
        index = self.clip_at(ms)
        if index >= 0:
            self.preview(self.clips[index], index, play=self.player.isPlaying(), position=self.source_pos(index, ms))

    def apply_seek(self):
        if self.pending_seek is None:
            return
        position, play = self.pending_seek
        self.player.setPosition(position)
        self.pending_seek = None
        if play:
            self.player.play()

    def media_status(self, status):
        if status in (QMediaPlayer.MediaStatus.LoadedMedia, QMediaPlayer.MediaStatus.BufferedMedia):
            self.apply_seek()
        elif status == QMediaPlayer.MediaStatus.EndOfMedia:
            self.advance_preview()

    def position_changed(self, position):
        if self.pending_seek is not None:
            return
        if not self.seek.isSliderDown():
            self.seek.setValue(position)
        self.clock.setText(timecode(position))
        self.play_button.setText("❚❚" if self.player.isPlaying() else "▶")
        clip, index = self.preview_clip, self.preview_index
        if index is not None and 0 <= index < len(self.clips) and self.clips[index] == clip:
            starts, _ = layout(self.clips)
            self.timeline.set_playhead(starts[index] + round((position - clip.start) * 100 / clip.speed))
        if self.player.isPlaying() and clip and position >= clip.end:
            self.advance_preview()

    def advance_preview(self):
        if self.preview_index is not None and self.preview_index + 1 < len(self.clips):
            index = self.preview_index + 1
            self.preview(self.clips[index], index, play=True)
        else:
            self.player.pause()
            self.play_button.setText("▶")

    def toggle_play(self):
        if self.player.isPlaying():
            self.player.pause()
            self.play_button.setText("▶")
            return
        if self.preview_clip is None:
            if not self.clips:
                return
            index = max(0, self.clip_at(self.timeline.playhead))     # Zeitleiste ab Abspielkopf
            starts, _ = layout(self.clips)
            self.preview(self.clips[index], index, play=True,
                         position=self.source_pos(index, max(self.timeline.playhead, starts[index])))
            return
        if self.player.position() >= self.preview_clip.end:
            self.player.setPosition(self.preview_clip.start)
        self.player.play()
        self.play_button.setText("❚❚")

    # ---- Projekt -----------------------------------------------------------------------
    def permit_project_change(self):
        if self.importing or self.export:
            self.statusBar().showMessage("Warte auf den Import oder Export.", 5000)
            return False
        if self.snapshot() == self.saved:
            return True
        choice = QMessageBox.question(self, "Ungespeicherte Änderungen", "Projekt speichern?",
                                      QMessageBox.StandardButton.Save | QMessageBox.StandardButton.Discard
                                      | QMessageBox.StandardButton.Cancel)
        return choice == QMessageBox.StandardButton.Discard or (choice == QMessageBox.StandardButton.Save and self.save_project())

    def load_state(self, path, media, clips, titles, music):
        self.project, self.media, self.clips, self.titles, self.music = path, media, clips, titles, music
        self.saved = self.snapshot()
        self.undo_stack.clear()
        self.redo_stack.clear()
        self.preview_clip = self.preview_index = None
        self.timeline.set_playhead(0)
        self.refresh(("", -1))

    def new_project(self):
        if self.permit_project_change():
            self.load_state(None, [], [], [], [])

    def open_project(self):
        if not self.permit_project_change():
            return
        path, _ = QFileDialog.getOpenFileName(self, "Projekt öffnen", str(Path.home()), "Creative Cut (*.creativecut)")
        if path:
            try:
                self.load_state(Path(path), *read_project(path))
            except (OSError, ValueError, KeyError, TypeError) as error:
                QMessageBox.warning(self, "Projekt konnte nicht geöffnet werden", str(error))

    def save_project(self):
        path = self.project
        if path is None:
            name, _ = QFileDialog.getSaveFileName(self, "Projekt speichern", str(Path.home() / "Neues Projekt.creativecut"),
                                                  "Creative Cut (*.creativecut)")
            if not name:
                return False
            path = Path(name if name.endswith(".creativecut") else name + ".creativecut")
        data = project_data(self.media, self.clips, self.titles, self.music)
        payload = json.dumps(data, ensure_ascii=False, indent=2).encode()
        output = QSaveFile(str(path))
        if not output.open(QIODevice.OpenModeFlag.WriteOnly) or output.write(payload) != len(payload) or not output.commit():
            QMessageBox.warning(self, "Speichern fehlgeschlagen", output.errorString())
            return False
        self.project = path
        self.saved = self.snapshot()
        self.refresh()
        return True

    # ---- Export ------------------------------------------------------------------------
    def render_preview(self):
        if not self.export and self.clips:
            self.start_render(None, 960, 540, int(self.fps.currentText()))

    def start_export(self):
        if self.export or not self.clips:
            return
        path, _ = QFileDialog.getSaveFileName(self, "Video exportieren", str(Path.home() / "Videos" / "Mein Film.mp4"),
                                              "MP4 (*.mp4)")
        if not path:
            return
        target = Path(path if path.lower().endswith(".mp4") else path + ".mp4")
        if os.path.lexists(target):
            QMessageBox.warning(self, "Datei existiert", "Wähle einen neuen Dateinamen für den Export.")
            return
        width, height = {"720p": (1280, 720), "1080p": (1920, 1080), "2160p": (3840, 2160)}[self.resolution.currentText()]
        self.start_render(target, width, height, int(self.fps.currentText()))

    def start_render(self, target, width, height, fps):
        try:
            temp = TemporaryDirectory(dir=target.parent if target else None, prefix=".creative-cut-")
        except OSError as error:
            QMessageBox.warning(self, "Rendern fehlgeschlagen", str(error))
            return
        clips, titles, music = list(self.clips), list(self.titles), list(self.music)
        self.export = dict(target=target, temp=temp, clips=clips, titles=titles, music=music, index=0,
                           stage="clips", cancelled=False, width=width, height=height, fps=fps, output=b"",
                           total=layout(clips)[1])
        self.progress.setRange(0, 100)
        self.progress.setValue(0)
        self.progress.show()
        self.cancel_button.setEnabled(True)
        self.cancel_button.show()
        self.export_button.setEnabled(False)
        self.effects_preview.setEnabled(False)
        self.next_render()

    def next_render(self):
        job = self.export
        root = Path(job["temp"].name)
        index = job["index"]
        job["output"] = b""
        clips = job["clips"]
        try:
            if index < len(clips):
                self.statusBar().showMessage(f"Rendere Clip {index + 1} von {len(clips)} …")
                clip = clips[index]
                title_file = None
                if clip.title:
                    title_file = f"title-{index}.txt"
                    (root / title_file).write_text(textwrap.fill(clip.title, width=36), encoding="utf-8")
                args = segment_args(clip, root / f"segment-{index}.mp4",
                                    job["width"], job["height"], job["fps"], title_file)
            elif needs_finish(clips, job["titles"], job["music"]):
                job["stage"] = "finish"
                self.statusBar().showMessage("Übergänge, Titel und Musik werden eingefügt …")
                files = []
                for k, title in enumerate(job["titles"]):
                    files.append(f"track-title-{k}.txt")
                    (root / files[-1]).write_text(textwrap.fill(title.text, width=32), encoding="utf-8")
                args = finish_args([root / f"segment-{i}.mp4" for i in range(len(clips))], clips,
                                   job["titles"], job["music"], job["width"], job["height"], job["fps"],
                                   files, root / "export.mp4")
            else:
                job["stage"] = "finish"
                manifest = root / "segments.txt"
                manifest.write_text("".join(f"file segment-{i}.mp4\n" for i in range(index)), encoding="utf-8")
                self.statusBar().showMessage("Füge die gerenderten Clips zusammen …")
                args = join_args(manifest, root / "export.mp4")
        except OSError as error:
            self.end_export(str(error))
            return
        self.process.setWorkingDirectory(str(root))
        self.process.start("ffmpeg", args)

    def render_progress(self):
        chunk = bytes(self.process.readAllStandardOutput())
        if not self.export:
            return
        job = self.export
        lines = (job["output"] + chunk).split(b"\n")
        job["output"] = lines.pop()
        clips = job["clips"]
        for line in lines:
            if not (line.startswith(b"out_time_us=") and line[12:].isdigit()):
                continue
            done = int(line[12:]) / 1000
            if job["stage"] == "clips" and job["index"] < len(clips):
                fraction = min(1, done / clips[job["index"]].length)
                self.progress.setValue(int(80 * (job["index"] + fraction) / len(clips)))
            elif job["stage"] == "finish" and job["total"]:
                self.progress.setValue(80 + int(19 * min(1, done / job["total"])))

    def render_finished(self, code, _status):
        job = self.export
        if not job:
            return
        error = bytes(self.process.readAllStandardError()).decode(errors="replace").strip()
        if job["cancelled"] or code:
            self.end_export(error or ("Export abgebrochen." if job["cancelled"] else "FFmpeg konnte nicht exportieren."))
        elif job["stage"] == "clips":
            job["index"] += 1
            self.next_render()
        elif job["target"] is None:
            self.end_export("")
        else:
            source = QFile(str(Path(job["temp"].name) / "export.mp4"))
            if source.rename(str(job["target"])):
                self.end_export("")
            else:
                self.end_export(source.errorString())

    def render_error(self, error):
        if self.export and error == QProcess.ProcessError.FailedToStart:
            self.end_export(self.process.errorString())

    def cancel_export(self):
        if self.export:
            self.export["cancelled"] = True
            self.cancel_button.setEnabled(False)
            self.process.kill()

    def end_export(self, error):
        job, self.export = self.export, None
        preview_ready = job["target"] is None and not error and not job["cancelled"]
        if preview_ready:
            self.player.stop()
            self.player.setSource(QUrl())
            if self.rendered_preview:
                self.rendered_preview.cleanup()
            self.rendered_preview = job["temp"]
            duration = job["total"]
            path = str(Path(self.rendered_preview.name) / "export.mp4")
            self.preview(Clip(Media(path, duration, True), 0, duration), play=True)
        else:
            job["temp"].cleanup()
        self.progress.hide()
        self.cancel_button.hide()
        self.export_button.setEnabled(bool(self.clips))
        self.effects_preview.setEnabled(bool(self.clips))
        if error and not job["cancelled"]:
            QMessageBox.warning(self, "Export fehlgeschlagen", error)
        self.statusBar().showMessage(
            "Export abgebrochen." if job["cancelled"] else "Export fehlgeschlagen." if error
            else "Vorschau mit allen Effekten läuft." if preview_ready
            else f"Export fertig: {job['target']}", 10000)

    def closeEvent(self, event):
        if not self.permit_project_change():
            event.ignore()
            return
        self.player.stop()
        self.player.setSource(QUrl())
        if self.rendered_preview:
            self.rendered_preview.cleanup()
        self.pool.shutdown(wait=False)
        self.thumbs.shutdown(wait=False, cancel_futures=True)
        super().closeEvent(event)


def main():
    app = QApplication(sys.argv)
    app.setDesktopFileName("creative-cut")
    window = CreativeCut()
    if "--selftest" in sys.argv:
        assert not window.export_button.isEnabled() and not window.clips
        assert window.inspector.count() == 4 and window.timeline.total() == 0
        window.close()
        return 0
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
