    def live(self, widget):
        """Änderungen im Inspektor sofort (leicht verzögert) übernehmen."""
        for name in ("valueChanged", "currentIndexChanged", "textEdited", "toggled"):
            signal = getattr(widget, name, None)
            if signal is not None:
                signal.connect(lambda *_: None if self.loading else self.apply_timer.start())
        return widget

