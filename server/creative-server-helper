#!/usr/bin/python3
"""Mein Server – Hilfsprogramm mit Administratorrechten (über pkexec).

Befehle:
  enable <ziel>   Server auf <ziel> einrichten und starten.
                  <ziel> = /dev/… (Partition einer Zusatz-Festplatte) oder „system“
  disable         Server ausschalten (Daten bleiben erhalten)
  internet <name> Aus dem Internet erreichbar machen (DuckDNS, Token über stdin)
  internet-off    Nur noch im Heimnetz
  duckdns-update  Internet-Adresse aktualisieren (läuft alle 5 Minuten)

Sicherheitsregeln: Es wird nie formatiert und nie etwas gelöscht. Das
System-Laufwerk wird nur über den festen Ordner /var/srv/mein-server benutzt.
"""

import json
import os
import pwd
import shutil
import subprocess
import sys
from pathlib import Path

STATE_DIR = Path("/var/lib/creative-server")
STATE = STATE_DIR / "state.json"
CADDYFILE = STATE_DIR / "Caddyfile"
SYSTEM_ROOT = Path("/var/srv/mein-server")
FOLDER = "Mein Server"
PHP_SOCK = "/run/php-fpm/www.sock"
SYSTEM_MOUNTS = {"/", "/sysroot", "/boot", "/boot/efi", "/efi", "/var", "/usr", "/etc", "/home", "/var/home"}
FS_OK = {"ext4", "ext3", "btrfs", "xfs", "ntfs", "ntfs3", "exfat", "vfat"}

INDEX = """<!doctype html>
<html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mein Server</title>
<style>
 body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#12151b;
      color:#dce6ff;font-family:Arial,Helvetica,sans-serif}
 .card{max-width:560px;padding:40px;border-radius:20px;background:#1c2029;box-shadow:0 0 0 1px rgba(255,255,255,.08)}
 h1{margin:0 0 10px;font-size:28px} p{line-height:1.6;margin:8px 0} code{background:#12151b;padding:2px 6px;border-radius:6px}
 .dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:#6fdcc0;margin-right:8px}
</style></head><body><div class="card">
<p><span class="dot"></span>Server läuft</p>
<h1>Willkommen auf deinem Server</h1>
<p>Diese Seite kommt aus dem Ordner <code>Webseite</code> in „Mein Server“.</p>
<p>Ersetze diese Datei (<code>index.html</code>) durch deine eigene Webseite – fertig.
Auch PHP-Seiten (<code>index.php</code>) funktionieren.</p>
<p style="opacity:.6;font-size:13px">Creative OS · Mein Server</p>
</div></body></html>
"""


def run(*args, check=False):
    return subprocess.run(list(args), capture_output=True, text=True, check=check)


def fail(msg):
    print(json.dumps({"ok": False, "error": msg}, ensure_ascii=False))
    sys.exit(1)


def user_ids():
    uid = int(os.environ.get("PKEXEC_UID", "0") or 0)
    try:
        pw = pwd.getpwuid(uid)
        return uid, pw.pw_gid
    except KeyError:
        return uid, uid


def find_device(dev):
    out = run("lsblk", "-J", "-p", "-o", "PATH,UUID,FSTYPE,MOUNTPOINTS,TYPE,LABEL").stdout
    def walk(nodes):
        for n in nodes or []:
            yield n
            yield from walk(n.get("children"))
    for n in walk(json.loads(out).get("blockdevices")):
        if n.get("path") == dev:
            return n
    return None


def ensure_mount(dev):
    n = find_device(dev)
    if not n or n.get("type") not in ("part", "disk", "crypt", "lvm"):
        fail("Dieses Laufwerk wurde nicht gefunden.")
    mps = [m for m in (n.get("mountpoints") or []) if m]
    if any(m in SYSTEM_MOUNTS or m.startswith("/sysroot") for m in mps):
        fail("Das System-Laufwerk kann nicht als Server-Festplatte gewählt werden.")
    fstype = (n.get("fstype") or "").lower()
    if fstype not in FS_OK:
        fail("Dieses Laufwerk hat kein lesbares Dateisystem. Creative OS formatiert nichts – bitte ein anderes wählen.")
    uuid = n.get("uuid")
    if not uuid:
        fail("Das Laufwerk hat keine Kennung (UUID).")

    # Schon dauerhaft eingebunden?
    fstab = Path("/etc/fstab").read_text() if Path("/etc/fstab").exists() else ""
    for line in fstab.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] == f"UUID={uuid}":
            target = parts[1]
            if target not in mps:
                run("mount", target)
            return Path(target), fstype

    target = Path(f"/var/mnt/server-{uuid[:8]}")
    target.mkdir(parents=True, exist_ok=True)
    uid, gid = user_ids()
    if fstype in ("ntfs", "ntfs3", "exfat", "vfat"):
        opts = f"uid={uid},gid={gid},umask=022,context=system_u:object_r:httpd_sys_content_t:s0,nofail"
    else:
        opts = "defaults,nofail"
    # Ist es gerade woanders (z. B. /run/media/…) eingebunden, dort lösen und dauerhaft einbinden
    for m in mps:
        run("umount", m)
    with open("/etc/fstab", "a", encoding="utf-8") as fh:
        fh.write(f"\n# Creative OS – Mein Server\nUUID={uuid} {target} {fstype} {opts} 0 0\n")
    run("systemctl", "daemon-reload")
    r = run("mount", str(target))
    if r.returncode != 0:
        fail("Das Laufwerk konnte nicht eingebunden werden: " + (r.stderr.strip() or "unbekannter Fehler"))
    return target, fstype


def prepare_folder(root, linux_fs):
    site = root / FOLDER / "Webseite"
    site.mkdir(parents=True, exist_ok=True)
    if not any(site.iterdir()):
        (site / "index.html").write_text(INDEX, encoding="utf-8")
    if linux_fs:
        uid, gid = user_ids()
        for p in (root / FOLDER, site):
            os.chown(p, uid, gid)
        for p in site.rglob("*"):
            try:
                os.lchown(p, uid, gid)
            except OSError:
                pass
        # Der Webserver darf lesen (nicht schreiben)
        os.chmod(root, os.stat(root).st_mode | 0o005)
        for p in [root / FOLDER, site] + [x for x in site.rglob("*")]:
            try:
                mode = os.lstat(p).st_mode
                os.chmod(p, mode | (0o005 if p.is_dir() else 0o004))
            except OSError:
                pass
        if shutil.which("chcon"):
            run("chcon", "-R", "-t", "httpd_sys_content_t", str(root / FOLDER))
    return site


def write_config(site, php, domain=""):
    """Caddy-Konfiguration: immer im Heimnetz (:80), optional zusätzlich die
    Internet-Adresse <domain> mit automatischem HTTPS-Zertifikat."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    (STATE_DIR / "data").mkdir(exist_ok=True)
    body = [f'\troot * "{site}"', "\tencode gzip"]
    if php:
        body.append(f"\tphp_fastcgi unix/{PHP_SOCK}")
    body.append("\tfile_server")
    lines = ["{", "\tadmin off", "\tpersist_config off"]
    if not domain:
        lines.append("\tauto_https off")
    lines += ["}", ""]
    if domain:
        lines += [f"{domain} {{"] + body + ["}", ""]
    lines += ["http://:80 {" if domain else ":80 {"] + body + ["}", ""]
    CADDYFILE.write_text("\n".join(lines), encoding="utf-8")
    try:
        caddy = pwd.getpwnam("caddy")
        for p in [STATE_DIR / "data"] + list((STATE_DIR / "data").rglob("*")):
            shutil.chown(p, caddy.pw_uid, caddy.pw_gid)
    except (KeyError, OSError):
        pass


def allow_caddy_php():
    """PHP-FPM lässt standardmäßig nur Apache/Nginx an den Socket – Caddy dazunehmen."""
    conf = Path("/etc/php-fpm.d/www.conf")
    try:
        text = conf.read_text(encoding="utf-8")
    except OSError:
        return
    out = []
    for line in text.splitlines():
        if line.strip().startswith("listen.acl_users") and "caddy" not in line:
            line = line.rstrip() + ",caddy"
        out.append(line)
    conf.write_text("\n".join(out) + "\n", encoding="utf-8")


def firewall(open_port):
    if shutil.which("firewall-cmd"):
        action = "--add-service=http" if open_port else "--remove-service=http"
        run("firewall-cmd", "--permanent", action)
        run("firewall-cmd", "--reload")


def enable(target):
    if not shutil.which("caddy"):
        fail("Der Webserver (Caddy) ist nicht installiert.")
    if target == "system":
        SYSTEM_ROOT.mkdir(parents=True, exist_ok=True)
        root, linux_fs, device = SYSTEM_ROOT, True, "system"
    else:
        root, fstype = ensure_mount(target)
        linux_fs, device = fstype in ("ext4", "ext3", "btrfs", "xfs"), target
    site = prepare_folder(root, linux_fs)

    php = bool(shutil.which("php-fpm"))
    if php:
        allow_caddy_php()
        run("systemctl", "enable", "--now", "php-fpm.service")
        run("systemctl", "restart", "php-fpm.service")
    domain = load_state().get("domain", "") if DUCK.exists() else ""
    write_config(site, php, domain)
    # Den mitgelieferten Caddy-Dienst nicht parallel laufen lassen (Port 80)
    run("systemctl", "disable", "--now", "caddy.service")
    firewall(True)
    run("systemctl", "daemon-reload")
    r = run("systemctl", "enable", "--now", "creative-server.service")
    run("systemctl", "restart", "creative-server.service")
    if r.returncode != 0:
        fail("Der Server konnte nicht gestartet werden.")
    STATE.write_text(json.dumps({"target": device, "root": str(root), "site": str(site), "php": php,
                                 **({"domain": domain} if domain else {})},
                                ensure_ascii=False, indent=2), encoding="utf-8")
    os.chmod(STATE, 0o644)
    print(json.dumps({"ok": True, "site": str(site)}, ensure_ascii=False))


DUCK = STATE_DIR / "duckdns.json"
DUCK_TIMER = """[Unit]
Description=Creative OS – Mein Server: Internet-Adresse aktuell halten

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
"""
DUCK_SERVICE = """[Unit]
Description=Creative OS – Mein Server: Internet-Adresse aktualisieren
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/creative-server-helper duckdns-update
"""


def load_state():
    try:
        return json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def duckdns_update():
    try:
        cfg = json.loads(DUCK.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    import urllib.parse
    import urllib.request
    q = urllib.parse.urlencode({"domains": cfg["name"], "token": cfg["token"], "ip": ""})
    try:
        with urllib.request.urlopen(f"https://www.duckdns.org/update?{q}", timeout=15) as r:
            return r.read().decode().strip() == "OK"
    except OSError:
        return False


def internet_on(name):
    name = name.strip().lower().removesuffix(".duckdns.org")
    if not name or not all(c.isalnum() or c == "-" for c in name):
        fail("Der DuckDNS-Name darf nur Buchstaben, Ziffern und Bindestriche enthalten.")
    token = sys.stdin.readline().strip()
    if len(token) < 20:
        fail("Der DuckDNS-Token fehlt oder ist zu kurz.")
    st = load_state()
    if not st.get("site"):
        fail("Bitte den Server zuerst einschalten.")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    DUCK.write_text(json.dumps({"name": name, "token": token}), encoding="utf-8")
    os.chmod(DUCK, 0o600)
    if not duckdns_update():
        DUCK.unlink(missing_ok=True)
        fail("DuckDNS hat den Namen oder Token nicht angenommen. Bitte beides auf duckdns.org prüfen.")
    Path("/etc/systemd/system/creative-duckdns.timer").write_text(DUCK_TIMER)
    Path("/etc/systemd/system/creative-duckdns.service").write_text(DUCK_SERVICE)
    domain = f"{name}.duckdns.org"
    write_config(st["site"], st.get("php", False), domain)
    if shutil.which("firewall-cmd"):
        run("firewall-cmd", "--permanent", "--add-service=https")
        run("firewall-cmd", "--reload")
    run("systemctl", "daemon-reload")
    run("systemctl", "enable", "--now", "creative-duckdns.timer")
    run("systemctl", "restart", "creative-server.service")
    st["domain"] = domain
    STATE.write_text(json.dumps(st, ensure_ascii=False, indent=2), encoding="utf-8")
    print(json.dumps({"ok": True, "domain": domain}, ensure_ascii=False))


def internet_off():
    st = load_state()
    run("systemctl", "disable", "--now", "creative-duckdns.timer")
    DUCK.unlink(missing_ok=True)
    if shutil.which("firewall-cmd"):
        run("firewall-cmd", "--permanent", "--remove-service=https")
        run("firewall-cmd", "--reload")
    if st.get("site"):
        write_config(st["site"], st.get("php", False), "")
        run("systemctl", "restart", "creative-server.service")
    st.pop("domain", None)
    if st:
        STATE.write_text(json.dumps(st, ensure_ascii=False, indent=2), encoding="utf-8")
    print(json.dumps({"ok": True}))


def disable():
    run("systemctl", "disable", "--now", "creative-server.service")
    run("systemctl", "disable", "--now", "creative-duckdns.timer")
    firewall(False)
    if shutil.which("firewall-cmd"):
        run("firewall-cmd", "--permanent", "--remove-service=https")
        run("firewall-cmd", "--reload")
    print(json.dumps({"ok": True}))


if __name__ == "__main__":
    if os.geteuid() != 0:
        fail("Bitte über die Systemsteuerung starten.")
    if len(sys.argv) >= 3 and sys.argv[1] == "enable":
        enable(sys.argv[2])
    elif len(sys.argv) == 2 and sys.argv[1] == "disable":
        disable()
    elif len(sys.argv) == 3 and sys.argv[1] == "internet":
        internet_on(sys.argv[2])
    elif len(sys.argv) == 2 and sys.argv[1] == "internet-off":
        internet_off()
    elif len(sys.argv) == 2 and sys.argv[1] == "duckdns-update":
        sys.exit(0 if duckdns_update() else 1)
    else:
        fail("Unbekannter Befehl.")
