[Unit]
Description=Creative OS – Mein Server (Webseite)
Documentation=file:///usr/share/doc/creative-server/README.md
After=network-online.target local-fs.target
Wants=network-online.target
ConditionPathExists=/var/lib/creative-server/Caddyfile

[Service]
Type=simple
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/creative-server/data XDG_CONFIG_HOME=/var/lib/creative-server/data HOME=/var/lib/creative-server/data
ExecStart=/usr/bin/caddy run --config /var/lib/creative-server/Caddyfile --adapter caddyfile
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
