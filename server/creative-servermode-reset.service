[Unit]
Description=Creative OS – Server-Modus beim Hochfahren zurücksetzen (normale Anmeldung)
Documentation=file:///usr/share/doc/creative-server/README.md
# Vor dem Anmeldebildschirm, damit er nicht die Server-Maske zeigt
Before=display-manager.service sddm.service creative-servermode.service
After=power-profiles-daemon.service local-fs.target
ConditionPathExists=/var/lib/creative-servermode/state.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/creative-servermode boot
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
