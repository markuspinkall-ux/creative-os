    def refresh_templates(self):
        self.templates.clear()
        items = tr.list_templates()
        for t in items:
            it = QListWidgetItem(QIcon(QPixmap(t["preview"])), t["name"])
            it.setData(Qt.ItemDataRole.UserRole, t["id"])
            it.setToolTip(t["name"])
            self.templates.addItem(it)
        self.no_templates.setVisible(not items)
        self.templates.setVisible(bool(items))
        self.update_template_buttons()

    def update_template_buttons(self):
        has = self.templates.currentItem() is not None and bool(self.templates.selectedItems())
        for b in (self.t_use, self.t_edit, self.t_rename, self.t_delete):
            b.setEnabled(has)

    def current_template(self):
        it = self.templates.currentItem()
        return it.data(Qt.ItemDataRole.UserRole) if it else None

    def start_new(self):
        self.design, self.template_id, self.template_name = tr.new_design(), None, ""
        self.sel = {"images": -1, "texts": -1, "stickers": -1}
        self.redraw()
        self.go(1)

    def use_template(self, edit=False):
        tid = self.current_template()
        if not tid:
            return
        try:
            self.design = tr.load_template(tid)
        except (OSError, ValueError) as error:
            QMessageBox.warning(self, APP, f"Die Vorlage ließ sich nicht öffnen:\n{error}")
            return
        self.template_id, self.template_name = tid, self.design.get("name", "")
        self.sel = {"images": -1, "texts": -1, "stickers": -1}
        self.redraw()
        if edit:
            self.go(1)                                     # Vorlage ändern: alle Schritte von vorn
        else:
            self.go(3 if self.design["texts"] else 1)      # meist will man nur den Text ändern

    def rename_template(self):
        tid = self.current_template()
        if not tid:
            return
        name, ok = QInputDialog.getText(self, "Vorlage umbenennen", "Name:", text=self.templates.currentItem().text())
        if ok and name.strip():
            tr.rename_template(tid, name)
            self.refresh_templates()

    def delete_template(self):
        tid = self.current_template()
        if not tid:
            return
        name = self.templates.currentItem().text()
        if QMessageBox.question(self, "Vorlage löschen", f"Die Vorlage „{name}“ wirklich löschen?") \
                == QMessageBox.StandardButton.Yes:
            tr.delete_template(tid)
            if self.template_id == tid:
                self.template_id, self.template_name = None, ""
            self.refresh_templates()

