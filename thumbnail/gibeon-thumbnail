    def file_stem(self):
        texts = [t["text"] for t in self.design["texts"] if t.get("text", "").strip()]
        base = (self.tpl_name.text().strip() or (texts[0] if texts else "") or "Thumbnail").replace("\n", " ")
        safe = "".join(c if c.isalnum() or c in " -_" else "_" for c in base).strip()[:60]
        return safe or "Thumbnail"

    def save_to_pictures(self):
        folder = pictures_dir() / "Thumbnails"
        folder.mkdir(parents=True, exist_ok=True)
        target = folder / f"{self.file_stem()}.png"
        n = 2
        while target.exists():
            target = folder / f"{self.file_stem()} ({n}).png"
            n += 1
        ok = tr.render(self.design).save(str(target))
        self.done_status.setText(f"Gespeichert: Bilder › Thumbnails › {target.name}" if ok else "Speichern fehlgeschlagen.")

    def export_as(self):
        path, chosen = QFileDialog.getSaveFileName(self, "Thumbnail speichern unter",
                                                   str(pictures_dir() / f"{self.file_stem()}.png"),
                                                   "PNG-Bild (*.png);;JPG-Bild (*.jpg)")
        if not path:
            return
        if not path.lower().endswith((".png", ".jpg", ".jpeg")):
            path += ".jpg" if "jpg" in (chosen or "").lower() else ".png"
        img = tr.render(self.design)
        if path.lower().endswith((".jpg", ".jpeg")):
            img = img.convertToFormat(QImage.Format.Format_RGB32)
            ok = img.save(path, "JPG", 92)
        else:
            ok = img.save(path)
        self.done_status.setText(f"Gespeichert: {Path(path).name}" if ok else "Speichern fehlgeschlagen.")

    def save_template(self, update):
        name = self.tpl_name.text().strip()
        if not name:
            self.done_status.setText("Bitte gib der Vorlage einen Namen.")
            self.tpl_name.setFocus()
            return
        try:
            tid = tr.save_template(self.design, name, self.template_id if update else None)
        except OSError as error:
            self.done_status.setText(f"Vorlage konnte nicht gespeichert werden: {error}")
            return
        self.template_id, self.template_name = tid, name
        self.design = tr.load_template(tid)                 # Bilder zeigen jetzt auf die Kopien der Vorlage
        self.load_controls()
        self.done_status.setText(f"Vorlage „{name}“ gespeichert – sie steht ab jetzt im ersten Schritt zur Wahl.")

    # ---- Bedienelemente mit dem Design abgleichen --------------------------------
    def refresh_lists(self):
        self.loading = True
        for kind, lst in (("images", self.image_list), ("texts", self.text_list), ("stickers", self.sticker_list)):
            lst.clear()
            for i, item in enumerate(self.design[kind]):
                if kind == "images":
                    label = Path(item.get("path", "")).name or f"Bild {i + 1}"
                elif kind == "texts":
                    label = (item.get("text") or "").split("\n")[0][:30] or f"Text {i + 1}"
                else:
                    label = tr.sticker_info(item.get("kind"))[0]
                lst.addItem(label)
            if self.sel[kind] >= len(self.design[kind]):
                self.sel[kind] = len(self.design[kind]) - 1
            if self.sel[kind] < 0 and self.design[kind]:
                self.sel[kind] = 0
            lst.setCurrentRow(self.sel[kind])
        self.loading = False

    def load_controls(self):
        self.loading = True
        bg = self.design["background"]
        kind = bg.get("type", "farbe")
        for key, b in self.bg_choice.items():
            b.setProperty("picked", "true" if key == kind else "false")
            repolish(b)
        self.bg_c1_label.setText("FARBE" if kind == "farbe" else "ERSTE FARBE")
        for wdg in (self.bg_c1_label, self.bg_c1):
            wdg.setVisible(kind in ("farbe", "verlauf"))
        for wdg in (self.bg_c2_label, self.bg_c2, self.bg_angle_label, self.bg_angle):
            wdg.setVisible(kind == "verlauf")
        for wdg in (self.bg_pick, self.bg_blur_label, self.bg_blur):
            wdg.setVisible(kind == "bild")
        self.bg_pick.setText(f"Bild: {Path(bg['image']).name}  ·  ändern …" if bg.get("image") else "Bild wählen …")
        self.bg_angle.setValue(int(bg.get("angle", 135)))
        self.bg_blur.setValue(int(bg.get("blur", 0)))
        self.bg_dim.setValue(int(bg.get("dim", 0)))
        fr = self.design["frame"]
        for key, b in self.fr_choice.items():
            b.setProperty("picked", "true" if key == fr.get("style") else "false")
            repolish(b)
        self.fr_width.setValue(int(fr.get("width", 14)))
        self.fr_color.set(fr.get("color", "#ffffff"))
        self.bg_c1.set(bg.get("color1", ""))
        self.bg_c2.set(bg.get("color2", ""))
        self.tpl_name.setText(self.template_name)
        self.tpl_update.setVisible(self.template_id is not None)
        if self.template_id is not None:
            self.tpl_update.setText(f"Änderungen in Vorlage „{self.template_name}“ speichern")
        self.loading = False
        self.load_layer_controls()

    def load_layer_controls(self):
        self.loading = True
        for kind, box in (("images", self.img_box), ("texts", self.txt_box), ("stickers", self.st_box)):
            i = self.sel[kind]
            items = self.design[kind]
            item = items[i] if 0 <= i < len(items) else None
            box.setEnabled(item is not None)
            if item is None:
                continue
            if kind == "images":
                self.img_scale.setValue(int(item.get("scale", 1) * 100))
                self.img_rot.setValue(int(item.get("rotation", 0)))
                self.img_mirror.setChecked(bool(item.get("mirror")))
                self.img_outline.setChecked(bool(item.get("outline")))
                self.img_outline_w.setValue(int(item.get("outlineWidth", 10)))
                self.img_outline_color.set(item.get("outlineColor", "#ffffff"))
            elif kind == "texts":
                if self.txt_edit.toPlainText() != item.get("text", ""):
                    self.txt_edit.setPlainText(item.get("text", ""))
                self.txt_font.setCurrentFont(QFont(item.get("font", "DejaVu Sans")))
                self.txt_bold.setChecked(bool(item.get("bold")))
                self.txt_italic.setChecked(bool(item.get("italic")))
                self.txt_align.setCurrentIndex(max(0, self.txt_align.findData(item.get("align", "mitte"))))
                self.txt_size.setValue(int(item.get("size", 110)))
                self.txt_rot.setValue(int(item.get("rotation", 0)))
                self.txt_outline.setValue(int(item.get("outline", 0)))
                self.txt_shadow.setChecked(bool(item.get("shadow")))
                self.txt_glow.setChecked(bool(item.get("glow")))
                self.txt_boxed.setChecked(bool(item.get("box")))
                self.txt_color.set(item.get("color", "#ffffff"))
                self.txt_outline_color.set(item.get("outlineColor", "#111111"))
                self.txt_extra_color.set(item.get("glowColor", "#ffd400"))
            else:
                self.st_scale.setValue(int(item.get("scale", 1) * 100))
                self.st_rot.setValue(int(item.get("rotation", 0)))
                self.st_color.set(item.get("color") or tr.sticker_info(item.get("kind"))[1])
        self.loading = False

    def set_layer(self, key, value):
        if self.loading:
            return
        kind, item = self.selected_layer()
        if item is None:
            return
        item[key] = value
        if kind == "texts" and key == "text":
            row = self.sel["texts"]
            if 0 <= row < self.text_list.count():
                self.text_list.item(row).setText(value.split("\n")[0][:30] or f"Text {row + 1}")
        self.changed()


