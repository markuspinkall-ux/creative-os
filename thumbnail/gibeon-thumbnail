class ColorRow(QWidget):
    """Farbvorschläge als runde Knöpfe plus „+“ für eine eigene Farbe; die gewählte Farbe hat einen Ring."""
    changed = Signal(str)

    def __init__(self, label=""):
        super().__init__()
        self.value = ""
        self.buttons = {}
        lay = QHBoxLayout(self)
        lay.setContentsMargins(0, 2, 0, 2)
        lay.setSpacing(5)
        for color in tr.SWATCHES:
            b = QPushButton(objectName="swatch")
            b.setToolTip(color)
            b.setAccessibleName(f"{label} {color}")
            b.clicked.connect(lambda _=False, c=color: self.pick(c))
            lay.addWidget(b)
            self.buttons[color] = b
        self.other = QPushButton("+", objectName="swatch")
        self.other.setToolTip("Andere Farbe …")
        self.other.setAccessibleName(f"{label}: andere Farbe")
        self.other.clicked.connect(self.custom)
        lay.addWidget(self.other)
        lay.addStretch()
        self.paint()

    def paint(self):
        for color, b in self.buttons.items():
            ring = "#8fb3ff" if color == self.value else "rgba(255,255,255,0.25)"
            width = 3 if color == self.value else 2
            b.setStyleSheet(f"background:{color}; border:{width}px solid {ring}; border-radius:12px;")
        custom = self.value and self.value not in self.buttons
        self.other.setStyleSheet(
            f"background:{self.value if custom else 'rgba(255,255,255,0.08)'}; border-radius:12px; font-weight:700;"
            f"border:{3 if custom else 2}px solid {'#8fb3ff' if custom else 'rgba(255,255,255,0.25)'};")

    def set(self, color):
        self.value = (color or "").lower()
        self.paint()

    def pick(self, color):
        self.set(color)
        self.changed.emit(color)

    def custom(self):
        color = QColorDialog.getColor(QColor(self.value or "#ffffff"), self, "Farbe wählen")
        if color.isValid():
            self.pick(color.name())


def slider(lo, hi, value=0):
    s = QSlider(Qt.Orientation.Horizontal)
    s.setRange(lo, hi)
    s.setValue(value)
    return s


class Canvas(QWidget):
    """Große Vorschau. Ebenen der aktuellen Seite lassen sich ziehen und per Mausrad skalieren."""
    moved = Signal()

    def __init__(self, app):
        super().__init__()
        self.app = app
        self.image = QImage()
        self.drag = None
        self.setMinimumSize(QSize(480, 270))
        self.setMouseTracking(True)
        self.setAccessibleName("Vorschau des Thumbnails")

    def target(self):
        w, h = self.width() - 8, self.height() - 8
        scale = min(w / tr.W, h / tr.H)
        dw, dh = tr.W * scale, tr.H * scale
        return (self.width() - dw) / 2, (self.height() - dh) / 2, scale

    def to_design(self, pos):
        x0, y0, s = self.target()
        return QPointF((pos.x() - x0) / s, (pos.y() - y0) / s)

    def paintEvent(self, _event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        x0, y0, s = self.target()
        if not self.image.isNull():
            p.drawImage(int(x0), int(y0), self.image.scaled(int(tr.W * s), int(tr.H * s),
                                                            Qt.AspectRatioMode.IgnoreAspectRatio,
                                                            Qt.TransformationMode.SmoothTransformation))
        kind, item = self.app.selected_layer()
        if item is not None:
            r = tr.layer_rect(kind, item)
            p.setPen(QColor(143, 179, 255, 200))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawRect(int(x0 + r.x() * s), int(y0 + r.y() * s), int(r.width() * s), int(r.height() * s))
        p.end()

    def mousePressEvent(self, event):
        pt = self.to_design(event.position())
        kind = self.app.layer_kind()
        if not kind:
            return
        items = self.app.design.get(kind, [])
        for i in range(len(items) - 1, -1, -1):
            if tr.layer_rect(kind, items[i]).contains(pt):
                self.app.select_layer(i)
                self.drag = (i, pt, items[i]["x"], items[i]["y"])
                return

    def mouseMoveEvent(self, event):
        kind = self.app.layer_kind()
        if kind:
            pt = self.to_design(event.position())
            hit = any(tr.layer_rect(kind, it).contains(pt) for it in self.app.design.get(kind, []))
            self.setCursor(Qt.CursorShape.SizeAllCursor if hit or self.drag else Qt.CursorShape.ArrowCursor)
        if not self.drag or not kind:
            return
        i, start, x, y = self.drag
        pt = self.to_design(event.position())
        item = self.app.design[kind][i]
        item["x"] = max(0, min(tr.W, x + pt.x() - start.x()))
        item["y"] = max(0, min(tr.H, y + pt.y() - start.y()))
        self.moved.emit()

    def mouseReleaseEvent(self, _event):
        self.drag = None

    def wheelEvent(self, event):
        kind, item = self.app.selected_layer()
        if item is None:
            return
        step = 1.06 if event.angleDelta().y() > 0 else 1 / 1.06
        if kind == "texts":
            item["size"] = int(max(20, min(400, item["size"] * step)))
        else:
            item["scale"] = max(0.1, min(5.0, item.get("scale", 1.0) * step))
        self.app.load_layer_controls()
        self.moved.emit()


