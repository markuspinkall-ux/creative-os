def pictures_dir():
    base = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.PicturesLocation) \
        or str(Path.home() / "Bilder")
    return Path(base)


def repolish(widget):
    widget.style().unpolish(widget)
    widget.style().polish(widget)


