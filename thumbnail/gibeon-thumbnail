    # ---- Ablauf -------------------------------------------------------------------
    def go(self, n):
        n = max(0, min(len(STEPS) - 1, n))
        self.step = n
        for i, b in enumerate(self.step_buttons):
            b.setProperty("current", "true" if i == n else "false")
            repolish(b)
        self.pages.setCurrentIndex(n)
        self.step_title.setText(f"Schritt {n + 1} von {len(STEPS)}: {STEPS[n]}")
        self.back.setEnabled(n > 0)
        self.next.setVisible(n < len(STEPS) - 1)
        if n == 0:
            self.refresh_templates()
        if self.layer_kind() == "texts" and not self.design["texts"]:
            self.add_text()
        self.refresh_lists()
        self.load_controls()
        self.hint.setText({"Bilder": "Bild in der Vorschau ziehen · Mausrad = Größe",
                           "Text": "Text in der Vorschau ziehen · Mausrad = Schriftgröße",
                           "Extras": "Sticker in der Vorschau ziehen · Mausrad = Größe"}.get(STEPS[n], ""))
        self.canvas.update()

    def changed(self):
        if not self.loading:
            self.timer.start()

    def redraw(self):
        self.canvas.image = tr.render(self.design)
        self.canvas.update()

    def layer_kind(self):
        return {2: "images", 3: "texts", 5: "stickers"}.get(self.step)

    def selected_layer(self):
        kind = self.layer_kind()
        if not kind:
            return None, None
        i = self.sel[kind]
        items = self.design.get(kind, [])
        return (kind, items[i]) if 0 <= i < len(items) else (kind, None)

    def select_layer(self, i):
        kind = self.layer_kind()
        if kind:
            self.sel[kind] = i
            lst = {"images": self.image_list, "texts": self.text_list, "stickers": self.sticker_list}[kind]
            lst.setCurrentRow(i)
            self.load_layer_controls()
            self.canvas.update()

