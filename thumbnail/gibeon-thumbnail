def example(window):
    """Beispiel-Design für Fotos und Selbsttest."""
    d = tr.new_design()
    d["background"].update({"type": "verlauf", "color1": "#0f2027", "color2": "#e5484d", "angle": 120, "dim": 10})
    t = tr.new_text("MEIN ERSTES\nTHUMBNAIL")
    t.update({"x": 470, "y": 330, "size": 120, "rotation": -4, "outline": 12, "glow": True})
    d["texts"] = [t]
    s = tr.new_sticker("neu")
    s.update({"x": 1080, "y": 120})
    d["stickers"] = [s, tr.new_sticker("pfeil") | {"x": 960, "y": 520, "rotation": 160}]
    d["frame"] = {"style": "neon", "color": "#ffd400", "width": 14}
    window.design = d
    window.redraw()


def main():
    selftest = "--selftest" in sys.argv
    shot = next((a.split("=", 1)[1] for a in sys.argv if a.startswith("--screenshot=")), None)
    step = next((int(a.split("=", 1)[1]) for a in sys.argv if a.startswith("--schritt=")), 0)
    app = QApplication(sys.argv)
    app.setApplicationName(APP)
    app.setDesktopFileName("gibeon-thumbnail")
    app.setWindowIcon(QIcon.fromTheme("gibeon-thumbnail"))
    window = Studio()
    if selftest:
        import tempfile
        os.environ["XDG_DATA_HOME"] = tempfile.mkdtemp(prefix="thumb-test-")
        example(window)
        img = tr.render(window.design)
        assert (img.width(), img.height()) == (tr.W, tr.H)
        tid = tr.save_template(window.design, "Test")
        assert [t["id"] for t in tr.list_templates()] == [tid]
        assert tr.load_template(tid)["texts"][0]["text"].startswith("MEIN")
        for n in range(len(STEPS)):
            window.go(n)
        tr.delete_template(tid)
        assert not tr.list_templates()
        window.close()
        print("Thumbnail Studio: Selbsttest ok")
        return 0
    if shot:
        if "--beispiel" in sys.argv:
            import tempfile
            os.environ["XDG_DATA_HOME"] = tempfile.mkdtemp(prefix="thumb-foto-")
            example(window)
            tr.save_template(window.design, "Let's Play Serie")      # damit „Meine Vorlagen“ etwas zeigt
        window.resize(1360, 820)
        window.show()
        window.go(step)
        if window.layer_kind():
            window.select_layer(0)

        def grab():
            window.grab().save(shot)
            tr.render(window.design).save(shot.replace(".png", "-bild.png"))
            app.quit()
        QTimer.singleShot(600, grab)
        return app.exec()
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
