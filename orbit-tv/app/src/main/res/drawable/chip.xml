<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/text" /><corners android:radius="22dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#268FB3FF" /><corners android:radius="22dp" />
            <stroke android:width="1.5dp" android:color="@color/accent" /></shape>
    </item>
    <item><shape><solid android:color="#14EEEBE4" /><corners android:radius="22dp" /></shape></item>
</selector>
