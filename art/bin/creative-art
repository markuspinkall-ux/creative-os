#!/bin/sh
# Creative Art – startet Krita mit dem Aufbau von Photoshop CS2 (Menüs, Tasten, Paletten).
# Die Menüleiste baut die Erweiterung „creative_art“ nach dem Start auf.
#
# Ältere Creative-OS-Versionen haben eine eigene krita5.xmlgui in den Benutzerordner
# gelegt – damit stürzt Krita 6 beim Start ab. Die wird hier entfernt (nur unsere,
# erkennbar an der Creative-Kennung; eigene Anpassungen bleiben).
old="${XDG_DATA_HOME:-$HOME/.local/share}/krita/krita5.xmlgui"
if [ -f "$old" ] && grep -q "Creative Art: Menüleiste" "$old"; then
    rm -f "$old"
fi
export NOSPLASH=1
# Krita läuft (noch) nur sauber über X11 – die Taskleiste gibt allen Programmen
# „Wayland“ mit, das wird hier zurückgesetzt (XWayland, gleiche Titelleiste)
export QT_QPA_PLATFORM=xcb
unset QT_QUICK_CONTROLS_STYLE
log="${XDG_CACHE_HOME:-$HOME/.cache}/creative-art.log"
mkdir -p "$(dirname "$log")"
exec krita "$@" >"$log" 2>&1
