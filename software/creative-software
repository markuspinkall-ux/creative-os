def catalog_rows(output):
    rows = {}
    for line in output.splitlines():
        fields = line.split("\t")
        if len(fields) >= 2 and ID.fullmatch(fields[0]):
            app_id, name = fields[:2]
            description = fields[2] if len(fields) > 2 else ""
            rows[app_id] = (app_id, name or app_id, description)
    return rows


def appstream_paths(scope):
    user_data = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
    roots = {"user": user_data / "flatpak", "system": Path("/var/lib/flatpak")}
    for filename in ("appstream.xml", "appstream.xml.gz"):
        yield roots[scope] / "appstream/flathub" / platform.machine() / "active" / filename


def screenshot_urls(app_id, scope):
    scopes = (scope, "system" if scope == "user" else "user")
    for source in scopes:
        for path in appstream_paths(source):
            try:
                opener = gzip.open if path.suffix == ".gz" else open
                with opener(path, "rb") as stream:
                    base = ""
                    for event, node in ElementTree.iterparse(stream, events=("start", "end")):
                        if event == "start" and node.tag == "components":
                            base = node.get("media_baseurl", "")
                        if event != "end" or node.tag != "component":
                            continue
                        if node.findtext("id") not in (app_id, app_id + ".desktop"):
                            node.clear()
                            continue
                        shots = node.findall("./screenshots/screenshot")
                        shots.sort(key=lambda shot: shot.get("type") != "default")
                        urls = []
                        for shot in shots:
                            images = shot.findall("image")
                            images.sort(key=lambda img: img.get("type") != "source")
                            for img in images:
                                url = urljoin(base.rstrip("/") + "/", (img.text or "").strip())
                                parts = urlsplit(url)
                                if parts.scheme == "https" and parts.hostname == "dl.flathub.org":
                                    urls.append(url)
                                    break
                        if urls:
                            return list(dict.fromkeys(urls))[:8]
                        break
            except (OSError, ValueError, ElementTree.ParseError):
                continue
    return []


def download_screenshot(url):
    limit = 8 * 1024 * 1024
    with urlopen(url, timeout=7) as response:
        payload = response.read(limit + 1)
    if len(payload) > limit:
        raise ValueError("Screenshot zu groß")
    return payload


class AppDetails(QDialog):
    def __init__(self, parent, row, scope):
        super().__init__(parent)
        app_id, name, description = row
        self.setWindowTitle(name)
        self.resize(740, 540)
        self.setMinimumSize(510, 410)
        self.pool = ThreadPoolExecutor(max_workers=1)
        self.urls = []
        self.index = 0
        self.original = QPixmap()
        layout = QVBoxLayout(self)
        heading = QLabel(name, objectName="headline")
        heading.setTextFormat(Qt.TextFormat.PlainText)
        layout.addWidget(heading)
        info = QLabel(description or app_id, objectName="muted")
        info.setTextFormat(Qt.TextFormat.PlainText)
        info.setWordWrap(True)
        layout.addWidget(info)
        self.image = QLabel("Screenshots werden gesucht …", objectName="gallery")
        self.image.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.image.setMinimumSize(460, 260)
        self.image.setScaledContents(False)
        self.image.setSizePolicy(QSizePolicy.Policy.Ignored, QSizePolicy.Policy.Ignored)
        layout.addWidget(self.image, 1)
        controls = QHBoxLayout()
        self.previous = QPushButton("‹ Zurück")
        self.next = QPushButton("Weiter ›")
        self.counter = QLabel("Screenshots · Flathub", objectName="muted")
        controls.addWidget(self.previous)
        controls.addWidget(self.counter)
        controls.addWidget(self.next)
        controls.addStretch()
        close = QPushButton("Schließen")
        close.clicked.connect(self.accept)
        controls.addWidget(close)
        layout.addLayout(controls)
        self.previous.clicked.connect(lambda: self.show_shot(self.index - 1))
        self.next.clicked.connect(lambda: self.show_shot(self.index + 1))
        self.previous.setEnabled(False)
        self.next.setEnabled(False)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.poll)
        self.finished.connect(self.stop)
        self.future = self.pool.submit(screenshot_urls, app_id, scope or "system")
        self.callback = self.load_gallery
        self.timer.start(50)

    def stop(self):
        self.timer.stop()
        self.pool.shutdown(wait=False, cancel_futures=True)

    def poll(self):
        if not self.future.done():
            return
        self.timer.stop()
        try:
            value = self.future.result()
        except (OSError, ValueError):
            value = None
        self.callback(value)

    def load_gallery(self, urls):
        self.urls = urls or []
        if self.urls:
            self.show_shot(0)
        else:
            self.image.setText("Für diese App sind keine Screenshots im lokalen Katalog verfügbar.")

    def show_shot(self, index):
        self.index = index
        self.previous.setEnabled(False)
        self.next.setEnabled(False)
        self.counter.setText(f"{index + 1} / {len(self.urls)} · Flathub")
        self.original = QPixmap()
        self.image.setText("Screenshot wird geladen …")
        self.future = self.pool.submit(download_screenshot, self.urls[index])
        self.callback = self.image_loaded
        self.timer.start(50)

    def image_loaded(self, payload):
        if payload and self.original.loadFromData(payload):
            self.scale_image()
        else:
            self.image.setText("Screenshot konnte nicht geladen werden.")
        self.previous.setEnabled(self.index > 0)
        self.next.setEnabled(self.index + 1 < len(self.urls))

    def resizeEvent(self, event):
        super().resizeEvent(event)
        if hasattr(self, "image"):
            self.scale_image()

    def scale_image(self):
        if not self.original.isNull():
            self.image.setPixmap(self.original.scaled(
                self.image.size(), Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            ))


