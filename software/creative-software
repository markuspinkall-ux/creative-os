def draw_icon(p, rect, app):
    """App-Symbol (aus dem Katalog) oder Buchstabe auf Farbfläche."""
    pix = app.get("iconPixmap")
    if pix is None and app.get("icon"):
        pix = QPixmap(app["icon"])
        app["iconPixmap"] = pix
    if pix is not None and not pix.isNull():
        p.drawPixmap(rect.toRect(), pix.scaled(rect.size().toSize() * 2, Qt.AspectRatioMode.KeepAspectRatio,
                                               Qt.TransformationMode.SmoothTransformation))
        return
    path = QPainterPath()
    path.addRoundedRect(rect, rect.width() * 0.24, rect.width() * 0.24)
    p.fillPath(path, QColor(tint_for(app["id"])))
    p.setPen(QColor("#ffffff"))
    font = QFont(p.font())
    font.setPixelSize(int(rect.height() * 0.48))
    font.setBold(True)
    p.setFont(font)
    p.drawText(rect, Qt.AlignmentFlag.AlignCenter, (app["name"] or "?")[:1].upper())


def draw_cover(p, rect, pix, app, radius, corners="all"):
    """Vorschaubild randlos (zugeschnitten) oder Farbverlauf mit großem Symbol."""
    path = QPainterPath()
    if corners == "top":
        path.addRoundedRect(QRectF(rect.x(), rect.y(), rect.width(), rect.height() + radius), radius, radius)
        clip = QPainterPath()
        clip.addRect(rect)
        path = path.intersected(clip)
    else:
        path.addRoundedRect(rect, radius, radius)
    p.save()
    p.setClipPath(path)
    if pix is not None and not pix.isNull():
        scaled = pix.scaled(rect.size().toSize(), Qt.AspectRatioMode.KeepAspectRatioByExpanding,
                            Qt.TransformationMode.SmoothTransformation)
        x = rect.x() + (rect.width() - scaled.width()) / 2
        p.drawPixmap(QPointF(x, rect.y()), scaled)
    else:
        base = tint_for(app["id"])
        grad = QLinearGradient(rect.topLeft(), rect.bottomRight())
        grad.setColorAt(0, QColor(base))
        grad.setColorAt(1, darker(base, 0.35))
        p.fillRect(rect, grad)
        size = min(rect.height() * 0.42, 72)
        icon = QRectF(rect.center().x() - size / 2, rect.center().y() - size / 2, size, size)
        draw_icon(p, icon, app)
    p.restore()


class Clickable(QFrame):
    def __init__(self, on_click=None):
        super().__init__()
        self.on_click = on_click
        self.hover = False
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setAttribute(Qt.WidgetAttribute.WA_Hover)

    def enterEvent(self, event):
        self.hover = True
        self.update()

    def leaveEvent(self, event):
        self.hover = False
        self.update()

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton and self.on_click and self.rect().contains(event.position().toPoint()):
            self.on_click()


class FeatureCard(Clickable):
    """Große Empfehlung oben: Vorschaubild, Schild, Symbol, Name."""

    def __init__(self, store, app, tag):
        super().__init__(lambda: store.details(app))
        self.store, self.app, self.tag = store, app, tag
        self.setMinimumHeight(200)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        self.setFixedHeight(210)

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHints(QPainter.RenderHint.Antialiasing | QPainter.RenderHint.SmoothPixmapTransform)
        r = QRectF(self.rect()).adjusted(1, 1, -1, -1)
        draw_cover(p, r, self.store.images.get(self.app.get("thumb")), self.app, 14)
        path = QPainterPath()
        path.addRoundedRect(r, 14, 14)
        shade = QLinearGradient(0, r.bottom() - 110, 0, r.bottom())
        shade.setColorAt(0, QColor(13, 15, 19, 0))
        shade.setColorAt(1, QColor(13, 15, 19, 235))
        p.fillPath(path, shade)
        # Schild
        font = QFont(self.font())
        font.setPixelSize(11)
        font.setBold(True)
        font.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 1.5)
        p.setFont(font)
        w = p.fontMetrics().horizontalAdvance(self.tag) + 20
        tag = QRectF(r.x() + 12, r.y() + 12, w, 24)
        tp = QPainterPath()
        tp.addRoundedRect(tag, 8, 8)
        p.fillPath(tp, QColor(18, 21, 27, 210))
        p.setPen(color("#8fb3ff"))
        p.drawText(tag, Qt.AlignmentFlag.AlignCenter, self.tag)
        # Symbol und Name
        icon = QRectF(r.x() + 14, r.bottom() - 52, 38, 38)
        draw_icon(p, icon, self.app)
        font.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 0)
        font.setPixelSize(15)
        p.setFont(font)
        p.setPen(QColor("#ffffff"))
        p.drawText(QRectF(icon.right() + 12, icon.y() - 1, r.width() - 80, 20), Qt.AlignmentFlag.AlignLeft,
                   self.app["name"])
        font.setBold(False)
        font.setPixelSize(12)
        p.setFont(font)
        p.setPen(QColor(220, 225, 235, 200))
        text = p.fontMetrics().elidedText(self.app["summary"], Qt.TextElideMode.ElideRight, int(r.width() - 80))
        p.drawText(QRectF(icon.right() + 12, icon.y() + 20, r.width() - 80, 18), Qt.AlignmentFlag.AlignLeft, text)
        if self.hover:
            p.setPen(color("#8fb3ff"))
            p.drawPath(path)


class CategoryTile(Clickable):
