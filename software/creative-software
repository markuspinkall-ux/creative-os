    # ---- Daten zusammenführen ---------------------------------------------------------------

    def read_appstream(self, scope):
        self.read_pool.submit(lambda: self.reader.done.emit(read_appstream(scope)))

    def appstream_loaded(self, infos):
        if infos:
            self.infos = infos
            self.apps = {}
            self.render(rebuild=True)

    def app(self, app_id, row=None, scope=None):
        """Alle Angaben zu einer App an einer Stelle (Katalog + Appstream + Installationsstand)."""
        row = row or self.catalog.get(app_id)
        info = self.infos.get(app_id, {})
        app = self.apps.get(app_id)
        if app is None:
            name = info.get("name") or (row[1] if row else app_id.split(".")[-1])
            summary = info.get("summary") or (row[2] if row and len(row) > 2 else "") or ""
            app = {"id": app_id, "name": name, "summary": summary,
                   "category": info.get("category") or "Werkzeuge",
                   "icon": info.get("icon"), "thumb": info.get("thumb")}
            self.apps[app_id] = app
        installed = next((s for s in ("user", "system") if (s, app_id) in self.installed), None)
        app["installed"] = installed
        app["update"] = bool(installed and (installed, app_id) in self.updates)
        app["scope"] = installed or scope or self.remote_scope
        return app

    def catalog_apps(self):
        return [self.app(app_id) for app_id in self.catalog]

    def action_for(self, app):
        if app.get("update"):
            return "Aktualisieren", "update", "primary"
        if app.get("installed"):
            return "Öffnen", "run", "soft"
        return "Holen", "install", "primary"

    def can(self, verb, app):
        if self.preview:
            return True
        scope = app.get("installed") if verb != "install" else app.get("scope")
        return bool(scope in ("user", "system") and not self.operation and
                    (verb != "install" or len(self.loaded_scopes) == 2))

    def image_ready(self, url):
        for widget in self.findChildren(Clickable):
            if getattr(widget, "app", {}).get("thumb") == url:
                widget.update()

    # ---- Navigation -------------------------------------------------------------------------

    def select(self, section):
        self.section = section
        for name, button in self.tabs.items():
            button.setChecked(name == section)
        self.view = ("home",) if section == "Entdecken" else ("section", section)
        self.search.blockSignals(True)
        self.search.clear()
        self.search.blockSignals(False)
        self.render(rebuild=True)

    def go_home(self):
        self.search.blockSignals(True)
        self.search.clear()
        self.search.blockSignals(False)
        self.select("Entdecken")

    def open_category(self, name):
        self.view = ("category", name)
        self.render(rebuild=True)

    def render(self, rebuild=False):
        query = self.search.text().casefold().strip()
        if query:
            view = ("search", self.section, query)
        elif self.view[0] == "search":
            view = ("home",) if self.section == "Entdecken" else ("section", self.section)
        else:
            view = self.view
        changed = rebuild or view != getattr(self, "shown_view", None)
        self.view = view
        self.shown_view = view
        if view[0] == "home":
            self.stack.setCurrentIndex(0)
            self.build_home()
            return
        self.stack.setCurrentIndex(1)
        if changed:
            apps, eyebrow, title, sub, colour, empty = self.listing(view)
            self.list_eyebrow.setText(eyebrow)
            self.list_title.setText(title)
            self.list_sub.setText(sub)
            self.list_head.setStyleSheet(
                f"QFrame {{ background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 {colour},stop:0.7 {T('#1c2029')}); "
                f"border-radius:16px; }} QLabel {{ background:transparent; }}"
                + ("QLabel { color:#ffffff; } QLabel#eyebrow { color:rgba(255,255,255,190); }" if colour != T("#1c2029") else ""))
            self.back.setVisible(self.section == "Entdecken")
            self.grid.show_apps(apps, empty)
        else:
            for tile in self.grid.tiles:
                self.app(tile.app["id"])
            self.grid.refresh()

    def listing(self, view):
        """Apps, Kopfzeilen und Farbe für eine Listenansicht."""
        plain = T("#1c2029")
        if view[0] == "category":
            name, glyph, base, sub, _ = CATEGORY[view[1]]
            apps = [a for a in self.catalog_apps() if a["category"] == name]
            apps.sort(key=lambda a: (a["id"] not in POPULAR, POPULAR.index(a["id"]) if a["id"] in POPULAR else 0,
                                     a["thumb"] is None, not a["name"][:1].isalpha(), a["name"].casefold()))
            return apps, "KATEGORIE", name, f"{sub} · {len(apps)} Apps", base, "In dieser Kategorie ist noch nichts im Katalog."
        if view[0] == "search":
            query = view[2]
            pool = self.section_apps(view[1]) if view[1] != "Entdecken" else self.catalog_apps()
            apps = [a for a in pool if query in f"{a['name']} {a['summary']} {a['id']}".casefold()]
            apps.sort(key=lambda a: (not a["name"].casefold().startswith(query), a["id"] not in POPULAR,
                                     a["name"].casefold()))
            return (apps, "SUCHE", f"„{self.search.text().strip()}“", f"{len(apps)} Treffer", plain,
                    "Keine passenden Apps. Versuch einen anderen Begriff.")
        section = view[1]
        apps = self.section_apps(section)
        if section == "Meine Apps":
            return apps, "INSTALLIERT", "Meine Apps", f"{len(apps)} Apps auf diesem Rechner", plain, \
                "Noch keine Apps aus dem Katalog installiert."
        return apps, "AKTUALISIERUNGEN", "Updates", \
            (f"{len(apps)} Apps können aktualisiert werden" if apps else "Alles aktuell"), plain, \
            "Alle Apps sind auf dem neuesten Stand."

    def section_apps(self, section):
        if section == "Meine Apps":
            apps = [self.app(app_id, row, scope) for (scope, app_id), row in self.installed.items()]
        else:
            apps = [self.app(app_id, row, scope) for (scope, app_id), row in self.installed.items()
                    if (scope, app_id) in self.updates]
        unique = {a["id"]: a for a in apps}
        return sorted(unique.values(), key=lambda a: a["name"].casefold())

    def build_home(self):
        def clear(layout):
            while layout.count():
                item = layout.takeAt(0)
                if item.widget():
                    item.widget().deleteLater()

        apps = self.catalog_apps()
        by_id = {a["id"]: a for a in apps}
        clear(self.featured)
        spots = [(by_id[i], tag) for i, tag in SPOTLIGHT if i in by_id][:3]
        if len(spots) < 3:
            extra = [a for a in apps if a["thumb"] and a["id"] not in dict(SPOTLIGHT)]
            spots += [(a, "ENTDECKEN") for a in extra[:3 - len(spots)]]
        for app, tag in spots:
            self.featured.addWidget(FeatureCard(self, app, tag))

        clear(self.category_grid)
        for index, (name, *_rest) in enumerate(CATEGORIES):
            members = [a for a in apps if a["category"] == name]
            members.sort(key=lambda a: (a["id"] not in POPULAR, POPULAR.index(a["id"]) if a["id"] in POPULAR else 0,
                                        not a["icon"]))
            self.category_grid.addWidget(CategoryTile(self, name, len(members), members[:4]), index // 3, index % 3)

        clear(self.popular)
        top = [by_id[i] for i in POPULAR if i in by_id][:6]
        for rank, app in enumerate(top, 1):
            self.popular.addWidget(PopularRow(self, rank, app))
        if not top:
            waiting = QLabel("Der Katalog wird geladen …", objectName="muted")
            self.popular.addWidget(waiting)
        updates = len({app for _, app in self.updates})
        self.tabs["Updates"].setText(f"Updates  {updates}" if updates else "Updates")

    # ---- Flatpak ----------------------------------------------------------------------------

    def closeEvent(self, event):
        if self.operation:
            self.status.setText("Flatpak arbeitet noch. Warte, bis der Auftrag abgeschlossen ist.")
            event.ignore()
        else:
            self.images.stop()
            self.read_pool.shutdown(wait=False, cancel_futures=True)
            super().closeEvent(event)

    def read_cache(self):
        try:
            return catalog_rows(Path(self.cache).read_text())
        except OSError:
            return {}

    def command(self, args, done, progress=None, program="flatpak"):
        proc = QProcess(self)
        self.processes.add(proc)
        proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        output = bytearray()

        def drain():
            chunk = bytes(proc.readAllStandardOutput())
            if progress:
                progress(chunk.decode(errors="replace"))
            else:
                output.extend(chunk)

        def finish(code):
            if proc not in self.processes:
                return
            drain()
            self.processes.remove(proc)
            proc.deleteLater()
            done(code, output.decode(errors="replace"))

        proc.readyReadStandardOutput.connect(drain)
        proc.finished.connect(lambda code, _: finish(code))
        proc.errorOccurred.connect(
            lambda error: finish(127) if error == QProcess.ProcessError.FailedToStart else None
        )
        proc.start(program, args)

    def scan(self):
        if self.preview or self.operation or not self.refresh.isEnabled():
            return
        self.refresh.setEnabled(False)
        self.loaded_scopes.clear()
        for scope in ("user", "system"):
            self.command(["list", f"--{scope}", "--app", "--columns=application,name,origin"],
                         lambda code, data, s=scope: self.installed_loaded(s, code, data))
        for scope in ("user", "system"):
            self.command(["remote-ls", f"--{scope}", "--updates", "--app", "--columns=application"],
                         lambda result, rows, s=scope: self.updates_loaded(s, result, rows))
        self.command(["remotes", "--user", "--columns=name"], self.user_remotes_loaded)

    def user_remotes_loaded(self, code, data):
        self.find_remote("user", code, data)
        self.render()

    def installed_loaded(self, scope, code, data):
        if code == 0:
            self.installed = {key: value for key, value in self.installed.items() if key[0] != scope}
            self.installed.update({(scope, app): row for app, row in catalog_rows(data).items()})
        self.loaded_scopes.add(scope)
        self.render(rebuild=self.section == "Meine Apps")

    def find_remote(self, scope, code, data):
        if code == 0 and "flathub" in data.splitlines():
            self.remote_scope = scope
            self.render()
            if not any(path.is_file() for path in appstream_paths(scope)):
                self.command(["update", f"--{scope}", "--appstream", "flathub"],
                             lambda *_: self.read_appstream(scope))
            elif not self.infos:
                self.read_appstream(scope)
            self.command(["remote-ls", f"--{scope}", "--app",
                          "--columns=application,name,description", "flathub"], self.catalog_loaded)
        elif scope == "user":
            self.command(["remotes", "--system", "--columns=name"],
                         lambda result, rows: self.find_remote("system", result, rows))
        else:
            self.remote_scope = None
            self.status.setText("Flathub ist nicht erreichbar oder in Flatpak nicht eingerichtet.")
            self.scan_finished()
            self.render()

    def catalog_loaded(self, code, data):
        if code == 0:
            rows = catalog_rows(data)
            if rows:
                self.catalog = rows
                try:
                    self.cache.parent.mkdir(parents=True, exist_ok=True)
                    self.cache.write_text(data)
                except OSError:
                    pass
        if not self.operation:
            self.status.setText(f"Flathub · {len(self.catalog)} Apps" if code == 0 else "Flathub · Gespeicherter Katalog")
        self.render(rebuild=self.view[0] != "home")
        self.scan_finished()

    def scan_finished(self):
        self.refresh.setEnabled(True)
        if self.rescan and not self.operation:
            self.rescan = False
            self.scan()

    def updates_loaded(self, scope, code, data):
        if code == 0:
            self.updates = {key for key in self.updates if key[0] != scope}
            self.updates.update((scope, app) for app in data.splitlines() if ID.fullmatch(app))
        self.render(rebuild=self.section == "Updates")

    def write_progress(self, output):
        self.log.moveCursor(QTextCursor.MoveOperation.End)
        self.log.insertPlainText(output.replace("\r", "\n"))

    def details(self, app):
        AppDetails(self, self.app(app["id"])).exec()

    def open_package(self):
        if self.preview or self.operation:
            return
        path, _ = QFileDialog.getOpenFileName(
            self, "Flatpak-Paket öffnen", "", "Flatpak-Dateien (*.flatpak *.flatpakref)"
        )
        if not path:
            return
        flag = {"flatpak": "--bundle", "flatpakref": "--from"}.get(Path(path).suffix.lstrip(".").lower())
        if flag:
            self.import_package(path, flag, Path(path).name)

    def open_ref(self):
        if self.preview or self.operation:
            return
        url = self.ask_url("Flatpak-Link öffnen", ".flatpakref")
        if url:
            self.import_package(url, "--from", url)

    def ask_url(self, title, suffix):
        value, accepted = QInputDialog.getText(self, title, f"HTTPS-Link zu einer {suffix}-Datei:")
        if not accepted:
            return None
        url = value.strip()
        try:
            parts = urlsplit(url)
            if (parts.scheme == "https" and parts.hostname and not parts.username
                    and not parts.password and parts.path.lower().endswith(suffix)):
                return url
        except ValueError:
            pass
        QMessageBox.warning(self, title, f"Bitte gib einen gültigen HTTPS-Link zu einer {suffix}-Datei ein.")
        return None

    def import_package(self, source, flag, name):
        question = f"""Dieses Paket für dein Benutzerkonto installieren?

{name}

Verwende nur Quellen, denen du vertraust."""
        if QMessageBox.question(self, "Paket installieren", question) == QMessageBox.StandardButton.Yes:
            self.transact(["install", "--user", "--noninteractive", "--assumeyes", flag, source], name)

    def apply(self, verb, app):
        app_id, name = app["id"], app["name"]
        scope = app.get("installed") if verb != "install" else app.get("scope")
        if self.preview or self.operation or scope not in ("user", "system"):
            return
        if verb == "run":
            ok, _ = QProcess.startDetached("flatpak", ["run", f"--{scope}", app_id])
            if not ok:
                self.status.setText("Die App konnte nicht gestartet werden.")
            return
        labels = {"install": "installieren", "uninstall": "entfernen", "update": "aktualisieren"}
        target = "nur für dich" if scope == "user" else "systemweit"
        message = f"{name} {target} {labels[verb]}?"
        if QMessageBox.question(self, "Software", message) != QMessageBox.StandardButton.Yes:
            return
        args = [verb, f"--{scope}", "--noninteractive", "--assumeyes"]
        if verb == "install":
            args.append("flathub")
        args.append(app_id)
        self.transact(args, name)

    def transact(self, args, name, cleanup=None):
        if self.operation:
            return
        self.operation = args[0]
        self.status.setText(f"{name} · wird ausgeführt …")
        self.log.clear()
        self.log.show()
        self.render()

        def done(code, _):
            if cleanup:
                cleanup()
            self.operation = None
            self.status.setText(f"{name} · " + ("Fertig" if code == 0 else f"Fehlgeschlagen (Code {code})"))
            if code == 0:
                self.log.hide()
            self.render()
            if code == 0:
                if self.refresh.isEnabled():
                    self.scan()
                else:
                    self.rescan = True

        self.command(args, done, self.write_progress)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Software")
    app.setDesktopFileName("creative-software")
    preview = "--preview" in sys.argv
    window = Store(preview or "--selftest" in sys.argv)
    if "--selftest" in sys.argv:
        tiles = window.findChildren(CategoryTile)
        assert len(tiles) == len(CATEGORIES), len(tiles)
        assert sum(t.count for t in tiles) == len(DEMO)
        assert len(window.findChildren(FeatureCard)) == 3
        window.open_category("Spiele")
        assert len(window.grid.apps) == 3 and window.stack.currentIndex() == 1
        window.search.setText("blend")
        window.render()
        assert [a["id"] for a in window.grid.apps] == ["org.blender.Blender"]
        window.go_home()
        assert window.stack.currentIndex() == 0
        return 0
    if "--updates" in sys.argv:
        window.select("Updates")
    if "--kategorie" in sys.argv:
        window.open_category(sys.argv[sys.argv.index("--kategorie") + 1])
    if "--suche" in sys.argv:
        window.search.setText(sys.argv[sys.argv.index("--suche") + 1])
    window.show()
    if preview:
        app.processEvents()
        return 0 if window.grab().save(sys.argv[sys.argv.index("--preview") + 1]) else 1
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
