def color(value):
    return QColor(T(value))


def darker(hex_value, factor):
    c = QColor(hex_value)
    return QColor(int(c.red() * factor), int(c.green() * factor), int(c.blue() * factor))


def tint_for(app_id):
    return PALETTE[int(hashlib.md5(app_id.encode()).hexdigest(), 16) % len(PALETTE)]


