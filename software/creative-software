def category_of(cats):
    """Freedesktop-Kategorien einer App → eine der sechs Gibeon-Kategorien."""
    for key in ORDER:
        if key in cats:
            return next(name for name, _, _, _, keys in CATEGORIES if key in keys)
    return "Werkzeuge"


