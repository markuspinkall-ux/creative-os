#!/usr/bin/python3
"""Creative OS software center backed by Flatpak."""

import re
import sys
from pathlib import Path

from PySide6.QtCore import QProcess, QStandardPaths, Qt
from PySide6.QtGui import QTextCursor
from PySide6.QtWidgets import (
    QApplication, QFrame, QHBoxLayout, QLabel, QLineEdit, QListWidget,
    QListWidgetItem, QMessageBox, QPushButton, QTextEdit, QVBoxLayout, QWidget,
)

DEMO = [
    ("org.gimp.GIMP", "GIMP", "Fotos bearbeiten und Grafiken gestalten", "G", "#a998d9"),
    ("org.blender.Blender", "Blender", "3D-Modelle, Animation und Rendering", "B", "#f5a567"),
    ("com.obsproject.Studio", "OBS Studio", "Bildschirm aufnehmen und live streamen", "O", "#8aa9f2"),
    ("org.videolan.VLC", "VLC", "Videos, Musik und Streams abspielen", "V", "#efb477"),
    ("org.inkscape.Inkscape", "Inkscape", "Vektorgrafiken und Illustrationen erstellen", "I", "#8fc6af"),
]
FEATURED = {row[0]: row for row in DEMO}
ID = re.compile(r"[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+){2,}")
STYLE = """
QWidget { background:#141720; color:#eaf0ff; font-size:14px; }
QFrame#hero { background:#212638; border:1px solid #343c53; border-radius:16px; }
QFrame#hero QLabel, QFrame#card QLabel { background:transparent; }
QFrame#card { background:#1d2230; border:1px solid #30384a; border-radius:11px; }
QLabel#headline { font-size:30px; font-weight:700; }
QLabel#eyebrow { color:#acafff; font-weight:700; }
QLabel#muted { color:#aab4cb; }
QLabel#appName { font-size:16px; font-weight:700; }
QLineEdit, QTextEdit { background:#1d2230; border:1px solid #343c53; border-radius:9px; padding:9px; }
QListWidget { border:0; outline:0; }
QListWidget::item { border:0; }
QPushButton { background:#2a3144; border:1px solid #3b455e; border-radius:8px; padding:8px 13px; }
QPushButton:hover { background:#3a4460; }
QPushButton:checked, QPushButton#primary { background:#aaa5ff; color:#18192a; border-color:#aaa5ff; font-weight:700; }
QPushButton#primary:hover { background:#c0bdff; }
QPushButton:disabled { color:#8590a6; background:#262b39; border-color:#343b4d; }
"""


def catalog_rows(output):
    rows = {}
    for line in output.splitlines():
        fields = line.split("\t")
        if len(fields) >= 2 and ID.fullmatch(fields[0]):
            app_id, name = fields[:2]
            description = fields[2] if len(fields) > 2 else ""
            rows[app_id] = (app_id, name or app_id, description)
    return rows


class Store(QWidget):
    def __init__(self, preview=False):
        super().__init__()
        self.preview = preview
        self.setWindowTitle("Creative Software")
        self.resize(980, 620)
        self.setMinimumSize(630, 480)
        self.setStyleSheet(STYLE)
        cache = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.CacheLocation)
        self.cache = Path(cache) / "flathub.tsv"
        self.catalog = {r[0]: r[:3] for r in DEMO} if preview else self.read_cache()
        self.installed = {}
        self.updates = set()
        self.remote_scope = None
        self.section = "Entdecken"
        self.operation = None
        self.processes = set()
        self.loaded_scopes = set()

        layout = QVBoxLayout(self)
        layout.setContentsMargins(26, 22, 26, 20)
        layout.setSpacing(13)
        hero = QFrame(objectName="hero")
        banner = QVBoxLayout(hero)
        banner.setContentsMargins(20, 14, 20, 14)
        banner.setSpacing(3)
        banner.addWidget(QLabel("CREATIVE OS  /  APP-KATALOG", objectName="eyebrow"))
        banner.addWidget(QLabel("Creative Software", objectName="headline"))
        banner.addWidget(QLabel("Entdecke Apps für Arbeit, Kreativität und Unterhaltung.", objectName="muted"))
        layout.addWidget(hero)
        controls = QHBoxLayout()
        self.tabs = {}
        for section in ("Entdecken", "Installiert", "Updates"):
            button = QPushButton(section, checkable=True)
            button.clicked.connect(lambda _, value=section: self.select(value))
            controls.addWidget(button)
            self.tabs[section] = button
        controls.addStretch()
        self.search = QLineEdit(placeholderText="Apps suchen …")
        self.search.setMinimumWidth(180)
        self.search.textChanged.connect(self.render)
        controls.addWidget(self.search)
        self.refresh = QPushButton("Aktualisieren")
        self.refresh.clicked.connect(self.scan)
        controls.addWidget(self.refresh)
        layout.addLayout(controls)

        self.heading = QLabel()
        self.heading.setObjectName("eyebrow")
        layout.addWidget(self.heading)
        self.list = QListWidget()
        self.list.setSelectionMode(QListWidget.SelectionMode.NoSelection)
        self.list.setSpacing(4)
        layout.addWidget(self.list, 1)
        self.status = QLabel("Flathub · Beispielansicht" if preview else "Lokaler Katalog · Flathub wird geprüft …")
        self.status.setObjectName("muted")
        self.status.setWordWrap(True)
        layout.addWidget(self.status)
        self.log = QTextEdit(readOnly=True)
        self.log.setMaximumHeight(125)
        self.log.document().setMaximumBlockCount(200)
        self.log.hide()
        layout.addWidget(self.log)
        self.select(self.section)
        if not preview:
            self.scan()

    def closeEvent(self, event):
        if self.operation:
            self.status.setText("Flatpak arbeitet noch. Warte, bis der Auftrag abgeschlossen ist.")
            event.ignore()
        else:
            super().closeEvent(event)

    def read_cache(self):
        try:
            return catalog_rows(Path(self.cache).read_text())
        except OSError:
            return {}

    def command(self, args, done, progress=None):
        proc = QProcess(self)
        self.processes.add(proc)
        proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        output = bytearray()

        def drain():
            chunk = bytes(proc.readAllStandardOutput())
            if progress:
                progress(chunk.decode(errors="replace"))
            else:
                output.extend(chunk)

        def finish(code):
            if proc not in self.processes:
                return
            drain()
            self.processes.remove(proc)
            proc.deleteLater()
            done(code, output.decode(errors="replace"))

        proc.readyReadStandardOutput.connect(drain)
        proc.finished.connect(lambda code, _: finish(code))
        proc.errorOccurred.connect(
            lambda error: finish(127) if error == QProcess.ProcessError.FailedToStart else None
        )
        proc.start("flatpak", args)

    def scan(self):
        if self.preview or self.operation or not self.refresh.isEnabled():
            return
        self.refresh.setEnabled(False)
        self.loaded_scopes.clear()
        for scope in ("user", "system"):
            self.command(["list", f"--{scope}", "--app", "--columns=application,name,origin"],
                         lambda code, data, s=scope: self.installed_loaded(s, code, data))
        self.command(["remotes", "--user", "--columns=name"],
                     lambda code, data: self.find_remote("user", code, data))

    def installed_loaded(self, scope, code, data):
        if code == 0:
            self.installed = {key: value for key, value in self.installed.items() if key[0] != scope}
            self.installed.update({(scope, app): row for app, row in catalog_rows(data).items()})
        self.loaded_scopes.add(scope)
        self.render()

    def find_remote(self, scope, code, data):
        if code == 0 and "flathub" in data.splitlines():
            self.remote_scope = scope
            self.render()
            self.command(["remote-ls", f"--{scope}", "--app",
                          "--columns=application,name,description", "flathub"], self.catalog_loaded)
        elif scope == "user":
            self.command(["remotes", "--system", "--columns=name"],
                         lambda result, rows: self.find_remote("system", result, rows))
        else:
            self.remote_scope = None
            self.status.setText("Flathub ist nicht erreichbar oder in Flatpak nicht eingerichtet.")
            self.refresh.setEnabled(True)
            self.render()

    def catalog_loaded(self, code, data):
        if code == 0:
            rows = catalog_rows(data)
            if rows:
                self.catalog = rows
                try:
                    self.cache.parent.mkdir(parents=True, exist_ok=True)
                    self.cache.write_text(data)
                except OSError:
                    pass
        if not self.operation:
            self.status.setText("Flathub · Katalog bereit" if code == 0 else "Flathub · Gespeicherter Katalog")
        self.render()
        for scope in ("user", "system"):
            self.command(["remote-ls", f"--{scope}", "--updates", "--app", "--columns=application"],
                         lambda result, rows, s=scope: self.updates_loaded(s, result, rows))
        self.refresh.setEnabled(True)

    def updates_loaded(self, scope, code, data):
        if code == 0:
            self.updates = {key for key in self.updates if key[0] != scope}
            self.updates.update((scope, app) for app in data.splitlines() if ID.fullmatch(app))
        if self.section == "Updates":
            self.render()

    def select(self, section):
        self.section = section
        for name, button in self.tabs.items():
            button.setChecked(name == section)
        self.render()

    def render(self):
        self.list.clear()
        self.heading.setText("ENTDECKEN   ·   FLATHUB" if self.section == "Entdecken" else self.section.upper())
        if self.section == "Entdecken":
            entries = [(self.remote_scope, row) for row in self.catalog.values()]
        else:
            entries = [(key[0], row) for key, row in self.installed.items()
                       if self.section != "Updates" or key in self.updates]
        query = self.search.text().casefold().strip()
        entries = [(scope, row) for scope, row in entries if query in " ".join(row).casefold()]
        entries.sort(key=lambda entry: (entry[1][0] not in FEATURED, entry[1][1].casefold()))
        for scope, row in entries[:150]:
            self.add_row(scope, row)
        if not entries:
            self.list.addItem("Keine passenden Apps. Verwende die Suche oder aktualisiere den Katalog.")

    def add_row(self, scope, row):
        app_id, name, description = row
        card = QFrame(objectName="card")
        layout = QHBoxLayout(card)
        layout.setContentsMargins(12, 7, 12, 7)
        featured = FEATURED.get(app_id)
        icon = QLabel(featured[3] if featured else name[:1].upper())
        icon.setAlignment(Qt.AlignmentFlag.AlignCenter)
        icon.setFixedSize(43, 43)
        color = featured[4] if featured else "#a9b6d6"
        icon.setStyleSheet(f"background:#30384f; color:{color}; border-radius:10px; font-size:19px; font-weight:700;")
        layout.addWidget(icon)
        labels = QVBoxLayout()
        title = QLabel(name, objectName="appName")
        subtitle = QLabel(description or app_id, objectName="muted")
        for label in (title, subtitle):
            label.setTextFormat(Qt.TextFormat.PlainText)
            labels.addWidget(label)
        layout.addLayout(labels, 1)
        installed = any(key[1] == app_id for key in self.installed)
        if self.section == "Entdecken":
            if installed:
                layout.addWidget(QLabel("Installiert", objectName="muted"))
            else:
                self.action(layout, "Installieren", "install", scope, app_id, name)
        elif self.section == "Updates":
            self.action(layout, "Update", "update", scope, app_id, name)
        else:
            self.action(layout, "Öffnen", "run", scope, app_id, name)
            self.action(layout, "Entfernen", "uninstall", scope, app_id, name)
        item = QListWidgetItem()
        item.setSizeHint(card.sizeHint())
        self.list.addItem(item)
        self.list.setItemWidget(item, card)

    def action(self, layout, label, verb, scope, app_id, name):
        button = QPushButton(label, objectName="primary" if verb in ("install", "update") else "")
        button.setEnabled(self.preview or (
            scope is not None and not self.operation and
            (verb != "install" or len(self.loaded_scopes) == 2)
        ))
        button.clicked.connect(lambda: self.apply(verb, scope, app_id, name))
        layout.addWidget(button)

    def apply(self, verb, scope, app_id, name):
        if self.preview or self.operation or scope not in ("user", "system"):
            return
        if verb == "run":
            ok, _ = QProcess.startDetached("flatpak", ["run", f"--{scope}", app_id])
            if not ok:
                self.status.setText("Die App konnte nicht gestartet werden.")
            return
        labels = {"install": "installieren", "uninstall": "entfernen", "update": "aktualisieren"}
        target = "nur für dich" if scope == "user" else "systemweit"
        message = f"{name} {target} {labels[verb]}?"
        if QMessageBox.question(self, "Creative Software", message) != QMessageBox.StandardButton.Yes:
            return
        self.operation = verb
        self.status.setText(f"{name} · Flatpak-Auftrag gestartet …")
        self.log.clear()
        self.log.show()
        self.render()
        args = [verb, f"--{scope}", "--noninteractive", "--assumeyes"]
        if verb == "install":
            args.append("flathub")
        args.append(app_id)

        def progress(output):
            self.log.moveCursor(QTextCursor.MoveOperation.End)
            self.log.insertPlainText(output.replace("\r", "\n"))

        def done(code, _):
            self.operation = None
            self.status.setText(f"{name} · " + ("Abgeschlossen" if code == 0 else f"Fehlgeschlagen (Code {code})"))
            self.render()
            if code == 0:
                self.scan()

        self.command(args, done, progress)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Creative Software")
    app.setDesktopFileName("creative-software")
    preview = "--preview" in sys.argv
    window = Store(preview or "--selftest" in sys.argv)
    if "--selftest" in sys.argv:
        assert window.list.count() == len(DEMO)
        return 0
    window.show()
    if preview:
        app.processEvents()
        return 0 if window.grab().save(sys.argv[sys.argv.index("--preview") + 1]) else 1
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
