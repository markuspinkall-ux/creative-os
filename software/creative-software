        _, glyph, base, _, _ = CATEGORY[self.name]
        p = QPainter(self)
        p.setRenderHints(QPainter.RenderHint.Antialiasing | QPainter.RenderHint.SmoothPixmapTransform)
        r = QRectF(self.rect()).adjusted(1, 1, -1, -1)
        path = QPainterPath()
        path.addRoundedRect(r, 14, 14)
        grad = QLinearGradient(r.topLeft(), r.bottomRight())
        grad.setColorAt(0, QColor(base))
        grad.setColorAt(1, darker(base, 0.28))
        p.fillPath(path, grad)
        font = QFont(self.font())
        font.setPixelSize(64)
        p.setFont(font)
        p.setPen(QColor(255, 255, 255, 60))
        p.drawText(QRectF(r.right() - 96, r.y() + 4, 84, 84), Qt.AlignmentFlag.AlignCenter, glyph)
        font.setPixelSize(19)
        font.setBold(True)
        p.setFont(font)
        p.setPen(QColor("#ffffff"))
        p.drawText(QRectF(r.x() + 18, r.y() + 56, r.width() - 36, 26), Qt.AlignmentFlag.AlignLeft, self.name)
        font.setBold(False)
        font.setPixelSize(12)
        p.setFont(font)
        p.setPen(QColor(255, 255, 255, 175))
        p.drawText(QRectF(r.x() + 18, r.y() + 82, r.width() - 36, 18), Qt.AlignmentFlag.AlignLeft,
                   f"{self.count} Apps" if self.count else "Katalog wird geladen …")
        x = r.right() - 14
        for app in reversed(self.apps[:4]):
            x -= 26
            draw_icon(p, QRectF(x, r.bottom() - 40, 24, 24), app)
            x -= 5
        p.setPen(QColor(255, 255, 255, 120 if self.hover else 26))
        p.drawPath(path)


