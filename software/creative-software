class TileGrid(QScrollArea):
    """Kacheln in so vielen Spalten wie hineinpassen; weitere werden beim Herunterrollen nachgeladen."""
    BATCH = 36

    def __init__(self, store):
        super().__init__()
        self.store = store
        self.setWidgetResizable(True)
        self.setFrameShape(QFrame.Shape.NoFrame)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.inner = QWidget()
        self.grid = QGridLayout(self.inner)
        self.grid.setContentsMargins(0, 4, 0, 16)
        self.grid.setHorizontalSpacing(16)
        self.grid.setVerticalSpacing(16)
        self.grid.setAlignment(Qt.AlignmentFlag.AlignTop | Qt.AlignmentFlag.AlignLeft)
        self.setWidget(self.inner)
        self.apps = []
        self.tiles = []
        self.columns = 0
        self.empty = QLabel(objectName="muted")
        self.empty.setWordWrap(True)
        self.verticalScrollBar().valueChanged.connect(self.maybe_more)

    def show_apps(self, apps, empty_text):
        for tile in self.tiles:
            self.grid.removeWidget(tile)
            tile.deleteLater()
        self.tiles = []
        self.apps = apps
        self.empty.setText(empty_text)
        self.empty.setVisible(not apps)
        self.grid.addWidget(self.empty, 0, 0, 1, 4)
        self.verticalScrollBar().setValue(0)
        self.add_more()

    def refresh(self):
        for tile in self.tiles:
            tile.refresh()

    def column_count(self):
        width = self.viewport().width()
        return max(1, (width + 16) // (AppTile.W + 16))

    def tile_width(self):
        cols = self.column_count()
        return max(AppTile.W, (self.viewport().width() - 16 * (cols - 1)) // cols)

    def add_more(self):
        self.columns = self.column_count()
        width = self.tile_width()
        start = len(self.tiles)
        for app in self.apps[start:start + self.BATCH]:
            tile = AppTile(self.store, app)
            tile.set_width(width)
            index = len(self.tiles)
            self.grid.addWidget(tile, index // self.columns, index % self.columns)
            self.tiles.append(tile)

    def maybe_more(self, value):
        bar = self.verticalScrollBar()
        if len(self.tiles) < len(self.apps) and value > bar.maximum() - 400:
            self.add_more()

    def resizeEvent(self, event):
        super().resizeEvent(event)
        width = self.tile_width()
        for tile in self.tiles:
            tile.set_width(width)
        if self.column_count() != self.columns and self.tiles:
            self.columns = self.column_count()
            for index, tile in enumerate(self.tiles):
                self.grid.addWidget(tile, index // self.columns, index % self.columns)
        QTimer.singleShot(0, lambda: self.maybe_more(self.verticalScrollBar().value()))


