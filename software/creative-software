def catalog_rows(output):
    rows = {}
    for line in output.splitlines():
        fields = line.split("\t")
        if len(fields) >= 2 and ID.fullmatch(fields[0]):
            app_id, name = fields[:2]
            description = fields[2] if len(fields) > 2 else ""
            rows[app_id] = (app_id, name or app_id, description)
    return rows


def appstream_paths(scope):
    user_data = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
    roots = {"user": user_data / "flatpak", "system": Path("/var/lib/flatpak")}
    for filename in ("appstream.xml", "appstream.xml.gz"):
        yield roots[scope] / "appstream/flathub" / platform.machine() / "active" / filename


LANG = "{http://www.w3.org/XML/1998/namespace}lang"


def _localized(node, tag):
    """Deutscher Text, sonst der ohne Sprachangabe."""
    fallback = None
    for child in node.findall(tag):
        lang = child.get(LANG)
        if lang in ("de", "de_DE"):
            return (child.text or "").strip()
        if lang is None and fallback is None:
            fallback = (child.text or "").strip()
    return fallback


def flathub_url(base, text):
    url = urljoin(base.rstrip("/") + "/", (text or "").strip())
    parts = urlsplit(url)
    return url if parts.scheme == "https" and parts.hostname == "dl.flathub.org" else None


def read_appstream(scope):
    """Kategorie, deutscher Name/Text, Symbol und Vorschaubild aller Apps aus dem lokalen Katalog."""
    infos = {}
    for path in appstream_paths(scope):
        if not path.is_file():
            continue
        icons = path.parent / "icons"
        try:
            opener = gzip.open if path.suffix == ".gz" else open
            with opener(path, "rb") as stream:
                base = ""
                for event, node in ElementTree.iterparse(stream, events=("start", "end")):
                    if event == "start" and node.tag == "components":
                        base = node.get("media_baseurl", "")
                    if event != "end" or node.tag != "component":
                        continue
                    app_id = (node.findtext("id") or "").removesuffix(".desktop")
                    if not ID.fullmatch(app_id):
                        node.clear()
                        continue
                    cats = {c.text for c in node.findall("./categories/category") if c.text}
                    icon = None
                    for size in ("128x128", "64x64"):
                        for el in node.findall("icon"):
                            if el.get("type") == "cached" and el.get("width") == size.split("x")[0] and el.text:
                                candidate = icons / size / el.text.strip()
                                if candidate.is_file():
                                    icon = str(candidate)
                                    break
                        if icon:
                            break
                    thumb = None
                    shots = node.findall("./screenshots/screenshot")
                    shots.sort(key=lambda shot: shot.get("type") != "default")
                    for shot in shots[:1]:
                        best = None
                        for img in shot.findall("image"):
                            width = int(img.get("width") or 0)
                            if img.get("type") == "thumbnail" and width >= 400:
                                if best is None or abs(width - 624) < abs(best[0] - 624):
                                    best = (width, img.text)
                        if best is None:
                            src = next((i for i in shot.findall("image") if i.get("type") == "source"), None)
                            best = (0, src.text) if src is not None else None
                        if best:
                            thumb = flathub_url(base, best[1])
                    infos[app_id] = {
                        "name": _localized(node, "name"),
                        "summary": _localized(node, "summary"),
                        "category": category_of(cats),
                        "icon": icon,
                        "thumb": thumb,
                    }
                    node.clear()
            if infos:
                return infos
        except (OSError, ValueError, EOFError, ElementTree.ParseError):
            continue
    return infos


def screenshot_urls(app_id, scope):
    scopes = (scope, "system" if scope == "user" else "user")
    for source in scopes:
        for path in appstream_paths(source):
            try:
                opener = gzip.open if path.suffix == ".gz" else open
                with opener(path, "rb") as stream:
                    base = ""
                    for event, node in ElementTree.iterparse(stream, events=("start", "end")):
                        if event == "start" and node.tag == "components":
                            base = node.get("media_baseurl", "")
                        if event != "end" or node.tag != "component":
                            continue
                        if node.findtext("id") not in (app_id, app_id + ".desktop"):
                            node.clear()
                            continue
                        shots = node.findall("./screenshots/screenshot")
                        shots.sort(key=lambda shot: shot.get("type") != "default")
                        urls = []
                        for shot in shots:
                            images = shot.findall("image")
                            images.sort(key=lambda img: img.get("type") != "source")
                            for img in images:
                                url = flathub_url(base, img.text)
                                if url:
                                    urls.append(url)
                                    break
                        if urls:
                            return list(dict.fromkeys(urls))[:8]
                        break
            except (OSError, ValueError, EOFError, ElementTree.ParseError):
                continue
    return []


def download_screenshot(url):
    limit = 8 * 1024 * 1024
    with urlopen(url, timeout=10) as response:
        payload = response.read(limit + 1)
    if len(payload) > limit:
        raise ValueError("Screenshot zu groß")
    return payload


class Images(QObject):
    """Vorschaubilder im Hintergrund laden und auf der Platte zwischenspeichern."""
    loaded = Signal(str)

    def __init__(self, cache_dir):
        super().__init__()
        self.dir = Path(cache_dir) / "vorschau"
        self.pool = ThreadPoolExecutor(max_workers=4)
        self.pixmaps = {}
        self.pending = set()
        self.failed = set()

    def path(self, url):
        return self.dir / (hashlib.sha1(url.encode()).hexdigest() + ".img")

    def get(self, url):
        """Fertiges Bild oder None (und Laden anstoßen)."""
        if not url or url in self.failed:
            return None
        pix = self.pixmaps.get(url)
        if pix is not None:
            return pix
        file = self.path(url)
        if file.is_file():
            pix = QPixmap()
            if pix.load(str(file)):
                self.pixmaps[url] = pix
                return pix
        if url not in self.pending:
            self.pending.add(url)
            self.pool.submit(self._fetch, url)
        return None

    def _fetch(self, url):
        try:
            data = download_screenshot(url)
            self.dir.mkdir(parents=True, exist_ok=True)
            tmp = self.path(url).with_suffix(".tmp")
            tmp.write_bytes(data)
            tmp.replace(self.path(url))
        except (OSError, ValueError):
            self.failed.add(url)
        self.pending.discard(url)
        self.loaded.emit(url)

    def stop(self):
        self.pool.shutdown(wait=False, cancel_futures=True)


