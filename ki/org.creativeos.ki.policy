<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Creative OS</vendor>
  <action id="org.creativeos.ki.setup">
    <description>KI-Modell für den KI-Helfer laden</description>
    <message>Das KI-Modell für den KI-Helfer wird geladen.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <!-- Nur Modelle aus der festen Liste mit Prüfsumme – darum ohne Passwort -->
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/creative-ki-setup</annotate>
  </action>
</policyconfig>
