#!/bin/sh
# Browser: Electron (Chromium mit H.264); die App liegt in electron/resources/app
export CHROME_DESKTOP=creative-browser.desktop
# Web-Apps bringen ihre eigene Fensterklasse mit (--class=creative-whatsapp …)
case " $* " in
    *" --class="*) exec /usr/lib/creative-browser/electron/electron "$@" ;;
    *) exec /usr/lib/creative-browser/electron/electron --class=creative-browser "$@" ;;
esac
