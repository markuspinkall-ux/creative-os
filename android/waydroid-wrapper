#!/bin/sh
# Gibeon OS: waydroid mit Fensterrahmen.
# Startet ein Benutzer Android (Sitzung, App, Oberfläche), läuft das Bild über den Fenster-Vermittler
# gibeon-android-fenster: Er gibt Android-Fenstern den normalen Gibeon-Rahmen und das Tablet-Format.
# Abschalten in „Android-Apps“ → Einstellungen. Klappt etwas nicht, geht es ohne Vermittler weiter.
#
# App starten, während Android noch nicht läuft: Waydroid würde dabei die ganze LineageOS-Oberfläche
# öffnen und die App darin zeigen. Stattdessen startet Android hier unsichtbar im Hintergrund;
# sobald es fertig hochgefahren ist, öffnet sich die App direkt als eigenes Fenster.
REAL="@WAYDROID@"
if [ "$(id -u)" -ne 0 ] && [ -n "${WAYLAND_DISPLAY:-}" ] && [ -x /usr/libexec/gibeon-android-fenster ]; then
    case "${1:-} ${2:-}" in
        "session start"*|"app launch"*|show-full-ui*|first-launch*)
            if disp=$(/usr/libexec/gibeon-android-fenster --ensure 2>/dev/null) && [ -n "$disp" ]; then
                export WAYLAND_DISPLAY="$disp"
            fi ;;
    esac
fi

laeuft() {
    timeout 10 "$REAL" status 2>/dev/null | grep -q "Session:[[:space:]]*RUNNING"
}

prop() {
    timeout 10 "$REAL" prop get "$1" 2>/dev/null | tail -n 1 | tr -d '[:space:]'
}

hochgefahren() {
    [ "$(prop sys.boot_completed)" = "1" ]
}

# Die Boot-Animation endet erst, wenn der Android-Startbildschirm (LineageOS) fertig gezeichnet ist.
# Startet die App vorher, schiebt sich der Startbildschirm danach davor – die App landet dann in der
# großen LineageOS-Oberfläche statt in ihrem eigenen Fenster.
startbild_fertig() {
    case "$(prop init.svc.bootanim)" in
        running|restarting) return 1 ;;
    esac
    return 0
}

# Ganze Android-Oberfläche bewusst geöffnet: dann nichts automatisch schließen
case "${1:-}" in show-full-ui) rm -f "${XDG_RUNTIME_DIR:-/tmp}/gibeon-android-erststart" ;; esac

nutzer=""
[ "$(id -u)" -ne 0 ] || [ -n "${GIBEON_WAYDROID_TEST:-}" ] && nutzer=1     # (Variable nur für Tests)
if [ -n "$nutzer" ] && [ "${1:-}" = "app" ] && [ "${2:-}" = "launch" ] && [ -n "${3:-}" ] && ! laeuft; then
    lock="${XDG_RUNTIME_DIR:-/tmp}/gibeon-android-start.lock"
    # Erster Start: Waydroid zeigt die erste App sonst in der ganzen LineageOS-Oberfläche – erst wenn die
    # einmal geschlossen wurde, kommen Apps als eigene Fenster. Der Fenster-Vermittler schließt sie dann
    # selbst (Datei „gibeon-android-erststart“), danach wird die App hier noch einmal geöffnet.
    erst="${XDG_RUNTIME_DIR:-/tmp}/gibeon-android-erststart"
    rm -f "$erst.fertig"
    touch "$erst"
    (
        # Mehrere Apps gleichzeitig angeklickt: nur einmal Android starten
        command -v flock >/dev/null 2>&1 && flock -w 180 9
        if ! laeuft; then
            setsid "$REAL" session start >/dev/null 2>&1 < /dev/null &
        fi
        i=0
        while [ "$i" -lt 180 ]; do
            if laeuft && hochgefahren && startbild_fertig; then
                sleep 3                     # Startbildschirm ganz fertig werden lassen
                break
            fi
            sleep 1
            i=$((i + 1))
        done
    ) 9>"$lock"
    # Danach: Sobald der Vermittler die LineageOS-Oberfläche geschlossen hat, die App als eigenes Fenster
    # neu öffnen. Kam die Oberfläche gar nicht, holt ein zweiter Aufruf die App trotzdem nach vorn.
    (
        i=0
        while [ "$i" -lt 25 ] && [ ! -e "$erst.fertig" ]; do sleep 1; i=$((i + 1)); done
        if [ -e "$erst.fertig" ]; then sleep 2; else sleep 0; fi
        rm -f "$erst" "$erst.fertig"
        "$REAL" app launch "$3" >/dev/null 2>&1
    ) </dev/null >/dev/null 2>&1 &
fi
exec "$REAL" "$@"
